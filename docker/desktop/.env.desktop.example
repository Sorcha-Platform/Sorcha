# =============================================================================
# Sorcha Desktop Node — environment
# Copy to ".env" in this folder and fill in the [REQUIRED] values.
#   cp .env.desktop.example .env
# The deploy script will generate secrets for you if you skip this step.
# NEVER commit .env — it holds secrets.
# =============================================================================

# ---- Installation identity --------------------------------------------------
# Drives the JWT issuer (urn:sorcha:{name}) and tier audiences. Pick something
# stable and unique to this node; changing it later invalidates existing tokens.
INSTALLATION_NAME=desktop

# ---- Secrets [REQUIRED] -----------------------------------------------------
# 256-bit base64 key signing every JWT. Generate: openssl rand -base64 32
JWT_SIGNING_KEY=

# Database credentials. Generate strong values; these are baked into the volumes
# on first boot, so set them BEFORE the first `up`.
POSTGRES_USER=sorcha
POSTGRES_PASSWORD=
MONGO_USERNAME=sorcha
MONGO_PASSWORD=

# Per-service ServiceAuth client secrets (#1423) — one per internal service
# principal, seeded into the Tenant Service DB and presented back by each
# service's own ServiceAuthClient. Generate distinct random values, e.g.
# openssl rand -base64 32 (or LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32).
# scripts/deploy-desktop.sh / .ps1 fill these in for you on first run.
WALLET_SERVICE_SECRET=
TENANT_SERVICE_SECRET=
REGISTER_SERVICE_SECRET=
VALIDATOR_SERVICE_SECRET=
HAIP_SERVICE_SECRET=
PEER_SERVICE_SECRET=
BLUEPRINT_SERVICE_SECRET=

# ---- Image selection --------------------------------------------------------
# Pull a pinned version instead of :latest for a reproducible node, e.g. 2.412.1
SORCHA_IMAGE_REPO=sorchadev
SORCHA_IMAGE_TAG=latest

# ---- Ingress ----------------------------------------------------------------
# Host port for the API Gateway (UI at /app, wallet at /wallet, APIs at /api/*).
# Kept >1024 so rootless Podman can bind it. Browse to http://localhost:8880/app
SORCHA_HTTP_PORT=8880
VERIFIER_PORT=7401
EMAIL_BASE_URL=http://localhost:8880

# ---- Peer / federation (optional) -------------------------------------------
PEER_NODE_ID=desktop-node.local
PEER_GRPC_PORT=50051
# To join an existing network, point these at a seed node and re-deploy:
# SEED_PEER_NODE_ID=n1.sorcha.dev
# SEED_PEER_HOST=n1.sorcha.dev
# SEED_PEER_PORT=50051
# SEED_PEER_ENABLE_TLS=true

# ---- Optional integrations --------------------------------------------------
# AI-assisted blueprint design chat (leave blank to disable).
ANTHROPIC_API_KEY=
# Outbound transactional email via Azure Communication Services (blank = no-op).
ACS_EMAIL_CONNECTION_STRING=
EMAIL_FROM_ADDRESS=noreply@sorcha.dev
EMAIL_FROM_NAME=Sorcha Platform

# ---- Tuning -----------------------------------------------------------------
# Login attempts/min before throttling — relaxed so a class/demo of 10-20 users
# self-registering in a burst isn't rate-limited.
PLATFORM_AUTH_LIMIT=500
# Require a token to read the OpenAPI/Scalar docs surface.
OPENAPI_REQUIRE_AUTH=true
