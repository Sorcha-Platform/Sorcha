{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sorcha-Platform/Sorcha/specs/117-ai-discoverability/contracts/mcp-manifest.schema.json",
  "title": "Sorcha MCP Manifest",
  "description": "Discovery manifest for the Sorcha MCP server, served at /.well-known/mcp.json.",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "transports",
    "authentication",
    "tool_categories",
    "tool_catalogue_url",
    "documentation_url"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Optional reference to this schema."
    },
    "name": {
      "type": "string",
      "const": "sorcha-mcp"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical platform version, identical to the served OpenAPI document's info.version."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence factual description of the MCP server. No marketing adjectives."
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transport" },
      "description": "Available transports. At minimum stdio + http+sse."
    },
    "authentication": { "$ref": "#/$defs/authentication" },
    "tool_categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/toolCategory" },
      "description": "Tool categories keyed by category name (admin, designer, participant)."
    },
    "tool_catalogue_url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the full tool catalogue endpoint."
    },
    "documentation_url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the human-readable MCP server documentation."
    }
  },
  "$defs": {
    "transport": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["stdio", "http+sse"]
        },
        "command": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "stdio" } } },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "type": { "const": "http+sse" } } },
          "then": { "required": ["url"] }
        }
      ]
    },
    "authentication": {
      "type": "object",
      "required": ["type", "issuer", "audience", "acquisition_url"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["jwt-bearer"]
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_url": {
          "type": "string",
          "format": "uri",
          "description": "Link to the JWT acquisition flow (script, doc, or endpoint)."
        }
      }
    },
    "toolCategory": {
      "type": "object",
      "required": ["count", "description"],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "One-sentence description of when an agent should pick this slice."
        }
      }
    }
  }
}
