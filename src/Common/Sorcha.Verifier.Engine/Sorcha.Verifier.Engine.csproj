<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Pure-managed Ed25519 verification (WASM-safe — the verifier engine runs in the citizen
         wallet PWA's Blazor WASM host, where libsodium P/Invoke is unavailable). -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sorcha.Verification.Abstractions\Sorcha.Verification.Abstractions.csproj" />
    <ProjectReference Include="..\Sorcha.ServiceClients.Http\Sorcha.ServiceClients.Http.csproj" />
    <ProjectReference Include="..\Sorcha.Cryptography.Secp256k1\Sorcha.Cryptography.Secp256k1.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sorcha.Verifier.Tests" />
  </ItemGroup>

</Project>
