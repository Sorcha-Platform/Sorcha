<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Sorcha.ServiceClients.Http</PackageId>
    <Description>HTTP REST clients and SignalR hub helper for Sorcha services. No gRPC dependencies.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="SimpleBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference common models needed by Register clients -->
    <ProjectReference Include="..\Sorcha.Register.Models\Sorcha.Register.Models.csproj" />
    <!-- Feature 114: citizen wallet DTO surface -->
    <ProjectReference Include="..\Sorcha.CitizenWallet.Abstractions\Sorcha.CitizenWallet.Abstractions.csproj" />
    <!-- Canonical Wallet HTTP contracts (CreateWalletRequest, Bip39WordCountAttribute, …) -->
    <ProjectReference Include="..\Sorcha.Wallet.Contracts\Sorcha.Wallet.Contracts.csproj" />
    <ProjectReference Include="..\Sorcha.Tenant.Models\Sorcha.Tenant.Models.csproj" />
    <ProjectReference Include="..\Sorcha.Serialization\Sorcha.Serialization.csproj" />
    <ProjectReference Include="..\Sorcha.WorkloadIdentity\Sorcha.WorkloadIdentity.csproj" />
    <ProjectReference Include="..\Sorcha.Cryptography.Secp256k1\Sorcha.Cryptography.Secp256k1.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sorcha.ServiceClients.Tests" />
  </ItemGroup>

</Project>
