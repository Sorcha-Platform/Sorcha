{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sorcha.dev/schemas/citizen-wallet/device-delegation-credential.v1.json",
  "title": "Sorcha Citizen Device Delegation Credential",
  "description": "SD-JWT VC issued by the citizen's holder key to a specific device, authorising the device to make presentations on the holder's behalf. Verifiers consume this offline as part of the trust chain.",
  "type": "object",
  "required": [
    "iss",
    "sub",
    "iat",
    "exp",
    "vct",
    "delegated_capabilities",
    "device",
    "cnf",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "iss": {
      "type": "string",
      "pattern": "^did:sorcha:holder:[A-Za-z0-9_-]{43}$",
      "description": "Issuer DID — the holder identity. Locator is the JWK thumbprint of the holder public key (slot 108)."
    },
    "sub": {
      "type": "string",
      "pattern": "^did:sorcha:device:[A-Za-z0-9_-]{43}$",
      "description": "Subject DID — the device identity. Locator is the JWK thumbprint of the device public key."
    },
    "iat": {
      "type": "integer",
      "description": "Issued-at, seconds since epoch."
    },
    "exp": {
      "type": "integer",
      "description": "Expiry, seconds since epoch. Default issuance: iat + 31_536_000 (12 months)."
    },
    "vct": {
      "const": "https://sorcha.dev/vc/citizen-device-delegation/v1",
      "description": "Verifiable Credential Type identifier."
    },
    "delegated_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "presentation.holder-key-binding"
        ]
      },
      "description": "Capabilities granted by the holder to the device. v1 supports exactly one capability."
    },
    "device": {
      "type": "object",
      "required": ["label", "platform", "enrolled_at"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "platform": {
          "type": "string",
          "maxLength": 120
        },
        "enrolled_at": {
          "type": "integer",
          "description": "Original enrolment time. Preserved across delegation renewals."
        }
      }
    },
    "cnf": {
      "type": "object",
      "required": ["jwk"],
      "additionalProperties": false,
      "properties": {
        "jwk": {
          "type": "object",
          "required": ["kty", "crv", "x", "y"],
          "properties": {
            "kty": { "const": "EC" },
            "crv": { "const": "P-256" },
            "x": { "type": "string", "description": "base64url" },
            "y": { "type": "string", "description": "base64url" }
          },
          "additionalProperties": false
        }
      },
      "description": "Confirmation method — the device's public key. Verifier validates the device's KB-JWT against this key."
    },
    "status": {
      "type": "object",
      "required": ["status_list"],
      "additionalProperties": false,
      "properties": {
        "status_list": {
          "type": "object",
          "required": ["uri", "idx"],
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri",
              "description": "URL of the org-scoped citizen-devices status list (Token Status List 2024)."
            },
            "idx": {
              "type": "integer",
              "minimum": 0,
              "description": "Bit position within the status list."
            }
          }
        }
      }
    }
  }
}
