<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Sorcha.AddressLookup</PackageId>
    <Description>Pluggable address lookup providers for Sorcha (postcode validation and full-address autocomplete). Hosted in Tenant Service; consumed via the /api/address-lookup/* endpoints and the PostcodeLookupField form control.</Description>
    <PackageTags>sorcha;address-lookup;postcode;paf</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
