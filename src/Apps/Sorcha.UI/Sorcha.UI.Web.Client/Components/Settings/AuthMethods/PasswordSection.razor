@* Read-only password section for the Accounts tab (Feature 116 US4).
   Set/Change/Remove actions get wired in US3 (PasswordManagementService). *@

@using Sorcha.UI.Core.Models
@using Sorcha.UI.Core.Services
@inject ILocalizationService Loc

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-1">
        @Loc.T("settings.accounts.password.title")
    </MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        @Loc.T("settings.accounts.password.description")
    </MudText>

    @if (Password is null)
    {
        <MudSkeleton Width="200px" Height="24px" />
    }
    else if (Password.IsSet)
    {
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Success" Class="mr-2" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1">
                    @Loc.T("settings.accounts.password.set")
                </MudText>
                @if (Password.LastChangedAt.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Loc.T("settings.accounts.password.lastChanged"):
                        @Password.LastChangedAt.Value.ToLocalTime().ToString("d MMM yyyy")
                    </MudText>
                }
            </div>
            <!-- Change / Remove actions wired in US3. -->
            <MudButton Variant="Variant.Outlined" Disabled="true" Class="mr-2">
                @Loc.T("settings.accounts.password.change")
            </MudButton>
            @if (Password.CanRemove)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="true">
                    @Loc.T("settings.accounts.password.remove")
                </MudButton>
            }
            else
            {
                <MudTooltip Text="@Loc.T("settings.accounts.lastMethodWarning")">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="true">
                        @Loc.T("settings.accounts.password.remove")
                    </MudButton>
                </MudTooltip>
            }
        </div>
    }
    else
    {
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Default" Class="mr-2" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1">
                    @Loc.T("settings.accounts.password.notSet")
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">
                @Loc.T("settings.accounts.password.set.button")
            </MudButton>
        </div>
    }
</MudPaper>

@code {
    [Parameter] public AuthMethodsPassword? Password { get; set; }
}
