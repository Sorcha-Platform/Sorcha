<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="mr-2" />
            Credential Offer
        </MudText>
    </TitleContent>
    <DialogContent>
        <CredentialOfferQrCard
            CredentialOfferUri="@CredentialOfferUri"
            OfferId="@OfferId"
            CredentialType="@CredentialType"
            IssuerName="@IssuerName"
            ExpiresAt="@ExpiresAt"
            OnStatusChanged="@HandleStatusChanged" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close" Variant="Variant.Text">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string CredentialOfferUri { get; set; } = string.Empty;
    [Parameter] public Guid OfferId { get; set; }
    [Parameter] public string CredentialType { get; set; } = string.Empty;
    [Parameter] public string? IssuerName { get; set; }
    [Parameter] public DateTimeOffset? ExpiresAt { get; set; }

    private void HandleStatusChanged(string newStatus)
    {
        if (newStatus == "Exchanged")
        {
            MudDialog.Close(DialogResult.Ok(newStatus));
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Cancel());
}
