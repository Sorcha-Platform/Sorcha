@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Credentials
@implements IDisposable
@inject IQrPresentationService QrService
@inject IHaipOfferService HaipService
@inject ILogger<PresentationRequestQrCard> Logger

<MudCard Elevation="3" Class="presentation-request-qr-card pa-4">
    <MudCardHeader>
        <CardHeaderAvatar>
            @if (_state == HaipVerificationStates.Verified)
            {
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Success" Size="Size.Large" />
            }
            else if (_state is HaipVerificationStates.Denied or HaipVerificationStates.Expired or HaipVerificationStates.Cancelled)
            {
                <MudIcon Icon="@Icons.Material.Filled.GppBad" Color="Color.Error" Size="Size.Large" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.QrCode2" Color="Color.Primary" Size="Size.Large" />
            }
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                @switch (_state)
                {
                    case HaipVerificationStates.Verified:
                        @:Credential Verified
                        break;
                    case HaipVerificationStates.Denied:
                        @:Presentation Denied
                        break;
                    case HaipVerificationStates.Expired:
                        @:Request Expired
                        break;
                    case HaipVerificationStates.Cancelled:
                        @:Request Cancelled
                        break;
                    case HaipVerificationStates.Submitted:
                        @:Verifying Credential...
                        break;
                    default:
                        @:Scan to Present Credential
                        break;
                }
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @CredentialType
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="d-flex flex-column align-center">
        @if (_state == HaipVerificationStates.Verified && _verificationResult is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                Credential verified successfully.
            </MudAlert>

            @if (_verificationResult.VerifiedClaims is { Count: > 0 })
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2 align-self-start">Disclosed Claims</MudText>
                <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" Style="max-width: 400px; width: 100%;">
                    <tbody>
                        @foreach (var claim in _verificationResult.VerifiedClaims)
                        {
                            <tr>
                                <td><MudText Typo="Typo.body2" Color="Color.Secondary">@claim.Key</MudText></td>
                                <td><MudText Typo="Typo.body2">@FormatClaimValue(claim.Value)</MudText></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }
        else if (_state == HaipVerificationStates.Denied)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                The wallet holder denied the presentation request.
            </MudAlert>
            @if (_verificationResult?.Errors is { Count: > 0 })
            {
                @foreach (var error in _verificationResult.Errors)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">@error</MudText>
                }
            }
        }
        else if (_state == HaipVerificationStates.Expired)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                This request has expired. A new presentation request is needed.
            </MudAlert>
        }
        else if (_state == HaipVerificationStates.Cancelled)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                This request was cancelled.
            </MudAlert>
        }
        else if (_state == HaipVerificationStates.Submitted)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Verifying presented credential...
            </MudText>
        }
        else if (!string.IsNullOrEmpty(_svgContent))
        {
            @* SVG is safe: generated by QRCoder from an internal API URI, not user-supplied markup *@
            <div class="qr-code-container mb-4">
                @((MarkupString)_svgContent)
            </div>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" Style="max-width: 280px;" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Waiting for wallet to scan...
            </MudText>
        }

        <MudSimpleTable Dense="true" Bordered="false" Class="mt-4" Style="max-width: 400px;">
            <tbody>
                @if (!string.IsNullOrEmpty(CredentialType))
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Required Credential</MudText></td>
                        <td><MudText Typo="Typo.body2">@CredentialType</MudText></td>
                    </tr>
                }
                @if (RequestedClaims is { Count: > 0 })
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Requested Claims</MudText></td>
                        <td><MudText Typo="Typo.body2">@string.Join(", ", RequestedClaims)</MudText></td>
                    </tr>
                }
                @if (ExpiresAt.HasValue && _state is HaipVerificationStates.Pending or HaipVerificationStates.Submitted)
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Request Expires</MudText></td>
                        <td><MudText Typo="Typo.body2">@ExpiresAt.Value.LocalDateTime.ToString("dd MMM HH:mm")</MudText></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@code {
    /// <summary>The openid4vp://authorize?... URI to render as a QR code.</summary>
    [Parameter, EditorRequired] public string PresentationRequestUri { get; set; } = string.Empty;

    /// <summary>The request ID used for result polling.</summary>
    [Parameter, EditorRequired] public Guid RequestId { get; set; }

    /// <summary>The type of credential being requested.</summary>
    [Parameter] public string CredentialType { get; set; } = string.Empty;

    /// <summary>The list of claims being requested for disclosure.</summary>
    [Parameter] public List<string>? RequestedClaims { get; set; }

    /// <summary>When the request expires.</summary>
    [Parameter] public DateTimeOffset? ExpiresAt { get; set; }

    /// <summary>Callback when the request state changes.</summary>
    [Parameter] public EventCallback<string> OnStateChanged { get; set; }

    /// <summary>Callback when verification completes successfully with the result.</summary>
    [Parameter] public EventCallback<HaipVerificationResult> OnVerified { get; set; }

    private string? _svgContent;
    private string _state = HaipVerificationStates.Pending;
    private HaipVerificationResult? _verificationResult;
    private Guid _polledRequestId;
    private CancellationTokenSource? _cts;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        if (RequestId != Guid.Empty && RequestId != _polledRequestId)
        {
            _cts?.Cancel();
            _cts?.Dispose();
            _polledRequestId = RequestId;
            _state = HaipVerificationStates.Pending;
            _verificationResult = null;
            _svgContent = !string.IsNullOrEmpty(PresentationRequestUri)
                ? QrService.GenerateSvgFromUri(PresentationRequestUri)
                : null;
            _cts = new CancellationTokenSource();
            _ = RunPollingLoopAsync(RequestId, _cts.Token);
        }
        else if (string.IsNullOrEmpty(_svgContent) && !string.IsNullOrEmpty(PresentationRequestUri))
        {
            _svgContent = QrService.GenerateSvgFromUri(PresentationRequestUri);
        }
    }

    private async Task RunPollingLoopAsync(Guid requestId, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(HaipPollingDefaults.PollInterval);
        var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (++ticks > HaipPollingDefaults.MaxPollTicks) break;
                if (ExpiresAt.HasValue && DateTimeOffset.UtcNow > ExpiresAt.Value)
                {
                    await InvokeAsync(() =>
                    {
                        if (_disposed || HaipVerificationStates.IsTerminal(_state)) return;
                        _state = HaipVerificationStates.Expired;
                        StateHasChanged();
                    });
                    break;
                }

                var result = await HaipService.GetVerificationResultAsync(requestId, ct);
                if (result is null) continue;

                var newState = result.State;
                if (newState == _state) continue;

                var terminal = HaipVerificationStates.IsTerminal(newState);

                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    _state = newState;
                    _verificationResult = result;
                    StateHasChanged();

                    if (OnStateChanged.HasDelegate)
                        await OnStateChanged.InvokeAsync(_state);

                    if (_state == HaipVerificationStates.Verified && OnVerified.HasDelegate)
                        await OnVerified.InvokeAsync(result);
                });

                if (terminal) break;
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on disposal or parameter change
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Polling loop failed for request {RequestId}", requestId);
        }
    }

    private static string FormatClaimValue(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString() ?? string.Empty,
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        JsonValueKind.Null or JsonValueKind.Undefined => "\u2014", // em dash
        JsonValueKind.Number => value.GetRawText(),
        // An object or array must never render as raw JSON: that is how an unresolved
        // SD-JWT digest array \u2014 {"_sd":[\u2026]} \u2014 reached a citizen's credential card.
        // The shared formatter renders it structurally and drops protocol keys.
        _ => CredentialClaimDisplayFormatter.FormatJsonElementForDetailDisplay(value)
    };

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
