@using Microsoft.Extensions.Logging
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Credentials
@implements IDisposable
@inject IQrPresentationService QrService
@inject IHaipOfferService HaipService
@inject ILogger<CredentialOfferQrCard> Logger

<MudCard Elevation="3" Class="credential-offer-qr-card pa-4">
    <MudCardHeader>
        <CardHeaderAvatar>
            @if (_status == HaipOfferStates.Exchanged)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            }
            else if (_status is HaipOfferStates.Expired or HaipOfferStates.Cancelled)
            {
                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.QrCode2" Color="Color.Primary" Size="Size.Large" />
            }
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                @if (_status == HaipOfferStates.Exchanged)
                {
                    @:Credential Collected
                }
                else
                {
                    @:Scan to Collect Credential
                }
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @CredentialType
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="d-flex flex-column align-center">
        @if (_status == HaipOfferStates.Exchanged)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                The credential has been collected by the external wallet.
            </MudAlert>
        }
        else if (_status == HaipOfferStates.Expired)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                This offer has expired. A new credential offer is needed.
            </MudAlert>
        }
        else if (_status == HaipOfferStates.Cancelled)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                This offer was cancelled.
            </MudAlert>
        }
        else if (!string.IsNullOrEmpty(_svgContent))
        {
            @* SVG is safe: generated by QRCoder from an internal API URI, not user-supplied markup *@
            <div class="qr-code-container mb-4">
                @((MarkupString)_svgContent)
            </div>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" Style="max-width: 280px;" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Waiting for wallet to scan...
            </MudText>
        }

        <MudSimpleTable Dense="true" Bordered="false" Class="mt-4" Style="max-width: 400px;">
            <tbody>
                @if (!string.IsNullOrEmpty(IssuerName))
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Issuer</MudText></td>
                        <td><MudText Typo="Typo.body2">@IssuerName</MudText></td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(CredentialType))
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Credential</MudText></td>
                        <td><MudText Typo="Typo.body2">@CredentialType</MudText></td>
                    </tr>
                }
                @if (ExpiresAt.HasValue)
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Offer Expires</MudText></td>
                        <td><MudText Typo="Typo.body2">@ExpiresAt.Value.LocalDateTime.ToString("dd MMM HH:mm")</MudText></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

<style>
    .credential-offer-qr-card .qr-code-container svg {
        max-width: 280px;
        max-height: 280px;
    }
</style>

@code {
    /// <summary>The openid-credential-offer:// URI to render as a QR code.</summary>
    [Parameter, EditorRequired] public string CredentialOfferUri { get; set; } = string.Empty;

    /// <summary>The offer ID used for status polling.</summary>
    [Parameter, EditorRequired] public Guid OfferId { get; set; }

    /// <summary>The type of credential being offered.</summary>
    [Parameter] public string CredentialType { get; set; } = string.Empty;

    /// <summary>Display name of the issuing organisation.</summary>
    [Parameter] public string? IssuerName { get; set; }

    /// <summary>When the offer expires.</summary>
    [Parameter] public DateTimeOffset? ExpiresAt { get; set; }

    /// <summary>Callback when the offer status changes (e.g. Pending → Exchanged).</summary>
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }

    private string? _svgContent;
    private string _status = HaipOfferStates.Pending;
    private Guid _polledOfferId;
    private CancellationTokenSource? _cts;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        if (OfferId != Guid.Empty && OfferId != _polledOfferId)
        {
            _cts?.Cancel();
            _cts?.Dispose();
            _polledOfferId = OfferId;
            _status = HaipOfferStates.Pending;
            _svgContent = !string.IsNullOrEmpty(CredentialOfferUri)
                ? QrService.GenerateSvgFromUri(CredentialOfferUri)
                : null;
            _cts = new CancellationTokenSource();
            _ = RunPollingLoopAsync(OfferId, _cts.Token);
        }
        else if (string.IsNullOrEmpty(_svgContent) && !string.IsNullOrEmpty(CredentialOfferUri))
        {
            _svgContent = QrService.GenerateSvgFromUri(CredentialOfferUri);
        }
    }

    private async Task RunPollingLoopAsync(Guid offerId, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(HaipPollingDefaults.PollInterval);
        var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (++ticks > HaipPollingDefaults.MaxPollTicks) break;
                if (ExpiresAt.HasValue && DateTimeOffset.UtcNow > ExpiresAt.Value) break;

                var result = await HaipService.GetOfferStatusAsync(offerId, ct);
                if (result is null) continue;

                var newStatus = result.Status;
                if (newStatus == _status) continue;

                var terminal = HaipOfferStates.IsTerminal(newStatus);

                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    _status = newStatus;
                    StateHasChanged();
                    if (OnStatusChanged.HasDelegate)
                        await OnStatusChanged.InvokeAsync(_status);
                });

                if (terminal) break;
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on disposal or parameter change
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Polling loop failed for offer {OfferId}", offerId);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
