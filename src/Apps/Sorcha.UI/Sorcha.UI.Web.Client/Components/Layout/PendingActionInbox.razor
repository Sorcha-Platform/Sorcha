@implements IDisposable
@inject IPendingActionService PendingActionService
@inject IActivityLogService ActivityLogService
@inject EventsHubConnection EventsHub
@inject NavigationManager Navigation
@using Sorcha.UI.Core.Models
@using Sorcha.UI.Core.Services
@using MudBlazor

<MudDrawer @bind-Open="IsOpen" Anchor="Anchor.End" Elevation="4" Width="420px" Variant="@DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Pending Actions</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadCurrentTab" />
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => IsOpen = false)" />
    </MudDrawerHeader>

    <MudTabs ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChanged" ApplyEffectsToContainer="true" PanelClass="pa-0">
        <MudTabPanel Text="Active" Icon="@Icons.Material.Filled.Inbox" />
        <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History" />
    </MudTabs>

    @if (_activeTab == 1)
    {
        @if (_historyLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_historyItems.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="ma-4">No notification history</MudAlert>
        }
        else
        {
            <MudList T="string" Class="pa-0">
                @foreach (var group in _historyGroups)
                {
                    <MudListSubheader>
                        <MudText Typo="Typo.subtitle2">@group.Key</MudText>
                    </MudListSubheader>
                    @foreach (var evt in group.Value)
                    {
                        <MudListItem T="string">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body2"><strong>@evt.Title</strong></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@evt.Message</MudText>
                                <MudText Typo="Typo.caption">@evt.CreatedAt.ToString("HH:mm")</MudText>
                            </div>
                        </MudListItem>
                    }
                }
            </MudList>
        }
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_groups.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="ma-4">No pending actions</MudAlert>
    }
    else
    {
        <MudList T="string" Class="pa-0">
            @foreach (var group in _groups)
            {
                <MudListSubheader>
                    <MudText Typo="Typo.subtitle2">@group.Key</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@group.Value.Count</MudChip>
                </MudListSubheader>
                @foreach (var action in group.Value)
                {
                    <MudListItem T="string" OnClick="@(() => NavigateToAction(action))">
                        <div class="d-flex flex-column">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@GetUrgencyIcon(action.Urgency)" Color="@GetUrgencyColor(action.Urgency)" Size="Size.Small" />
                                <MudText Typo="Typo.body2"><strong>@action.ActionTitle</strong></MudText>
                                @if (!string.IsNullOrEmpty(action.InstanceReference))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-family: monospace;">@action.InstanceReference</MudText>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(action.Summary))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@action.Summary</MudText>
                            }
                            <div class="d-flex justify-space-between mt-1">
                                <MudText Typo="Typo.caption">@action.SenderDisplayName</MudText>
                                @if (action.Deadline.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="@GetDeadlineColor(action.Deadline.Value)">
                                        @FormatDeadline(action.Deadline.Value)
                                    </MudText>
                                }
                            </div>
                        </div>
                    </MudListItem>
                }
            }
        </MudList>

        @if (_totalCount > _items.Count)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" OnClick="LoadMoreAsync"
                       Class="my-2">
                Load more (@(_totalCount - _items.Count) remaining)
            </MudButton>
        }
    }
</MudDrawer>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private bool _loading;
    private int _page = 1;
    private int _totalCount;
    private int _activeTab;
    private List<PendingActionSummaryDto> _items = [];
    private Dictionary<string, List<PendingActionSummaryDto>> _groups = new();
    private readonly List<PendingActionNotificationDto> _realtimeBuffer = [];
    private DateTime _lastRender = DateTime.UtcNow;
    private System.Timers.Timer? _batchTimer;

    // History tab state
    private bool _historyLoading;
    private List<ActivityEventDto> _historyItems = [];
    private Dictionary<string, List<ActivityEventDto>> _historyGroups = new();

    protected override void OnInitialized()
    {
        EventsHub.OnPendingActionReceived += HandleRealtimeNotification;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && _items.Count == 0)
        {
            await LoadCurrentTab();
        }
    }

    private async Task OnTabChanged(int index)
    {
        _activeTab = index;
        await LoadCurrentTab();
    }

    private async Task LoadCurrentTab()
    {
        if (_activeTab == 1)
            await LoadHistoryAsync();
        else
            await LoadPendingActionsAsync();
    }

    private async Task LoadHistoryAsync()
    {
        _historyLoading = true;
        StateHasChanged();

        var response = await ActivityLogService.GetEventsAsync(page: 1, pageSize: 50);
        _historyItems = response.Items
            .Where(e => e.EventType == "PendingAction")
            .ToList();

        _historyGroups = _historyItems
            .GroupBy(e => CategorizeDate(e.CreatedAt))
            .ToDictionary(g => g.Key, g => g.ToList());

        _historyLoading = false;
        StateHasChanged();
    }

    private static string CategorizeDate(DateTime date)
    {
        var today = DateTime.UtcNow.Date;
        if (date.Date == today) return "Today";
        if (date.Date == today.AddDays(-1)) return "Yesterday";
        if (date.Date >= today.AddDays(-7)) return "This Week";
        return "Earlier";
    }

    private async Task LoadPendingActionsAsync()
    {
        _loading = true;
        _page = 1;
        StateHasChanged();

        var response = await PendingActionService.GetPendingActionsAsync(page: _page);
        _items = response.Items;
        _totalCount = response.TotalCount;
        RebuildGroups();

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadMoreAsync()
    {
        _page++;
        var response = await PendingActionService.GetPendingActionsAsync(page: _page);
        _items.AddRange(response.Items);
        RebuildGroups();
        StateHasChanged();
    }

    private void RebuildGroups()
    {
        _groups = _items
            .OrderByDescending(a => a.Urgency == "urgent" ? 0 : a.Urgency == "warning" ? 1 : 2)
            .ThenByDescending(a => a.ReceivedAt)
            .GroupBy(a => a.BlueprintTitle)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void HandleRealtimeNotification(PendingActionNotificationDto dto)
    {
        InvokeAsync(() =>
        {
            if (!IsOpen) return;

            // Burst throttling: batch updates when >10 arrive in 2 seconds
            _realtimeBuffer.Add(dto);
            var now = DateTime.UtcNow;
            if ((now - _lastRender).TotalSeconds < 2 && _realtimeBuffer.Count > 10)
            {
                if (_batchTimer is null)
                {
                    _batchTimer = new System.Timers.Timer(500) { AutoReset = false };
                    _batchTimer.Elapsed += (_, _) => InvokeAsync(FlushRealtimeBuffer);
                }
                _batchTimer.Stop();
                _batchTimer.Start();
                return;
            }

            FlushRealtimeBuffer();
        });
    }

    private void FlushRealtimeBuffer()
    {
        foreach (var dto in _realtimeBuffer)
        {
            _items.Insert(0, new PendingActionSummaryDto
            {
                InstanceId = string.Empty,
                ActionId = 0,
                ActionTitle = dto.ActionTitle,
                BlueprintTitle = dto.BlueprintTitle,
                SenderDisplayName = dto.SenderDisplayName,
                Summary = dto.Summary,
                Urgency = dto.Urgency,
                Deadline = dto.Deadline,
                NavigationPath = dto.NavigationPath,
                ReceivedAt = dto.Timestamp,
                TransactionId = dto.TransactionId,
                RegisterId = dto.RegisterId
            });
            _totalCount++;
        }

        _realtimeBuffer.Clear();
        _lastRender = DateTime.UtcNow;
        RebuildGroups();
        StateHasChanged();
    }

    private void NavigateToAction(PendingActionSummaryDto action)
    {
        if (!string.IsNullOrEmpty(action.NavigationPath))
        {
            Navigation.NavigateTo(action.NavigationPath);
            IsOpen = false;
            IsOpenChanged.InvokeAsync(false);
        }
    }

    private static string GetUrgencyIcon(string urgency) => urgency switch
    {
        "urgent" => Icons.Material.Filled.PriorityHigh,
        "warning" => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Info
    };

    private static Color GetUrgencyColor(string urgency) => urgency switch
    {
        "urgent" => Color.Error,
        "warning" => Color.Warning,
        _ => Color.Info
    };

    private static Color GetDeadlineColor(DateTimeOffset deadline)
    {
        var remaining = deadline - DateTimeOffset.UtcNow;
        if (remaining.TotalHours < 4) return Color.Error;
        if (remaining.TotalHours < 24) return Color.Warning;
        return Color.Default;
    }

    private static string FormatDeadline(DateTimeOffset deadline)
    {
        var remaining = deadline - DateTimeOffset.UtcNow;
        if (remaining.TotalMinutes < 0) return "Overdue";
        if (remaining.TotalHours < 1) return $"{(int)remaining.TotalMinutes}m left";
        if (remaining.TotalHours < 24) return $"{(int)remaining.TotalHours}h left";
        return $"{(int)remaining.TotalDays}d left";
    }

    public void Dispose()
    {
        EventsHub.OnPendingActionReceived -= HandleRealtimeNotification;
        _batchTimer?.Dispose();
    }
}
