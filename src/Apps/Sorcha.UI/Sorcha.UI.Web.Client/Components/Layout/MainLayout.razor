@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Sorcha.UI.Core.Services.Authentication
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Theme
@using Sorcha.UI.Core.Components.Shared
@using Sorcha.UI.Core.Models.Credentials
@using Sorcha.UI.Core.Models.Registers
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ITokenRefreshService TokenRefreshService
@inject IThemeService ThemeService
@inject IJSRuntime JSRuntime
@inject BlueprintHubConnection BlueprintHub
@inject TenantHubConnection TenantHub
@inject IInboxApiService InboxApi
@inject ILocalizationService Loc

<MudThemeProvider Theme="SorchaMudTheme.Default" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h5" Class="ml-3" Style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("dashboard"))">Sorcha</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <OrgSwitcher />
                @* Feature 118 — durable inbox bell. Single notification surface
                   after retirement of the legacy ActivityLogPanel + PendingActionInbox
                   in PRs #538 / this PR. *@
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" OnClick="@ToggleInboxPanel" Title="Inbox"
                               Class="@(_badgeWiggle ? "inbox-bell-wiggle" : null)">
                    @if (_inboxUnreadCount > 0)
                    {
                        <MudBadge Content="@_inboxUnreadCount" Color="Color.Primary" Overlap="true" />
                    }
                </MudIconButton>
                @* Feature 118 T105 — inline reconnect affordance driven by the
                   inbox connection state. No blocking toast. *@
                @if (_inboxConnectionStatus is ConnectionStatus.Reconnecting or ConnectionStatus.Disconnected)
                {
                    <MudTooltip Text="@_reconnectTooltip" Placement="Placement.Bottom">
                        <MudChip T="string"
                                 Icon="@Icons.Material.Filled.SyncProblem"
                                 Color="Color.Warning"
                                 Size="Size.Small"
                                 Variant="Variant.Text"
                                 Class="ml-2">
                            Reconnecting…
                        </MudChip>
                    </MudTooltip>
                }
                <UserProfileMenu />
            </Authorized>
            <NotAuthorized>
                <MudButton OnClick="@(() => Navigation.NavigateTo("/auth/login", forceLoad: true))" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">
                    @Loc.T("nav.signIn")
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="@DrawerVariant.Mini" OpenMiniOnHover="true" ClipMode="DrawerClipMode.Always" Elevation="2">
        @* Feature 092 / US4 — the "Navigation" header was removed. The
           MudDrawerHeader element stays in place so the drawer keeps its
           expected vertical rhythm and top spacing. *@
        <MudDrawerHeader></MudDrawerHeader>
        <AuthorizeView>
            <Authorized>
                <MudNavMenu>
                    <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                        @Loc.T("nav.dashboard")
                    </MudNavLink>
                    @if (_drawerOpen)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.overline" Class="px-4 mud-text-secondary">@Loc.T("nav.section.myActivity")</MudText>
                    }
                    <MudNavLink Href="new-submissions" Icon="@Icons.Material.Filled.PostAdd">
                        @Loc.T("nav.newSubmission")
                    </MudNavLink>
                    <MudNavLink Href="my-actions" Icon="@Icons.Material.Filled.Task">
                        @Loc.T("nav.pendingActions")
                    </MudNavLink>
                    <MudNavLink Href="wallets" Icon="@Icons.Material.Filled.AccountBalanceWallet">
                        @Loc.T("nav.myWallet")
                    </MudNavLink>
                    <MudNavLink Href="credentials" Icon="@Icons.Material.Filled.Badge">
                        @Loc.T("nav.myCredentials")
                        @if (_pendingCredentialCount > 0)
                        {
                            <MudBadge Content="@_pendingCredentialCount" Color="Color.Warning" Overlap="true" />
                        }
                    </MudNavLink>
                    <MudNavLink Href="my-transactions" Icon="@Icons.Material.Filled.Receipt">
                        @Loc.T("nav.myTransactions")
                    </MudNavLink>
                    <MudNavLink Href="operations" Icon="@Icons.Material.Filled.Lock">
                        @Loc.T("nav.encryptionOperations")
                    </MudNavLink>
                    <AuthorizeView Roles="Administrator,SystemAdmin,Designer">
                        <Authorized Context="designerContext">
                            @if (_drawerOpen)
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.overline" Class="px-4 mud-text-secondary">@Loc.T("nav.section.designer")</MudText>
                            }
                            <MudNavLink Href="blueprints" Icon="@Icons.Material.Filled.Description">
                                @Loc.T("nav.myBlueprints")
                            </MudNavLink>
                            <MudNavLink Href="designer/blueprint" Icon="@Icons.Material.Filled.SmartToy">
                                @Loc.T("nav.aiChatDesigner")
                            </MudNavLink>
                            <MudNavLink Href="templates" Icon="@Icons.Material.Filled.ContentCopy">
                                @Loc.T("nav.catalogue")
                            </MudNavLink>
                            <MudNavLink Href="schemas" Icon="@Icons.Material.Filled.Schema">
                                @Loc.T("nav.dataSchemas")
                            </MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Administrator,SystemAdmin,Auditor">
                        <Authorized Context="adminNavContext">
                            @if (_drawerOpen)
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.overline" Class="px-4 mud-text-secondary">@Loc.T("nav.section.administration")</MudText>
                            }
                            <MudNavGroup Title="@Loc.T("nav.wallets")" Icon="@Icons.Material.Filled.AccountBalanceWallet" Expanded="false">
                                <MudNavLink Href="wallet-admin" Icon="@Icons.Material.Filled.List">
                                    @Loc.T("nav.allWallets")
                                </MudNavLink>
                                <MudNavLink Href="wallets/create" Icon="@Icons.Material.Filled.AddCircleOutline">
                                    @Loc.T("nav.createWallet")
                                </MudNavLink>
                                <MudNavLink Href="wallets/recover" Icon="@Icons.Material.Filled.Restore">
                                    @Loc.T("nav.recoverWallet")
                                </MudNavLink>
                            </MudNavGroup>
                            <MudNavLink Href="registers" Icon="@Icons.Material.Filled.Storage">
                                @Loc.T("nav.registers")
                            </MudNavLink>
                            <MudNavLink Href="participants" Icon="@Icons.Material.Filled.People">
                                @Loc.T("nav.participants")
                            </MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Administrator,OrganizationAdmin,SystemAdmin">
                        <Authorized Context="orgAdminContext">
                            <MudNavLink Href="admin/credentials" Icon="@Icons.Material.Filled.VerifiedUser">
                                @Loc.T("nav.issuedCredentials")
                            </MudNavLink>
                            <MudNavLink Href="admin/organizations" Icon="@Icons.Material.Filled.Business"
                                        data-testid="nav-organisations">
                                Organisations
                            </MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Administrator,SystemAdmin">
                        <Authorized Context="adminContext">
                            <MudNavGroup Title="Identity" Icon="@Icons.Material.Filled.Security" Expanded="false">
                                <MudNavLink Href="admin/identity" Icon="@Icons.Material.Filled.Dashboard">
                                    Dashboard
                                </MudNavLink>
                                <MudNavLink Href="admin/identity/users" Icon="@Icons.Material.Filled.People">
                                    Users
                                </MudNavLink>
                                <MudNavLink Href="admin/identity/idp" Icon="@Icons.Material.Filled.Key">
                                    Identity Providers
                                </MudNavLink>
                                <MudNavLink Href="admin/identity/invitations" Icon="@Icons.Material.Filled.Email">
                                    Invitations
                                </MudNavLink>
                                <MudNavLink Href="admin/identity/domains" Icon="@Icons.Material.Filled.Domain">
                                    Domain Restrictions
                                </MudNavLink>
                                <MudNavLink Href="admin/identity/audit" Icon="@Icons.Material.Filled.History">
                                    Audit Log
                                </MudNavLink>
                                <MudNavLink Href="admin/settings/organization" Icon="@Icons.Material.Filled.Settings">
                                    Org Settings
                                </MudNavLink>
                            </MudNavGroup>
                            <MudNavGroup Title="System" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                                <AuthorizeView Roles="SystemAdmin">
                                    <Authorized Context="sysAdminCtx">
                                        <MudNavLink Href="admin/settings/platform" Icon="@Icons.Material.Filled.Tune">
                                            Platform Settings
                                        </MudNavLink>
                                    </Authorized>
                                </AuthorizeView>
                                <MudNavLink Href="admin/health" Icon="@Icons.Material.Filled.HealthAndSafety">
                                    @Loc.T("nav.systemHealth")
                                </MudNavLink>
                                <MudNavLink Href="admin/peers" Icon="@Icons.Material.Filled.Hub">
                                    @Loc.T("nav.peerNetwork")
                                </MudNavLink>
                                <MudNavLink Href="admin/validator" Icon="@Icons.Material.Filled.VerifiedUser">
                                    @Loc.T("nav.validator")
                                </MudNavLink>
                                <MudNavLink Href="admin/principals" Icon="@Icons.Material.Filled.VpnKey">
                                    @Loc.T("nav.servicePrincipals")
                                </MudNavLink>
                                <MudNavLink Href="admin/sectors" Icon="@Icons.Material.Filled.FilterList">
                                    @Loc.T("nav.schemaSectors")
                                </MudNavLink>
                                <MudNavLink Href="admin/schema-providers" Icon="@Icons.Material.Filled.CloudSync">
                                    @Loc.T("nav.schemaProviders")
                                </MudNavLink>
                                <MudNavLink Href="admin/events" Icon="@Icons.Material.Filled.Event">
                                    Events
                                </MudNavLink>
                                <MudNavLink Href="admin/system-register" Icon="@Icons.Material.Filled.Storage">
                                    System Register
                                </MudNavLink>
                                <MudNavLink Href="admin/status-lists" Icon="@Icons.Material.Filled.Checklist">
                                    Status Lists
                                </MudNavLink>
                                <MudNavLink Href="admin/presentations" Icon="@Icons.Material.Filled.QrCode2">
                                    Presentations
                                </MudNavLink>
                            </MudNavGroup>
                        </Authorized>
                    </AuthorizeView>
                    @* Feature 092 / US4 — Settings and Notifications nav
                       links removed. Settings is reachable from the avatar
                       menu; notification preferences are now a tab inside
                       the Settings page. Help remains in the side nav. *@
                    @if (_drawerOpen)
                    {
                        <MudDivider Class="my-2" />
                    }
                    <MudNavLink Href="help" Icon="@Icons.Material.Filled.Help">
                        @Loc.T("nav.help")
                    </MudNavLink>
                </MudNavMenu>
            </Authorized>
            <NotAuthorized>
                <MudNavMenu>
                    <MudNavLink OnClick="@(() => Navigation.NavigateTo("/auth/login", forceLoad: true))" Icon="@Icons.Material.Filled.Login">
                        @Loc.T("nav.signIn")
                    </MudNavLink>
                </MudNavMenu>
            </NotAuthorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4" Style="padding-bottom: 40px;">
            @* Feature 128 US2 (FR-024) — nag-banner for signed-in citizens
               with zero paired devices. Self-gates on IHasPairedDeviceProbe;
               dismissable per-session. *@
            <AuthorizeView>
                <Authorized>
                    <Sorcha.UI.Core.Components.Pairing.PairingNagBanner />
                </Authorized>
            </AuthorizeView>
            @* Phase 1 of the Snackbar retirement — inline feedback host
               renders at the top of the content region. Stays empty (and
               occupies no vertical space) until a page surfaces a message
               via IInlineFeedback. *@
            <Sorcha.UI.Core.Components.Feedback.InlineFeedbackHost />
            @Body
        </MudContainer>
    </MudMainContent>
    <StatusFooter />
    <OperationNotificationListener />
    <CryptoProgressPopover />

    @* Feature 118 — durable inbox UI. *@
    <InboxPanel @bind-IsOpen="_inboxPanelOpen" />
</MudLayout>

</CascadingAuthenticationState>

@code {
    private bool _drawerOpen = true;
    private bool _tokenRefreshStarted;
    private bool _inboxPanelOpen;
    private int _inboxUnreadCount;
    private ConnectionStatus _inboxConnectionStatus = ConnectionStatus.Connecting;
    private string _reconnectTooltip = "Reconnecting to the notification service…";

    private void OnTenantHubConnectionChanged(ConnectionState state)
    {
        InvokeAsync(() =>
        {
            _inboxConnectionStatus = state.Status;
            _reconnectTooltip = state.Status switch
            {
                ConnectionStatus.Reconnecting => $"Reconnecting to the notification service (attempt {state.ReconnectAttempts})…",
                ConnectionStatus.Disconnected => "Notification service disconnected — retrying…",
                _ => "Connected"
            };
            StateHasChanged();
        });
    }
    private int _pendingCredentialCount;
    private bool _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_tokenRefreshStarted)
        {
            _tokenRefreshStarted = true;
            await TokenRefreshService.StartAsync(JSRuntime);

            // Only fetch authenticated data if user is logged in — avoids 401 console noise
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await RefreshUnreadCount();
            }

            ThemeService.OnThemeChanged += OnThemeChanged;
            await ThemeService.InitializeAsync();
            _isDarkMode = ThemeService.IsDarkMode;

            Loc.OnLanguageChanged += OnLanguageChanged;
            await Loc.InitializeAsync();

            BlueprintHub.OnCredentialReceived += OnCredentialReceived;
            BlueprintHub.OnPendingCredentialCountUpdated += OnPendingCredentialCountUpdated;

            // Feature 118 — TenantHub is the authoritative source of the unread
            // bell badge after retirement of the legacy ActivityLogPanel.
            TenantHub.OnInboxUnreadCountUpdated += OnInboxUnreadCountUpdated;
            // T105 — drive the inline "Reconnecting…" affordance off the inbox
            // connection state.
            TenantHub.OnConnectionStateChanged += OnTenantHubConnectionChanged;
            try
            {
                await TenantHub.StartAsync();
            }
            catch (Exception)
            {
                // Hub may be unavailable — auto-reconnect handles transient outages.
            }

            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        Loc.OnLanguageChanged -= OnLanguageChanged;
        BlueprintHub.OnCredentialReceived -= OnCredentialReceived;
        BlueprintHub.OnPendingCredentialCountUpdated -= OnPendingCredentialCountUpdated;
        TenantHub.OnInboxUnreadCountUpdated -= OnInboxUnreadCountUpdated;
        TenantHub.OnConnectionStateChanged -= OnTenantHubConnectionChanged;
        await TenantHub.DisposeAsync();
        await TokenRefreshService.StopAsync();
    }

    private void OnThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Feature 118 — TenantHub inbox unread-count handler. Authoritative source
    /// for the bell badge after retirement of the legacy ActivityLogPanel.
    /// </summary>
    /// <remarks>
    /// Phase 6 of the Snackbar retirement deletes PendingActionToast — the
    /// CSS wiggle on the badge below replaces the popup as the "look, new
    /// thing landed" cue.
    /// </remarks>
    private Task OnInboxUnreadCountUpdated(int unreadCount, DateTimeOffset occurredAt, string traceId)
    {
        if (unreadCount > _inboxUnreadCount)
        {
            _ = WiggleBadgeAsync();
        }
        _inboxUnreadCount = unreadCount;
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private bool _badgeWiggle;

    private async Task WiggleBadgeAsync()
    {
        _badgeWiggle = true;
        await InvokeAsync(StateHasChanged);
        // Wiggle keyframe runs for ~700ms; clear the class shortly after so
        // the next inbox event can re-trigger it.
        await Task.Delay(800);
        _badgeWiggle = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleInboxPanel()
    {
        _inboxPanelOpen = !_inboxPanelOpen;
    }

    private void OnCredentialReceived(CredentialNotification notification)
    {
        // Feature 118 T088 + Snackbar retirement Phase 4 — the hub signal
        // carries opaque IDs only. WalletInboxWriter.WriteCredentialReceivedAsync
        // produces the durable bell-drawer entry on the server side
        // (Phase 2b); there's nothing for this layout handler to surface
        // beyond keeping its own render fresh for the badge tick.
        InvokeAsync(StateHasChanged);
    }

    private void OnPendingCredentialCountUpdated(int count)
    {
        InvokeAsync(() =>
        {
            _pendingCredentialCount = count;
            StateHasChanged();
        });
    }

    private async Task RefreshUnreadCount()
    {
        try
        {
            // Feature 118 — inbox-only unread count after retirement of the
            // legacy ActivityLogPanel. The TenantHub event keeps it live.
            _inboxUnreadCount = await InboxApi.GetUnreadCountAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            // Resilience: unread count is a non-critical UI element -- don't fail the layout
        }
    }
}
