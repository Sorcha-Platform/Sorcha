@* legacy redirect shim — superseded by /designer/blueprint (Feature 109) *@

@page "/designer/chat"
@page "/designer/chat/{ExistingBlueprintId}"
@inject NavigationManager Navigation

@code {
    [Parameter] public string? ExistingBlueprintId { get; set; }

    protected override void OnInitialized()
    {
        var suffix = string.IsNullOrEmpty(ExistingBlueprintId) ? string.Empty : "/" + ExistingBlueprintId;
        Navigation.NavigateTo($"designer/blueprint{suffix}?stage=describe", replace: true, forceLoad: false);
    }
}
