@page "/new-submissions"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Sorcha.UI.Core.Components.Shared
@using Sorcha.UI.Core.Models.Registers
@using Sorcha.UI.Core.Models.Wallet
@using Sorcha.UI.Core.Models.Workflows
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Wallet
@inject IBlueprintApiService BlueprintApiService
@inject IWalletApiService WalletService
@inject IRegisterService RegisterService
@inject IRegisterSubscriptionService SubscriptionService
@inject IWalletPreferenceService WalletPreferenceService
@inject NavigationStateService NavState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>New Submissions - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="0" Class="mb-4">
        <MudText Typo="Typo.h4">
            <MudIcon Icon="@Icons.Material.Filled.PostAdd" Class="mr-2" />
            New Submissions
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Browse available workflows and start a new submission
        </MudText>
    </MudStack>

    @* Controls bar *@
    @if (!_loading && _wallets.Count > 0 && _allBlueprints.Count > 0)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2" AlignItems="Center">
                <MudItem xs="12" sm="6" md="5">
                    <MudTextField T="string"
                                  Value="@_searchQuery"
                                  ValueChanged="HandleSearchChanged"
                                  Placeholder="Search blueprints..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <MudSelect T="string"
                               Value="@_sortBy"
                               ValueChanged="HandleSortChanged"
                               Label="Sort by"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem Value="@("name")">Name</MudSelectItem>
                        <MudSelectItem Value="@("register")">Register</MudSelectItem>
                        <MudSelectItem Value="@("version")">Version</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3" md="4" Class="d-flex justify-end">
                    <MudToggleIconButton Toggled="@(_viewMode == "table")"
                                         ToggledChanged="ToggleViewMode"
                                         Icon="@Icons.Material.Filled.ViewModule"
                                         ToggledIcon="@Icons.Material.Filled.ViewList"
                                         Color="Color.Primary"
                                         Title="@(_viewMode == "cards" ? "Switch to table view" : "Switch to card view")" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        <MudGrid>
            @for (var i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Class="mb-2" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (_wallets.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.AccountBalanceWallet"
                    Title="No Wallets Found"
                    Description="You need at least one wallet to browse and start submissions." />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("wallets"))">
            Go to My Wallet
        </MudButton>
        @* (wallets nav already uses relative form, no fix needed) *@
    }
    else if (_allBlueprints.Count == 0 && !_hasLoadErrors)
    {
        <EmptyState Icon="@Icons.Material.Filled.Inbox"
                    Title="No blueprints available"
                    Description="Subscribe to a register to see available workflows." />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Storage"
                   OnClick="@(() => Navigation.NavigateTo("registers"))">
            Manage Subscriptions
        </MudButton>
    }
    else if (_viewMode == "table")
    {
        <MudTable Items="FilterAndSort()" Hover="true" Dense="true" Elevation="2">
            <HeaderContent>
                <MudTh>Blueprint</MudTh>
                <MudTh>Register</MudTh>
                <MudTh>Version</MudTh>
                <MudTh>Starting Action</MudTh>
                <MudTh Style="width:120px">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Blueprint">
                    <MudText Typo="Typo.body1">@context.Blueprint.Title</MudText>
                    @if (!string.IsNullOrEmpty(context.Blueprint.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Blueprint.Description</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Register">@context.RegisterName</MudTd>
                <MudTd DataLabel="Version">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">v@(context.Blueprint.Version)</MudChip>
                </MudTd>
                <MudTd DataLabel="Starting Action">@context.Blueprint.StartingActionTitle</MudTd>
                <MudTd>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="@(() => HandleStart(context.Blueprint))">
                        Start
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        @* Card view grouped by register *@
        @foreach (var group in GetFilteredGroups())
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@group.Register.Name</MudText>
                        @if (!string.IsNullOrEmpty(group.Register.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@group.Register.Description</MudText>
                        }
                    </MudStack>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @group.Blueprints.Count workflow(s)
                    </MudChip>
                </MudStack>

                <MudGrid>
                    @foreach (var bp in group.Blueprints)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="1" Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.subtitle1">@bp.Title</MudText>
                                    @if (!string.IsNullOrEmpty(bp.Description))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1"
                                                 Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @bp.Description
                                        </MudText>
                                    }
                                    <MudStack Row="true" Spacing="2" Class="mt-2">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">v@(bp.Version)</MudChip>
                                        @if (!string.IsNullOrEmpty(bp.StartingActionTitle))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Text">
                                                @bp.StartingActionTitle
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                               OnClick="@(() => HandleStart(bp))">
                                        Start
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }

        @if (_failedRegisters.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                Some registers could not be loaded: @string.Join(", ", _failedRegisters)
            </MudAlert>
        }
    }
</MudContainer>

@code {
    private const string ViewModeStorageKey = "sorcha:newSubmissions:viewMode";

    private List<WalletDto> _wallets = [];
    private List<RegisterBlueprintGroup> _registerGroups = [];
    private List<BlueprintRowViewModel> _allBlueprints = [];
    private List<string> _failedRegisters = [];
    private bool _loading = true;
    private bool _hasLoadErrors;
    private string _viewMode = "cards";
    private string _searchQuery = string.Empty;
    private string _sortBy = "name";
    private string _defaultWallet = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ViewModeStorageKey);
                if (!string.IsNullOrEmpty(stored) && (stored == "cards" || stored == "table"))
                {
                    _viewMode = stored;
                    StateHasChanged();
                }
            }
            catch { /* localStorage not available */ }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _registerGroups = [];
        _allBlueprints = [];
        _failedRegisters = [];
        _hasLoadErrors = false;
        StateHasChanged();

        try
        {
            _wallets = await WalletService.GetWalletsAsync();
            if (_wallets.Count == 0)
            {
                _loading = false;
                return;
            }

            _defaultWallet = await WalletPreferenceService.GetSmartDefaultAsync(_wallets) ?? _wallets[0].Address;

            var subscriptions = await SubscriptionService.GetMySubscribedRegistersAsync();
            var subscribedRegisterIds = subscriptions
                .Select(s => s.RegisterId)
                .Where(id => !string.IsNullOrEmpty(id))
                .ToHashSet();

            var allRegisters = await RegisterService.GetRegistersAsync();
            var onlineRegisters = allRegisters
                .Where(r => r.IsOnline && subscribedRegisterIds.Contains(r.Id))
                .ToList();

            foreach (var register in onlineRegisters)
            {
                try
                {
                    var available = await BlueprintApiService.GetAvailableBlueprintsAsync(_defaultWallet, register.Id);
                    if (available?.Blueprints is { Count: > 0 })
                    {
                        var startables = available.Blueprints
                            .Where(bp => bp.AvailableActions.Any(a => a.IsAvailable))
                            .Select(bp =>
                            {
                                var startingAction = bp.AvailableActions.FirstOrDefault(a => a.IsAvailable);
                                return new StartableBlueprintViewModel
                                {
                                    BlueprintId = bp.BlueprintId,
                                    Title = bp.Title,
                                    Description = bp.Description,
                                    Version = bp.Version,
                                    RegisterId = register.Id,
                                    StartingActionTitle = startingAction?.Title ?? "Start",
                                    StartingActionDescription = startingAction?.Description
                                };
                            })
                            .ToList();

                        if (startables.Count > 0)
                        {
                            _registerGroups.Add(new RegisterBlueprintGroup
                            {
                                Register = register,
                                Blueprints = startables
                            });

                            _allBlueprints.AddRange(startables.Select(s => new BlueprintRowViewModel(s, register.Name)));
                        }
                    }
                }
                catch
                {
                    _failedRegisters.Add(register.Name);
                    _hasLoadErrors = true;
                }
            }
        }
        catch
        {
            _hasLoadErrors = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleSearchChanged(string value)
    {
        _searchQuery = value ?? string.Empty;
    }

    private void HandleSortChanged(string value)
    {
        _sortBy = value ?? "name";
    }

    private async Task ToggleViewMode(bool isTable)
    {
        _viewMode = isTable ? "table" : "cards";
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ViewModeStorageKey, _viewMode);
        }
        catch { /* localStorage not available */ }
    }

    private IEnumerable<BlueprintRowViewModel> FilterAndSort()
    {
        IEnumerable<BlueprintRowViewModel> rows = _allBlueprints;

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim();
            rows = rows.Where(r =>
                r.Blueprint.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (r.Blueprint.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                r.RegisterName.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        rows = _sortBy switch
        {
            "register" => rows.OrderBy(r => r.RegisterName).ThenBy(r => r.Blueprint.Title),
            "version" => rows.OrderByDescending(r => r.Blueprint.Version).ThenBy(r => r.Blueprint.Title),
            _ => rows.OrderBy(r => r.Blueprint.Title)
        };

        return rows;
    }

    private IEnumerable<RegisterBlueprintGroup> GetFilteredGroups()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return _registerGroups;

        var q = _searchQuery.Trim();
        return _registerGroups
            .Select(g => new RegisterBlueprintGroup
            {
                Register = g.Register,
                Blueprints = g.Blueprints
                    .Where(bp =>
                        bp.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (bp.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        g.Register.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
                    .ToList()
            })
            .Where(g => g.Blueprints.Count > 0);
    }

    private void HandleStart(StartableBlueprintViewModel blueprint)
    {
        // Stash the selected blueprint in navigation state so the workspace page
        // can skip an API roundtrip on hot navigation. On direct navigation
        // (bookmark/refresh), the state will be empty and the workspace falls
        // back to fetching from the published endpoint.
        var key = $"blueprint:{blueprint.RegisterId}:{blueprint.BlueprintId}";
        NavState.Set(key, blueprint);
        // Relative path so it resolves against the Blazor app base href (/app/)
        // rather than the server root.
        Navigation.NavigateTo($"new-submission/{blueprint.RegisterId}/{blueprint.BlueprintId}");
    }

    private sealed record BlueprintRowViewModel(StartableBlueprintViewModel Blueprint, string RegisterName);
}
