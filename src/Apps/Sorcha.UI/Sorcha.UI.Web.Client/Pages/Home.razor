@page "/"
@page "/dashboard"
@layout MainLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Sorcha.UI.Core.Models.Admin
@using Sorcha.UI.Core.Models.Dashboard
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Web.Client.Components.Layout
@inject AuthenticationStateProvider AuthStateProvider
@inject IDashboardService DashboardService
@inject IAlertService AlertService
@inject IAlertDismissalService AlertDismissal
@inject IWalletPreferenceService WalletPreferences
@inject IWalletApiService WalletApi
@inject ILocalizationService Loc
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@Loc.T("dashboard.pageTitle")</PageTitle>

@if (!_hasDefaultWallet && !_isLoading)
{
    <MudText Typo="Typo.h4" Class="mb-4">@Loc.T("dashboard.welcome")</MudText>
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.AccountBalanceWallet">
        <MudText Typo="Typo.body1">
            @Loc.T("dashboard.wizard.walletRequired")
        </MudText>
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="wallets/create?wizard=true"
               StartIcon="@Icons.Material.Filled.Add" Size="Size.Large">
        @Loc.T("wallet.create")
    </MudButton>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">@Loc.T("dashboard.welcomeBack", _displayName)</MudText>

    @* Feature 131 / UX-005 — stats cards visible to admins/auditors. Two
       shapes discriminated by @_stats.Scope: "org" renders the 4 org-scoped
       cards, "platform" renders the 6 platform-wide cards. The Org/Platform
       toggle is only visible to SystemAdmin. *@
    <AuthorizeView Roles="Administrator,SystemAdmin,Auditor">
        <Authorized Context="statsContext">
    <AuthorizeView Roles="SystemAdmin" Context="scopeToggleContext">
        <Authorized>
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
                <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                data-testid="dashboard-scope-toggle">
                    <MudButton OnClick="@(() => SetScopeAsync("org"))"
                               Color="@(_scope == "org" ? Color.Primary : Color.Default)"
                               Variant="@(_scope == "org" ? Variant.Filled : Variant.Outlined)"
                               data-testid="dashboard-scope-org">@Loc.T("dashboard.scope.org")</MudButton>
                    <MudButton OnClick="@(() => SetScopeAsync("platform"))"
                               Color="@(_scope == "platform" ? Color.Primary : Color.Default)"
                               Variant="@(_scope == "platform" ? Variant.Filled : Variant.Outlined)"
                               data-testid="dashboard-scope-platform">@Loc.T("dashboard.scope.platform")</MudButton>
                </MudButtonGroup>
            </MudStack>
        </Authorized>
    </AuthorizeView>

    @if (_stats.Scope == "org")
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" data-testid="dashboard-card-active-users">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else { <MudText Typo="Typo.h5">@(_stats.ActiveUsers ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.activeUsers")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" data-testid="dashboard-card-pending-invitations">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else { <MudText Typo="Typo.h5">@(_stats.PendingInvitations ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.pendingInvitations")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" data-testid="dashboard-card-subscribed-registers">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Warning" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else { <MudText Typo="Typo.h5">@(_stats.SubscribedRegisters ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.subscribedRegisters")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" data-testid="dashboard-card-recent-transactions">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else { <MudText Typo="Typo.h5">@(_stats.OrgRecentTransactions ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.recentTransactions")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        @* Platform-scope view — SystemAdmin only via the toggle above. *@
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" data-testid="dashboard-card-blueprints">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else if (!_stats.IsLoaded) { <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.T("dashboard.stats.unavailable")</MudText> }
                        else { <MudText Typo="Typo.h5">@(_stats.ActiveBlueprints ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.blueprints")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" data-testid="dashboard-card-wallets">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else if (!_stats.IsLoaded) { <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.T("dashboard.stats.unavailable")</MudText> }
                        else { <MudText Typo="Typo.h5">@(_stats.TotalWallets ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.wallets")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" data-testid="dashboard-card-platform-transactions">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else if (!_stats.IsLoaded) { <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.T("dashboard.stats.unavailable")</MudText> }
                        else { <MudText Typo="Typo.h5">@(_stats.PlatformRecentTransactions ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.transactions")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" data-testid="dashboard-card-peers">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else if (!_stats.IsLoaded) { <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.T("dashboard.stats.unavailable")</MudText> }
                        else { <MudText Typo="Typo.h5">@(_stats.ConnectedPeers ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.peers")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" data-testid="dashboard-card-platform-registers">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Warning" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else if (!_stats.IsLoaded) { <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.T("dashboard.stats.unavailable")</MudText> }
                        else { <MudText Typo="Typo.h5">@(_stats.PlatformActiveRegisters ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.registers")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" data-testid="dashboard-card-organizations">
                    <MudCardContent Class="d-flex flex-column align-center pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Dark" Size="Size.Large" Class="mb-2" />
                        @if (_isLoading) { <MudSkeleton Width="40px" Height="32px" /> }
                        else if (!_stats.IsLoaded) { <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.T("dashboard.stats.unavailable")</MudText> }
                        else { <MudText Typo="Typo.h5">@(_stats.TotalOrganizations ?? 0)</MudText> }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.stats.organizations")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
        </Authorized>
    </AuthorizeView>

    @* Alerts Panel — operational alerts (peer health, validator quorum,
       service degradation) are surfaced only to users who can act on
       them. Citizens have no agency over infrastructure health, so
       showing them a "Peer network health is 0.0%" warning on the
       welcome page is misleading and adds anxiety for nothing. We
       drive visibility from _canSeeAdminDashboard instead of wrapping
       in an AuthorizeView so the role check lives in one place
       (OnInitializedAsync). *@
    @if (_canSeeAdminDashboard)
    {
        <AlertsPanel Alerts="@_visibleAlerts" OnRefresh="RefreshAlertsAsync" />
    }

    @if (_isRefreshing)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
    }

    @* Quick Actions *@
    <MudText Typo="Typo.h6" Class="mb-2">@Loc.T("dashboard.quickActions")</MudText>
    <MudStack Row="true" Spacing="2" Class="mb-6">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="new-submissions"
                   StartIcon="@Icons.Material.Filled.PostAdd">
            @Loc.T("nav.newSubmission")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="wallets"
                   StartIcon="@Icons.Material.Filled.AccountBalanceWallet">
            @Loc.T("dashboard.manageWallets")
        </MudButton>
        <AuthorizeView Roles="Administrator,SystemAdmin,Designer">
            <Authorized Context="quickActionsContext">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="designer"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Loc.T("blueprint.create")
                </MudButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Administrator,SystemAdmin,Auditor">
            <Authorized Context="registersQuickContext">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="registers"
                           StartIcon="@Icons.Material.Filled.Storage">
                    @Loc.T("dashboard.viewRegisters")
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>

    @* Error State Display — only for admin viewers who actually request
       the stats. Citizens never load the stats endpoint, so "stats not
       loaded" for them is not an error, just a not-applicable state. *@
    @if (_canSeeAdminDashboard && !_stats.IsLoaded && !_isLoading)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @Loc.T("dashboard.statsError") <a href="wallets" class="mud-alert-link">@Loc.T("dashboard.viewWallets")</a>
        </MudAlert>
    }

    @* Recent Activity *@
    <MudText Typo="Typo.h6" Class="mb-2">@Loc.T("dashboard.recentActivity")</MudText>
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc.T("dashboard.noRecentActivity")</MudText>
    </MudPaper>
}

@code {
    private const int RefreshIntervalMs = 30_000;
    private DashboardStatsViewModel _stats = new();
    private IReadOnlyList<ServiceAlert> _visibleAlerts = [];
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _hasDefaultWallet;
    private bool _canSeeAdminDashboard;
    private bool _isSystemAdmin;
    private string _displayName = string.Empty;
    private string _platformUserId = string.Empty;
    private string _scope = "org"; // Feature 131 / UX-005 — default for everyone
    private System.Timers.Timer? _refreshTimer;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += OnLanguageChanged;

        // Get display name from auth state (already verified by [Authorize] + AuthorizeRouteView)
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _displayName = GetDisplayName(authState.User);
        // Operational alerts + admin-scoped dashboard stats are only
        // fetched for users in admin roles — citizens don't see the
        // AlertsPanel or the admin stat grid, so polling those endpoints
        // for them just produces 401 noise in the console.
        _canSeeAdminDashboard = authState.User.IsInRole("Administrator")
                                || authState.User.IsInRole("SystemAdmin")
                                || authState.User.IsInRole("OrganizationAdmin");
        _isSystemAdmin = authState.User.IsInRole("SystemAdmin");
        _platformUserId = authState.User.FindFirst("platform_user_id")?.Value ?? string.Empty;

        // Feature 131 — restore SystemAdmin's persisted scope choice. Other
        // roles always stay on "org" (the only view they can read).
        if (_isSystemAdmin)
        {
            await RestoreScopeFromLocalStorageAsync();
        }

        var wallets = await WalletApi.GetWalletsAsync();
        var defaultWallet = await WalletPreferences.GetSmartDefaultAsync(wallets);
        _hasDefaultWallet = defaultWallet is not null;

        if (_canSeeAdminDashboard)
        {
            _stats = await DashboardService.GetDashboardStatsAsync(_scope);
            await LoadAlertsAsync();
        }
        _isLoading = false;

        StartAutoRefresh();
    }

    private async Task RestoreScopeFromLocalStorageAsync()
    {
        if (string.IsNullOrEmpty(_platformUserId)) return;
        try
        {
            var key = $"dashboard-scope-{_platformUserId}";
            var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", key);
            if (string.Equals(stored, "platform", StringComparison.OrdinalIgnoreCase))
            {
                _scope = "platform";
            }
        }
        catch
        {
            // Non-critical UI element — silent on storage failure.
        }
    }

    private async Task SetScopeAsync(string scope)
    {
        if (_scope == scope) return;
        _scope = scope;
        if (_isSystemAdmin && !string.IsNullOrEmpty(_platformUserId))
        {
            try
            {
                var key = $"dashboard-scope-{_platformUserId}";
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", key, scope);
            }
            catch
            {
                // ignored
            }
        }
        await RefreshDashboardAsync();
    }

    private void StartAutoRefresh()
    {
        _refreshTimer = new System.Timers.Timer(RefreshIntervalMs);
        _refreshTimer.Elapsed += async (_, _) => await InvokeAsync(RefreshDashboardAsync);
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    private async Task RefreshDashboardAsync()
    {
        if (_disposed) return;
        if (!_canSeeAdminDashboard) return;

        _isRefreshing = true;
        StateHasChanged();

        _stats = await DashboardService.GetDashboardStatsAsync(_scope);
        await LoadAlertsAsync();

        _isRefreshing = false;
        StateHasChanged();
    }

    private async Task LoadAlertsAsync()
    {
        var response = await AlertService.GetAlertsAsync();
        _visibleAlerts = await AlertDismissal.FilterDismissedAsync(response.Alerts);
    }

    private async Task RefreshAlertsAsync()
    {
        await LoadAlertsAsync();
        StateHasChanged();
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        Loc.OnLanguageChanged -= OnLanguageChanged;
    }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        return user.FindFirst("name")?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst("email")?.Value
            ?? string.Empty;
    }
}
