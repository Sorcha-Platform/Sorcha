@namespace Sorcha.UI.Web.Client.Pages.DesignerShell
@page "/designer/blueprint"
@page "/designer/blueprint/{BlueprintId}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "Administrator,SystemAdmin,Designer")]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Sorcha.UI.Core.Components.Designer
@using Sorcha.UI.Core.Services.Designer
@using Sorcha.UI.Web.Client.Pages.DesignerShell.Panes
@using Sorcha.UI.Web.Client.Pages.DesignerShell.Stages
@inject NavigationManager Navigation
@inject DesignerContext Context
@implements IDisposable

@*
    Feature 142 designer shell: a rail-driven staged workspace. The toolbar and the always-visible
    lifecycle rail sit at the top; below them a two-pane body keeps the AI chat persistent on the
    left (it is the on-ramp across every stage and its E2E test hooks register on first render) and
    swaps the right-hand stage canvas on Context.Lifecycle.CurrentStage. The active stage is mirrored
    to the ?stage= query string for deep-linking; the legacy ?tab= values are accepted as an alias.
*@

<div class="designer-shell">
    <DesignerToolbar />
    <LifecycleRail />

    <div class="designer-shell__body">
        <div class="designer-shell__ai" data-testid="designer-ai-rail">
            <AiDesignerPane />
        </div>
        <div class="designer-shell__canvas" data-testid="designer-stage-canvas">
            @switch (Context.Lifecycle.CurrentStage)
            {
                case LifecycleStage.Describe:
                    <DescribeStage />
                    break;
                case LifecycleStage.Understand:
                    <UnderstandStage />
                    break;
                case LifecycleStage.Rehearse:
                    <RehearseStage />
                    break;
                case LifecycleStage.GoLive:
                    <GoLiveStage />
                    break;
            }
        </div>
    </div>

    <RailGuidedOverlay />
</div>
