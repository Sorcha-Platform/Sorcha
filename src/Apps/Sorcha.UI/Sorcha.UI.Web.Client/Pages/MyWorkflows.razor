@* Legacy route — redirects to /new-submissions. Feature 091 replaced this page
   with the searchable blueprint catalogue. This stub preserves deep links from
   bookmarks and external references. TODO: remove in a future cleanup PR once
   analytics show no traffic on /my-workflows. *@

@page "/my-workflows"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

<PageTitle>Redirecting... - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body1">Redirecting to New Submissions...</MudText>
    </MudStack>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("new-submissions", replace: true);
    }
}
