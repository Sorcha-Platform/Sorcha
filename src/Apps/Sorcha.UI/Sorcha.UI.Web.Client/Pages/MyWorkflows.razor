@* Legacy route — redirects to /my-applications (Feature 186 / #1163).

   It used to land on /new-submissions, so the route a citizen would guess for "what did I
   submit" took them to "start a new one" instead. Now that a My Applications view exists,
   this stub sends the bookmark where its name always implied. *@

@page "/my-workflows"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

<PageTitle>Redirecting... - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body1">Redirecting to My Applications…</MudText>
    </MudStack>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("my-applications", replace: true);
    }
}
