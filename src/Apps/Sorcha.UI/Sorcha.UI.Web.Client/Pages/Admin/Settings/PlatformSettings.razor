@page "/admin/settings/platform"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "SystemAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Feedback

@inject IPlatformSettingsAdminService PlatformService
@inject IInlineFeedback Feedback

<PageTitle>Platform Settings - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />
    <MudText Typo="Typo.h4" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" />
        Platform Settings
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Configure platform-wide settings (SystemAdmin only)
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }
    else
    {
        <!-- Public Organisation -->
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Public Organisation</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                When enabled, users can self-register via social login or email/password.
                When disabled, the public organisation is suspended.
            </MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSwitch @bind-Value="_publicOrgEnabled" Label="Public Organisation Enabled"
                               Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudChip T="string"
                             Color="@(_publicOrgStatus == "Active" ? Color.Success : Color.Warning)"
                             Size="Size.Small">
                        @_publicOrgStatus
                    </MudChip>
                </MudItem>
                <MudItem xs="12" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SavePublicOrgAsync" Disabled="_savingPublicOrg">
                        @if (_savingPublicOrg) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Save Public Organisation
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Organisation Creation Limits -->
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Organisation Creation Limits</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Maximum number of private organisations a single user can create.
            </MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_maxOrgsPerUser" Label="Max Organisations Per User"
                                     Min="1" Max="100" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SaveMaxOrgsAsync" Disabled="_savingMaxOrgs">
                        @if (_savingMaxOrgs) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Save Limit
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Platform Info -->
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Platform Info</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_publicOrgId.ToString()" Label="Public Organisation ID"
                                  ReadOnly="true" Variant="Variant.Filled" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_updatedAt" Label="Last Updated"
                                  ReadOnly="true" Variant="Variant.Filled" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Admin", href: "/app/admin/health"),
        new("Settings", href: null, disabled: true),
        new("Platform", href: null, disabled: true)
    ];

    private bool _loading = true;
    private bool _savingPublicOrg;
    private bool _savingMaxOrgs;
    private string? _error;

    // Public org
    private bool _publicOrgEnabled;
    private string _publicOrgStatus = "";
    private Guid _publicOrgId;

    // Org limits
    private int _maxOrgsPerUser = 3;

    // Info
    private string _updatedAt = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await PlatformService.GetSettingsAsync();
            if (settings != null)
            {
                _publicOrgEnabled = settings.PublicOrgEnabled;
                _publicOrgStatus = settings.PublicOrgStatus;
                _publicOrgId = settings.PublicOrgId;
                _maxOrgsPerUser = settings.MaxOrgsPerUser;
                _updatedAt = settings.UpdatedAt.LocalDateTime.ToString("g");
            }
            else
            {
                _error = "Failed to load platform settings.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load settings: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SavePublicOrgAsync()
    {
        _savingPublicOrg = true;
        try
        {
            var result = await PlatformService.UpdatePublicOrgAsync(_publicOrgEnabled);
            if (result != null)
            {
                _publicOrgStatus = result.PublicOrgStatus;
                _updatedAt = result.UpdatedAt.LocalDateTime.ToString("g");
                Feedback.ShowSuccess("Public organisation setting updated");
            }
            else
            {
                Feedback.ShowError("Failed to update public organisation setting", autoDismissMs: 0);
            }
        }
        catch (Exception ex)
        {
            Feedback.ShowError($"Error: {ex.Message}", autoDismissMs: 0);
        }
        finally
        {
            _savingPublicOrg = false;
        }
    }

    private async Task SaveMaxOrgsAsync()
    {
        if (_maxOrgsPerUser < 1 || _maxOrgsPerUser > 100)
        {
            Feedback.ShowWarning("Max organisations must be between 1 and 100");
            return;
        }

        _savingMaxOrgs = true;
        try
        {
            var result = await PlatformService.UpdateMaxOrgsPerUserAsync(_maxOrgsPerUser);
            if (result != null)
            {
                _updatedAt = result.UpdatedAt.LocalDateTime.ToString("g");
                Feedback.ShowSuccess("Organisation limit updated");
            }
            else
            {
                Feedback.ShowError("Failed to update organisation limit", autoDismissMs: 0);
            }
        }
        catch (Exception ex)
        {
            Feedback.ShowError($"Error: {ex.Message}", autoDismissMs: 0);
        }
        finally
        {
            _savingMaxOrgs = false;
        }
    }
}
