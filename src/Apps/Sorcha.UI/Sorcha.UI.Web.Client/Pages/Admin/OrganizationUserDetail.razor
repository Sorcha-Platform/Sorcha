@page "/admin/organizations/{OrgId:guid}/users/{UserId:guid}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "Administrator,SystemAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Feedback

@inject IOrganizationAdminService OrganizationService
@inject NavigationManager Navigation
@inject IInlineFeedback Feedback

<PageTitle>User Detail - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-2">Loading user...</MudText>
    }
    else if (_error != null)
    {
        <MudAlert Severity="Severity.Error" data-testid="user-detail-error">@_error</MudAlert>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="admin/organizations" Class="mt-2">
            Back to Organisations
        </MudButton>
    }
    else if (_user != null)
    {
        <MudStack Spacing="4">
            @* User header *@
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudAvatar Color="Color.Primary" Size="Size.Large">
                    @(_user.DisplayName.Length > 0 ? _user.DisplayName[0].ToString().ToUpper() : "?")
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5" data-testid="user-detail-name">@_user.DisplayName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="user-detail-email">@_user.Email</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Color="@GetCompositeStatusColor(_user.CompositeStatus)"
                         data-testid="user-detail-status">
                    @_user.CompositeStatus
                </MudChip>
                @if (_user.CompositeStatus == "Unverified")
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.MarkEmailRead"
                               OnClick="VerifyEmailAsync"
                               data-testid="user-detail-verify-btn">
                        Verify Email
                    </MudButton>
                }
            </MudStack>

            @* Edit form *@
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Edit User</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_editDisplayName" Label="Display Name"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_editRole" Label="Role"
                                   Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Administrator")">Administrator</MudSelectItem>
                            <MudSelectItem Value="@("Designer")">Designer</MudSelectItem>
                            <MudSelectItem Value="@("Auditor")">Auditor</MudSelectItem>
                            <MudSelectItem Value="@("Consumer")">Member</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="SaveChangesAsync"
                                       data-testid="user-detail-save-btn">
                                Save Changes
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Href="@($"admin/organizations/{OrgId}")">
                                Cancel
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* User info *@
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Details</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td><strong>Provisioned Via</strong></td><td>@_user.ProvisionedVia</td></tr>
                        <tr><td><strong>Email Verified</strong></td><td>@(_user.EmailVerified ? $"Yes ({_user.EmailVerifiedAt:g})" : "No")</td></tr>
                        <tr><td><strong>Last Login</strong></td><td>@(_user.LastLoginAt?.ToString("g") ?? "Never")</td></tr>
                        <tr><td><strong>Created</strong></td><td>@_user.CreatedAt.ToString("g")</td></tr>
                        <tr><td><strong>Roles</strong></td><td>@string.Join(", ", _user.Roles)</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudStack>
    }
</MudContainer>

@code {
    [Parameter] public Guid OrgId { get; set; }
    [Parameter] public Guid UserId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private UserDto? _user;
    private OrganizationDto? _org;
    private bool _loading = true;
    private string? _error;
    private string _editDisplayName = string.Empty;
    private string _editRole = "Consumer";

    private List<BreadcrumbItem> _breadcrumbs = [
        new("Admin", href: "/app/admin/health"),
        new("Organisations", href: "/app/admin/organizations")
    ];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            // Validate org access for non-system admins
            if (AuthenticationState != null)
            {
                var authState = await AuthenticationState;
                var isSystemAdmin = authState.User.IsInRole("SystemAdmin");

                if (!isSystemAdmin)
                {
                    var orgIdClaim = authState.User.Claims
                        .FirstOrDefault(c => c.Type == "org_id" || c.Type == "organization_id");
                    if (orgIdClaim != null && Guid.TryParse(orgIdClaim.Value, out var userOrgId) && userOrgId != OrgId)
                    {
                        _error = "You do not have access to this organisation.";
                        return;
                    }
                }
            }

            _org = await OrganizationService.GetOrganizationAsync(OrgId);
            if (_org == null)
            {
                _error = "Organisation not found.";
                return;
            }

            _user = await OrganizationService.GetOrganizationUserAsync(OrgId, UserId);
            if (_user == null)
            {
                _error = "User not found in this organisation.";
                return;
            }

            _editDisplayName = _user.DisplayName;
            _editRole = _user.Roles.FirstOrDefault() ?? "Consumer";

            _breadcrumbs =
            [
                new("Admin", href: "/app/admin/health"),
                new("Organisations", href: "/app/admin/organizations"),
                new(_org.Name, href: $"/app/admin/organizations/{OrgId}"),
                new("Users", href: $"/app/admin/organizations/{OrgId}"),
                new(_user.DisplayName, href: null, disabled: true)
            ];
        }
        catch (Exception ex)
        {
            _error = $"Failed to load: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveChangesAsync()
    {
        if (_user == null) return;

        try
        {
            var updated = await OrganizationService.UpdateOrganizationUserAsync(OrgId, UserId, new UpdateUserDto
            {
                DisplayName = _editDisplayName,
                Roles = [_editRole]
            });

            if (updated != null)
            {
                _user = updated;
                _editDisplayName = updated.DisplayName;
                _editRole = updated.Roles.FirstOrDefault() ?? "Consumer";
                Feedback.ShowSuccess("User updated successfully.");
            }
        }
        catch (Exception ex)
        {
            Feedback.ShowError($"Failed to update user: {ex.Message}", autoDismissMs: 0);
        }
    }

    private async Task VerifyEmailAsync()
    {
        if (_user == null) return;

        try
        {
            var verified = await OrganizationService.VerifyEmailAsync(OrgId, UserId);
            if (verified)
            {
                Feedback.ShowSuccess("Email verified successfully.");
                _user = await OrganizationService.GetOrganizationUserAsync(OrgId, UserId);
            }
            else
            {
                Feedback.ShowInfo("Email is already verified.");
            }
        }
        catch (Exception ex)
        {
            Feedback.ShowError($"Failed to verify email: {ex.Message}", autoDismissMs: 0);
        }
    }

    private static Color GetCompositeStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Unverified" => Color.Warning,
        "Suspended" => Color.Error,
        _ => Color.Default
    };
}
