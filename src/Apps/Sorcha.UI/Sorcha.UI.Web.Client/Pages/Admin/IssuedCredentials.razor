@page "/admin/credentials"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "Administrator,OrganizationAdmin,SystemAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Sorcha.UI.Core.Components.Admin
@using Sorcha.UI.Core.Models.Credentials
@using Sorcha.UI.Core.Services.Credentials

@inject IIssuedCredentialService IssuedCredentialService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Issued Credentials - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />
    <MudText Typo="Typo.h4" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Class="mr-2" />
        Issued Credentials
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        View and manage credentials issued by your organisation
    </MudText>

    @if (_loadError != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Value="_statusFilter" Label="Status" Clearable="true"
                           ValueChanged="@((string v) => { _statusFilter = v; InvokeAsync(LoadCredentialsAsync); })">
                    <MudSelectItem T="string" Value="@CredentialStatus.Active">Active</MudSelectItem>
                    <MudSelectItem T="string" Value="@CredentialStatus.Suspended">Suspended</MudSelectItem>
                    <MudSelectItem T="string" Value="@CredentialStatus.Revoked">Revoked</MudSelectItem>
                    <MudSelectItem T="string" Value="@CredentialStatus.Expired">Expired</MudSelectItem>
                    <MudSelectItem T="string" Value="@CredentialStatus.Consumed">Consumed</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_typeFilter" Label="Credential Type"
                              Placeholder="Filter by type..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="400"
                              OnDebounceIntervalElapsed="@(_ => InvokeAsync(LoadCredentialsAsync))" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@LoadCredentialsAsync">
                    Refresh
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <IssuedCredentialsGrid Credentials="_credentials"
                           IsLoading="_loading"
                           OnStatusAction="HandleStatusActionAsync" />
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Admin", href: "/app/admin/health"),
        new("Credentials", href: null, disabled: true)
    ];

    private List<IssuedCredentialListItem> _credentials = [];
    private bool _loading = true;
    private string? _loadError;
    private string? _statusFilter;
    private string? _typeFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadCredentialsAsync();
    }

    private async Task LoadCredentialsAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            _credentials = await IssuedCredentialService.GetIssuedCredentialsAsync(
                statusFilter: _statusFilter,
                typeFilter: _typeFilter);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load credentials: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleStatusActionAsync((string CredentialId, string Action) args)
    {
        var (credentialId, action) = args;

        var parameters = new DialogParameters
        {
            { nameof(CredentialStatusDialog.CredentialId), credentialId },
            { nameof(CredentialStatusDialog.Action), action }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CredentialStatusDialog>($"{action} Credential", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        var reason = result.Data as string ?? string.Empty;

        CredentialOperationResult operationResult = action switch
        {
            "Suspend" => await IssuedCredentialService.SuspendCredentialAsync(credentialId, reason),
            "Revoke" => await IssuedCredentialService.RevokeCredentialAsync(credentialId, reason),
            "Reinstate" => await IssuedCredentialService.ReinstateCredentialAsync(credentialId),
            "Refresh" => await IssuedCredentialService.RefreshCredentialAsync(credentialId),
            _ => CredentialOperationResult.Fail(CredentialErrorType.ServerError, $"Unknown action: {action}")
        };

        if (operationResult.Success)
        {
            var pastTense = action switch
            {
                "Suspend" => "suspended",
                "Revoke" => "revoked",
                "Reinstate" => "reinstated",
                "Refresh" => "refreshed",
                _ => action.ToLowerInvariant()
            };
            Snackbar.Add($"Credential {pastTense} successfully.", Severity.Success);
            await LoadCredentialsAsync();
        }
        else
        {
            Snackbar.Add(operationResult.ErrorMessage ?? $"Failed to {action.ToLowerInvariant()} credential.", Severity.Error);
        }
    }
}
