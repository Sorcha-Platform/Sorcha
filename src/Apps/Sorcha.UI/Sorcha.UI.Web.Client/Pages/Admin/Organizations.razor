@page "/admin/organizations"
@page "/admin/organizations/{OrgId:guid}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "Administrator,OrganizationAdmin,SystemAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Sorcha.UI.Core.Components.Admin
@using Sorcha.UI.Core.Services

@inject IOrganizationAdminService OrganizationService

<PageTitle>Organisations - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />

    @if (_isSystemAdmin)
    {
        <MudText Typo="Typo.h4" Class="mb-2" data-testid="page-title">
            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
            Organisations
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
            Manage platform organisations, users, and configuration
        </MudText>

        <OrgSelectorPanel SelectedOrg="_selectedOrganization"
                          OnOrganizationSelected="OnOrganizationSelected"
                          IsExpanded="@(_selectedOrganization == null)" />

        @if (_selectedOrganization != null)
        {
            <OrganizationDashboard Organization="_selectedOrganization"
                                   IsSystemAdmin="true"
                                   CurrentUserId="_currentUserId"
                                   OnBack="OnBackToOrganizations" />
        }
    }
    else
    {
        @* Org Admin: Direct org dashboard *@
        @if (_loadingOrgAdmin)
        {
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="mt-2">Loading your organisation...</MudText>
        }
        else if (_orgAdminError != null)
        {
            <MudAlert Severity="Severity.Error" data-testid="org-error">@_orgAdminError</MudAlert>
        }
        else if (_selectedOrganization != null)
        {
            <MudText Typo="Typo.h4" Class="mb-4" data-testid="page-title">
                <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
                @_selectedOrganization.Name
            </MudText>

            <OrganizationDashboard Organization="_selectedOrganization"
                                   IsSystemAdmin="false"
                                   CurrentUserId="_currentUserId"
                                   OnBack="@(() => {})" />
        }
    }
</MudContainer>

@code {
    [Parameter]
    public Guid? OrgId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Admin", href: "/app/admin/health"),
        new("Organisations", href: null, disabled: true)
    ];

    private OrganizationDto? _selectedOrganization;
    private bool _isSystemAdmin;
    private Guid? _currentUserId;
    private bool _loadingOrgAdmin;
    private string? _orgAdminError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;

            _isSystemAdmin = authState.User.IsInRole("SystemAdmin");

            var userIdClaim = authState.User.Claims
                .FirstOrDefault(c => c.Type == "sub" || c.Type == ClaimTypes.NameIdentifier);
            if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var userId))
            {
                _currentUserId = userId;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Deep-link: if OrgId is set, load that org
        if (OrgId.HasValue)
        {
            await LoadOrganizationByIdAsync(OrgId.Value);
        }
        else if (!_isSystemAdmin && _selectedOrganization == null)
        {
            // Org admin without system admin: auto-load their organization
            if (AuthenticationState != null)
            {
                var authState = await AuthenticationState;
                await LoadOrgAdminOrganizationAsync(authState);
            }
        }
    }

    private async Task LoadOrganizationByIdAsync(Guid orgId)
    {
        try
        {
            _selectedOrganization = await OrganizationService.GetOrganizationAsync(orgId);
            if (_selectedOrganization == null)
            {
                _orgAdminError = "Organisation not found.";
            }
        }
        catch (Exception ex)
        {
            _orgAdminError = $"Failed to load organisation: {ex.Message}";
        }
    }

    private async Task LoadOrgAdminOrganizationAsync(AuthenticationState authState)
    {
        _loadingOrgAdmin = true;
        try
        {
            var orgIdClaim = authState.User.Claims
                .FirstOrDefault(c => c.Type == "org_id" || c.Type == "organization_id");

            if (orgIdClaim != null && Guid.TryParse(orgIdClaim.Value, out var orgId))
            {
                _selectedOrganization = await OrganizationService.GetOrganizationAsync(orgId);
                if (_selectedOrganization == null)
                {
                    _orgAdminError = "Your organisation could not be found.";
                }
            }
            else
            {
                _orgAdminError = "No organisation claim found in your token. Please contact your administrator.";
            }
        }
        catch (Exception ex)
        {
            _orgAdminError = $"Failed to load organisation: {ex.Message}";
        }
        finally
        {
            _loadingOrgAdmin = false;
        }
    }

    private void OnOrganizationSelected(OrganizationDto organization)
    {
        _selectedOrganization = organization;
    }

    private void OnBackToOrganizations()
    {
        _selectedOrganization = null;
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Suspended" => Color.Warning,
        _ => Color.Default
    };
}
