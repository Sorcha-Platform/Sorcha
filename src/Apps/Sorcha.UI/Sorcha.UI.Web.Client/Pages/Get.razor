    Feature 128 US4 — app-store cold landing.

    Entry point for someone who discovered the Sorcha Wallet via an
    app-store listing and has no prior context. Explains what Sorcha
    is, offers a way to find services that use the platform, and
    surfaces a sign-in CTA. Sign-in routes through Login.cshtml.cs's
    F128 gate which lands a zero-device citizen on /setup/add-device.

    Anonymous — does not require authentication. Reachable at
    /get (and ultimately mapped from sorcha.dev/get via the existing
    nginx + sorcha-ui-web routing — no infrastructure change needed).
*@

@page "/get"

@* Uses the default MainLayout; the NotAuthorized branch of the
   layout's AuthorizeView keeps the nav chrome minimal for cold
   visitors. *@

@using Sorcha.UI.Core.Services
@inject NavigationManager Nav
@inject IQrPresentationService Qr

<PageTitle>Get started with Sorcha</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8" data-testid="get-landing">
    <MudPaper Elevation="2" Class="pa-8">
        <MudText Typo="Typo.h3" Class="mb-4" GutterBottom="true">
            Welcome to Sorcha
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-6">
            The Sorcha Wallet keeps your credentials on your own device.
            When a council, service, or organisation issues you a
            credential, it arrives directly in your wallet — ready to
            present whenever you need to prove something.
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
                   OnClick="@(() => Nav.NavigateTo(_walletUrl, forceLoad: true))"
                   data-testid="get-landing-open-wallet">
            Open Wallet
        </MudButton>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.h6" Class="mb-3">
            Install on your phone
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Scan this code with your phone's camera to open the wallet,
            then use "Add to Home Screen" to install it.
        </MudText>
        <div class="d-flex justify-center mb-2" data-testid="get-landing-qr">
            @((MarkupString)_walletQrSvg)
        </div>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.h6" Class="mb-3">
            Already have an account?
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Login"
                   OnClick="@HandleSignIn"
                   data-testid="get-landing-signin">
            Sign in to Sorcha
        </MudButton>
    </MudPaper>

    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-4 d-block mud-text-secondary">
        Sorcha is a federated identity + credential platform.
        Learn more at <MudLink Href="https://sorcha.dev">sorcha.dev</MudLink>.
    </MudText>
</MudContainer>

@code {
    private string _walletUrl = "/wallet/";
    private string _walletQrSvg = string.Empty;

    protected override void OnInitialized()
    {
        // The wallet PWA lives at origin-root /wallet/ (a separate WASM
        // app behind the gateway), not under this app's base path — so
        // resolve an absolute origin URL for both the CTA and the QR.
        _walletUrl = new Uri(new Uri(Nav.BaseUri), "/wallet/").ToString();
        _walletQrSvg = Qr.GenerateSvgFromUri(_walletUrl, pixelsPerModule: 6);
    }

    private void HandleSignIn()
    {
        // F128 US4 — sign-in returnUrl pinned to the F128 handoff so a
        // zero-device citizen lands on /setup/add-device after auth.
        // The reason=cold-landing query lets downstream telemetry
        // attribute the subsequent enrol-session mint to this route
        // (route="cold-landing" — Login.cshtml.cs honours this
        // attribution when it constructs the redirect; see the F128
        // research R4 telemetry contract).
        Nav.NavigateTo(
            "/auth/login?returnUrl=%2Fsetup%2Fadd-device&reason=cold-landing",
            forceLoad: true);
    }
}
