@page "/my-actions"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Sorcha.UI.Core.Models.Actions
@using Sorcha.UI.Core.Models.Registers
@using Sorcha.UI.Core.Models.Workflows
@using Sorcha.UI.Core.Components.Admin
@using Sorcha.UI.Core.Components.Credentials
@using Sorcha.UI.Core.Components.Shared
@using Sorcha.UI.Core.Components.Workflows
@using Sorcha.UI.Core.Models.Credentials
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Forms
@using Sorcha.UI.Core.Services.Wallet
@using Sorcha.UI.Core.Models.Forms
@using Sorcha.UI.Core.Services.Feedback
@inject IWorkflowService WorkflowService
@inject IBlueprintApiService BlueprintApiService
@inject IWalletApiService WalletService
@inject IWalletPreferenceService WalletPreferenceService
@inject BlueprintHubConnection BlueprintHub
@inject IInlineFeedback Feedback
@inject IDialogService DialogService
@inject ILogger<MyActions> Logger
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>My Pending Actions - Sorcha Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @* Issue #1275: this row did not wrap, so on a phone the heading was squeezed over three
       lines and "Actions requiring your attention" over four, beside the Connected badge and
       Refresh. Wrapping lets the controls drop to their own row instead of compressing the text. *@
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center" Class="mb-2">
        <MudStack Spacing="0" Style="flex: 1 1 260px; min-width: 0;">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Task" Class="mr-2" />
                My Pending Actions
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Actions requiring your attention
            </MudText>
        </MudStack>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @* Real-time connection status indicator *@
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@GetConnectionColor()"
                     Icon="@GetConnectionIcon()"
                     Variant="Variant.Outlined">
                @_connectionState.StatusText
            </MudChip>
            <MudToggleIconButton Toggled="@(_viewMode == "table")"
                                 ToggledChanged="ToggleViewMode"
                                 Icon="@Icons.Material.Filled.ViewModule"
                                 ToggledIcon="@Icons.Material.Filled.ViewList"
                                 Size="Size.Small"
                                 Title="@(_viewMode == "cards" ? "Switch to table view" : "Switch to card view")" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadActionsAsync">
                Refresh
            </MudButton>
        </MudStack>
    </MudStack>

    @* Encryption progress is now handled by the global CryptoProgressPopover in MainLayout *@

    @* Navigation warning banner when encryption is in progress *@
    @if (_activeEncryptionOperationId is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true"
                  Icon="@Icons.Material.Filled.Warning">
            Encryption in progress — if you navigate away, you'll be notified when it completes.
        </MudAlert>
    }

    @* Real-time notifications banner *@
    @if (_recentNotifications.Count > 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="ClearNotifications">
            <MudText Typo="Typo.body2">
                <strong>@_recentNotifications.Count new notification(s)</strong> received via real-time updates
            </MudText>
        </MudAlert>
    }

    @if (_serviceError)
    {
        <ServiceUnavailable ServiceName="Workflow Service" OnRetry="LoadActionsAsync" />
    }
    else if (_loading)
    {
        <MudGrid>
            @for (var i = 0; i < 3; i++)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudSkeleton Width="60%" Height="24px" Class="mb-2" />
                            <MudSkeleton Width="40%" Height="16px" Class="mb-3" />
                            <MudSkeleton Width="100%" Height="16px" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else if (_actions.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.CheckCircle"
                    Title="All Caught Up!"
                    Description="No pending actions require your attention." />
    }
    else
    {
        @foreach (var group in _groupedActions)
        {
            @if (_groupedActions.Count > 1)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 mt-3">
                    <MudText Typo="Typo.subtitle1"><strong>@group.Key</strong></MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@group.Value.Count</MudChip>
                </MudStack>
            }

            @if (_viewMode == "table")
            {
                <MudTable Items="@group.Value" Hover="true" Dense="true" Elevation="2" Class="mb-4">
                    <HeaderContent>
                        <MudTh>Action</MudTh>
                        <MudTh>Reference</MudTh>
                        @if (_groupedActions.Count <= 1)
                        {
                            <MudTh>Blueprint</MudTh>
                        }
                        <MudTh>Assigned</MudTh>
                        <MudTh>Priority</MudTh>
                        <MudTh Style="width: 140px;"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Action">@context.ActionName</MudTd>
                        <MudTd DataLabel="Reference">
                            @if (!string.IsNullOrEmpty(context.InstanceReference))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-family: monospace;">@context.InstanceReference</MudText>
                            }
                        </MudTd>
                        @if (_groupedActions.Count <= 1)
                        {
                            <MudTd DataLabel="Blueprint">@context.BlueprintName</MudTd>
                        }
                        <MudTd DataLabel="Assigned">@context.AssignedAt.ToString("MMM dd, yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Priority">
                            <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)">@context.Priority</MudChip>
                        </MudTd>
                        <MudTd>
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                                       OnClick="() => TakeAction(context)">
                                Take Action
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudGrid Class="mb-4">
                    @foreach (var action in group.Value)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudCard Elevation="2">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@action.BlueprintName</MudText>
                                        <MudText Typo="Typo.h6">@action.ActionName</MudText>
                                        @if (!string.IsNullOrEmpty(action.InstanceReference))
                                        {
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-family: monospace;">@action.InstanceReference</MudText>
                                        }
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(action.Priority)">@action.Priority</MudChip>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    @if (!string.IsNullOrEmpty(action.Description))
                                    {
                                        <MudText Typo="Typo.body2" Class="mb-2">@action.Description</MudText>
                                    }

                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                        Assigned: @action.AssignedAt.ToString("MMM dd, yyyy HH:mm")
                                    </MudText>
                                    @if (action.DueAt.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="@(action.DueAt.Value < DateTimeOffset.Now ? Color.Error : Color.Secondary)">
                                            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                                            Due: @action.DueAt.Value.ToString("MMM dd, yyyy HH:mm")
                                        </MudText>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true"
                                               OnClick="() => TakeAction(action)">
                                        Take Action
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    }

    <MudItem xs="12" Class="mt-4">
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
                @* Issue #1268: the previous wording announced live updates in general, beside a green
                   Connected badge, which sets the expectation that the whole
                   LIST is live. It is not: F118 delivers action-available and workflow-completed to a
                   wallet, and there is no "your action went away" event — when an instance advances to
                   someone else's action, nothing is emitted to this citizen at all. So additions are
                   live and removals are not, and the copy now says exactly that rather than
                   overclaiming. Narrowly true but misleading is still misleading. *@
                <MudText Typo="Typo.body2">
                    <strong>New actions appear automatically.</strong>
                    Completed ones clear when you refresh — use Refresh if you have just submitted something.
                    @if (_connectionState.Status != ConnectionStatus.Connected)
                    {
                        <span class="ml-2" style="color: var(--mud-palette-warning);">
                            (Currently @_connectionState.StatusText.ToLower())
                        </span>
                    }
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudContainer>

@code {
    private List<PendingActionViewModel> _actions = [];
    private List<SignalNotification> _recentNotifications = [];
    private List<KeyValuePair<string, List<PendingActionViewModel>>> _groupedActions = [];
    private ConnectionState _connectionState = new();
    private BlueprintHubConnection? _blueprintHub = null;
    private bool _loading = true;
    private bool _serviceError;
    private string _viewMode = "cards";
    private string? _activeEncryptionOperationId;
    private ActionExecuteRequest? _activeEncryptionRequest;
    private const string ViewModeStorageKey = "sorcha:pendingActions:viewMode";

    protected override async Task OnInitializedAsync()
    {
        await LoadActionsAsync();
        await ConnectToBlueprintHubAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ViewModeStorageKey);
                if (stored is "cards" or "table")
                {
                    _viewMode = stored;
                    StateHasChanged();
                }
            }
            catch { /* localStorage not available */ }
        }
    }

    private async Task ToggleViewMode(bool isTable)
    {
        _viewMode = isTable ? "table" : "cards";
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ViewModeStorageKey, _viewMode);
        }
        catch { /* localStorage not available */ }
    }

    private void RebuildGroups()
    {
        _groupedActions = _actions
            .GroupBy(a => a.BlueprintName)
            .OrderBy(g => g.Key)
            .Select(g => new KeyValuePair<string, List<PendingActionViewModel>>(
                g.Key, g.OrderByDescending(a => a.AssignedAt).ToList()))
            .ToList();
    }

    private async Task ConnectToBlueprintHubAsync()
    {
        _blueprintHub = BlueprintHub;

        // Subscribe to events
        _blueprintHub.OnConnectionStateChanged += HandleConnectionStateChanged;
        _blueprintHub.OnActionAvailable += HandleActionAvailable;
        _blueprintHub.OnActionRejected += HandleActionRejected;
        _blueprintHub.OnWorkflowCompleted += HandleWorkflowCompleted;

        // Sync current state
        _connectionState = _blueprintHub.ConnectionState;

        try
        {
            await _blueprintHub.StartAsync();

            // Subscribe to user's wallet addresses for targeted notifications
            var wallets = await WalletService.GetWalletsAsync();
            foreach (var wallet in wallets)
            {
                await _blueprintHub.SubscribeToWalletAsync(wallet.Address);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to connect to BlueprintHub — page will use polling");
        }
    }

    private async Task LoadActionsAsync()
    {
        _loading = true;
        _serviceError = false;

        try
        {
            _actions = await WorkflowService.GetPendingActionsAsync();
            RebuildGroups();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading pending actions");
            _serviceError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TakeAction(PendingActionViewModel action)
    {
        // Resolve wallet for signing
        var wallets = await WalletService.GetWalletsAsync();
        var walletAddress = await WalletPreferenceService.GetSmartDefaultAsync(wallets) ?? string.Empty;

        // Fetch blueprint to get action schema for form rendering.
        // Use the PUBLISHED-blueprint endpoint via IBlueprintApiService — the
        // pre-existing WorkflowService.GetBlueprintAsync path /api/blueprints/{id}
        // 404s for published blueprints and left the form dialog empty. The
        // published path is /api/actions/{wallet}/{register}/blueprints/{id}.
        if (action.DataSchema is null && !string.IsNullOrEmpty(action.BlueprintId)
            && !string.IsNullOrEmpty(action.RegisterId) && !string.IsNullOrEmpty(walletAddress))
        {
            try
            {
                var blueprint = await BlueprintApiService.GetPublishedBlueprintDetailAsync(
                    walletAddress, action.RegisterId, action.BlueprintId);
                if (blueprint != null)
                {
                    var actionDef = blueprint.Actions.FirstOrDefault(a => a.Id.ToString() == action.ActionId);
                    if (actionDef?.DataSchemas?.Any() == true)
                    {
                        // Convention: actions have a single merged schema document
                        var schemaJson = actionDef.DataSchemas.First().RootElement.GetRawText();
                        action = action with { DataSchema = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(schemaJson) };
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load schema for action {ActionId} on blueprint {BlueprintId}", action.ActionId, action.BlueprintId);
                Feedback.ShowError("Failed to load action form — please try again.", autoDismissMs: 0);
                return;
            }
        }

        // Feature 104 wave 14b — if this pending action carries a prepopulated
        // credential offer payload (via Route.OutputMapping on the previous
        // action), render the CredentialClaimCard dialog instead of the
        // default form. Falls through to the form for all non-claim actions.
        var offerInfo = CredentialOfferSchemaResolver.TryResolve(action.DataSchema, action.PrepopulatedPayload);

        IDialogReference dialog;
        if (offerInfo is not null)
        {
            var claimParams = new DialogParameters<Components.Credentials.CredentialClaimDialog>
            {
                { x => x.Offer, offerInfo },
                { x => x.Title, action.ActionName },
                { x => x.Description, action.Description },
                { x => x.LocalWalletAddress, walletAddress }
            };
            var claimOptions = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
            // Use the action name as the dialog shell title — the dialog
            // no longer renders its own <TitleContent>, so this is shown
            // once in the overlay chrome. The card inside renders the same
            // name as its primary header for the citizen.
            dialog = await DialogService.ShowAsync<Components.Credentials.CredentialClaimDialog>(
                action.ActionName, claimParams, claimOptions);
        }
        else
        {
            var parameters = new DialogParameters
            {
                ["Action"] = action,
                ["WalletAddress"] = walletAddress
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
            dialog = await DialogService.ShowAsync<ActionForm>("Execute Action", parameters, options);
        }
        var result = await dialog.Result;

        // Handle the CredentialClaimDialog FormSubmission shape — convert it to
        // the ActionSubmissionViewModel the existing execution path expects.
        // The card's FormSubmission.Data uses leading-slash JSON Pointer keys,
        // matching ActionForm's own convention.
        if (result is { Canceled: false, Data: FormSubmission cardSubmission })
        {
            // Assemble the flat JSON-Pointer-keyed FormContext data into a
            // nested dictionary so v2 blueprints that flatten core primitives
            // (PersonName, DateOfBirth, EmailAddress, PostalAddress) pass
            // validator schema validation. See FormPayloadBuilder.
            var adapted = new ActionSubmissionViewModel
            {
                ActionId = action.ActionId,
                InstanceId = action.InstanceId,
                Data = FormPayloadBuilder.BuildNested(cardSubmission.Data)
            };
            result = DialogResult.Ok(adapted);
        }
        else if (result is { Canceled: false, Data: string decision }
                 && decision == Components.Credentials.CredentialClaimDialog.RejectResult)
        {
            // Decline path from either dialog — fire the reject endpoint and remove the action.
            try
            {
                var rejected = await WorkflowService.RejectActionAsync(
                    action.InstanceId, action.ActionId, "declined");
                if (rejected)
                {
                    Feedback.ShowInfo("Action declined");
                    _actions.Remove(action);
                    RebuildGroups();
                    StateHasChanged();
                }
                else
                {
                    Feedback.ShowError("Failed to decline action. Please try again.", autoDismissMs: 0);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error rejecting action {ActionId}", action.ActionId);
                Feedback.ShowError("An error occurred while declining the action.", autoDismissMs: 0);
            }
            return;
        }

        if (result is { Canceled: false, Data: ActionSubmissionViewModel submission })
        {
            try
            {
                var executeRequest = new ActionExecuteRequest
                {
                    BlueprintId = action.BlueprintId,
                    ActionId = submission.ActionId,
                    InstanceId = submission.InstanceId,
                    SenderWallet = walletAddress,
                    RegisterAddress = action.RegisterId,
                    PayloadData = submission.Data
                };

                var submitResult = await WorkflowService.SubmitActionExecuteAsync(executeRequest);
                // Issue #1277: the server's dropped-claim warnings were discarded here entirely.
                submitResult.SurfaceWarnings(Feedback);
                if (submitResult is { HasAsyncOperation: true })
                {
                    // Async encryption — show progress indicator
                    _activeEncryptionOperationId = submitResult.OperationId;
                    _activeEncryptionRequest = executeRequest;
                    Feedback.ShowInfo("Encryption started — tracking progress...");
                    StateHasChanged();
                }
                else if (submitResult != null)
                {
                    Feedback.ShowSuccess("Action submitted successfully");
                    _actions.Remove(action);
                    RebuildGroups();
                    StateHasChanged();

                    // HAIP external wallet interactions — show QR dialog
                    if (submitResult.CredentialOffer is { } offer)
                    {
                        var offerParams = new DialogParameters<Components.Credentials.CredentialOfferQrDialog>
                        {
                            { x => x.CredentialOfferUri, offer.CredentialOfferUri },
                            { x => x.OfferId, offer.OfferId },
                            { x => x.CredentialType, offer.CredentialType },
                            { x => x.IssuerName, offer.IssuerName },
                            { x => x.ExpiresAt, offer.ExpiresAt },
                            // Wave 13: pass the action's signing wallet so
                            // the QR card offers the "Receive on this
                            // device" alternative path.
                            { x => x.LocalWalletAddress, walletAddress }
                        };
                        var offerOptions = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
                        await DialogService.ShowAsync<Components.Credentials.CredentialOfferQrDialog>(
                            "Credential Offer", offerParams, offerOptions);
                    }
                    else if (submitResult.PresentationRequest is { } request)
                    {
                        var requestParams = new DialogParameters<Components.Credentials.PresentationRequestQrDialog>
                        {
                            { x => x.PresentationRequestUri, request.PresentationRequestUri },
                            { x => x.RequestId, request.RequestId },
                            { x => x.CredentialType, request.CredentialType },
                            { x => x.RequestedClaims, request.RequestedClaims },
                            { x => x.ExpiresAt, request.ExpiresAt },
                            // Without these the dialog defaults to HAIP and a SorchaWallet gate
                            // polls a verifier that has never heard of it.
                            { x => x.Source, request.Source },
                            { x => x.ClaimsFetchToken, request.ClaimsFetchToken }
                        };
                        var requestOptions = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
                        await DialogService.ShowAsync<Components.Credentials.PresentationRequestQrDialog>(
                            "Credential Verification", requestParams, requestOptions);
                    }

                    // Feature 062 follow-up — when the action minted a credential, show the
                    // IssuanceSummaryPanel after any HAIP-side QR dialogs close. The server
                    // populates submitResult.IssuedCredential from
                    // ActionSubmissionResponse.IssuedCredential (Sorcha.Blueprint.Service).
                    if (submitResult.IssuedCredential is not null)
                    {
                        var summaryParams = new DialogParameters<IssuanceSummaryPanel>
                        {
                            { x => x.Summary, MapToIssuanceSummary(submitResult.IssuedCredential) }
                        };
                        var summaryOptions = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
                        await DialogService.ShowAsync<IssuanceSummaryPanel>(
                            "Credential Issued", summaryParams, summaryOptions);
                    }
                }
                else
                {
                    Feedback.ShowError("Failed to submit action. Please try again.", autoDismissMs: 0);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error submitting action {ActionId}", action.ActionId);
                Feedback.ShowError("An error occurred while submitting the action.", autoDismissMs: 0);
            }
        }
    }

    private async Task HandleEncryptionCompleted()
    {
        _activeEncryptionOperationId = null;
        _activeEncryptionRequest = null;
        Feedback.ShowSuccess("Encryption completed successfully!");
        await LoadActionsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleEncryptionFailed()
    {
        // Keep the progress indicator visible so user can see error and retry
        Feedback.ShowError("Encryption failed. See details above.", autoDismissMs: 0);
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Priority accent. <c>normal</c> is the DEFAULT state and must read as neutral.
    /// </summary>
    /// <remarks>
    /// Issue #1275: <c>normal</c> was mapped to <see cref="Color.Warning"/>, so the ordinary
    /// default state rendered amber/brown and read as if something were wrong — on every action in
    /// the list, which also devalues the amber that <c>high</c> genuinely needs.
    /// </remarks>
    private Color GetPriorityColor(string priority) => priority.ToLower() switch
    {
        "high" => Color.Error,
        "normal" => Color.Default,
        "low" => Color.Info,
        _ => Color.Default
    };

    private void HandleConnectionStateChanged(ConnectionState state)
    {
        _connectionState = state;
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleActionAvailable(SignalNotification signal)
    {
        _recentNotifications.Add(signal);
        // Real-time signal — reload actions from REST to get full details
        await LoadActionsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleActionRejected(SignalNotification signal)
    {
        // Real-time signal delivered via TenantHub inbox events
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleWorkflowCompleted(SignalNotification signal)
    {
        // Real-time signal — reload actions from REST to get full details
        await LoadActionsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ClearNotifications()
    {
        _recentNotifications.Clear();
        StateHasChanged();
    }

    private Color GetConnectionColor() => _connectionState.Status switch
    {
        ConnectionStatus.Connected => Color.Success,
        ConnectionStatus.Connecting => Color.Info,
        ConnectionStatus.Reconnecting => Color.Warning,
        ConnectionStatus.Disconnected => Color.Error,
        _ => Color.Default
    };

    private string GetConnectionIcon() => _connectionState.Status switch
    {
        ConnectionStatus.Connected => Icons.Material.Filled.SignalCellularAlt,
        ConnectionStatus.Connecting => Icons.Material.Filled.Sync,
        ConnectionStatus.Reconnecting => Icons.Material.Filled.SyncProblem,
        ConnectionStatus.Disconnected => Icons.Material.Filled.SignalCellularOff,
        _ => Icons.Material.Filled.HelpOutline
    };

    public ValueTask DisposeAsync()
    {
        if (_blueprintHub != null)
        {
            _blueprintHub.OnConnectionStateChanged -= HandleConnectionStateChanged;
            _blueprintHub.OnActionAvailable -= HandleActionAvailable;
            _blueprintHub.OnActionRejected -= HandleActionRejected;
            _blueprintHub.OnWorkflowCompleted -= HandleWorkflowCompleted;
        }

        return ValueTask.CompletedTask;
    }

    /// <summary>
    /// Maps the server-supplied <see cref="IssuedCredentialInfo"/> to the dialog's
    /// <see cref="IssuanceSummaryViewModel"/>. The server populates every human-readable
    /// field (recipient name, issuing org, processed-by) using JWT claims +
    /// participant-lookup; the UI is a pure pass-through.
    /// </summary>
    private static IssuanceSummaryViewModel MapToIssuanceSummary(IssuedCredentialInfo info) =>
        new()
        {
            CredentialType = info.CredentialType,
            IssuedToDid = info.IssuedToDid,
            IssuedToName = info.IssuedToName,
            SignedByOrg = info.SignedByOrg,
            ProcessedByName = info.ProcessedByName,
            ProcessedByRole = info.ProcessedByRole,
            TotalClaims = info.TotalClaims,
            DisclosableClaims = info.DisclosableClaims,
            UsagePolicy = info.UsagePolicy,
            ExpiresAt = info.ExpiresAt,
            BlueprintName = info.BlueprintName,
            ActionName = info.ActionName
        };
}
