@page "/registers/{RegisterId}"
@using Sorcha.UI.Core.Components.Registers
@using Sorcha.UI.Core.Components.Explorer
@using Sorcha.UI.Core.Components.Provenance
@using Sorcha.UI.Core.Components.Shared
@using Sorcha.UI.Core.Models.Registers
@using Sorcha.UI.Core.Models.Explorer
@using Sorcha.UI.Core.Services
@implements IAsyncDisposable

@inject IRegisterReadService RegisterService
@inject ITransactionService TransactionService
@inject RegisterHubConnection HubConnection
@inject NavigationManager Navigation
@inject ILogger<Detail> Logger

<PageTitle>@(_register?.Name ?? "Register") - Sorcha</PageTitle>

<div @onkeydown="OnKeyDown" tabindex="0" data-testid="register-detail-page" class="register-detail-container">
<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    @* Header with back navigation *@
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="NavigateBack"
                       aria-label="Back to registers"
                       data-testid="back-button" />
        @if (_isLoadingRegister)
        {
            <MudSkeleton Width="200px" Height="32px" />
        }
        else if (_register is not null)
        {
            <MudStack Spacing="0" Style="flex: 1">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5" data-testid="register-name">@_register.Name</MudText>
                    <RegisterStatusBadge Status="@_register.Status" />
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(_register.Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="register-description">
                        @_register.Description
                    </MudText>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="register-id">
                    @_register.Id
                </MudText>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.h5" Color="Color.Error">Register not found</MudText>
        }
    </MudStack>

    @if (_registerError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_registerError
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadRegisterAsync" Class="ml-2">
                Retry
            </MudButton>
        </MudAlert>
    }
    else if (_register is not null)
    {
        @* Register info summary *@
        <MudPaper Elevation="1" Class="pa-4 mb-4" data-testid="register-metadata">
            <MudGrid Spacing="3">
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Height</MudText>
                        <MudText Typo="Typo.h6" data-testid="register-height">@_register.HeightFormatted</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Transactions</MudText>
                        <MudText Typo="Typo.h6" data-testid="transaction-count">@_totalTransactions</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Last Updated</MudText>
                        <MudText Typo="Typo.body1" data-testid="last-updated">@_register.LastUpdateFormatted</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Visibility</MudText>
                        <MudText Typo="Typo.body1" data-testid="visibility">
                            @(_register.Advertise ? "Public" : "Private")
                        </MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* Real-time indicator (visible on all tabs) *@
        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  AlignItems="AlignItems.Center"
                  Class="mb-2">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               OnClick="RefreshAllAsync"
                               aria-label="Refresh" />
                <RealTimeIndicator ConnectionState="@_connectionState"
                                   IsEnabled="@_realtimeEnabled"
                                   IsEnabledChanged="OnRealtimeToggled" />
            </MudStack>
        </MudStack>

        @* Tabbed content area *@
        <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4"
                 ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnActiveTabChanged">
            <MudTabPanel Text="Transactions" Icon="@Icons.Material.Filled.Receipt">
                <div class="pa-3 transactions-tab-container">
                    <ResizableSplitter ShowBottom="@(_selectedTransaction is not null)"
                                       StorageKey="sorcha:panel-height:register-detail">
                        <TopContent>
                            <MudPaper Elevation="0" Class="transaction-list-paper" data-testid="transaction-list">
                                <div class="transaction-list-content">
                                    <TransactionList RegisterId="@RegisterId"
                                                     @ref="_transactionListRef"
                                                     SelectedTransaction="_selectedTransaction"
                                                     SelectedTransactionChanged="OnTransactionSelected"
                                                     OnTransactionsLoaded="OnTransactionsLoaded" />
                                </div>
                            </MudPaper>
                        </TopContent>
                        <BottomContent>
                            @if (_selectedTransaction is not null)
                            {
                                <TransactionDetailPanel Transaction="@_selectedTransaction"
                                                        NavigationContext="@_navContext"
                                                        OnClose="ClearSelection"
                                                        OnBreadcrumbNavigate="OnBreadcrumbNavigate"
                                                        OnShowInMap="ShowInMap"
                                                        OnNavigateToDocket="OnNavigateToDocketAsync" />
                            }
                        </BottomContent>
                    </ResizableSplitter>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Docket Chain" Icon="@Icons.Material.Filled.Link">
                <div class="pa-3 docket-tab-container">
                    <ResizableSplitter ShowBottom="@(_selectedDocket is not null || (_selectedTransaction is not null && _navContext.Level == NavigationLevel.Transaction && _activeTabIndex == 1))"
                                       StorageKey="sorcha:panel-height:docket-detail">
                        <TopContent>
                            <MudPaper Elevation="0" Class="docket-list-paper">
                                <div class="docket-list-content">
                                    <DocketChain RegisterId="@RegisterId"
                                                 @ref="_docketChainRef"
                                                 SelectedDocketId="@_selectedDocket?.DocketId"
                                                 OnDocketSelected="OnDocketSelectedAsync" />
                                </div>
                            </MudPaper>
                        </TopContent>
                        <BottomContent>
                            @if (_navContext.Level == NavigationLevel.Transaction && _selectedTransaction is not null)
                            {
                                <TransactionDetailPanel Transaction="@_selectedTransaction"
                                                        NavigationContext="@_navContext"
                                                        OnClose="ClearDocketDrillThrough"
                                                        OnBreadcrumbNavigate="OnDocketBreadcrumbNavigate"
                                                        OnNavigateToDocket="OnNavigateToDocketAsync" />
                            }
                            else if (_selectedDocket is not null)
                            {
                                <div class="docket-detail-panel">
                                    <div class="panel-header">
                                        <div class="panel-header-left">
                                            <BreadcrumbNav Context="@_navContext"
                                                           OnNavigate="OnDocketBreadcrumbNavigate" />
                                        </div>
                                        <div class="panel-header-right">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Size="Size.Small"
                                                           OnClick="ClearDocketDrillThrough"
                                                           aria-label="Close docket panel"
                                                           data-testid="close-docket-panel" />
                                        </div>
                                    </div>
                                    <MudDivider Class="mb-3" />
                                    <DocketDetail Docket="@_selectedDocket"
                                                  RegisterId="@RegisterId"
                                                  OnTransactionSelected="OnDocketTransactionSelected" />
                                </div>
                            }
                        </BottomContent>
                    </ResizableSplitter>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Governance" Icon="@Icons.Material.Filled.Policy">
                <MudStack Spacing="6">
                    @* Feature 189 T084: the proposals sit above the policy because they are what an
                       approver is being asked to act on. Both read the same register's governance. *@
                    <GovernanceProposalsPanel RegisterId="@RegisterId" />
                    <MudDivider />
                    <RegisterPolicyTab RegisterId="@RegisterId" />
                </MudStack>
            </MudTabPanel>

            @* Feature 188 — provenance. Reached from the register the administrator is already
               looking at, deliberately NOT a new top-level nav item: "who signed this off" is a
               question about a register, not a separate destination. *@
            <MudTabPanel Text="Provenance" Icon="@Icons.Material.Filled.Verified">
                <div class="pa-3">
                    <RegisterLineage RegisterId="@RegisterId" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Register Map" Icon="@Icons.Material.Filled.Map">
                <div class="pa-3" style="height: calc(100vh - 380px); min-height: 400px;">
                    <RegisterMap RegisterId="@RegisterId"
                                 OnTransactionSelected="OnMapTransactionSelected"
                                 @ref="_registerMapRef" />
                </div>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>
</div>

@code {
    [Parameter]
    public string RegisterId { get; set; } = string.Empty;

    private RegisterViewModel? _register;
    private bool _isLoadingRegister = true;
    private string? _registerError;
    private TransactionViewModel? _selectedTransaction;
    private DocketViewModel? _selectedDocket;
    private int _totalTransactions;
    private TransactionList? _transactionListRef;
    private DocketChain? _docketChainRef;
    private RegisterMap? _registerMapRef;
    private int _activeTabIndex;
    private ConnectionState _connectionState = new();
    private bool _realtimeEnabled = true;
    private ExplorerNavigationContext _navContext = new();

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to connection state changes
        HubConnection.OnConnectionStateChanged += OnConnectionStateChanged;
        HubConnection.OnTransactionConfirmed += OnTransactionConfirmedAsync;
        HubConnection.OnRegisterHeightUpdated += OnRegisterHeightUpdatedAsync;
        HubConnection.OnDocketSealed += OnDocketSealedAsync;

        // Sync with actual hub state (may already be connected from previous navigation)
        _connectionState = HubConnection.ConnectionState;

        await LoadRegisterAsync();

        // Start SignalR connection and subscribe to register
        await StartRealtimeAsync();
    }

    private async Task StartRealtimeAsync()
    {
        try
        {
            await HubConnection.StartAsync();
            await HubConnection.SubscribeToRegisterAsync(RegisterId);

            // Sync state after start (StartAsync may return without firing event if already connected)
            _connectionState = HubConnection.ConnectionState;
        }
        catch (Exception ex)
        {
            // Log but don't fail - the UI still works without real-time updates
            Logger.LogWarning(ex, "Failed to start real-time connection");
            _connectionState = HubConnection.ConnectionState;
        }
    }

    private void OnConnectionStateChanged(ConnectionState state)
    {
        _connectionState = state;
        InvokeAsync(StateHasChanged);
    }

    private async Task OnRealtimeToggled(bool enabled)
    {
        _realtimeEnabled = enabled;

        if (_realtimeEnabled)
        {
            // Re-start connection and subscribe
            await StartRealtimeAsync();
        }
        else
        {
            // Stop the connection — pauses all real-time updates
            try
            {
                await HubConnection.StopAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to stop connection");
            }

            _connectionState = HubConnection.ConnectionState;
        }
    }

    private async Task OnTransactionConfirmedAsync(string registerId, string txId)
    {
        if (registerId != RegisterId)
            return;

        // Auto-prepend the new transaction to the table
        try
        {
            var transaction = await TransactionService.GetTransactionAsync(RegisterId, txId);
            if (transaction is not null && _transactionListRef is not null)
            {
                await _transactionListRef.PrependTransactionAsync(transaction);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to auto-load transaction {TxId}", txId);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRegisterHeightUpdatedAsync(string registerId, uint newHeight)
    {
        if (registerId != RegisterId || _register is null)
            return;

        // Update register height
        _register = _register with { Height = newHeight };
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnDocketSealedAsync(string registerId, ulong docketId, string hash)
    {
        if (registerId != RegisterId)
            return;

        // Auto-refresh the docket table
        try
        {
            if (_docketChainRef is not null)
            {
                await _docketChainRef.RefreshAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to auto-refresh dockets for register {RegisterId}", registerId);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadRegisterAsync()
    {
        try
        {
            _isLoadingRegister = true;
            _registerError = null;

            _register = await RegisterService.GetRegisterAsync(RegisterId);

            if (_register is null)
            {
                _registerError = "Register not found";
            }
        }
        catch (Exception ex)
        {
            _registerError = $"Failed to load register: {ex.Message}";
        }
        finally
        {
            _isLoadingRegister = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("registers");
    }

    private async Task RefreshAllAsync()
    {
        // Refresh transaction list
        if (_transactionListRef is not null)
        {
            await _transactionListRef.RefreshAsync();
        }

        // Refresh docket chain
        if (_docketChainRef is not null)
        {
            await _docketChainRef.RefreshAsync();
        }

        // Reload register metadata
        await LoadRegisterAsync();

    }

    private void OnTransactionsLoaded(int total)
    {
        _totalTransactions = total;
        StateHasChanged();
    }

    private void OnTransactionSelected(TransactionViewModel? transaction)
    {
        _selectedTransaction = transaction;

        if (_selectedTransaction is not null)
        {
            _navContext = new ExplorerNavigationContext
            {
                Level = NavigationLevel.Transaction,
                TransactionId = _selectedTransaction.TxId
            };
        }
        else
        {
            _navContext = new ExplorerNavigationContext();
        }
    }

    private void ClearSelection()
    {
        _selectedTransaction = null;
        _navContext = new ExplorerNavigationContext();
    }

    private void OnBreadcrumbNavigate(NavigationLevel level)
    {
        if (level == NavigationLevel.Register)
        {
            ClearSelection();
        }
    }

    private void OnActiveTabChanged(int index)
    {
        _activeTabIndex = index;

        // When switching away from Docket Chain tab, clear docket drill-through state
        if (index != 1)
        {
            _selectedDocket = null;
            // Only clear transaction if it was from docket drill-through (not from Transactions tab)
            if (_navContext.DocketId is not null)
            {
                _selectedTransaction = null;
                _navContext = new ExplorerNavigationContext();
            }
        }
    }

    private async Task OnMapTransactionSelected(TransactionGraphNode node)
    {
        var transaction = await TransactionService.GetTransactionAsync(RegisterId, node.TxId);
        if (transaction is not null)
        {
            _selectedTransaction = transaction;
            _navContext = new ExplorerNavigationContext
            {
                Level = NavigationLevel.Transaction,
                TransactionId = transaction.TxId
            };
        }
    }

    private async Task ShowInMap(string txId)
    {
        // Switch to the Register Map tab (index 3: Transactions=0, Docket Chain=1, Governance=2, Register Map=3)
        _activeTabIndex = 3;
        StateHasChanged();

        // Allow render to complete before highlighting
        await Task.Yield();

        _registerMapRef?.HighlightTransaction(txId);
    }

    private void OnDocketSelectedAsync(DocketViewModel? docket)
    {
        if (docket is null)
        {
            // Deselection
            _selectedDocket = null;
            _selectedTransaction = null;
            _navContext = new ExplorerNavigationContext();
        }
        else
        {
            _selectedDocket = docket;
            _selectedTransaction = null;
            _navContext = new ExplorerNavigationContext
            {
                Level = NavigationLevel.Docket,
                DocketId = docket.DocketId,
                DocketVersion = (ulong)docket.Version
            };
        }
    }

    private void OnDocketTransactionSelected(TransactionViewModel tx)
    {
        _selectedTransaction = tx;
        _navContext = new ExplorerNavigationContext
        {
            Level = NavigationLevel.Transaction,
            DocketId = _selectedDocket?.DocketId,
            DocketVersion = _selectedDocket is not null ? (ulong)_selectedDocket.Version : null,
            TransactionId = tx.TxId
        };
    }

    private void OnDocketBreadcrumbNavigate(NavigationLevel level)
    {
        switch (level)
        {
            case NavigationLevel.Register:
                // Clear everything
                _selectedTransaction = null;
                _selectedDocket = null;
                _navContext = new ExplorerNavigationContext();
                break;

            case NavigationLevel.Docket:
                // Clear transaction, keep docket
                _selectedTransaction = null;
                if (_selectedDocket is not null)
                {
                    _navContext = new ExplorerNavigationContext
                    {
                        Level = NavigationLevel.Docket,
                        DocketId = _selectedDocket.DocketId,
                        DocketVersion = (ulong)_selectedDocket.Version
                    };
                }
                else
                {
                    _navContext = new ExplorerNavigationContext();
                }
                break;
        }
    }

    private void ClearDocketDrillThrough()
    {
        _selectedTransaction = null;
        _selectedDocket = null;
        _navContext = new ExplorerNavigationContext();
    }

    private async Task OnNavigateToDocketAsync(ulong docketVersion)
    {
        // Switch to the Docket Chain tab (index 1)
        _activeTabIndex = 1;

        // Clear any existing transaction selection from the Transactions tab
        _selectedTransaction = null;

        StateHasChanged();

        // Allow render to complete so DocketChain is available
        await Task.Yield();

        // Find the docket by version from the loaded dockets
        var docket = _docketChainRef?.FindDocketByVersion(docketVersion);
        if (docket is not null)
        {
            _selectedDocket = docket;
            _navContext = new ExplorerNavigationContext
            {
                Level = NavigationLevel.Docket,
                DocketId = docket.DocketId,
                DocketVersion = (ulong)docket.Version
            };
            StateHasChanged();
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (_selectedTransaction is not null)
            {
                if (_activeTabIndex == 1 && _selectedDocket is not null)
                {
                    // In Docket Chain tab with transaction selected: go back to docket level
                    OnDocketBreadcrumbNavigate(NavigationLevel.Docket);
                }
                else
                {
                    ClearSelection();
                }
            }
            else if (_selectedDocket is not null)
            {
                ClearDocketDrillThrough();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Unsubscribe from events
        HubConnection.OnConnectionStateChanged -= OnConnectionStateChanged;
        HubConnection.OnTransactionConfirmed -= OnTransactionConfirmedAsync;
        HubConnection.OnRegisterHeightUpdated -= OnRegisterHeightUpdatedAsync;
        HubConnection.OnDocketSealed -= OnDocketSealedAsync;

        // Unsubscribe from register updates
        try
        {
            await HubConnection.UnsubscribeFromRegisterAsync(RegisterId);
        }
        catch (Exception)
        {
            // Best-effort unsubscribe during cleanup -- connection may already be closed
        }
    }
}

<style>
    .register-detail-container:focus {
        outline: none;
    }

    .transactions-tab-container {
        height: calc(100vh - 300px);
        min-height: 400px;
    }

    .transaction-list-paper {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .transaction-list-content {
        flex: 1;
        overflow: hidden;
    }

    .border-bottom {
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .docket-tab-container {
        height: calc(100vh - 300px);
        min-height: 400px;
    }

    .docket-list-paper {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .docket-list-content {
        flex: 1;
        overflow: auto;
    }

    .docket-detail-panel {
        padding: 16px;
        height: 100%;
        overflow: auto;
    }

    .docket-detail-panel .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .docket-detail-panel .panel-header-left {
        flex: 1;
        min-width: 0;
    }

    .docket-detail-panel .panel-header-right {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
    }
</style>
