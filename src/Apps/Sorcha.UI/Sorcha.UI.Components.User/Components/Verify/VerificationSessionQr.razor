@*
    SPDX-License-Identifier: MIT
    Copyright (c) 2026 Sorcha Contributors

    Shared session QR component for the verify flow (Feature 163, US2). Starts a verification session
    via IVerificationTransport, renders the OID4VP QR code and deep link, polls for completion, and
    handles not-configured / loading / error / complete states. Implements IAsyncDisposable so the
    poll loop is cancelled cleanly on unmount.
*@
@namespace Sorcha.UI.Core.Components.Verify
@using QRCoder
@using Sorcha.UI.Components.User.Models.Verification
@using Sorcha.UI.Components.User.Services.Verification
@using Sorcha.Verifier.Engine.Models
@inject IVerificationTransport Transport
@implements IAsyncDisposable

<div class="verification-session-qr" data-testid="verification-session-qr">
    @if (_notConfigured)
    {
        <MudAlert Severity="Severity.Info" data-testid="not-configured">
            Verification is not yet configured here.
        </MudAlert>
    }
    else if (_error)
    {
        <MudAlert Severity="Severity.Error" Dense="true" data-testid="transport-error">
            Verification unavailable. Check your connection.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="RetryAsync" data-testid="retry-button">
            Retry
        </MudButton>
    }
    else if (_loading)
    {
        <div data-testid="loading">
            <MudProgressCircular Indeterminate="true" />
        </div>
    }
    else if (!string.IsNullOrEmpty(_qrPng))
    {
        @* Issue #1282: this used to render the raw openid4vp:// request URI as the link's own text —
           a protocol string shown to a citizen as if it were content, overflowing the viewport with
           no explanation of what to do with the QR, and no way out of the screen. The URI belongs in
           the href only; the QR is the affordance. *@
        <div data-testid="qr-active" class="qr-active">
            <MudText Typo="Typo.subtitle1" Class="mb-1" data-testid="qr-heading">@EffectiveHeading</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3" data-testid="qr-instruction">
                Ask them to scan this with their wallet app. You'll see the result here as soon as they share.
            </MudText>

            <img src="data:image/png;base64,@_qrPng" alt="Scan to verify" class="qr-image" />

            <div class="qr-waiting mt-3" data-testid="qr-waiting">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Waiting for them to share…</MudText>
            </div>

            <MudStack Row="true" Spacing="2" Class="mt-3" Justify="Justify.Center">
                @* Same-device escape hatch. The URI rides the href where it belongs — never as
                   visible text. Only useful when a wallet app is installed on THIS device, so it is
                   secondary to the QR. *@
                <MudLink Href="@_qrDeepLink" Underline="Underline.Always"
                         Typo="Typo.body2" data-testid="deep-link">
                    Open in a wallet on this device
                </MudLink>
                @if (OnCancel.HasDelegate)
                {
                    <MudLink Href="javascript:void(0)" Underline="Underline.Always" Typo="Typo.body2"
                             data-testid="qr-cancel" @onclick="@(() => OnCancel.InvokeAsync())">
                        Cancel
                    </MudLink>
                }
            </MudStack>
        </div>
    }
</div>

@code {
    /// <summary>The verification question/preset to start a session for.</summary>
    [Parameter, EditorRequired] public VerificationPreset Question { get; set; } = default!;

    /// <summary>Host-supplied cancellation token; linked into the component's own CTS.</summary>
    [Parameter] public CancellationToken CancellationToken { get; set; } = default;

    /// <summary>Raised once with the vp_token when polling reports completion.</summary>
    [Parameter] public EventCallback<string> OnCompleted { get; set; }

    /// <summary>Raised once with the computed verdict when polling reports completion (may be null).</summary>
    [Parameter] public EventCallback<VerificationOutcome?> OnOutcome { get; set; }

    /// <summary>
    /// Raised when the operator abandons the session. When no handler is supplied the Cancel
    /// affordance is not rendered — a dead control is worse than none (issue #1282: the QR screen
    /// offered no way out at all).
    /// </summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Optional override for the heading above the QR. Left unset, the component names the check
    /// itself from <see cref="Question"/> — it already has the preset, so a host should not have to
    /// remember to pass this for the screen to say what it is doing (issue #1282: the QR screen
    /// carried no heading at all).
    /// </summary>
    [Parameter] public string? ScanHeading { get; set; }

    private string EffectiveHeading =>
        !string.IsNullOrWhiteSpace(ScanHeading) ? ScanHeading!
        : !string.IsNullOrWhiteSpace(Question?.Label) ? $"Checking: {Question!.Label}"
        : "Show this to the person you're checking";

    private CancellationTokenSource? _cts;
    private Task? _pollTask;
    private bool _notConfigured;
    private bool _loading = true;
    private bool _error;
    private bool _disposed;
    private string _qrPng = "";
    private string _qrDeepLink = "";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _cts = CancellationTokenSource.CreateLinkedTokenSource(CancellationToken);
        _loading = true;
        _notConfigured = false;
        _error = false;
        _qrPng = "";
        _qrDeepLink = "";

        try
        {
            var started = await Transport.StartSessionAsync(Question, _cts.Token);

            if (string.IsNullOrEmpty(started.SessionId) || string.IsNullOrEmpty(started.QrDeepLink))
            {
                _notConfigured = true;
                _loading = false;
                return;
            }

            _qrDeepLink = started.QrDeepLink;
            _qrPng = GenerateQrPng(started.QrDeepLink);
            _loading = false;

            _pollTask = PollAsync(started.SessionId, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            _loading = false;
        }
        catch
        {
            _error = true;
            _loading = false;
        }
    }

    private async Task PollAsync(string sessionId, CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(3000, ct);
                var poll = await Transport.PollSessionAsync(sessionId, ct);
                if (poll.IsComplete)
                {
                    if (!_disposed)
                    {
                        await OnOutcome.InvokeAsync(poll.Outcome);
                        await OnCompleted.InvokeAsync(poll.VpToken ?? "");
                    }
                    return;
                }
                if (poll.IsTerminal)
                {
                    await FailAsync();
                    return;
                }
            }
        }
        catch (OperationCanceledException) { }
        catch
        {
            await FailAsync();
        }
    }

    /// <summary>
    /// Surfaces the error state from the poll loop.
    /// </summary>
    /// <remarks>
    /// Issue #1282: the two previous call sites invoked <c>StateHasChanged()</c> DIRECTLY from this
    /// background poll task. Rendering must be marshalled onto the renderer's dispatcher; calling it
    /// off-dispatcher is the classic source of Blazor's "An unhandled error has occurred" bar — which
    /// is exactly what the citizen saw on this screen, and it suppressed the verdict panel that would
    /// otherwise have rendered. <c>InvokeAsync</c> marshals it correctly.
    /// <para>
    /// Swallows <see cref="ObjectDisposedException"/> because the component can be unmounted between
    /// the disposed check and the dispatch — losing a state update on a dying component is correct,
    /// crashing the page is not.
    /// </para>
    /// </remarks>
    private async Task FailAsync()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                _error = true;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
    }

    private async Task RetryAsync()
    {
        _cts?.Cancel();
        if (_pollTask is not null)
        {
            try { await _pollTask; } catch { }
        }
        _cts?.Dispose();
        _cts = CancellationTokenSource.CreateLinkedTokenSource(CancellationToken);
        await OnInitializedAsync();
        StateHasChanged();
    }

    private static string GenerateQrPng(string content)
    {
        try
        {
            using var qrGenerator = new QRCodeGenerator();
            var qrCodeData = qrGenerator.CreateQrCode(content, QRCodeGenerator.ECCLevel.M);
            using var qrCode = new PngByteQRCode(qrCodeData);
            return Convert.ToBase64String(qrCode.GetGraphic(5));
        }
        catch
        {
            return "";
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts?.Cancel();
        if (_pollTask is not null)
        {
            try { await _pollTask; }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        }
        _cts?.Dispose();
    }
}
