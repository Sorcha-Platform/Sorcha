@using MudBlazor
@using Sorcha.UI.Core.Models.Credentials

<MudStack Spacing="3">
    @* ── Banner ──────────────────────────────────────────────────────── *@
    <MudAlert Severity="@BannerSeverity"
              Icon="@BannerIcon"
              Elevation="0"
              Class="pa-3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@BannerTitle</MudText>
            <MudText Typo="Typo.body2">@BannerSubtitle</MudText>
        </MudStack>
    </MudAlert>

    @* ── Verification details expansion panel ────────────────────────── *@
    <MudExpansionPanels Elevation="1">
        <MudExpansionPanel IsInitiallyExpanded="@DetailsExpanded">
            <TitleContent>
                <MudText Typo="Typo.body2">
                    Verification details — @Result.PassedCheckCount of @Result.TotalCheckCount checks passed
                </MudText>
            </TitleContent>
            <ChildContent>
                <MudList T="string" Dense="true" Class="pa-0">
                    @* Check 1: Signature valid *@
                    <MudListItem T="string" Class="@GetCheckRowClass(Result.SignatureValid)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@GetCheckIcon(Result.SignatureValid)"
                                     Color="@GetCheckIconColor(Result.SignatureValid)"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="flex: 1;">Signature valid</MudText>
                        </MudStack>
                    </MudListItem>

                    @* Check 2: Issuer trusted *@
                    <MudListItem T="string" Class="@GetCheckRowClass(Result.IssuerTrusted)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@GetCheckIcon(Result.IssuerTrusted)"
                                     Color="@GetCheckIconColor(Result.IssuerTrusted)"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="flex: 1;">Issuer trusted</MudText>
                            @if (Result.IssuerTrusted && !string.IsNullOrWhiteSpace(Result.IssuerName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Result.IssuerName</MudText>
                            }
                        </MudStack>
                    </MudListItem>

                    @* Check 3: Revocation status *@
                    <MudListItem T="string" Class="@GetRevocationRowClass()">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@GetRevocationIcon()"
                                     Color="@GetRevocationIconColor()"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="flex: 1;">Revocation status</MudText>
                            @if (GetRevocationWarning() is { } warning)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">@warning.Message</MudText>
                            }
                        </MudStack>
                    </MudListItem>

                    @* Check 4: Not expired *@
                    <MudListItem T="string" Class="@GetCheckRowClass(Result.NotExpired)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@GetCheckIcon(Result.NotExpired)"
                                     Color="@GetCheckIconColor(Result.NotExpired)"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="flex: 1;">Not expired</MudText>
                            @if (Result.NotExpired && Result.ExpiresAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Expires @Result.ExpiresAt.Value.ToString("yyyy-MM-dd")
                                </MudText>
                            }
                        </MudStack>
                    </MudListItem>

                    @* Check 5: Required claims present *@
                    <MudListItem T="string" Class="@GetCheckRowClass(Result.RequiredClaimsPresent)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@GetCheckIcon(Result.RequiredClaimsPresent)"
                                     Color="@GetCheckIconColor(Result.RequiredClaimsPresent)"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2" Style="flex: 1;">Required claims present</MudText>
                            @if (Result.RequiredClaimCount > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @Result.PresentClaimCount of @Result.RequiredClaimCount
                                </MudText>
                            }
                        </MudStack>
                    </MudListItem>
                </MudList>

                @* Warnings list (amber state) *@
                @if (Result.Warnings.Count > 0)
                {
                    <MudDivider Class="my-2" />
                    @foreach (var warning in Result.Warnings)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">
                            <MudText Typo="Typo.caption">@warning.Message</MudText>
                        </MudAlert>
                    }
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @* ── Disclosed claims grid ───────────────────────────────────────── *@
    @if (Result.DisclosedClaims is { Count: > 0 })
    {
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Disclosed Claims</MudText>
            <MudSimpleTable Dense="true" Hover="true" Bordered="false">
                <tbody>
                    @foreach (var claim in Result.DisclosedClaims)
                    {
                        <tr>
                            <td style="width: 40%;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@claim.Key</MudText>
                            </td>
                            <td>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@claim.Value?.ToString()</MudText>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudStack>
    }
</MudStack>

@code {
    /// <summary>The verification result to display.</summary>
    [Parameter, EditorRequired]
    public VerificationResultViewModel Result { get; set; } = default!;

    // ── Computed banner properties ────────────────────────────────────────

    private Severity BannerSeverity => Result.EscalationLevel switch
    {
        TrustEscalation.Green => Severity.Success,
        TrustEscalation.Amber => Severity.Warning,
        _ => Severity.Error,
    };

    private string BannerIcon => Result.EscalationLevel switch
    {
        TrustEscalation.Green => Icons.Material.Filled.CheckCircle,
        TrustEscalation.Amber => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Cancel,
    };

    private string BannerTitle => Result.EscalationLevel switch
    {
        TrustEscalation.Green => "Verified Credential",
        TrustEscalation.Amber => "Verification Warning",
        _ => "Verification Failed",
    };

    private string BannerSubtitle => Result.EscalationLevel switch
    {
        TrustEscalation.Green =>
            !string.IsNullOrWhiteSpace(Result.CredentialType) && !string.IsNullOrWhiteSpace(Result.IssuerName)
                ? $"{Result.CredentialType} · {Result.IssuerName}"
                : Result.CredentialType ?? Result.IssuerName ?? string.Empty,
        TrustEscalation.Amber =>
            $"{Result.Warnings.Count} check(s) need attention",
        _ => GetRedSubtitle(),
    };

    private bool DetailsExpanded => Result.EscalationLevel != TrustEscalation.Green;

    // ── Check row helpers ─────────────────────────────────────────────────

    private static string GetCheckRowClass(bool passed) =>
        passed ? string.Empty : "mud-theme-error";

    private static string GetCheckIcon(bool passed) =>
        passed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel;

    private static Color GetCheckIconColor(bool passed) =>
        passed ? Color.Success : Color.Error;

    // ── Revocation-specific helpers (supports amber warning state) ────────

    private string GetRevocationRowClass()
    {
        if (!Result.NotRevoked) return "mud-theme-error";
        if (GetRevocationWarning() is not null) return "mud-theme-warning";
        return string.Empty;
    }

    private string GetRevocationIcon()
    {
        if (!Result.NotRevoked) return Icons.Material.Filled.Cancel;
        if (GetRevocationWarning() is not null) return Icons.Material.Filled.Warning;
        return Icons.Material.Filled.CheckCircle;
    }

    private Color GetRevocationIconColor()
    {
        if (!Result.NotRevoked) return Color.Error;
        if (GetRevocationWarning() is not null) return Color.Warning;
        return Color.Success;
    }

    private VerificationWarning? GetRevocationWarning() =>
        Result.Warnings.FirstOrDefault(w =>
            w.Code.Contains("revocation", StringComparison.OrdinalIgnoreCase) ||
            w.Code.Contains("REVOCATION", StringComparison.OrdinalIgnoreCase) ||
            w.Message.Contains("FailOpen", StringComparison.OrdinalIgnoreCase));

    // ── Red subtitle ──────────────────────────────────────────────────────

    private string GetRedSubtitle()
    {
        if (!Result.SignatureValid) return "Credential signature is invalid";
        if (!Result.IssuerTrusted) return "Issuer is not trusted by this organisation";
        if (!Result.NotRevoked) return "Credential has been revoked";
        if (!Result.NotExpired) return "Credential has expired";
        if (!Result.RequiredClaimsPresent) return "Required claims are missing from the presentation";
        return "One or more verification checks failed";
    }
}
