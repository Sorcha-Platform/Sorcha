    SPDX-License-Identifier: MIT
    Copyright (c) 2026 Sorcha Contributors

    Credential picker (Feature 114, T098; Feature 181 US2, T026). Two selection
    shapes, pure presentational (raises the choice back to Present.razor):
      • Candidate mode (legacy) — the verifier's single ask matches more than one
        credential the citizen holds; pick which credential to use.
      • Alternative mode (US2) — a DCQL credential_set offers several satisfiable
        options (e.g. Passport OR Driving Licence); the citizen picks which option
        to provide. There is deliberately NO auto-pick when several options match
        (FR edge case) — the choice is always the citizen's.
*@
@using Sorcha.UI.Core.Models.Presentation

@if (SetChoice is not null)
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">Choose which credential to provide</MudText>
    @if (!string.IsNullOrWhiteSpace(SetChoice.Purpose))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">@SetChoice.Purpose</MudText>
    }
    <MudList T="int" SelectedValueChanged="HandleOptionSelected">
        @for (var i = 0; i < SetChoice.SatisfiableOptions.Count; i++)
        {
            var index = i;
            var option = SetChoice.SatisfiableOptions[index];
            <MudListItem T="int" Value="index" data-testid="credential-picker-option">
                <strong>@OptionLabel(option)</strong>
            </MudListItem>
        }
    </MudList>
    <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="OnCancel">Cancel</MudButton>
}
else
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">Choose a credential</MudText>
    <MudList T="CredentialMatch" SelectedValueChanged="HandleSelected">
        @foreach (var m in Matches)
        {
            <MudListItem T="CredentialMatch" Value="m" data-testid="credential-picker-candidate">
                <strong>@(m.Credential.DisplayLabel ?? m.Credential.Vct)</strong>
                <MudText Typo="Typo.caption">id: @m.Credential.Id</MudText>
            </MudListItem>
        }
    </MudList>
    <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="OnCancel">Cancel</MudButton>
}

@code {
    /// <summary>Candidate matches from the presentation engine (candidate mode).</summary>
    [Parameter] public IReadOnlyList<CredentialMatch> Matches { get; set; } = [];

    /// <summary>Invoked with the citizen's candidate selection (candidate mode).</summary>
    [Parameter] public EventCallback<CredentialMatch> OnChosen { get; set; }

    /// <summary>
    /// Feature 181 US2 — the alternative set to choose from (alternative mode). When non-null the
    /// dialog offers each satisfiable option and ignores <see cref="Matches"/>.
    /// </summary>
    [Parameter] public DcqlSetChoice? SetChoice { get; set; }

    /// <summary>
    /// Feature 181 US2 — per-query matches used to render human labels for option query ids.
    /// </summary>
    [Parameter] public IReadOnlyList<DcqlQueryMatch>? PerQuery { get; set; }

    /// <summary>
    /// Feature 181 US2 — invoked with the query ids that make up the citizen's chosen option
    /// (alternative mode).
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> OnOptionChosen { get; set; }

    /// <summary>Invoked when the citizen backs out.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSelected(CredentialMatch? match)
    {
        if (match is null) return;
        await OnChosen.InvokeAsync(match);
    }

    private async Task HandleOptionSelected(int index)
    {
        if (SetChoice is null || index < 0 || index >= SetChoice.SatisfiableOptions.Count) return;
        await OnOptionChosen.InvokeAsync(SetChoice.SatisfiableOptions[index]);
    }

    /// <summary>Render an option (a set of query ids) as a "A + B" label using the per-query vct values.</summary>
    private string OptionLabel(IReadOnlyList<string> option)
        => string.Join(" + ", option.Select(id =>
            PerQuery?.FirstOrDefault(q => q.QueryId == id)?.Vct ?? id));
}
