    Feature 141 — the hero action button used on the wallet Home action pair.
    Two variants: Primary (brand-gradient fill) and Ghost (surface fill).
    Tall, icon-prominent, with a title + subtitle. Press feedback is driven
    by pointer events (scale .97) rather than CSS :active, which iOS PWAs eat
    inconsistently (handoff note 6). Disabled drops to opacity .72 with no
    press and no activation. Design: docs/mockups/design_handoff_wallet_home/.
*@
@namespace Sorcha.UI.Core.Components.Wallet

<button type="button"
        class="@RootClass"
        disabled="@Disabled"
        aria-label="@AccessibleName"
        data-testid="@TestIdResolved"
        @onclick="HandleClickAsync"
        @onpointerdown="OnPressStart"
        @onpointerup="OnPressEnd"
        @onpointercancel="OnPressEnd"
        @onpointerleave="OnPressEnd">
    <span class="big-action__chip">
        <MudIcon Icon="@Icon" Size="Size.Medium" />
    </span>
    <span class="big-action__text">
        <span class="big-action__title">@Title</span>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <span class="big-action__subtitle">@Subtitle</span>
        }
    </span>
</button>

@code {
    /// <summary>Visual variant: <see cref="BigActionKind.Primary"/> (gradient) or <see cref="BigActionKind.Ghost"/> (surface).</summary>
    [Parameter, EditorRequired] public BigActionKind Kind { get; set; }

    /// <summary>MudBlazor icon (SVG path) shown in the top icon chip.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    /// <summary>Bold action title (e.g. "Present").</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Dimmed one-line subtitle under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>When true the button is visually de-emphasised and does not activate.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Dark-mode styling (non-palette shadows/borders). Host passes IThemeService.IsDarkMode.</summary>
    [Parameter] public bool Dark { get; set; }

    /// <summary>Fired on click/tap when not disabled.</summary>
    [Parameter] public EventCallback OnActivated { get; set; }

    /// <summary>Stable test id; defaults from the title.</summary>
    [Parameter] public string? TestId { get; set; }

    private bool _pressed;

    private string TestIdResolved => TestId ?? $"big-action-{Title.ToLowerInvariant()}";

    private string AccessibleName =>
        string.IsNullOrWhiteSpace(Subtitle) ? Title : $"{Title}. {Subtitle}";

    private string RootClass =>
        $"big-action big-action--{(Kind == BigActionKind.Primary ? "primary" : "ghost")}"
        + (Dark ? " big-action--dark" : "")
        + (_pressed && !Disabled ? " big-action--pressed" : "");

    private async Task HandleClickAsync()
    {
        if (Disabled) return;
        if (OnActivated.HasDelegate) await OnActivated.InvokeAsync();
    }

    private void OnPressStart() { if (!Disabled) _pressed = true; }
    private void OnPressEnd() => _pressed = false;
}
