@namespace Sorcha.UI.Core.Components.Wallet

@using MudBlazor
@using System.Net.Http.Json
@using Sorcha.UI.Core.Extensions
@inject HttpClient Http
@inject Sorcha.UI.Core.Services.User.Verification.IVerificationBundleClient BundleClient
@inject IJSRuntime JS

@if (!string.IsNullOrEmpty(ReceiptId))
{
    <MudCard Outlined="true" Class="mt-3">
        <MudCardContent>
            <MudText Typo="Typo.subtitle2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Class="mr-1" />
                Receipt Proof
            </MudText>
            <MudSimpleTable Dense="true" Hover="true" Class="mb-3">
                <tbody>
                    <tr>
                        <td><strong>Receipt ID</strong></td>
                        <td><code style="font-size: 0.8rem; word-break: break-all;">@ReceiptId</code></td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            @if (_verificationResult is not null)
            {
                <MudAlert Severity="@(_verificationResult.Value ? Severity.Success : Severity.Error)" Class="mb-2" Dense="true">
                    @(_verificationResult.Value ? "Receipt verified successfully." : "Receipt verification failed.")
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Verified"
                           Disabled="@(_isVerifying || string.IsNullOrEmpty(RegisterId))"
                           OnClick="VerifyReceiptAsync">
                    @if (_isVerifying)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Verify Receipt
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@(_isDownloading || string.IsNullOrEmpty(RegisterId) || string.IsNullOrEmpty(TransactionId))"
                           OnClick="DownloadBundleAsync">
                    @if (_isDownloading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Download Bundle
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>
}

@code {
    /// <summary>
    /// Receipt identifier for the transaction.
    /// </summary>
    [Parameter]
    public string? ReceiptId { get; set; }

    /// <summary>
    /// Register identifier containing the transaction.
    /// </summary>
    [Parameter]
    public string? RegisterId { get; set; }

    /// <summary>
    /// Transaction identifier for verification bundle download.
    /// </summary>
    [Parameter]
    public string? TransactionId { get; set; }

    private bool _isVerifying;
    private bool _isDownloading;
    private bool? _verificationResult;
    private string? _errorMessage;

    /// <summary>
    /// Verifies the receipt by calling the Register Service receipts/verify endpoint.
    /// </summary>
    private async Task VerifyReceiptAsync()
    {
        _isVerifying = true;
        _verificationResult = null;
        _errorMessage = null;

        try
        {
            var url = $"/api/register/registers/{Uri.EscapeDataString(RegisterId!)}/receipts/verify";
            var payload = new { receiptId = ReceiptId };
            var response = await Http.PostAsJsonAsync(url, payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ReceiptVerifyResult>(JsonDefaults.Api);
                _verificationResult = result?.Valid ?? false;
            }
            else
            {
                _errorMessage = $"Verification request failed (HTTP {(int)response.StatusCode}). The Register Service may be unavailable.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the Register Service for receipt verification.";
        }
        finally
        {
            _isVerifying = false;
        }
    }

    /// <summary>
    /// Downloads the verification bundle as a JSON file via browser download.
    /// </summary>
    private async Task DownloadBundleAsync()
    {
        _isDownloading = true;
        _errorMessage = null;

        try
        {
            // Issue #1311 — through a bearer-carrying typed client. This used the ambient
            // HttpClient (no Authorization header) while the endpoint requires CanReadTransactions,
            // so it 401'd and reported the failure as "the Register Service may be unavailable" —
            // blaming availability for an auth problem. The verify POST above deliberately stays on
            // the ambient client: that endpoint IS AllowAnonymous, by design.
            var content = await BundleClient.DownloadAsync(RegisterId!, TransactionId!);

            if (content is not null)
            {
                var fileName = $"verification-bundle-{TransactionId![..8]}.json";
                await JS.InvokeVoidAsync("downloadFile", fileName, "application/json", content);
            }
            else
            {
                _errorMessage = "Bundle download failed. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the Register Service for bundle download.";
        }
        finally
        {
            _isDownloading = false;
        }
    }

    /// <summary>
    /// Response model for receipt verification.
    /// </summary>
    private record ReceiptVerifyResult
    {
        public bool Valid { get; init; }
    }
}
