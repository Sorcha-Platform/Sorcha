@namespace Sorcha.UI.Core.Components.Persona

@using Microsoft.Extensions.Logging
@using Sorcha.Tenant.Models.Persona
@using Sorcha.UI.Core.Models.Persona
@using Sorcha.UI.Core.Services.Feedback
@using Sorcha.UI.Core.Services.Persona

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
        My Profile
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-2">
        Saved once, filled everywhere. Your profile is encrypted at rest and only ever
        used to autofill forms you open — nothing is shared with anyone else.
    </MudText>

    @* Issue #1271: PersonaAttribute carries Source/VerifiedBy and nothing rendered them, so a
       citizen could not tell a value they typed from one backed by a credential. That is not
       cosmetic — UT-001 was a wrongful rejection caused by exactly this confusion between a
       self-asserted profile value and a verified ACCOUNT claim. The statement is derived from the
       provenance actually loaded rather than hardcoded, so it starts telling the truth about
       credential-backed values the moment any exist rather than needing to be remembered. *@
    @if (_provenanceSummary is not null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4"
                 data-testid="persona-provenance-summary">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" Class="mr-1" />
            @_provenanceSummary
        </MudText>
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@_loadError</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-8" />
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.h6">Autofill forms from my profile</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        When on, matching fields on any form are filled automatically the first
                        time you open it. You can always edit or clear the values.
                    </MudText>
                </div>
                <MudSwitch T="bool" @bind-Value="_autofillEnabled" Color="Color.Primary"
                           Class="ml-4" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">Identity</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_givenName" Label="Given name"
                                  Variant="Variant.Outlined" data-testid="persona-given-name" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_familyName" Label="Family name"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_fullName" Label="Full name (optional fallback)"
                                  Variant="Variant.Outlined"
                                  HelperText="Only used by autofill if given and family name are both blank." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_dateOfBirth" Label="Date of birth"
                                   Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Email addresses</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined"
                           Color="Color.Primary" Disabled="@(_emails.Count >= MaxListEntries)"
                           OnClick="AddEmail">Add email</MudButton>
            </MudStack>
            @if (_emails.Count >= MaxListEntries)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    You've reached the maximum of @MaxListEntries email entries.
                </MudAlert>
            }
            @for (var i = 0; i < _emails.Count; i++)
            {
                var idx = i;
                var row = _emails[idx];
                <MudGrid Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="6">
                        <MudTextField Value="row.Value" Label="Email"
                                      Variant="Variant.Outlined"
                                      data-testid="@($"persona-email-{idx}")"
                                      ValueChanged="@((string v) => _emails[idx] = row with { Value = v })" />
                    </MudItem>
                    <MudItem xs="8" sm="3">
                        <MudTextField Value="row.Label" Label="Label"
                                      Placeholder="Personal, Work…"
                                      Variant="Variant.Outlined"
                                      ValueChanged="@((string v) => _emails[idx] = row with { Label = string.IsNullOrWhiteSpace(v) ? null : v })" />
                    </MudItem>
                    <MudItem xs="4" sm="2">
                        <MudRadio T="int" Value="idx" Color="Color.Primary"
                                  Checked="@(row.IsDefault)"
                                  CheckedChanged="@((bool _) => SetDefaultEmail(idx))">
                            Default
                        </MudRadio>
                    </MudItem>
                    <MudItem xs="12" sm="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => RemoveEmail(idx))" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Phone numbers</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined"
                           Color="Color.Primary" Disabled="@(_phones.Count >= MaxListEntries)"
                           data-testid="persona-add-phone"
                           OnClick="AddPhone">Add phone</MudButton>
            </MudStack>
            @for (var i = 0; i < _phones.Count; i++)
            {
                var idx = i;
                var row = _phones[idx];
                <MudGrid Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="5">
                        <MudTextField Value="row.Value" Label="Phone (E.164, e.g. +441234567890)"
                                      Variant="Variant.Outlined"
                                      data-testid="@($"persona-phone-{idx}")"
                                      ValueChanged="@((string v) => _phones[idx] = row with { Value = v })" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudSelect T="PersonaPhoneKind?" Value="row.Kind" Label="Kind"
                                   Variant="Variant.Outlined" Clearable="true"
                                   ValueChanged="@((PersonaPhoneKind? v) => _phones[idx] = row with { Kind = v })">
                            <MudSelectItem T="PersonaPhoneKind?" Value="@((PersonaPhoneKind?)PersonaPhoneKind.Mobile)">Mobile</MudSelectItem>
                            <MudSelectItem T="PersonaPhoneKind?" Value="@((PersonaPhoneKind?)PersonaPhoneKind.Home)">Home</MudSelectItem>
                            <MudSelectItem T="PersonaPhoneKind?" Value="@((PersonaPhoneKind?)PersonaPhoneKind.Work)">Work</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudTextField Value="row.Label" Label="Label"
                                      Variant="Variant.Outlined"
                                      ValueChanged="@((string v) => _phones[idx] = row with { Label = string.IsNullOrWhiteSpace(v) ? null : v })" />
                    </MudItem>
                    <MudItem xs="8" sm="2">
                        <MudRadio T="int" Value="idx" Color="Color.Primary"
                                  Checked="@(row.IsDefault)"
                                  CheckedChanged="@((bool _) => SetDefaultPhone(idx))">
                            Default
                        </MudRadio>
                    </MudItem>
                    <MudItem xs="4" sm="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => RemovePhone(idx))" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Addresses</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined"
                           Color="Color.Primary" Disabled="@(_addresses.Count >= MaxListEntries)"
                           OnClick="AddAddress">Add address</MudButton>
            </MudStack>
            @for (var i = 0; i < _addresses.Count; i++)
            {
                var idx = i;
                var row = _addresses[idx];
                <MudPaper Outlined="true" Class="pa-3 mb-2">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="row.Line1" Label="Line 1" Variant="Variant.Outlined"
                                          ValueChanged="@((string v) => _addresses[idx] = row with { Line1 = v })" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="row.Line2" Label="Line 2 (optional)" Variant="Variant.Outlined"
                                          ValueChanged="@((string v) => _addresses[idx] = row with { Line2 = string.IsNullOrWhiteSpace(v) ? null : v })" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="row.City" Label="City" Variant="Variant.Outlined"
                                          ValueChanged="@((string v) => _addresses[idx] = row with { City = v })" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="row.Region" Label="Region / state (optional)" Variant="Variant.Outlined"
                                          ValueChanged="@((string v) => _addresses[idx] = row with { Region = string.IsNullOrWhiteSpace(v) ? null : v })" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Value="row.PostalCode" Label="Postal code" Variant="Variant.Outlined"
                                          ValueChanged="@((string v) => _addresses[idx] = row with { PostalCode = v })" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Value="row.Country" Label="Country (ISO 3166-1 alpha-2)"
                                          Variant="Variant.Outlined" MaxLength="2"
                                          ValueChanged="@((string v) => _addresses[idx] = row with { Country = (v ?? string.Empty).ToUpperInvariant() })" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Value="row.Label" Label="Label (Home, Work…)"
                                          Variant="Variant.Outlined"
                                          ValueChanged="@((string v) => _addresses[idx] = row with { Label = string.IsNullOrWhiteSpace(v) ? null : v })" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudRadio T="int" Value="idx" Color="Color.Primary"
                                          Checked="@(row.IsDefault)"
                                          CheckedChanged="@((bool _) => SetDefaultAddress(idx))">
                                    Default address
                                </MudRadio>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveAddress(idx))" />
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">Nationalities</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                ISO 3166-1 alpha-2 codes (e.g. GB, IE, US). Up to @MaxListEntries.
            </MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                <MudTextField @bind-Value="_newNationality" Label="Add nationality"
                              Variant="Variant.Outlined" MaxLength="2" Style="max-width: 200px;" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           OnClick="AddNationality" Disabled="@(_nationalities.Count >= MaxListEntries)">
                    Add
                </MudButton>
            </MudStack>
            @if (_nationalities.Count > 0)
            {
                <MudChipSet T="string" SelectedValue="@_defaultNationality"
                            SelectedValueChanged="@((string? v) => _defaultNationality = v)"
                            SelectionMode="SelectionMode.SingleSelection">
                    @foreach (var nat in _nationalities)
                    {
                        var natCode = nat;
                        <MudChip T="string" Value="@natCode" Color="Color.Primary"
                                 OnClose="@(() => RemoveNationality(natCode))">
                            @natCode
                        </MudChip>
                    }
                </MudChipSet>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    Click a chip to mark it as your default nationality for autofill.
                </MudText>
            }
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mb-8">
            <MudButton Variant="Variant.Text" Color="Color.Error"
                       OnClick="HandleDelete" Disabled="@_saving">
                Delete profile
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       data-testid="persona-save-button"
                       OnClick="HandleSave" Disabled="@_saving">
                @(_saving ? "Saving…" : "Save profile")
            </MudButton>
        </MudStack>
    }
</MudContainer>

@code {
    private const int MaxListEntries = 5;

    /// <summary>Persona read/write service. Fetches on load; accepts save and delete commands.</summary>
    [Inject] private IPersonaService PersonaService { get; set; } = default!;

    /// <summary>Inline feedback surface for save/delete outcomes and validation warnings.</summary>
    [Inject] private IInlineFeedback Feedback { get; set; } = default!;

    /// <summary>Structured logger for load and save diagnostics.</summary>
    [Inject] private ILogger<PersonaEditor> Logger { get; set; } = default!;

    private bool _loading = true;
    private bool _saving;
    private string? _loadError;

    private bool _autofillEnabled = true;
    private string? _givenName;
    private string? _familyName;
    private string? _fullName;
    private DateTime? _dateOfBirth;

    private readonly List<PersonaEmail> _emails = new();
    private readonly List<PersonaPhone> _phones = new();
    private readonly List<PersonaAddress> _addresses = new();
    private readonly List<string> _nationalities = new();
    private string? _defaultNationality;
    private string? _newNationality;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _autofillEnabled = await PersonaService.GetAutofillEnabledAsync();
            var persona = await PersonaService.GetAsync();
            HydrateFromRead(persona);
        }
        catch (PersonaWalletNotProvisionedException)
        {
            _loadError = "Your account doesn't have a wallet yet, so profile changes can't be saved. Set up a wallet first, then come back.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load persona");
            _loadError = "We couldn't load your profile. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Issue #1271 — one sentence naming where the values on this page came from, derived from the
    /// attributes actually loaded. Null when the profile is empty, so a blank page makes no claim.
    /// </summary>
    private string? _provenanceSummary;

    private void BuildProvenanceSummary(PersonaReadModelV1 read)
    {
        var verified = new List<string>();
        var anySelfAsserted = false;

        void Note(PersonaAttributeSource source, string? verifiedBy)
        {
            if (source == PersonaAttributeSource.VerifiedCredential)
            {
                verified.Add(PersonaProvenance.Describe(source, verifiedBy));
            }
            else
            {
                anySelfAsserted = true;
            }
        }

        if (read.GivenName is { } gn) Note(gn.Source, gn.VerifiedBy);
        if (read.FamilyName is { } fn) Note(fn.Source, fn.VerifiedBy);
        if (read.FullName is { } full) Note(full.Source, full.VerifiedBy);
        if (read.DateOfBirth is { } dob) Note(dob.Source, dob.VerifiedBy);
        if (read.DefaultEmail is { } de) Note(de.Source, de.VerifiedBy);
        if (read.DefaultPhone is { } dp) Note(dp.Source, dp.VerifiedBy);
        if (read.DefaultAddress is { } da) Note(da.Source, da.VerifiedBy);

        if (!anySelfAsserted && verified.Count == 0)
        {
            _provenanceSummary = null;
            return;
        }

        _provenanceSummary = verified.Count == 0
            ? "You entered everything here yourself. Sorcha hasn't checked any of it — "
              + "that's separate from your verified account details."
            : $"Mostly entered by you. {string.Join("; ", verified.Distinct())}.";
    }

    private void HydrateFromRead(PersonaReadModelV1 read)
    {
        BuildProvenanceSummary(read);
        _givenName = read.GivenName?.Value;
        _familyName = read.FamilyName?.Value;
        _fullName = read.FullName?.Value;
        _dateOfBirth = read.DateOfBirth?.Value.ToDateTime(TimeOnly.MinValue);

        _emails.Clear();
        _emails.AddRange(read.AllEmails);
        _phones.Clear();
        _phones.AddRange(read.AllPhones);
        _addresses.Clear();
        _addresses.AddRange(read.AllAddresses);

        // Issue #1271: the read model does not promise that any row is flagged default, so a citizen
        // with exactly ONE email saw a Default radio with nothing selected — which reads as a broken
        // control, not as a meaningful state. Normalised at hydrate rather than at render so the
        // value shown selected is the value that gets saved.
        PersonaDefaultSelection.EnsureOne(_emails, r => r.IsDefault, (r, d) => r with { IsDefault = d });
        PersonaDefaultSelection.EnsureOne(_phones, r => r.IsDefault, (r, d) => r with { IsDefault = d });
        PersonaDefaultSelection.EnsureOne(_addresses, r => r.IsDefault, (r, d) => r with { IsDefault = d });

        _nationalities.Clear();
        _nationalities.AddRange(read.AllNationalities);
        _defaultNationality = read.DefaultNationality?.Value ?? _nationalities.FirstOrDefault();
    }

    // ---- List mutators ----

    private void AddEmail()
    {
        if (_emails.Count >= MaxListEntries) return;
        _emails.Add(new PersonaEmail(string.Empty, _emails.Count == 0));
    }

    private void RemoveEmail(int idx)
    {
        if (idx < 0 || idx >= _emails.Count) return;
        var wasDefault = _emails[idx].IsDefault;
        _emails.RemoveAt(idx);
        if (wasDefault && _emails.Count > 0)
        {
            _emails[0] = _emails[0] with { IsDefault = true };
        }
    }

    private void SetDefaultEmail(int idx)
    {
        for (int i = 0; i < _emails.Count; i++)
        {
            _emails[i] = _emails[i] with { IsDefault = i == idx };
        }
    }

    private void AddPhone()
    {
        if (_phones.Count >= MaxListEntries) return;
        _phones.Add(new PersonaPhone(string.Empty, _phones.Count == 0));
    }

    private void RemovePhone(int idx)
    {
        if (idx < 0 || idx >= _phones.Count) return;
        var wasDefault = _phones[idx].IsDefault;
        _phones.RemoveAt(idx);
        if (wasDefault && _phones.Count > 0)
        {
            _phones[0] = _phones[0] with { IsDefault = true };
        }
    }

    private void SetDefaultPhone(int idx)
    {
        for (int i = 0; i < _phones.Count; i++)
        {
            _phones[i] = _phones[i] with { IsDefault = i == idx };
        }
    }

    private void AddAddress()
    {
        if (_addresses.Count >= MaxListEntries) return;
        _addresses.Add(new PersonaAddress(
            Line1: string.Empty,
            Line2: null,
            City: string.Empty,
            Region: null,
            PostalCode: string.Empty,
            Country: string.Empty,
            IsDefault: _addresses.Count == 0));
    }

    private void RemoveAddress(int idx)
    {
        if (idx < 0 || idx >= _addresses.Count) return;
        var wasDefault = _addresses[idx].IsDefault;
        _addresses.RemoveAt(idx);
        if (wasDefault && _addresses.Count > 0)
        {
            _addresses[0] = _addresses[0] with { IsDefault = true };
        }
    }

    private void SetDefaultAddress(int idx)
    {
        for (int i = 0; i < _addresses.Count; i++)
        {
            _addresses[i] = _addresses[i] with { IsDefault = i == idx };
        }
    }

    private void AddNationality()
    {
        if (_nationalities.Count >= MaxListEntries) return;
        if (string.IsNullOrWhiteSpace(_newNationality)) return;

        var code = _newNationality.Trim().ToUpperInvariant();
        if (code.Length != 2 || !code.All(char.IsLetter))
        {
            Feedback.ShowWarning("Nationality must be a 2-letter ISO 3166-1 alpha-2 code.");
            return;
        }
        if (_nationalities.Contains(code))
        {
            _newNationality = null;
            return;
        }
        _nationalities.Add(code);
        _defaultNationality ??= code;
        _newNationality = null;
    }

    private void RemoveNationality(string code)
    {
        _nationalities.Remove(code);
        if (_defaultNationality == code)
        {
            _defaultNationality = _nationalities.FirstOrDefault();
        }
    }

    // ---- Save / delete ----

    private async Task HandleSave()
    {
        _saving = true;
        try
        {
            // Promote default nationality to the head of the list so the
            // server — which uses the first entry for the default marker on
            // plain-string lists — treats it as the canonical default.
            var nationalities = _nationalities.ToList();
            if (_defaultNationality is { } d && nationalities.Contains(d))
            {
                nationalities.Remove(d);
                nationalities.Insert(0, d);
            }

            var payload = new PersonaAttributesV1
            {
                GivenName = NullIfBlank(_givenName),
                FamilyName = NullIfBlank(_familyName),
                FullName = NullIfBlank(_fullName),
                DateOfBirth = _dateOfBirth is { } dob ? DateOnly.FromDateTime(dob) : null,
                Emails = _emails.Where(e => !string.IsNullOrWhiteSpace(e.Value)).ToList(),
                Phones = _phones
                    .Where(p => !string.IsNullOrWhiteSpace(p.Value))
                    .Select(p => p with { Value = PhoneNormalizer.ToE164(p.Value) ?? p.Value })
                    .ToList(),
                Addresses = _addresses.Where(a => !string.IsNullOrWhiteSpace(a.Line1)).ToList(),
                Nationalities = nationalities,
            };

            var updated = await PersonaService.UpdateAsync(payload);
            await PersonaService.SetAutofillEnabledAsync(_autofillEnabled);
            HydrateFromRead(updated);
            Feedback.ShowSuccess("Profile saved.");
        }
        catch (PersonaValidationException ex)
        {
            foreach (var (field, errors) in ex.Errors)
            {
                foreach (var err in errors)
                {
                    Feedback.ShowError(PhoneNormalizer.DescribeError(field, err), autoDismissMs: 0);
                }
            }
        }
        catch (PersonaWalletNotProvisionedException)
        {
            Feedback.ShowWarning(
                "Your account doesn't have a wallet yet, so profile changes can't be saved. Set up a wallet first.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save persona");
            Feedback.ShowError("Couldn't save profile. Please try again.", autoDismissMs: 0);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleDelete()
    {
        _saving = true;
        try
        {
            await PersonaService.DeleteAsync();
            HydrateFromRead(new PersonaReadModelV1());
            Feedback.ShowInfo("Profile deleted.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete persona");
            Feedback.ShowError("Couldn't delete profile. Please try again.", autoDismissMs: 0);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? NullIfBlank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
