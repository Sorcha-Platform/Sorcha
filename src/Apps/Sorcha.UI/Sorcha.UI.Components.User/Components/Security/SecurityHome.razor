@*
    The unified Security home (Feature 150) — built once here and rendered verbatim on web
    (/app/security) and the wallet PWA (/wallet/security). Job-based information architecture
    (D3): "How you sign in" / "Two-factor authentication" / "Recovery". Loads the aggregate
    /api/me/auth-methods read and reflects the server's per-row CanRemove / RequiredProofTier /
    AssuranceTier — the UI never decides (FR-008).
*@

@using Sorcha.UI.Core.Models
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Feedback
@using Sorcha.Tenant.Models.Auth
@inject IAuthMethodsClientService AuthMethodsClient
@inject IInlineFeedback Feedback

<MudText Typo="Typo.h4" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-2" />
    Security
</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    Manage how you sign in, your second factor, and account recovery.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
    <MudSkeleton Width="100%" Height="80px" Class="mb-4" />
    <MudSkeleton Width="100%" Height="80px" Class="mb-4" />
}
else if (_methods is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="security-load-failed">
        We couldn't load your security settings.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" OnClick="LoadAsync">Retry</MudButton>
}
else
{
    @* ── Group 1: How you sign in ─────────────────────────────── *@
    <section data-testid="security-group-signin">
        <MudText Typo="Typo.h6" Class="mb-3">How you sign in</MudText>

        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-3" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body1">@_methods.Email</MudText>
                </div>
                <MudChip T="string" Size="Size.Small"
                         Color="@(_methods.EmailVerified ? Color.Success : Color.Warning)"
                         Variant="Variant.Outlined">
                    @(_methods.EmailVerified ? "Verified" : "Unverified")
                </MudChip>
            </div>

            @* Issue #1210 — until now the Unverified chip was the end of the road: the resend
               endpoint had existed (rate-limited, 3/hour) since before any caller, and nothing in the
               web app, the PWA or the Tenant Service's Razor Pages ever invoked it. A user whose
               verification email was lost, expired or filtered had no self-serve recovery, and AIAS
               gates on email_verified, so the dead-end was total.

               It sits here, on a signed-in surface, because the endpoint is authenticated — which
               works only because LoginService does NOT refuse an unverified user, it mints a token
               carrying email_verified: false. An affordance on the anonymous login page could not
               have called it. *@
            @if (!_methods.EmailVerified)
            {
                <div class="d-flex align-center mt-3" data-testid="security-email-unverified">
                    <MudText Typo="Typo.body2" Class="flex-grow-1 mud-text-secondary">
                        Didn't get the verification email? Check your spam folder, or send a new one.
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Disabled="@_resending"
                               OnClick="ResendVerificationAsync"
                               data-testid="security-resend-verification">
                        @(_resending ? "Sending…" : "Resend email")
                    </MudButton>
                </div>
            }
        </MudPaper>

        <PasswordSection Password="_methods.Password"
                         IsBootstrap="@IsBootstrap"
                         OnChanged="LoadAsync" />
        <SocialLinksSection Socials="_methods.Socials" OnChanged="LoadAsync" />
        <PasskeysSection Passkeys="_methods.Passkeys" OnChanged="LoadAsync" />
    </section>

    @* ── Group 2: Two-factor authentication ───────────────────── *@
    <section data-testid="security-group-2fa">
        <MudText Typo="Typo.h6" Class="mb-3 mt-4">Two-factor authentication</MudText>
        <TwoFactorSection EmailEnabled="_methods.EmailOtpEnabled"
                          SmsAvailable="_methods.SmsAvailable"
                          SmsEnabled="_methods.SmsOtpEnabled"
                          OnChanged="LoadAsync" />
    </section>

    @* ── Group 3: Recovery ─────────────────────────────────────── *@
    <section data-testid="security-group-recovery">
        <MudText Typo="Typo.h6" Class="mb-3 mt-4">Recovery</MudText>
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Backup" Class="mr-3" />
                <div class="flex-grow-1">
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudText Typo="Typo.body1">Backup codes</MudText>
                        <AssuranceBadge Tier="AuthAssuranceTier.Basic" />
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        One-time codes generated when you set up your authenticator. Keep them safe.
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </section>
}

@code {
    private AuthMethodsResponse? _methods;
    private bool _loading = true;

    /// <summary>
    /// Bootstrap = no sign-in method yet (no password, no social, no active passkey). In that
    /// state setting a first password skips the step-up (the server bypasses it).
    /// </summary>
    private bool IsBootstrap =>
        _methods is not null
        && !_methods.Password.IsSet
        && _methods.Socials.Count == 0
        && !_methods.Passkeys.Any(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase));

    /// <summary>Issue #1210 — guards the resend button against a double-tap while in flight.</summary>
    private bool _resending;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// Issue #1210 — request a fresh verification email. Feedback is inline per the notification
    /// routing rules (CLAUDE.md §12): this is the actor's own action on the current page, so it is
    /// <see cref="IInlineFeedback"/>, not an inbox entry.
    ///
    /// <para>Rate-limited (429) is reported distinctly from failure. The user has done nothing wrong
    /// and only needs to wait, whereas "couldn't send" invites an immediate retry that would burn
    /// another of the three hourly attempts.</para>
    /// </summary>
    private async Task ResendVerificationAsync()
    {
        _resending = true;
        StateHasChanged();
        try
        {
            var outcome = await AuthMethodsClient.ResendVerificationEmailAsync();
            switch (outcome)
            {
                case ResendVerificationOutcome.Sent:
                    Feedback.ShowSuccess("Verification email sent — check your inbox.");
                    break;
                case ResendVerificationOutcome.RateLimited:
                    Feedback.ShowWarning(
                        "You've requested several verification emails recently. Please wait a while before trying again.",
                        autoDismissMs: 0);
                    break;
                default:
                    Feedback.ShowError("We couldn't send the verification email. Please try again.", autoDismissMs: 0);
                    break;
            }
        }
        finally
        {
            _resending = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _methods = await AuthMethodsClient.GetAuthMethodsAsync();
            if (_methods is null)
            {
                Feedback.ShowError("We couldn't load your security settings.", autoDismissMs: 0);
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
