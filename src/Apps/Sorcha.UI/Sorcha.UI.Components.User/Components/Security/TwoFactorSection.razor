@*
    Two-factor authentication section (Feature 150). US1 ships the Authenticator (TOTP) row —
    enable (QR + verify), disable (step-up gated via AuthChallengeDialog). US2 adds the Email-code
    row and US3 the SMS-code row onto the same surface. Each row carries an AssuranceBadge.
*@

@using Sorcha.UI.Core.Models
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Feedback
@using Sorcha.Tenant.Models.Auth
@inject ITotpClientService TotpService
@inject IAuthMethodsClientService AuthMethodsClient
@inject IDialogService DialogService
@inject IInlineFeedback Feedback

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <div class="d-flex align-center mb-1">
        <MudIcon Icon="@Icons.Material.Filled.Smartphone" Class="mr-3" />
        <div class="flex-grow-1">
            <div class="d-flex align-center" style="gap:8px;">
                <MudText Typo="Typo.h6">Authenticator app</MudText>
                <AssuranceBadge Tier="AuthAssuranceTier.Strong" />
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Time-based one-time codes from an app like Google Authenticator or 1Password.
            </MudText>
        </div>
        @if (_status is null)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        }
        else if (_status.IsEnabled)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">On</MudChip>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="ml-2"
                       Disabled="_busy" OnClick="DisableAsync">
                Turn off
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="_busy" OnClick="BeginSetupAsync">
                Turn on
            </MudButton>
        }
    </div>

    @if (_setup is not null && _status is { IsEnabled: false })
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Scan to set up</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            Scan this code in your authenticator app, or enter the key manually, then enter the
            6-digit code it shows.
        </MudText>
        <MudText Typo="Typo.caption" Class="mb-3">
            Manual key: <code>@_setup.Secret</code>
        </MudText>
        <MudTextField T="string" @bind-Value="_verifyCode"
                      Label="6-digit code" Variant="Variant.Outlined" Margin="Margin.Dense"
                      MaxLength="6" InputMode="InputMode.numeric" Immediate="true"
                      Style="max-width: 220px;" Disabled="_busy" />
        <div class="mt-2 d-flex align-center" style="gap:8px;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(_busy || _verifyCode.Length != 6 || !_verifyCode.All(char.IsDigit))"
                       OnClick="VerifyAsync">
                Verify and enable
            </MudButton>
            <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="CancelSetup">Cancel</MudButton>
        </div>

        @if (_setup.BackupCodes.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                Save these one-time backup codes somewhere safe — they let you sign in if you lose
                your device:
            </MudAlert>
            <MudPaper Class="pa-3 mt-2" Outlined="true" Style="max-width: 260px;">
                @foreach (var backupCode in _setup.BackupCodes)
                {
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@backupCode</MudText>
                }
            </MudPaper>
        }
    }
</MudPaper>

@* ── Email one-time codes (Feature 150 US2) ─────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <div class="d-flex align-center mb-1">
        <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-3" />
        <div class="flex-grow-1">
            <div class="d-flex align-center" style="gap:8px;">
                <MudText Typo="Typo.h6">Email code</MudText>
                <AssuranceBadge Tier="AuthAssuranceTier.Basic" />
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                A one-time code sent to your email. Lower assurance — handy if you don't use an
                authenticator app.
            </MudText>
        </div>
        @if (EmailEnabled)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">On</MudChip>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="ml-2"
                       Disabled="_emailBusy" OnClick="DisableEmailAsync">
                Turn off
            </MudButton>
        }
        else if (_emailVerifying)
        {
            <MudButton Variant="Variant.Text" Disabled="_emailBusy" OnClick="CancelEmailSetup">Cancel</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="_emailBusy" OnClick="BeginEmailSetupAsync">
                Turn on
            </MudButton>
        }
    </div>

    @if (_emailVerifying && !EmailEnabled)
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            We've sent a 6-digit code to your email. Enter it to turn on email codes.
        </MudText>
        <MudTextField T="string" @bind-Value="_emailCode"
                      Label="6-digit code" Variant="Variant.Outlined" Margin="Margin.Dense"
                      MaxLength="6" InputMode="InputMode.numeric" Immediate="true"
                      Style="max-width: 220px;" Disabled="_emailBusy" />
        <div class="mt-2 d-flex align-center" style="gap:8px;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(_emailBusy || _emailCode.Length != 6 || !_emailCode.All(char.IsDigit))"
                       OnClick="VerifyEmailAsync">
                Verify and enable
            </MudButton>
            <MudButton Variant="Variant.Text" Disabled="_emailBusy" OnClick="ResendEmailAsync">Resend</MudButton>
        </div>
    }
</MudPaper>

@* ── SMS one-time codes (Feature 150 US3, config-gated — hidden when unavailable) ── *@
@if (SmsAvailable)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true" data-testid="sms-2fa-row">
        <div class="d-flex align-center mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Sms" Class="mr-3" />
            <div class="flex-grow-1">
                <div class="d-flex align-center" style="gap:8px;">
                    <MudText Typo="Typo.h6">SMS code</MudText>
                    <AssuranceBadge Tier="AuthAssuranceTier.Basic" />
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    A one-time code texted to your mobile. Lower assurance.
                </MudText>
            </div>
            @if (SmsEnabled)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">On</MudChip>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="ml-2"
                           Disabled="_smsBusy" OnClick="DisableSmsAsync">Turn off</MudButton>
            }
            else if (!_smsCapturing)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           Disabled="_smsBusy" OnClick="@(() => _smsCapturing = true)">Turn on</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text" Disabled="_smsBusy" OnClick="CancelSmsSetup">Cancel</MudButton>
            }
        </div>

        @if (_smsCapturing && !SmsEnabled)
        {
            <MudDivider Class="my-3" />
            @if (!_smsCodeSent)
            {
                <MudTextField T="string" @bind-Value="_smsPhone"
                              Label="Mobile number (e.g. +14155550123)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="max-width: 280px;" Disabled="_smsBusy" />
                <div class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(_smsBusy || string.IsNullOrWhiteSpace(_smsPhone))"
                               OnClick="CaptureSmsAsync">Send code</MudButton>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Enter the code we texted to @_smsPhone.
                </MudText>
                <MudTextField T="string" @bind-Value="_smsCode"
                              Label="6-digit code" Variant="Variant.Outlined" Margin="Margin.Dense"
                              MaxLength="6" InputMode="InputMode.numeric" Immediate="true"
                              Style="max-width: 220px;" Disabled="_smsBusy" />
                <div class="mt-2 d-flex align-center" style="gap:8px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(_smsBusy || _smsCode.Length != 6 || !_smsCode.All(char.IsDigit))"
                               OnClick="VerifySmsAsync">Verify and enable</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="_smsBusy" OnClick="CaptureSmsAsync">Resend</MudButton>
                </div>
            }
        }
    </MudPaper>
}

@code {
    /// <summary>Invoked after enable / disable so the parent can refresh assurance state.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Whether emailed one-time codes are currently enabled (from the aggregate read).</summary>
    [Parameter] public bool EmailEnabled { get; set; }

    /// <summary>Whether an SMS provider is configured on this installation (US3). Hides the row when false.</summary>
    [Parameter] public bool SmsAvailable { get; set; }

    /// <summary>Whether SMS one-time codes are currently enabled.</summary>
    [Parameter] public bool SmsEnabled { get; set; }

    private TotpStatusResponse? _status;
    private TotpSetupResponse? _setup;
    private string _verifyCode = string.Empty;
    private bool _busy;

    private bool _emailVerifying;
    private string _emailCode = string.Empty;
    private bool _emailBusy;

    private bool _smsCapturing;
    private bool _smsCodeSent;
    private string _smsPhone = string.Empty;
    private string _smsCode = string.Empty;
    private bool _smsBusy;

    protected override async Task OnInitializedAsync() => await RefreshStatusAsync();

    private async Task RefreshStatusAsync()
    {
        _status = await TotpService.GetStatusAsync();
        StateHasChanged();
    }

    private async Task BeginSetupAsync()
    {
        _busy = true;
        StateHasChanged();
        try
        {
            _setup = await TotpService.SetupTotpAsync();
            if (_setup is null) Feedback.ShowError("Couldn't start authenticator setup. Try again.", autoDismissMs: 0);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void CancelSetup()
    {
        _setup = null;
        _verifyCode = string.Empty;
    }

    private async Task VerifyAsync()
    {
        _busy = true;
        StateHasChanged();
        try
        {
            var ok = await TotpService.VerifySetupAsync(_verifyCode);
            if (ok)
            {
                Feedback.ShowSuccess("Authenticator enabled.");
                _setup = null;
                _verifyCode = string.Empty;
                await RefreshStatusAsync();
                if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
            }
            else
            {
                Feedback.ShowError("That code didn't match. Try again.");
                _verifyCode = string.Empty;
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ---- Email one-time codes (US2) ----

    private async Task BeginEmailSetupAsync()
    {
        _emailBusy = true;
        StateHasChanged();
        try
        {
            if (await AuthMethodsClient.EnableEmailOtpAsync())
            {
                _emailVerifying = true;
                _emailCode = string.Empty;
                Feedback.ShowInfo("We've emailed you a code.");
            }
            else
            {
                Feedback.ShowError("Couldn't send the email code. Try again shortly.", autoDismissMs: 0);
            }
        }
        finally
        {
            _emailBusy = false;
            StateHasChanged();
        }
    }

    private async Task ResendEmailAsync() => await BeginEmailSetupAsync();

    private void CancelEmailSetup()
    {
        _emailVerifying = false;
        _emailCode = string.Empty;
    }

    private async Task VerifyEmailAsync()
    {
        _emailBusy = true;
        StateHasChanged();
        try
        {
            var outcome = await AuthMethodsClient.VerifyEmailOtpAsync(_emailCode);
            switch (outcome)
            {
                case OtpMutationOutcome.Succeeded:
                    Feedback.ShowSuccess("Email codes enabled.");
                    _emailVerifying = false;
                    _emailCode = string.Empty;
                    EmailEnabled = true;
                    if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
                    break;
                case OtpMutationOutcome.Invalid:
                    Feedback.ShowError("That code didn't match. Try again.");
                    _emailCode = string.Empty;
                    break;
                case OtpMutationOutcome.Expired:
                    Feedback.ShowError("That code expired — send a new one.", autoDismissMs: 0);
                    _emailCode = string.Empty;
                    break;
                case OtpMutationOutcome.RateLimited:
                    Feedback.ShowWarning("Too many attempts. Wait a moment and request a new code.");
                    break;
                default:
                    Feedback.ShowError("Couldn't verify the code. Try again.");
                    break;
            }
        }
        finally
        {
            _emailBusy = false;
            StateHasChanged();
        }
    }

    private async Task DisableEmailAsync()
    {
        _emailBusy = true;
        StateHasChanged();
        try
        {
            if (await AuthMethodsClient.DisableEmailOtpAsync())
            {
                Feedback.ShowSuccess("Email codes turned off.");
                EmailEnabled = false;
                if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
            }
            else
            {
                Feedback.ShowError("Couldn't turn off email codes. Try again.");
            }
        }
        finally
        {
            _emailBusy = false;
            StateHasChanged();
        }
    }

    // ---- SMS one-time codes (US3) ----

    private void CancelSmsSetup()
    {
        _smsCapturing = false; _smsCodeSent = false; _smsPhone = string.Empty; _smsCode = string.Empty;
    }

    private async Task CaptureSmsAsync()
    {
        _smsBusy = true; StateHasChanged();
        try
        {
            if (await AuthMethodsClient.CaptureSmsPhoneAsync(_smsPhone.Trim()))
            {
                _smsCodeSent = true; _smsCode = string.Empty;
                Feedback.ShowInfo("We've texted you a code.");
            }
            else { Feedback.ShowError("Couldn't send the SMS. Check the number and try again.", autoDismissMs: 0); }
        }
        finally { _smsBusy = false; StateHasChanged(); }
    }

    private async Task VerifySmsAsync()
    {
        _smsBusy = true; StateHasChanged();
        try
        {
            var outcome = await AuthMethodsClient.VerifySmsPhoneAsync(_smsCode);
            if (outcome == OtpMutationOutcome.Succeeded)
            {
                if (await AuthMethodsClient.EnableSmsOtpAsync())
                {
                    Feedback.ShowSuccess("SMS codes enabled.");
                    CancelSmsSetup(); SmsEnabled = true;
                    if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
                }
                else { Feedback.ShowError("Number verified, but couldn't enable SMS. Try again."); }
            }
            else if (outcome == OtpMutationOutcome.Invalid) { Feedback.ShowError("That code didn't match. Try again."); _smsCode = string.Empty; }
            else { Feedback.ShowError("That code expired — send a new one.", autoDismissMs: 0); _smsCode = string.Empty; }
        }
        finally { _smsBusy = false; StateHasChanged(); }
    }

    private async Task DisableSmsAsync()
    {
        _smsBusy = true; StateHasChanged();
        try
        {
            if (await AuthMethodsClient.DisableSmsOtpAsync())
            {
                Feedback.ShowSuccess("SMS codes turned off."); SmsEnabled = false;
                if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
            }
            else { Feedback.ShowError("Couldn't turn off SMS codes. Try again."); }
        }
        finally { _smsBusy = false; StateHasChanged(); }
    }

    private async Task DisableAsync()
    {
        // Disabling 2FA is a Strong-tier operation — step-up first.
        var parameters = new DialogParameters { ["Scope"] = ScopedOperation.Disable2Fa };
        var dialog = await DialogService.ShowAsync<AuthChallengeDialog>("Confirm it's you", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string token) return;

        _busy = true;
        StateHasChanged();
        try
        {
            var ok = await TotpService.DisableTotpAsync(token);
            if (ok)
            {
                Feedback.ShowSuccess("Authenticator turned off.");
                await RefreshStatusAsync();
                if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
            }
            else
            {
                Feedback.ShowError("Couldn't turn off the authenticator. Try again.");
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }
}
