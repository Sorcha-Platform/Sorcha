@* Password section for the Accounts tab + Security tab (Feature 116).
   US4 shipped the read-only render; US3 wires Set / Change / Remove.

   Set: bootstrap path (zero other methods) skips AuthChallengeDialog —
        server bypasses the challenge in that case. Otherwise step-up
        first, then enter new password, then submit.
   Change: step-up first, then enter new password, then submit.
   Remove: step-up only (no new password input). *@

@using MudBlazor
@using Sorcha.UI.Core.Models
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Feedback
@using Sorcha.Tenant.Models.Auth
@inject ILocalizationService Loc
@inject IAuthMethodsClientService AuthMethodsClient
@inject IDialogService DialogService
@inject IInlineFeedback Feedback

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <div class="d-flex align-center mb-1" style="gap:8px;">
        <MudText Typo="Typo.h6">
            @Loc.T("settings.accounts.password.title")
        </MudText>
        @if (Password is not null && Password.IsSet)
        {
            <AssuranceBadge Tier="Password.AssuranceTier" />
        }
    </div>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        @Loc.T("settings.accounts.password.description")
    </MudText>

    @if (Password is null)
    {
        <MudSkeleton Width="200px" Height="24px" />
    }
    else if (Password.IsSet)
    {
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Success" Class="mr-2" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1">
                    @Loc.T("settings.accounts.password.set")
                </MudText>
                @if (Password.LastChangedAt.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Loc.T("settings.accounts.password.lastChanged"):
                        @Password.LastChangedAt.Value.ToLocalTime().ToString("d MMM yyyy")
                    </MudText>
                }
            </div>
            <MudButton Variant="Variant.Outlined" Class="mr-2"
                       Disabled="@(_busy || _mode is not null)"
                       OnClick="BeginChange">
                @Loc.T("settings.accounts.password.change")
            </MudButton>
            @if (Password.CanRemove)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           Disabled="@(_busy || _mode is not null)"
                           OnClick="RemoveAsync">
                    @Loc.T("settings.accounts.password.remove")
                </MudButton>
            }
            else
            {
                <MudTooltip Text="@Loc.T("settings.accounts.lastMethodWarning")">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="true">
                        @Loc.T("settings.accounts.password.remove")
                    </MudButton>
                </MudTooltip>
            }
        </div>
    }
    else
    {
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Default" Class="mr-2" />
            <div class="flex-grow-1">
                <MudText Typo="Typo.body1">
                    @Loc.T("settings.accounts.password.notSet")
                </MudText>
                @if (IsBootstrap)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Loc.T("settings.accounts.password.bootstrapHint")
                    </MudText>
                }
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(_busy || _mode is not null)"
                       OnClick="BeginSet">
                @Loc.T("settings.accounts.password.set.button")
            </MudButton>
        </div>
    }

    @if (_mode is Mode.SetForm or Mode.ChangeForm)
    {
        <MudDivider Class="my-3" />
        <MudStack Spacing="2" Style="max-width: 400px;">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(_mode == Mode.ChangeForm
                    ? Loc.T("settings.accounts.password.changeHint")
                    : Loc.T("settings.accounts.password.setHint"))
            </MudText>
            <MudTextField T="string" @bind-Value="_newPassword"
                          Label="@Loc.T("settings.accounts.password.newLabel")"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Immediate="true"
                          MaxLength="200"
                          Disabled="_busy" />
            <MudTextField T="string" @bind-Value="_newPasswordConfirm"
                          Label="@Loc.T("settings.accounts.password.confirmLabel")"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Immediate="true"
                          MaxLength="200"
                          Disabled="_busy"
                          Error="@HasMismatch"
                          ErrorText="@Loc.T("settings.accounts.password.mismatch")" />
            <div class="d-flex align-center" style="gap:8px;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(_busy || !CanSubmitNewPassword)"
                           OnClick="SubmitNewPasswordAsync">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>@Loc.T("settings.accounts.password.saving")</span>
                    }
                    else
                    {
                        <span>@Loc.T("settings.accounts.password.save")</span>
                    }
                </MudButton>
                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="CancelForm">
                    @Loc.T("common.cancel")
                </MudButton>
            </div>
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public AuthMethodsPassword? Password { get; set; }

    /// <summary>True when the signed-in user has zero other sign-in methods. Server treats this
    /// as the "bootstrap" path for password set and bypasses the step-up challenge.</summary>
    [Parameter] public bool IsBootstrap { get; set; }

    /// <summary>Invoked after a successful set / change / remove so the parent reloads.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private enum Mode { SetForm, ChangeForm }

    private Mode? _mode;
    private string _newPassword = string.Empty;
    private string _newPasswordConfirm = string.Empty;
    private bool _busy;

    private bool HasMismatch =>
        !string.IsNullOrEmpty(_newPasswordConfirm) &&
        !string.Equals(_newPassword, _newPasswordConfirm, StringComparison.Ordinal);

    private bool CanSubmitNewPassword =>
        !string.IsNullOrEmpty(_newPassword) &&
        _newPassword.Length >= 12 &&
        string.Equals(_newPassword, _newPasswordConfirm, StringComparison.Ordinal);

    // ---- Set -----------------------------------------------------------

    private void BeginSet()
    {
        _mode = Mode.SetForm;
        _newPassword = string.Empty;
        _newPasswordConfirm = string.Empty;
    }

    // ---- Change --------------------------------------------------------

    private void BeginChange()
    {
        _mode = Mode.ChangeForm;
        _newPassword = string.Empty;
        _newPasswordConfirm = string.Empty;
    }

    private void CancelForm()
    {
        _mode = null;
        _newPassword = string.Empty;
        _newPasswordConfirm = string.Empty;
    }

    private async Task SubmitNewPasswordAsync()
    {
        if (!CanSubmitNewPassword || _mode is null) return;

        _busy = true;
        StateHasChanged();

        try
        {
            string? token = null;
            var needsChallenge = !(_mode == Mode.SetForm && IsBootstrap);

            if (needsChallenge)
            {
                var scope = _mode == Mode.ChangeForm
                    ? ScopedOperation.ChangePassword
                    : ScopedOperation.SetPassword;
                token = await OpenChallengeAsync(scope);
                if (token is null) return; // user cancelled
            }

            PasswordMutationOutcome outcome = _mode == Mode.ChangeForm
                ? await AuthMethodsClient.ChangePasswordAsync(_newPassword, token!)
                : await AuthMethodsClient.SetPasswordAsync(_newPassword, token);

            await HandleOutcomeAsync(outcome, isSet: _mode == Mode.SetForm);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ---- Remove --------------------------------------------------------

    private async Task RemoveAsync()
    {
        if (_busy) return;

        var token = await OpenChallengeAsync(ScopedOperation.RemovePassword);
        if (token is null) return;

        _busy = true;
        StateHasChanged();

        try
        {
            var outcome = await AuthMethodsClient.RemovePasswordAsync(token);
            switch (outcome)
            {
                case PasswordMutationOutcome.Succeeded:
                    Feedback.ShowSuccess(Loc.T("settings.accounts.password.removed"));
                    if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
                    break;
                case PasswordMutationOutcome.Conflict:
                    Feedback.ShowError(Loc.T("settings.accounts.lastMethodWarning"), autoDismissMs: 0);
                    break;
                case PasswordMutationOutcome.Forbidden:
                    Feedback.ShowError(Loc.T("settings.accounts.stepUpExpired"));
                    break;
                default:
                    Feedback.ShowError(Loc.T("settings.accounts.password.removeFailed"));
                    break;
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ---- Shared --------------------------------------------------------

    private async Task<string?> OpenChallengeAsync(ScopedOperation scope)
    {
        var parameters = new DialogParameters { ["Scope"] = scope };
        var dialog = await DialogService.ShowAsync<AuthChallengeDialog>(
            Loc.T("settings.accounts.unlink.confirmTitle"), parameters);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string token } ? token : null;
    }

    private async Task HandleOutcomeAsync(PasswordMutationOutcome outcome, bool isSet)
    {
        switch (outcome)
        {
            case PasswordMutationOutcome.Succeeded:
                Feedback.ShowSuccess(Loc.T(isSet
                    ? "settings.accounts.password.setSuccess"
                    : "settings.accounts.password.changedSuccess"));
                CancelForm();
                if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
                break;
            case PasswordMutationOutcome.PolicyViolation:
                Feedback.ShowError(Loc.T("settings.accounts.password.policyViolation"));
                break;
            case PasswordMutationOutcome.Conflict:
                Feedback.ShowError(Loc.T(isSet
                    ? "settings.accounts.password.alreadySet"
                    : "settings.accounts.password.notCurrentlySet"));
                break;
            case PasswordMutationOutcome.Forbidden:
                Feedback.ShowError(Loc.T("settings.accounts.stepUpExpired"));
                break;
            default:
                Feedback.ShowError(Loc.T("settings.accounts.password.saveFailed"));
                break;
        }
    }
}
