@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Sorcha.Blueprint.Models
@using Sorcha.Blueprint.Models.Credentials
@using Sorcha.Blueprint.Models.Forms
@using Sorcha.Tenant.Models.Persona
@using Sorcha.UI.Core.Models.Forms
@using Sorcha.UI.Core.Services.Forms
@using Sorcha.UI.Core.Services.Persona
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

@inject IFormSchemaService SchemaService
@inject ILogger<SorchaFormRenderer> Logger
@inject IServiceProvider ServiceProvider

<CascadingValue Value="_formContext">
    <div class="sorcha-form">
        <MudStack Spacing="4">
            @* Feature 142 / US5 — Designer-only Edit-mode header. Renders ONLY when
               EditAllowed is true (designer surfaces opt in); citizens never see this. *@
            @if (EditAllowed)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1"
                          Class="sorcha-form-edit-header">
                    <MudTooltip Text="@(Mode == FormAuthoringMode.Edit ? "Exit edit mode" : "Edit form layout")"
                                Placement="Placement.Top">
                        <MudIconButton Icon="@(Mode == FormAuthoringMode.Edit ? Icons.Material.Filled.Visibility : Icons.Material.Filled.Edit)"
                                       Color="@(Mode == FormAuthoringMode.Edit ? Color.Primary : Color.Default)"
                                       Size="MudBlazor.Size.Small"
                                       OnClick="HandleEditModeToggle"
                                       data-testid="form-edit-mode-toggle"
                                       aria-pressed="@(Mode == FormAuthoringMode.Edit)" />
                    </MudTooltip>
                </MudStack>
            }

            @* Previous Data Panel *@
            @if (PreviousData is not null)
            {
                <PreviousDataPanel PreviousData="PreviousData" />
                <MudDivider />
            }

            @* Credential Gate Panel *@
            @if (_credentialRequirements.Any())
            {
                <CredentialGatePanel Requirements="_credentialRequirements"
                                            WalletAddress="@SigningWalletAddress" />
                <MudDivider />
            }

            @* Wizard stepper — rendered above the form when x-pages is defined *@
            @if (_hasWizard && Layout?.Pages is not null)
            {
                <WizardStepper Pages="Layout.Pages"
                               CurrentPage="_currentPage"
                               OnPageSelected="HandleStepperClick" />
            }

            @* Persona fill summary — Feature 092 / US3. Only visible when the
               resolver has filled at least one field. Renders nothing
               otherwise so existing forms pick up zero visual change. *@
            <PersonaFillSummary Count="@_personaFilledPaths.Count"
                                Fills="@_personaFillsList"
                                IsAutofillEnabled="@_autofillEnabled"
                                PendingCount="@(_pendingPersonaFills?.Count ?? 0)"
                                OnFillFromProfile="HandleFillFromProfile"
                                OnClearAll="HandleClearAllPersonaFills"
                                OnClearField="HandleClearPersonaField" />

            @* Form Controls — rendered in one of three modes *@
            @if (_formControl is null)
            {
                @* Action has no renderable form *@
            }
            else if (_hasWizard && Layout?.Pages is not null && _currentPage < Layout.Pages.Count)
            {
                @* Wizard mode: render current page's sections only *@
                var wizardPage = Layout.Pages[_currentPage];
                <div class="sorcha-form-page">
                    <MudText Typo="Typo.h6" Class="sorcha-form-page-title mb-2">@wizardPage.Title</MudText>
                    @if (!string.IsNullOrWhiteSpace(wizardPage.Description))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            @wizardPage.Description
                        </MudText>
                    }

                    @if (wizardPage.ReviewExtension is not null)
                    {
                        @* Feature 107 — x-review page. Suppress field rendering
                           entirely and hand over to the review summary
                           component with the prior pages as the value source.
                           Pass credentialRequirements + credentialIssuanceConfig
                           so the renderer can switch to stacked-cards mode on
                           credential-chain actions (PR 2 / FR-026). *@
                        var priorPages = Layout.Pages.Take(_currentPage).ToList();
                        <ReviewSummaryRenderer Page="@wizardPage"
                                               PriorPages="@priorPages"
                                               RuntimeState="@RuntimeState"
                                               ActionCredentialRequirements="@Action?.CredentialRequirements"
                                               ActionCredentialIssuanceConfig="@Action?.CredentialIssuanceConfig"
                                               OnEditSection="HandleReviewEdit" />
                    }
                    else if (wizardPage.Sections is { Count: > 0 })
                    {
                        @foreach (var sec in wizardPage.Sections)
                        {
                            @RenderSection(sec)
                        }
                    }

                    @* Catch-all on the last wizard page (skipped for review pages — they are read-only) *@
                    @if (wizardPage.ReviewExtension is null &&
                         _currentPage == Layout.Pages.Count - 1 &&
                         _orphanFieldControls.Count > 0)
                    {
                        @RenderCatchAll()
                    }
                </div>
            }
            else if (_hasSectionsFlat && Layout?.Sections is not null)
            {
                @* Sections mode (no wizard): render each section with header *@
                <div class="sorcha-form-sections">
                    @foreach (var sec in Layout.Sections)
                    {
                        @RenderSection(sec)
                    }

                    @if (_orphanFieldControls.Count > 0)
                    {
                        @RenderCatchAll()
                    }
                </div>
            }
            else
            {
                @* Flat mode: render the full auto-generated control tree as-is *@
                <div class="sorcha-form-flat">
                    <ControlDispatcher Control="_formControl" Depth="0" />
                </div>
            }

            @* Calculated Fields Panel *@
            @if (_hasCalculations)
            {
                <MudDivider />
                <CalculatedFieldsPanel Calculations="Action?.Calculations"
                                               FormContext="_formContext" />
            }

            @* Validation Summary — lists each failing field by its friendly label
               so the user knows exactly what to fix, even when the failing
               control doesn't render an inline error (e.g. switches). *@
            @if (_showValidationSummary && _formContext.HasErrors)
            {
                <MudAlert Severity="Severity.Error" Dense="false" Class="mt-2 sorcha-form-validation-summary">
                    <MudText Typo="Typo.body2" Class="mb-1">Please fix the following before continuing:</MudText>
                    <ul style="margin: 0 0 0 1.25rem; padding: 0;">
                        @foreach (var (scope, errors) in _formContext.ValidationErrors)
                        {
                            var label = ResolveFieldLabelForScope(scope);
                            <li>
                                <MudText Typo="Typo.body2">
                                    <strong>@label:</strong> @string.Join("; ", errors)
                                </MudText>
                            </li>
                        }
                    </ul>
                </MudAlert>
            }

            @* Form Actions *@
            @if (!IsReadOnly)
            {
                <MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween" Class="mt-4 sorcha-form-actions">
                    <div>
                        @if (_hasWizard && _currentPage > 0)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                                       Variant="Variant.Outlined"
                                       OnClick="HandleBack">
                                Back
                            </MudButton>
                        }
                    </div>
                    <MudStack Row="true" Spacing="2">
                        @if (OnCancel.HasDelegate)
                        {
                            <MudButton OnClick="HandleCancel" Variant="Variant.Text">Cancel</MudButton>
                        }
                        @if (OnReject.HasDelegate && Action?.RejectionConfig is not null)
                        {
                            <MudButton OnClick="HandleReject" Color="Color.Error" Variant="Variant.Text">Reject</MudButton>
                        }
                        @if (_hasWizard && Layout?.Pages is not null && _currentPage < Layout.Pages.Count - 1)
                        {
                            <MudButton OnClick="HandleNext"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled">
                                Next: @Layout.Pages[_currentPage + 1].Title
                            </MudButton>
                        }
                        else
                        {
                            <MudTooltip Text="@(PreviewMode ? "Preview — submission disabled" : null)" Placement="Placement.Top">
                                <MudButton OnClick="HandleSubmit"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Disabled="@(_isSubmitting || PreviewMode)"
                                           data-testid="preview-submit-btn">
                                    @if (_isSubmitting)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    }
                                    Submit
                                </MudButton>
                            </MudTooltip>
                        }
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    </div>
</CascadingValue>

@* Local render fragments used by the modes above *@
@{
    RenderFragment RenderSection(BlueprintSectionDefinition sec) =>
    @<div class="sorcha-form-section sorcha-form-section-@(sec.Layout?.ToLowerInvariant() ?? "vertical") mb-3">
        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
            @if (!string.IsNullOrWhiteSpace(sec.Title))
            {
                <MudText Typo="Typo.h6" Class="sorcha-form-section-title">@sec.Title</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(sec.Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="sorcha-form-section-description mb-2">
                    @sec.Description
                </MudText>
            }
            <div class="sorcha-form-section-fields">
                @foreach (var fieldName in sec.Fields)
                {
                    var fieldControl = LookupFieldControl(fieldName);
                    if (fieldControl is not null)
                    {
                        var autofilled = IsPersonaFilled(fieldName);
                        var fieldClass = $"sorcha-field sorcha-field-{fieldControl.ControlType.ToString().ToLowerInvariant()} sorcha-field-width-{GetWidthForField(fieldName)}{(autofilled ? " autofilled" : string.Empty)}";
                        <div class="@fieldClass"
                             aria-describedby="@(autofilled ? PersonaFilledAriaId(fieldName) : null)">
                            @if (autofilled)
                            {
                                <span class="persona-tick" id="@PersonaFilledAriaId(fieldName)">self — filled from your profile</span>
                            }
                            <ControlDispatcher Control="fieldControl" Depth="0" />
                        </div>
                    }
                }
            </div>
        </MudPaper>
    </div>;

    RenderFragment RenderCatchAll() =>
    @<div class="sorcha-form-catchall mb-3">
        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Additional information</MudText>
            <div class="sorcha-form-catchall-fields">
                @foreach (var (orphanName, orphanControl) in _orphanFieldControls)
                {
                    var orphanAutofilled = IsPersonaFilled(orphanName);
                    var orphanFieldClass = $"sorcha-field sorcha-field-{orphanControl.ControlType.ToString().ToLowerInvariant()} sorcha-field-width-{GetWidthForField(orphanName)}{(orphanAutofilled ? " autofilled" : string.Empty)}";
                    <div class="@orphanFieldClass"
                         aria-describedby="@(orphanAutofilled ? PersonaFilledAriaId(orphanName) : null)">
                        @if (orphanAutofilled)
                        {
                            <span class="persona-tick" id="@PersonaFilledAriaId(orphanName)">self — filled from your profile</span>
                        }
                        <ControlDispatcher Control="orphanControl" Depth="0" />
                    </div>
                }
            </div>
        </MudPaper>
    </div>;
}

@code {
    [Parameter] public Sorcha.Blueprint.Models.Action? Action { get; set; }
    [Parameter] public JsonDocument? PreviousData { get; set; }

    /// <summary>
    /// Feature 107 — the lifecycle state the review/id-card is being rendered in (draft vs assessor-pending
    /// vs issued credential), which drives the review summary's watermark/footer treatment. Defaults to
    /// <see cref="ActionRuntimeState.CitizenDraft"/>; assessor and wallet-detail hosts set it explicitly so
    /// the review page is no longer hard-pinned to the Draft watermark (issue #338).
    /// </summary>
    [Parameter] public ActionRuntimeState RuntimeState { get; set; } = ActionRuntimeState.CitizenDraft;

    /// <summary>
    /// Feature 152 — editable values to seed the form with on (re)open, keyed by JSON Pointer scope
    /// (e.g. a saved offline draft). Unlike <see cref="PreviousData"/> (read-only prior-action data),
    /// these populate the editable controls so a citizen can resume an in-progress draft.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, object?>? InitialFormData { get; set; }

    /// <summary>
    /// Feature 152 — raised when the user edits form data, carrying the current values. Lets a host
    /// (e.g. the offline draft autosave) persist in-progress work without waiting for submit.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnFormDataChanged { get; set; }
    [Parameter] public string ParticipantAddress { get; set; } = string.Empty;
    [Parameter] public string SigningWalletAddress { get; set; } = string.Empty;
    [Parameter] public EventCallback<FormSubmission> OnSubmit { get; set; }
    [Parameter] public EventCallback<string> OnReject { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsSenderAction { get; set; }

    /// <summary>
    /// Fires when a form field gains focus with the field's JSON Pointer scope,
    /// or null on blur. Used by <c>ActionWorkspace</c> to drive the contextual
    /// help panel. Added in Feature 091 (US2).
    /// </summary>
    [Parameter] public EventCallback<string?> OnFieldFocused { get; set; }

    /// <summary>
    /// Optional layout metadata parsed from the action's x-pages / x-sections /
    /// x-introduction / x-width extensions. When provided, the renderer:
    /// - Renders sections with titles and descriptions (x-sections)
    /// - Renders a wizard with stepper and Next/Back navigation (x-pages)
    /// - Applies per-field width hints (x-width)
    /// - Renders any orphan fields (not referenced by any section) in a
    ///   catch-all panel at the bottom (or on the last wizard page)
    /// When null or empty, the renderer falls back to the flat control tree —
    /// fully backwards compatible with existing forms. Feature 091.
    /// </summary>
    [Parameter] public SchemaLayoutInfo? Layout { get; set; }

    /// <summary>
    /// Fires when the wizard advances to the next page, retreats, or jumps via
    /// the stepper. Useful for host pages that want to update URL state or
    /// analytics. The renderer owns the canonical current-page state.
    /// </summary>
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>
    /// Feature 109 — when <c>true</c>, the renderer is in designer-preview mode:
    /// the submit button is rendered but disabled (tooltip: "Preview — submission
    /// disabled") and the submit handler early-returns before validation /
    /// <see cref="OnSubmit"/> is invoked. All other behaviour — fields remain
    /// interactable, conditional logic fires, validation highlights still show —
    /// is preserved so designers can audit the form as-built. Additive parameter
    /// with default <c>false</c>; existing callers are unaffected.
    /// </summary>
    [Parameter] public bool PreviewMode { get; set; } = false;

    /// <summary>
    /// Feature 142 / US5 — the renderer's authoring mode. <see cref="FormAuthoringMode.Preview"/>
    /// (default) renders the form exactly as a citizen would see it. <see cref="FormAuthoringMode.Edit"/>
    /// activates the designer's layout-authoring affordances (LayoutToolsPanel + per-field overlays).
    /// Has no effect unless <see cref="EditAllowed"/> is true.
    /// </summary>
    [Parameter] public FormAuthoringMode Mode { get; set; } = FormAuthoringMode.Preview;

    /// <summary>
    /// Feature 142 / US5 — when true, the renderer surfaces the small Edit / Preview toggle in its
    /// header. Designer surfaces (the Understand stage's FormPreviewPane) pass this; citizen
    /// surfaces MUST leave it false.
    /// </summary>
    [Parameter] public bool EditAllowed { get; set; } = false;

    /// <summary>
    /// Feature 142 / US5 — fires when the user toggles between Preview and Edit. The parent is
    /// the owner of <see cref="Mode"/> and decides whether to honour the change.
    /// </summary>
    [Parameter] public EventCallback<FormAuthoringMode> OnEditModeChanged { get; set; }

    private FormContext _formContext = new();
    private Control? _formControl;
    private List<CredentialRequirement> _credentialRequirements = [];
    private bool _hasCalculations;
    private bool _isSubmitting;
    private bool _showValidationSummary;
    private int _currentPage;
    private bool _hasWizard;
    private bool _hasSectionsFlat;
    private readonly Dictionary<string, Control> _fieldIndex = new(StringComparer.Ordinal);
    private readonly List<(string Name, Control Control)> _orphanFieldControls = new();

    // Identity tracking — only rebuild the FormContext when Action / Layout
    // identity actually changes. Without this, every parent re-render (e.g.
    // from focus events) would wipe FormData mid-typing. Reference equality
    // is the right check because Sorcha.Blueprint.Models.Action is a class
    // and the same instance flows down on every render unless the parent
    // page genuinely loaded a different action.
    private Sorcha.Blueprint.Models.Action? _lastAction;
    private SchemaLayoutInfo? _lastLayout;
    private string? _lastSigningWalletAddress;
    private bool _lastIsReadOnly;
    private bool _lastIsSenderAction;

    // --- Feature 092 — Persona autofill state ---
    // Set of JSON Pointer scopes (leading slash, e.g. "/email") whose current
    // FormData value came from the user's persona and has not been edited
    // since. Used by the render path to apply the `.autofilled` class and the
    // `self` tick. Cleared paths lose the tint immediately per FR-019.
    private readonly HashSet<string> _personaFilledPaths = new(StringComparer.Ordinal);
    // Original values we wrote so we can detect edits on OnDataChanged.
    private readonly Dictionary<string, object?> _personaFilledOriginal = new(StringComparer.Ordinal);
    // Per-path fill result (for the US3 review popover). Keyed by the same
    // pointer we store in _personaFilledPaths so we can surface the attribute
    // name, match mode, and value to the user.
    private readonly Dictionary<string, PersonaFillResult> _personaFillsByPath = new(StringComparer.Ordinal);
    // Projection of the above as a list, refreshed whenever paths change,
    // so the summary component can iterate without mutating the dictionary.
    private IReadOnlyList<PersonaFillResult> _personaFillsList = Array.Empty<PersonaFillResult>();
    // Feature 092 / US5 — when the global autofill preference is OFF the
    // resolver still runs but its decisions are held here instead of being
    // applied. The summary banner renders in "Fill from profile" mode and
    // the user can opt in with a single click.
    private bool _autofillEnabled = true;
    private IReadOnlyDictionary<string, PersonaFillResult>? _pendingPersonaFills;
    // Whether we've kicked off the fire-and-forget persona load for the
    // current Action — reset on action change.
    private bool _personaLoadKicked;
    private CancellationTokenSource? _personaLoadCts;

    protected override void OnParametersSet()
    {
        if (Action is null) return;

        // Identity check — Blazor calls OnParametersSet on every parent render,
        // even when our parameters are unchanged. Without this guard, every
        // focus event from a child input would re-run the heavy initialisation
        // below and wipe FormData mid-typing (Feature 091 wizard regression).
        // Reference equality is correct because the parent passes the same
        // Action / Layout instance unless it genuinely loaded a new one.
        var actionChanged = !ReferenceEquals(_lastAction, Action);
        var layoutChanged = !ReferenceEquals(_lastLayout, Layout);
        var walletChanged = !string.Equals(_lastSigningWalletAddress, SigningWalletAddress, StringComparison.Ordinal);
        var modeChanged = _lastIsReadOnly != IsReadOnly || _lastIsSenderAction != IsSenderAction;

        if (!actionChanged && !layoutChanged && !walletChanged && !modeChanged)
        {
            return;
        }

        _lastAction = Action;
        _lastLayout = Layout;
        _lastSigningWalletAddress = SigningWalletAddress;
        _lastIsReadOnly = IsReadOnly;
        _lastIsSenderAction = IsSenderAction;

        // Detach any prior subscription so we don't leak to a stale context.
        if (_formContext is not null)
        {
            _formContext.OnFocusedFieldChanged -= HandleFocusedFieldChanged;
            _formContext.OnDataChanged -= HandlePersonaDataChanged;
        }

        if (actionChanged)
        {
            // Reset persona autofill state whenever a new action loads.
            _personaFilledPaths.Clear();
            _personaFilledOriginal.Clear();
            _personaFillsByPath.Clear();
            _personaFillsList = Array.Empty<PersonaFillResult>();
            _pendingPersonaFills = null;
            _personaLoadKicked = false;
            _personaLoadCts?.Cancel();
            _personaLoadCts?.Dispose();
            _personaLoadCts = null;
        }

        if (actionChanged)
        {
            // New action → fresh FormContext
            _formContext = new FormContext
            {
                DataSchema = SchemaService.MergeSchemas(Action.DataSchemas),
                IsReadOnly = IsReadOnly,
                SigningWalletAddress = SigningWalletAddress
            };
        }
        else if (_formContext is not null)
        {
            // Same action — keep existing FormContext (and FormData) but
            // refresh the mutable bits in case wallet / read-only changed.
            _formContext.IsReadOnly = IsReadOnly;
            _formContext.SigningWalletAddress = SigningWalletAddress;
        }

        // Re-attach focus event subscription. _formContext is non-null after the
        // branches above (either freshly created or pre-existing with field updates).
        _formContext!.OnFocusedFieldChanged += HandleFocusedFieldChanged;
        // Watch FormData so we can drop the autofill tint as soon as the user
        // edits a field (FR-019).
        _formContext.OnDataChanged += HandlePersonaDataChanged;

        // Build disclosure filter (depends on Action + IsSenderAction)
        BuildDisclosureFilter();

        // Parse previous data only on action change (otherwise we'd reset values)
        if (actionChanged && PreviousData is not null)
        {
            ParsePreviousData();
        }

        // Feature 152 — seed editable values from a saved draft on (re)open, before controls render.
        if (actionChanged && InitialFormData is { Count: > 0 })
        {
            foreach (var kv in InitialFormData)
            {
                _formContext.FormData[kv.Key] = kv.Value;
            }
        }

        if (actionChanged)
        {
            // Determine form control — use Action.Form if it has elements, otherwise auto-generate.
            // Action.Form defaults to an empty Layout (non-null) even when JSON has no "form" key,
            // so we must check for elements rather than null.
            var explicitForm = Action.Form;
            var hasExplicitFormElements = explicitForm?.Elements is { Count: > 0 };
            _formControl = hasExplicitFormElements ? explicitForm! : SchemaService.AutoGenerateForm(Action.DataSchemas);

            // Build the leaf field index (scope → Control) so sections and wizard
            // pages can look up individual controls by field name.
            BuildFieldIndex(_formControl);
        }

        // Compute layout mode flags from the (optional) Layout parameter
        _hasWizard = Layout is { HasWizard: true };
        _hasSectionsFlat = !_hasWizard && Layout is { HasSections: true };
        if (_currentPage < 0 || (Layout?.Pages is not null && _currentPage >= Layout.Pages.Count))
        {
            _currentPage = 0;
        }

        // Compute orphan fields (in schema but not referenced by any section)
        BuildOrphanFieldList();

        if (actionChanged)
        {
            // Credential requirements
            _credentialRequirements = Action.CredentialRequirements?.ToList() ?? [];
            _formContext.CredentialGateSatisfied = !_credentialRequirements.Any();

            // Calculations
            _hasCalculations = Action.Calculations?.Count > 0;
        }

        // Kick off the persona autofill load — fire-and-forget so the form
        // renders immediately and becomes interactive without waiting on the
        // network round-trip. Only run once per Action identity. Read-only
        // forms and the sender-action replay path skip autofill entirely.
        if (actionChanged && !_personaLoadKicked && !IsReadOnly)
        {
            _personaLoadKicked = true;
            _personaLoadCts = new CancellationTokenSource();
            _ = LoadPersonaAndApplyAsync(_personaLoadCts.Token);
        }

        // Feature 183 (US1) used to seed x-claim-source fields here from the browser's JWT claims.
        // REMOVED by issue #1264: a token is a snapshot from mint time, so the seeded value was only
        // ever as fresh as the token the client happened to hold — a citizen who verified their email
        // mid-session (the normal signup order) submitted a stale `false` and was auto-rejected while
        // fully compliant. These bindings are now resolved server-side at submission, in
        // ActionExecutionService step 6a-bis, where the live value is knowable and the client cannot
        // assert a field the platform is supposed to vouch for. Do NOT reintroduce a client-side seed:
        // it would be silently discarded by the server overwrite, and re-implying otherwise is how the
        // staleness came back into scope in the first place.
    }

    /// <summary>
    /// Loads the signed-in user's persona and applies matching values to the
    /// current form data bag. Runs fire-and-forget from
    /// <see cref="OnParametersSet"/>. User-touched fields are never
    /// overwritten (FR-009a / research.md Decision 9). Graceful on any
    /// failure — persona autofill is optional and must never break the form.
    /// </summary>
    private async Task LoadPersonaAndApplyAsync(CancellationToken ct)
    {
        try
        {
            var personaService = ServiceProvider.GetService(typeof(IPersonaService)) as IPersonaService;
            var resolver = ServiceProvider.GetService(typeof(PersonaAutofillResolver)) as PersonaAutofillResolver;
            if (personaService is null || resolver is null)
            {
                // Host has not registered persona services (e.g. bUnit test
                // context). Silently skip — autofill is an enhancement.
                return;
            }

            // Honour the global autofill preference (FR-015). When disabled,
            // we do NOT apply fills automatically but still resolve and stash
            // them so the US5 "Fill from profile" button in the summary can
            // apply them on demand.
            _autofillEnabled = await personaService.GetAutofillEnabledAsync().ConfigureAwait(false);

            var persona = await personaService.GetAsync(null, ct).ConfigureAwait(false);
            ct.ThrowIfCancellationRequested();

            var fills = resolver.Resolve(_formContext.DataSchema, persona);
            if (fills.Count == 0) return;

            // Marshal back to the renderer's sync context before mutating
            // FormData so StateHasChanged re-renders safely.
            await InvokeAsync(() =>
            {
                if (_autofillEnabled)
                {
                    ApplyPersonaFills(fills);
                }
                else
                {
                    // US5 off-state: hold the resolver decisions for the
                    // "Fill from profile" button without touching FormData.
                    _pendingPersonaFills = fills;
                }
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // Action changed or component disposed — nothing to do.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Persona autofill failed for action {ActionTitle}", Action?.Title);
        }
    }

    /// <summary>
    /// Writes the resolver's decisions into the form data bag, skipping any
    /// field the user has already touched. Populates
    /// <see cref="_personaFilledPaths"/> and <see cref="_personaFilledOriginal"/>
    /// so the render path can apply the cream tint and the change watcher
    /// can release it on edit.
    /// </summary>
    private void ApplyPersonaFills(IReadOnlyDictionary<string, PersonaFillResult> fills)
    {
        foreach (var (pointer, fill) in fills)
        {
            if (fill.Value is PersonaAddress address)
            {
                // Address fields fan out to child pointers. Each child gets
                // its own fill record so the review popover can list them
                // individually instead of as one opaque "address" entry.
                TryFillScalar(pointer + "/line1", address.Line1, "addressLine1", fill);
                if (!string.IsNullOrEmpty(address.Line2)) TryFillScalar(pointer + "/line2", address.Line2, "addressLine2", fill);
                TryFillScalar(pointer + "/city", address.City, "city", fill);
                if (!string.IsNullOrEmpty(address.Region)) TryFillScalar(pointer + "/region", address.Region, "region", fill);
                TryFillScalar(pointer + "/postalCode", address.PostalCode, "postalCode", fill);
                TryFillScalar(pointer + "/country", address.Country, "country", fill);
                continue;
            }

            TryFillScalar(pointer, UnwrapValue(fill.Value), fill.AttributeName, fill);
        }

        RefreshPersonaFillsList();
    }

    private void TryFillScalar(string pointer, object? value, string attributeName, PersonaFillResult parent)
    {
        if (value is null) return;

        // User activity wins: skip fields the user is currently editing or
        // has already populated with any non-empty value.
        if (string.Equals(_formContext.FocusedFieldScope, pointer, StringComparison.Ordinal))
        {
            return;
        }

        if (_formContext.FormData.TryGetValue(pointer, out var existing) && !IsEmpty(existing))
        {
            return;
        }

        _formContext.FormData[pointer] = value;
        _personaFilledPaths.Add(pointer);
        _personaFilledOriginal[pointer] = value;
        _personaFillsByPath[pointer] = new PersonaFillResult(
            FieldPath: pointer,
            AttributeName: attributeName,
            Value: value,
            Source: parent.Source,
            MatchedBy: parent.MatchedBy);
    }

    private void RefreshPersonaFillsList()
    {
        _personaFillsList = _personaFillsByPath.Values.ToList();
    }

    /// <summary>
    /// US3 — handler for the summary banner's "Clear all" button. Removes
    /// every persona-filled path from both the form data bag and the
    /// tracking sets. User-edited fields are untouched — the change watcher
    /// has already dropped them from the filled set before we reach here.
    /// </summary>
    private void HandleClearAllPersonaFills()
    {
        if (_personaFilledPaths.Count == 0) return;
        foreach (var pointer in _personaFilledPaths.ToList())
        {
            _formContext.FormData.Remove(pointer);
        }
        _personaFilledPaths.Clear();
        _personaFilledOriginal.Clear();
        _personaFillsByPath.Clear();
        RefreshPersonaFillsList();
        _formContext.NotifyDataChanged();
        StateHasChanged();
    }

    /// <summary>
    /// US5 — handler for the off-state "Fill from profile" button. Applies
    /// the pending resolver decisions exactly as the on-state path would,
    /// then clears the pending buffer so the summary flips into the
    /// standard disclosure mode.
    /// </summary>
    private void HandleFillFromProfile()
    {
        if (_pendingPersonaFills is null || _pendingPersonaFills.Count == 0) return;
        ApplyPersonaFills(_pendingPersonaFills);
        _pendingPersonaFills = null;
        StateHasChanged();
    }

    /// <summary>
    /// US3 — handler for the per-row clear buttons in the review popover.
    /// Removes a single persona-filled field from the form data bag and the
    /// tracking sets. No-op if the path is not currently persona-filled.
    /// </summary>
    private void HandleClearPersonaField(string pointer)
    {
        if (!_personaFilledPaths.Remove(pointer)) return;
        _formContext.FormData.Remove(pointer);
        _personaFilledOriginal.Remove(pointer);
        _personaFillsByPath.Remove(pointer);
        RefreshPersonaFillsList();
        _formContext.NotifyDataChanged();
        StateHasChanged();
    }

    private static bool IsEmpty(object? value) => value switch
    {
        null => true,
        string s => string.IsNullOrEmpty(s),
        _ => false,
    };

    private static object? UnwrapValue(object? value) => value switch
    {
        DateOnly d => d.ToDateTime(TimeOnly.MinValue),
        _ => value,
    };

    /// <summary>
    /// Raised whenever FormData changes. Compares each persona-filled path to
    /// the value we originally wrote; if the value has diverged, the user has
    /// edited the field so the provenance claim must drop (FR-019).
    /// </summary>
    private void HandlePersonaDataChanged()
    {
        if (_personaFilledPaths.Count == 0) return;

        List<string>? toRemove = null;
        foreach (var pointer in _personaFilledPaths)
        {
            _formContext.FormData.TryGetValue(pointer, out var current);
            _personaFilledOriginal.TryGetValue(pointer, out var original);
            if (!Equals(current, original))
            {
                (toRemove ??= new()).Add(pointer);
            }
        }
        if (toRemove is null) return;

        foreach (var pointer in toRemove)
        {
            _personaFilledPaths.Remove(pointer);
            _personaFilledOriginal.Remove(pointer);
            _personaFillsByPath.Remove(pointer);
        }
        RefreshPersonaFillsList();

        // Feature 152 — surface the edit to a host autosave (offline drafts).
        if (OnFormDataChanged.HasDelegate)
        {
            _ = OnFormDataChanged.InvokeAsync(_formContext.FormData);
        }

        // StateHasChanged is safe here — OnDataChanged is raised by user
        // interactions on the sync context.
        InvokeAsync(StateHasChanged);
    }

    private bool IsPersonaFilled(string fieldName)
    {
        if (_personaFilledPaths.Count == 0) return false;
        var key = fieldName.StartsWith('/') ? fieldName : "/" + fieldName;
        return _personaFilledPaths.Contains(key);
    }

    private static string PersonaFilledAriaId(string fieldName)
    {
        var slug = fieldName.Replace('/', '-').Trim('-');
        return $"persona-fill-{slug}";
    }

    private void BuildDisclosureFilter()
    {
        if (Action is null) return;

        // If this is the sender's own action (e.g., new submission or assigned pending action),
        // disclose all fields — the sender always sees their own form
        if (IsSenderAction)
        {
            _formContext.AllFieldsDisclosed = true;
            return;
        }

        var disclosures = Action.Disclosures?.ToList() ?? [];

        // If the current participant is the sender (matched by participant ID), they see all fields
        if (Action.Sender == ParticipantAddress)
        {
            _formContext.AllFieldsDisclosed = true;
            return;
        }

        foreach (var disclosure in disclosures)
        {
            if (disclosure.ParticipantAddress == ParticipantAddress)
            {
                foreach (var pointer in disclosure.DataPointers)
                {
                    if (pointer == "/*")
                    {
                        _formContext.AllFieldsDisclosed = true;
                        return;
                    }
                    _formContext.DisclosureFilter.Add(pointer);
                }
            }
        }
    }

    private void ParsePreviousData()
    {
        if (PreviousData is null) return;

        try
        {
            var root = PreviousData.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                foreach (var prop in root.EnumerateObject())
                {
                    _formContext.PreviousData["/" + prop.Name] = prop.Value.ValueKind switch
                    {
                        JsonValueKind.String => prop.Value.GetString(),
                        JsonValueKind.Number => prop.Value.GetDecimal(),
                        JsonValueKind.True => true,
                        JsonValueKind.False => false,
                        _ => prop.Value.GetRawText()
                    };
                }
            }
        }
        catch
        {
            // Gracefully handle malformed previous data
        }
    }

    /// <summary>
    /// Walks the Control tree and populates <see cref="_fieldIndex"/> with a
    /// (stripped scope → Control) mapping for every leaf control that has a
    /// scope. Layout / group controls are not indexed.
    /// </summary>
    private void BuildFieldIndex(Control root)
    {
        _fieldIndex.Clear();
        if (root is null) return;

        void Walk(Control node)
        {
            if (!string.IsNullOrEmpty(node.Scope))
            {
                var key = node.Scope.StartsWith('/') ? node.Scope[1..] : node.Scope;
                _fieldIndex[key] = node;
            }
            if (node.Elements is { Count: > 0 })
            {
                foreach (var child in node.Elements)
                {
                    Walk(child);
                }
            }
        }

        Walk(root);
    }

    /// <summary>
    /// Builds the list of "orphan" field controls — leaf fields that exist in
    /// the schema but are not referenced by any section (standalone or inside
    /// a wizard page). These render in a catch-all panel so no data is lost.
    /// </summary>
    private void BuildOrphanFieldList()
    {
        _orphanFieldControls.Clear();
        if (Layout is null) return;

        var referenced = new HashSet<string>(StringComparer.Ordinal);
        if (Layout.Sections is not null)
        {
            foreach (var section in Layout.Sections)
                foreach (var f in section.Fields)
                    referenced.Add(f);
        }
        if (Layout.Pages is not null)
        {
            foreach (var page in Layout.Pages)
            {
                if (page.Sections is null) continue;
                foreach (var section in page.Sections)
                    foreach (var f in section.Fields)
                        referenced.Add(f);
            }
        }

        // If no section referenced anything, there are no orphans — every field
        // will be rendered via the flat mode fallback in the markup.
        if (referenced.Count == 0) return;

        foreach (var (name, control) in _fieldIndex)
        {
            if (!referenced.Contains(name))
            {
                _orphanFieldControls.Add((name, control));
            }
        }
    }

    private Control? LookupFieldControl(string fieldName)
    {
        var key = fieldName.StartsWith('/') ? fieldName[1..] : fieldName;
        return _fieldIndex.TryGetValue(key, out var control) ? control : null;
    }

    /// <summary>
    /// Returns the human-readable label for a field scope ("/firstName" → "First Name").
    /// Prefers the auto-generated Control.Title (which is sourced from the schema's
    /// "title" property), then falls back to a humanised version of the field name.
    /// Used by the validation summary so users know exactly which field failed.
    /// </summary>
    private string ResolveFieldLabelForScope(string scope)
    {
        var control = LookupFieldControl(scope);
        if (control is not null && !string.IsNullOrWhiteSpace(control.Title))
            return control.Title;

        var key = scope.StartsWith('/') ? scope[1..] : scope;
        if (string.IsNullOrEmpty(key)) return scope;

        // camelCase → "Camel Case"
        var sb = new System.Text.StringBuilder();
        sb.Append(char.ToUpperInvariant(key[0]));
        for (int i = 1; i < key.Length; i++)
        {
            if (char.IsUpper(key[i]) && !char.IsUpper(key[i - 1]))
                sb.Append(' ');
            sb.Append(key[i]);
        }
        return sb.ToString();
    }

    private string GetWidthForField(string fieldName)
    {
        var key = fieldName.StartsWith('/') ? fieldName[1..] : fieldName;
        if (Layout?.FieldWidths is not null && Layout.FieldWidths.TryGetValue(key, out var width))
            return width;
        return "full";
    }

    private async Task HandleStepperClick(int pageIndex)
    {
        if (Layout?.Pages is null) return;
        if (pageIndex < 0 || pageIndex > _currentPage) return; // only allow visited pages

        _currentPage = pageIndex;
        _showValidationSummary = false;
        if (OnPageChanged.HasDelegate)
            await OnPageChanged.InvokeAsync(_currentPage);
    }

    /// <summary>
    /// Feature 107 — Edit-X jump from a review card's section. The review
    /// page is always the last position in the wizard, so section Edit
    /// buttons MUST NOT be able to jump to it (self-jump would create an
    /// infinite edit loop). The bound is tight: strictly less than
    /// <c>Layout.Pages.Count - 1</c>.
    /// </summary>
    private async Task HandleReviewEdit(int pageIndex)
    {
        if (Layout?.Pages is null) return;
        if (pageIndex < 0 || pageIndex >= Layout.Pages.Count - 1) return;
        _currentPage = pageIndex;
        _showValidationSummary = false;
        if (OnPageChanged.HasDelegate)
            await OnPageChanged.InvokeAsync(_currentPage);
    }

    private async Task HandleBack()
    {
        if (_currentPage <= 0) return;
        _currentPage--;
        _showValidationSummary = false;
        if (OnPageChanged.HasDelegate)
            await OnPageChanged.InvokeAsync(_currentPage);
    }

    private async Task HandleNext()
    {
        if (Layout?.Pages is null || _currentPage >= Layout.Pages.Count - 1) return;

        // Per-page validation: only enforce required fields on the current page.
        // The full-schema validation still runs at final submit, catching any
        // cross-page validity issues (e.g., wizardfinale must match first page).
        if (_formContext.DataSchema is not null)
        {
            var pageFields = GetCurrentPageFields();
            if (pageFields.Count > 0)
            {
                var errors = SchemaService.ValidateData(_formContext.DataSchema, _formContext.FormData);
                _formContext.ClearErrors();
                bool hasPageErrors = false;
                foreach (var (scope, fieldErrors) in errors)
                {
                    var trimmed = scope.StartsWith('/') ? scope[1..] : scope;
                    // $ref core-primitive fields (PersonName, PostalAddress, ...) surface validation
                    // errors at nested pointers ("/name/givenName"); the page lists only the top-level
                    // field ("name"). Match on the first path segment so a missing required nested field
                    // still blocks the wizard from advancing (otherwise the error is dropped and Next
                    // proceeds past unfilled required data).
                    var topLevelField = trimmed.Contains('/') ? trimmed[..trimmed.IndexOf('/')] : trimmed;
                    if (pageFields.Contains(topLevelField))
                    {
                        _formContext.SetErrors(scope, fieldErrors);
                        hasPageErrors = true;
                    }
                }
                if (hasPageErrors)
                {
                    _showValidationSummary = true;
                    return;
                }
            }
        }

        _currentPage++;
        _showValidationSummary = false;
        if (OnPageChanged.HasDelegate)
            await OnPageChanged.InvokeAsync(_currentPage);
    }

    private HashSet<string> GetCurrentPageFields()
    {
        var fields = new HashSet<string>(StringComparer.Ordinal);
        if (Layout?.Pages is null || _currentPage >= Layout.Pages.Count)
            return fields;

        var page = Layout.Pages[_currentPage];
        if (page.Sections is not null)
        {
            foreach (var section in page.Sections)
                foreach (var f in section.Fields)
                    fields.Add(f);
        }
        // Catch-all fields are part of the last wizard page
        if (_currentPage == Layout.Pages.Count - 1)
        {
            foreach (var (name, _) in _orphanFieldControls)
                fields.Add(name);
        }
        return fields;
    }

    // async void is required because the FormContext.OnFocusedFieldChanged
    // event is `Action<string?>`. Wrap in try/catch so a thrown exception
    // can't escape into the synchronisation context (which would crash the
    // circuit on Blazor Server and silently disappear on WASM).
    private async void HandleFocusedFieldChanged(string? scope)
    {
        try
        {
            if (!OnFieldFocused.HasDelegate) return;
            await InvokeAsync(async () =>
            {
                await OnFieldFocused.InvokeAsync(scope);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error propagating focused-field change for scope {Scope}", scope);
        }
    }

    private async Task HandleSubmit()
    {
        // Feature 109 — designer-preview mode short-circuits submission before
        // any side effects (validation UI flash, persona fills, OnSubmit).
        if (PreviewMode)
        {
            return;
        }

        _showValidationSummary = true;

        // Validate
        if (_formContext.DataSchema is not null)
        {
            var errors = SchemaService.ValidateData(_formContext.DataSchema, _formContext.FormData);
            _formContext.ClearErrors();
            foreach (var (scope, fieldErrors) in errors)
            {
                _formContext.SetErrors(scope, fieldErrors);
            }
        }

        if (_formContext.HasErrors)
        {
            StateHasChanged();
            return;
        }

        // Block submission if credential requirements are not satisfied
        if (!_formContext.CredentialGateSatisfied && _credentialRequirements.Any())
        {
            _formContext.SetErrors("credentials", ["All credential requirements must be satisfied before submitting."]);
            StateHasChanged();
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var submission = new FormSubmission
            {
                Data = new Dictionary<string, object?>(_formContext.FormData),
                CalculatedValues = new Dictionary<string, object?>(_formContext.CalculatedValues),
                SigningWalletAddress = SigningWalletAddress,
                FileAttachments = [.. _formContext.FileAttachments],
                ProofAttachments = [.. _formContext.ProofAttachments]
            };

            // Map credential presentations
            foreach (var cp in _formContext.CredentialPresentations)
            {
                submission.CredentialPresentations.Add(new CredentialPresentation
                {
                    CredentialId = cp.CredentialId,
                    DisclosedClaims = cp.DisclosedClaims,
                    RawPresentation = cp.RawPresentation,
                    KeyBindingProof = cp.KeyBindingProof
                });
            }

            await OnSubmit.InvokeAsync(submission);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task HandleReject()
    {
        await OnReject.InvokeAsync("rejected");
    }

    /// <summary>
    /// Feature 142 / US5 — flips the local authoring mode and invokes the parent callback so
    /// the owner (e.g. <c>FormPreviewPane</c>) can persist the choice and show/hide the
    /// surrounding <c>LayoutToolsPanel</c>. Does nothing when <see cref="EditAllowed"/> is false.
    /// </summary>
    private async Task HandleEditModeToggle()
    {
        if (!EditAllowed) return;
        var next = Mode == FormAuthoringMode.Edit ? FormAuthoringMode.Preview : FormAuthoringMode.Edit;
        if (OnEditModeChanged.HasDelegate)
        {
            await OnEditModeChanged.InvokeAsync(next);
        }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    public void Dispose()
    {
        if (_formContext is not null)
        {
            _formContext.OnFocusedFieldChanged -= HandleFocusedFieldChanged;
            _formContext.OnDataChanged -= HandlePersonaDataChanged;
        }
        _personaLoadCts?.Cancel();
        _personaLoadCts?.Dispose();
    }
}
