@*
    SPDX-License-Identifier: MIT
    Copyright (c) 2026 Sorcha Contributors

    Feature 127 — Credential gate component. Wraps a consumer page's form
    in a presentation-then-render flow:
      (1) consumer page submits the verify-identity action and hands this
          component the resulting PresentationRequestId + AuthorizationRequestUri
          + ClaimsFetchToken via the Init parameter;
      (2) this component renders the HybridQrAffordance over the request URI,
          subscribes to IPresentationSignal for the outcome, and on Success
          fetches the disclosed claims from the F127 /disclosed-claims endpoint;
      (3) it then fires OnPresented(DisclosedClaimsResponse) and the consumer
          page advances to render its ChildContent (typically the second
          action's form, pre-populated from the disclosed claims).

    Composition with EnrolGateComponent:

        <EnrolGateComponent CouncilName="..." ServiceLabel="...">
            <CredentialGateComponent Init="@_init"
                                     OnPresented="@HandlePresentedAsync"
                                     LinkBackUrl="/services/driving-licence"
                                     NameOfMissingCredentialType="Assured Identity">
                <BlueBadgeForm Disclosed="@_disclosed" />
            </CredentialGateComponent>
        </EnrolGateComponent>

    The page owns the action-submission HTTP call (and the resulting Init).
    The component owns the QR + signal + claims-fetch + autofill handoff.
*@
@using System.Net.Http.Json
@using Microsoft.Extensions.Logging
@using Sorcha.UI.Core.Components.EnrolGate
@using Sorcha.UI.Core.Models.User.Presentation
@using Sorcha.UI.Core.Services.User.Presentation
@inject IPresentationSignal Signal
@inject HttpClient Http
@inject ILogger<CredentialGateComponent> Logger
@implements IAsyncDisposable

@if (_state == State.NoGate)
{
    @ChildContent
}
else if (_state == State.Succeeded)
{
    @ChildContent
}
else if (_state == State.NoCredentialAvailable)
{
    <div class="credential-gate credential-gate--error" role="alert">
        <h3>We need an @NameOfMissingCredentialType credential to continue.</h3>
        <p>If you don't have one yet, apply for one first.</p>
        @if (!string.IsNullOrEmpty(LinkBackUrl))
        {
            <p><a href="@LinkBackUrl" class="cta">Go to the application that issues this credential →</a></p>
        }
    </div>
}
else if (_state == State.Declined || _state == State.Abandoned)
{
    <div class="credential-gate credential-gate--declined" role="alert">
        @if (_state == State.Declined)
        {
            <h3>We couldn't verify your credential.</h3>
            <p>Please try again, or contact the council if the problem persists.</p>
        }
        else
        {
            <h3>Your wallet didn't respond in time.</h3>
            <p>Please try again with a fresh QR code.</p>
        }
    </div>
}
else if (_state == State.ManualRecoveryRequired)
{
    <div class="credential-gate credential-gate--manual-recovery" role="status">
        <h3>Couldn't reach your wallet.</h3>
        <p>Refresh this page to try again.</p>
    </div>
}
else if (Init is not null)
{
    <div class="credential-gate credential-gate--waiting">
        <h3>Prove you're you</h3>
        <p>Scan the QR with your phone — or tap the link if your wallet is on this device.</p>
        <HybridQrAffordance QrUrl="@Init.AuthorizationRequestUri" Layout="HybridQrAffordance.HybridQrLayout.Auto" />
        @if (_fallbackEngaged)
        {
            <p class="credential-gate__hint">Still connecting to your wallet…</p>
        }
    </div>
}

@code {
    /// <summary>
    /// Data the consumer page obtained from F111's <c>InitiateAsync</c>
    /// (via the action-submission endpoint) and hands to the gate.
    /// </summary>
    [Parameter, EditorRequired] public CredentialGateInit? Init { get; set; }

    /// <summary>
    /// Fires when the gate has retrieved disclosed claims successfully. The
    /// consumer page typically transitions its form into autofill state and
    /// renders ChildContent.
    /// </summary>
    [Parameter] public EventCallback<DisclosedClaimsResponse> OnPresented { get; set; }

    /// <summary>
    /// URL to point a citizen at when no matching credential is available.
    /// Typically the council page that issues the gating credential.
    /// </summary>
    [Parameter] public string? LinkBackUrl { get; set; }

    /// <summary>Human-readable name of the gating credential (e.g. "Assured Identity").</summary>
    [Parameter] public string NameOfMissingCredentialType { get; set; } = "credential";

    /// <summary>
    /// Renders only after the gate clears (Success state). Typically the
    /// second-action form populated from the disclosed claims.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private enum State { Initialising, NoGate, Waiting, Succeeded, Declined, Abandoned, NoCredentialAvailable, ManualRecoveryRequired }
    private State _state = State.Initialising;
    private bool _fallbackEngaged;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        // No-gate case: parent passed Init = null deliberately (no
        // credentialRequirement on the action). Render ChildContent directly.
        if (Init is null)
        {
            _state = State.NoGate;
            return;
        }

        _cts = new CancellationTokenSource();
        _state = State.Waiting;

        Signal.OnOutcomeReady += HandleOutcomeAsync;
        Signal.OnFallbackEngaged += HandleFallbackEngaged;
        Signal.OnManualRecoveryRequired += HandleManualRecoveryRequired;

        try
        {
            await Signal.StartAsync(Init.PresentationRequestId, _cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Failed to start IPresentationSignal for {RequestId}",
                Init.PresentationRequestId);
        }
    }

    private async Task HandleOutcomeAsync(PresentationSignalOutcome outcome)
    {
        switch (outcome.Kind)
        {
            case "success":
                await FetchAndSurfaceClaimsAsync(outcome.PresentationRequestId);
                break;
            case "decline":
                _state = State.Declined;
                await InvokeAsync(StateHasChanged);
                break;
            case "abandoned":
            case "abandoned-with-late-outcome":
            case "expired":
                _state = State.Abandoned;
                await InvokeAsync(StateHasChanged);
                break;
        }
    }

    private async Task FetchAndSurfaceClaimsAsync(Guid requestId)
    {
        if (Init?.ClaimsFetchToken is null)
        {
            // The page submitted but didn't receive a ClaimsFetchToken (HAIP
            // or other consumer that doesn't expose council-page claims).
            // Surface as declined — the gate can't autofill the form.
            Logger.LogWarning(
                "Outcome ready for {RequestId} but no ClaimsFetchToken on Init; gate cannot complete",
                requestId);
            _state = State.Declined;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var url = $"/api/presentations/{requestId:D}/disclosed-claims?token={Uri.EscapeDataString(Init.ClaimsFetchToken)}";
            using var response = await Http.GetAsync(url, _cts?.Token ?? CancellationToken.None);
            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning(
                    "Claims-fetch returned {Status} for {RequestId}", response.StatusCode, requestId);
                _state = response.StatusCode == System.Net.HttpStatusCode.Gone
                    ? State.Abandoned
                    : State.Declined;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var disclosed = await response.Content
                .ReadFromJsonAsync<DisclosedClaimsResponse>(_cts?.Token ?? CancellationToken.None);
            if (disclosed is null || disclosed.Status != "success")
            {
                _state = State.Declined;
                await InvokeAsync(StateHasChanged);
                return;
            }

            _state = State.Succeeded;
            await InvokeAsync(StateHasChanged);

            if (OnPresented.HasDelegate)
            {
                await OnPresented.InvokeAsync(disclosed);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Claims-fetch threw for {RequestId}", requestId);
            _state = State.Declined;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleFallbackEngaged()
    {
        _fallbackEngaged = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleManualRecoveryRequired()
    {
        if (_state != State.Succeeded)
        {
            _state = State.ManualRecoveryRequired;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Signal.OnOutcomeReady -= HandleOutcomeAsync;
        Signal.OnFallbackEngaged -= HandleFallbackEngaged;
        Signal.OnManualRecoveryRequired -= HandleManualRecoveryRequired;
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
        try { await Signal.StopAsync(); } catch { /* non-fatal */ }
        _cts?.Dispose();
        GC.SuppressFinalize(this);
    }
}
