@*
    Feature 169 — Unified Activity Timeline.

    Shared component used by both the web /app host (/activity route) and the
    Citizen Wallet PWA. Renders ALL inbox entries (no actionable filter) with
    an Actionable / Informational classification badge on each row.

    Subscribes to TenantHub.OnInboxEntryAdded for real-time refresh.
*@

@namespace Sorcha.UI.Components.User.Components.Activity

@implements IDisposable

@inject IInboxApiService InboxApi
@inject TenantHubConnection TenantHub
@inject ILogger<ActivityFeed> Logger
@inject NavigationManager Navigation

@using Sorcha.UI.Core.Services
@using Sorcha.UI.Components.User.Components.Shared
@using Sorcha.UI.Components.User.Services.Shared
@using MudBlazor
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components

<div data-testid="activity-feed">
    @if (_loading && _entries.Count == 0)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" data-testid="activity-feed-loading" />
    }
    else if (_entries.Count == 0)
    {
        <div data-testid="activity-feed-empty">
            <EmptyState Icon="@Icons.Material.Filled.History"
                        Title="No activity yet"
                        Description="Your activity history will appear here." />
        </div>
    }
    else
    {
        <MudList T="InboxEntryDto" Class="pa-0">
            @foreach (var entry in _entries)
            {
                var isUnread = entry.ReadAt is null;
                <MudListItem T="InboxEntryDto"
                             Style="@(isUnread ? "background-color: rgba(79,70,229,0.06);" : "")"
                             data-testid="@($"activity-entry-{entry.Id}")">
                    <div class="d-flex flex-column gap-1" @onclick="() => HandleEntryClickAsync(entry)"
                         style="@(!string.IsNullOrWhiteSpace(entry.DetailHref) ? "cursor:pointer;" : "")">
                        <div class="d-flex align-center gap-2">
                            @* Issue #1273: the glyph now honours the entry's own iconKey (e.g.
                               "workflow.rejected") and only falls back to a category glyph. *@
                            <MudIcon Icon="@IconFor(entry.IconKey, entry.Category)"
                                     Color="@SeverityColor(entry.Severity)"
                                     Size="Size.Small"
                                     data-testid="@($"activity-icon-{entry.Id}")" />
                            <MudText Typo="Typo.body2">
                                <strong>@entry.Title</strong>
                            </MudText>
                            @* Issue #1273: the chip used to be a bare Actionable/Informational
                               binary, so a warning-severity rejection read exactly like
                               "Profile updated". It now names the severity when that is elevated. *@
                            <MudChip T="string" Size="Size.Small"
                                     Color="@ChipColor(entry.Category, entry.Severity)"
                                     Variant="Variant.Filled"
                                     data-testid="@($"activity-chip-{entry.Id}")">
                                @ChipLabel(entry.Category, entry.Severity)
                            </MudChip>
                            @if (isUnread)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Circle"
                                         Color="Color.Primary"
                                         Size="Size.Small"
                                         Title="Unread" />
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Summary))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Summary</MudText>
                        }
                        <MudText Typo="Typo.caption">@FormatTimestamp(entry.OccurredAt)</MudText>
                    </div>
                </MudListItem>
                <MudDivider />
            }
        </MudList>
        @if (_entries.Count < _totalCount)
        {
            <div class="d-flex justify-center pa-3" data-testid="activity-feed-load-more">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Disabled="@_loadingMore"
                           OnClick="LoadMoreAsync">
                    @if (_loadingMore)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Load more
                </MudButton>
            </div>
        }
    }
</div>

@code {
    /// <summary>Entries per incremental load (clamped 1..100 server-side).</summary>
    [Parameter] public int PageSize { get; set; } = 20;

    private readonly List<InboxEntryDto> _entries = new();
    private bool _loading;
    private bool _loadingMore;
    private bool _disposed;
    private int _currentPage = 1;
    private int _totalCount;

    protected override async Task OnInitializedAsync()
    {
        TenantHub.OnInboxEntryAdded += OnInboxEntryAddedAsync;
        await LoadAsync();
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        TenantHub.OnInboxEntryAdded -= OnInboxEntryAddedAsync;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _currentPage = 1;
        try
        {
            var page = await InboxApi.ListAsync(page: 1, pageSize: PageSize, actionableOnly: false);
            _entries.Clear();
            if (page is not null)
            {
                _entries.AddRange(page.Entries);
                _totalCount = page.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ActivityFeed — failed to load inbox entries");
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;
        try
        {
            var nextPage = _currentPage + 1;
            var page = await InboxApi.ListAsync(page: nextPage, pageSize: PageSize, actionableOnly: false);
            if (page is not null && page.Entries.Count > 0)
            {
                _entries.AddRange(page.Entries);
                _totalCount = page.TotalCount;
                _currentPage = nextPage;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ActivityFeed — failed to load more inbox entries");
        }
        finally
        {
            _loadingMore = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnInboxEntryAddedAsync(string entryId, DateTimeOffset occurredAt, string traceId)
    {
        await LoadAsync();
    }

    private async Task HandleEntryClickAsync(InboxEntryDto entry)
    {
        if (entry.ReadAt is null)
        {
            var ok = await InboxApi.MarkReadAsync(entry.Id);
            if (ok)
            {
                var idx = _entries.FindIndex(e => e.Id == entry.Id);
                if (idx >= 0)
                {
                    _entries[idx] = entry with { ReadAt = DateTimeOffset.UtcNow };
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        if (!string.IsNullOrWhiteSpace(entry.DetailHref))
        {
            Navigation.NavigateTo(entry.DetailHref);
        }
    }

    /// <summary>
    /// Resolves the row glyph: the entry's own <c>iconKey</c> first, then its category.
    /// </summary>
    /// <remarks>
    /// Issue #1273: <c>iconKey</c> was ignored entirely, and the category switch was case-sensitive
    /// PascalCase against a lower-case wire value — so EVERY row fell through to the generic bell,
    /// which is exactly what the citizen reported seeing on all five entries.
    /// </remarks>
    internal static string IconFor(string? iconKey, string? category)
    {
        var key = ActivityClassification.Normalise(iconKey);
        var byKey = key switch
        {
            "workflowrejected" => Icons.Material.Filled.Cancel,
            "workflowapproved" => Icons.Material.Filled.CheckCircle,
            "workflowcompleted" => Icons.Material.Filled.TaskAlt,
            "credentialissued" or "credentialreceived" => Icons.Material.Filled.VerifiedUser,
            "credentialrevoked" => Icons.Material.Filled.GppBad,
            "securityalert" => Icons.Material.Filled.Shield,
            "devicepaired" or "deviceenrolled" => Icons.Material.Filled.PhonelinkRing,
            "devicerevoked" => Icons.Material.Filled.PhonelinkErase,
            _ => null,
        };

        return byKey ?? IconForCategory(category);
    }

    private static string IconForCategory(string? category) => ActivityClassification.Normalise(category) switch
    {
        "action" => Icons.Material.Filled.AssignmentTurnedIn,
        "credential" => Icons.Material.Filled.VerifiedUser,
        "membership" => Icons.Material.Filled.GroupAdd,
        "security" => Icons.Material.Filled.Security,
        "system" => Icons.Material.Filled.Campaign,
        "workflow" => Icons.Material.Filled.AccountTree,
        _ => Icons.Material.Filled.Notifications,
    };

    /// <summary>Severity accent colour. Normalised — the wire sends kebab/lower-case (#1273).</summary>
    internal static Color SeverityColor(string? severity) => ActivityClassification.Normalise(severity) switch
    {
        "critical" => Color.Error,
        "actionrequired" => Color.Warning,
        "warning" => Color.Warning,
        _ => Color.Default,
    };

    /// <summary>
    /// The row's classification chip. Names the severity when it is elevated, so a rejected identity
    /// application cannot read as routine information (#1273).
    /// </summary>
    internal static string ChipLabel(string? category, string? severity)
        => ActivityClassification.Normalise(severity) switch
        {
            "critical" => "Critical",
            "actionrequired" => "Action needed",
            "warning" => "Warning",
            _ => ActivityClassification.IsActionable(category ?? "", severity ?? "")
                ? "Actionable"
                : "Informational",
        };

    /// <summary>Chip colour, matched to <see cref="ChipLabel"/>.</summary>
    internal static Color ChipColor(string? category, string? severity)
        => ActivityClassification.Normalise(severity) switch
        {
            "critical" => Color.Error,
            "actionrequired" or "warning" => Color.Warning,
            _ => ActivityClassification.IsActionable(category ?? "", severity ?? "")
                ? Color.Warning
                : Color.Default,
        };

    private static string FormatTimestamp(DateTimeOffset occurredAt)
    {
        var age = DateTimeOffset.UtcNow - occurredAt;
        if (age.TotalSeconds < 60) return "just now";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalHours < 24) return $"{(int)age.TotalHours}h ago";
        if (age.TotalDays < 7) return $"{(int)age.TotalDays}d ago";
        return occurredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm");
    }
}
