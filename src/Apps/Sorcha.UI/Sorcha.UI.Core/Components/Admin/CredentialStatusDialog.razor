@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@GetActionIcon()" Color="@GetTitleColor()" />
            <MudText Typo="Typo.h6">@Action Credential</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Credential ID: <strong>@CredentialId</strong>
            </MudText>

            @if (Action == "Revoke")
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                    This action is <strong>irreversible</strong>. The credential will be permanently revoked and cannot be reinstated.
                </MudAlert>
            }
            else if (Action == "Suspend")
            {
                <MudAlert Severity="Severity.Warning">
                    Suspending this credential will prevent it from being presented until reinstated.
                </MudAlert>
            }
            else if (Action == "Reinstate")
            {
                <MudAlert Severity="Severity.Info">
                    Reinstating this credential will allow it to be presented again.
                </MudAlert>
            }
            else if (Action == "Refresh")
            {
                <MudAlert Severity="Severity.Info">
                    Refreshing this credential will extend its validity with a new expiry date.
                </MudAlert>
            }

            @if (RequiresReason)
            {
                <MudTextField T="string" Label="Reason" @bind-Value="_reason"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Placeholder="@GetReasonPlaceholder()"
                              HelperText="A reason is required for this action." />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@GetConfirmColor()" Variant="Variant.Filled"
                   Disabled="@(RequiresReason && string.IsNullOrWhiteSpace(_reason))"
                   OnClick="Confirm">
            @Action
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The credential ID this action applies to.</summary>
    [Parameter, EditorRequired]
    public string CredentialId { get; set; } = string.Empty;

    /// <summary>The lifecycle action: "Suspend", "Revoke", "Reinstate", or "Refresh".</summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = string.Empty;

    private string? _reason;

    private bool RequiresReason => Action is "Suspend" or "Revoke";

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_reason ?? string.Empty));

    private string GetActionIcon() => Action switch
    {
        "Suspend" => Icons.Material.Filled.Pause,
        "Reinstate" => Icons.Material.Filled.PlayArrow,
        "Revoke" => Icons.Material.Filled.Cancel,
        "Refresh" => Icons.Material.Filled.Refresh,
        _ => Icons.Material.Filled.Info
    };

    private Color GetTitleColor() => Action switch
    {
        "Revoke" => Color.Error,
        "Suspend" => Color.Warning,
        "Reinstate" => Color.Success,
        "Refresh" => Color.Primary,
        _ => Color.Default
    };

    private Color GetConfirmColor() => Action switch
    {
        "Suspend" => Color.Warning,
        "Reinstate" => Color.Success,
        "Revoke" => Color.Error,
        "Refresh" => Color.Primary,
        _ => Color.Primary
    };

    private string GetReasonPlaceholder() => Action switch
    {
        "Suspend" => "Reason for suspension...",
        "Revoke" => "Reason for revocation...",
        _ => "Reason..."
    };
}
