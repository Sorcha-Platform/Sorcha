@using MudBlazor
@using Sorcha.UI.Core.Models.Credentials

<MudDataGrid T="IssuedCredentialListItem" Items="Credentials" Loading="IsLoading"
             Filterable="false" SortMode="SortMode.Multiple"
             Hover="true" Striped="true" Dense="true" Elevation="2">
    <Columns>
        <PropertyColumn Property="x => x.Type" Title="Type" />
        <PropertyColumn Property="x => x.IssuedToName" Title="Issued To" />
        <TemplateColumn Title="Via Blueprint">
            <CellTemplate>
                @if (!string.IsNullOrWhiteSpace(context.Item.BlueprintName))
                {
                    <MudText Typo="Typo.body2">@context.Item.BlueprintName</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Tertiary">—</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Issued Date" SortBy="x => x.IssuedAt">
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.IssuedAt.LocalDateTime.ToString("g")</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Expires" SortBy="x => x.ExpiresAt">
            <CellTemplate>
                @if (context.Item.ExpiresAt.HasValue)
                {
                    var color = context.Item.IsExpired ? Color.Error
                        : context.Item.IsExpiringSoon ? Color.Warning
                        : Color.Default;
                    <MudText Typo="Typo.body2" Color="@color">
                        @context.Item.ExpiresAt.Value.LocalDateTime.ToString("g")
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Tertiary">Never</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" SortBy="x => x.Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Presentations" SortBy="x => x.PresentationCount">
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.PresentationCount</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight">
                    @if (context.Item.Status == CredentialStatus.Active)
                    {
                        <MudMenuItem OnClick="@(() => OnStatusAction.InvokeAsync((context.Item.CredentialId, "Suspend")))">
                            Suspend
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => OnStatusAction.InvokeAsync((context.Item.CredentialId, "Revoke")))">
                            <MudText Color="Color.Error">Revoke</MudText>
                        </MudMenuItem>
                    }
                    @if (context.Item.Status == CredentialStatus.Suspended)
                    {
                        <MudMenuItem OnClick="@(() => OnStatusAction.InvokeAsync((context.Item.CredentialId, "Reinstate")))">
                            Reinstate
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => OnStatusAction.InvokeAsync((context.Item.CredentialId, "Revoke")))">
                            <MudText Color="Color.Error">Revoke</MudText>
                        </MudMenuItem>
                    }
                    @if (context.Item.Status == CredentialStatus.Expired || context.Item.IsExpired)
                    {
                        <MudMenuItem OnClick="@(() => OnStatusAction.InvokeAsync((context.Item.CredentialId, "Refresh")))">
                            Refresh
                        </MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="IssuedCredentialListItem" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Class="pa-4" Color="Color.Secondary">No credentials found matching the current filters.</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    /// <summary>The credentials to display in the grid.</summary>
    [Parameter, EditorRequired]
    public List<IssuedCredentialListItem> Credentials { get; set; } = [];

    /// <summary>Raised when the user selects a lifecycle action from the grid menu.</summary>
    [Parameter]
    public EventCallback<(string CredentialId, string Action)> OnStatusAction { get; set; }

    /// <summary>Whether the grid is in a loading state.</summary>
    [Parameter]
    public bool IsLoading { get; set; }

    private static Color GetStatusColor(string status) => status switch
    {
        CredentialStatus.Active => Color.Success,
        CredentialStatus.Suspended => Color.Warning,
        CredentialStatus.Revoked => Color.Error,
        CredentialStatus.Expired => Color.Default,
        CredentialStatus.Consumed => Color.Info,
        _ => Color.Default
    };
}
