@using MudBlazor
@using Sorcha.UI.Core.Models.Credentials
@using Sorcha.UI.Core.Services.Credentials

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Share" />
            <MudText Typo="Typo.h6">Presentation Request</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @* Expiry countdown *@
            @if (!Request.IsExpired)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Request expires in @FormatTimeRemaining()
                </MudText>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true">This request has expired.</MudAlert>
            }

            @* Credential selection — when multiple credentials match, allow choosing first *@
            @if (Request.MatchingCredentials.Count > 1)
            {
                <MudText Typo="Typo.subtitle2">Select Credential</MudText>
                <MudRadioGroup T="string" Value="@_selectedCredentialId" ValueChanged="OnCredentialSelected">
                    @foreach (var cred in Request.MatchingCredentials)
                    {
                        <MudRadio T="string" Value="@cred.CredentialId" Color="Color.Primary">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@cred.Type</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Issuer: @(cred.IssuerDid.Length > 30 ? cred.IssuerDid[..30] + "..." : cred.IssuerDid)
                                </MudText>
                            </MudStack>
                        </MudRadio>
                    }
                </MudRadioGroup>
            }
            else if (Request.MatchingCredentials.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    No matching credentials found in your wallet for this request.
                </MudAlert>
            }

            @* DisclosurePicker replaces the previous flat checkbox list *@
            @if (!Request.IsExpired && _selectedCredential is not null)
            {
                <DisclosurePicker VerifierIdentity="@Request.VerifierIdentity"
                                  BlueprintContext="@Request.CredentialType"
                                  MatchedCredential="@BuildMatchedCredentialCard()"
                                  Claims="@_disclosureClaims"
                                  OnPresent="@HandlePresent"
                                  OnDeny="@HandleDeny"
                                  IsLoading="@_submitting" />
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Actions are provided inline by DisclosurePicker; only Cancel remains here *@
        <MudButton Color="Color.Default" OnClick="@(() => MudDialog.Close())"
                   Disabled="@_submitting">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public PresentationRequestViewModel Request { get; set; } = default!;

    [Parameter]
    public EventCallback<PresentationSubmitResult> OnSubmitted { get; set; }

    [Parameter]
    public EventCallback OnDenied { get; set; }

    [Inject]
    private ICredentialApiService CredentialApi { get; set; } = default!;

    private string _selectedCredentialId = string.Empty;
    private MatchingCredentialViewModel? _selectedCredential;
    private List<DisclosureClaimViewModel> _disclosureClaims = [];
    private bool _submitting;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        // Auto-select first matching credential
        if (Request.MatchingCredentials.Count > 0)
        {
            OnCredentialSelected(Request.MatchingCredentials[0].CredentialId);
        }
    }

    private void OnCredentialSelected(string credentialId)
    {
        _selectedCredentialId = credentialId;
        _selectedCredential = Request.MatchingCredentials
            .FirstOrDefault(c => c.CredentialId == credentialId);

        _disclosureClaims = BuildDisclosureClaims();
    }

    /// <summary>
    /// Builds the DisclosureClaimViewModel list from the selected credential's available claims
    /// and the verifier's requested claims.
    /// </summary>
    private List<DisclosureClaimViewModel> BuildDisclosureClaims()
    {
        if (_selectedCredential is null)
            return [];

        // Convert the flat AvailableClaims list to a dictionary with placeholder values,
        // as DisclosureClaimViewModel.CategoriseClaims requires Dictionary<string, object>.
        // Claim values are not exposed in MatchingCredentialViewModel (by design — they are
        // disclosed only upon presentation); we use empty string as the display value here.
        var allClaims = _selectedCredential.AvailableClaims
            .ToDictionary(c => c, c => (object)string.Empty);

        // All RequestedClaims are treated as Required; no Optional set is known at this level.
        return DisclosureClaimViewModel.CategoriseClaims(
            allClaims,
            requiredClaims: Request.RequestedClaims,
            disclosable: _selectedCredential.AvailableClaims,
            optionalClaims: null);
    }

    /// <summary>
    /// Maps the selected MatchingCredentialViewModel to a CredentialCardViewModel
    /// for display inside DisclosurePicker.
    /// </summary>
    private CredentialCardViewModel? BuildMatchedCredentialCard()
    {
        if (_selectedCredential is null)
            return null;

        return new CredentialCardViewModel
        {
            CredentialId = _selectedCredential.CredentialId,
            Type = _selectedCredential.Type,
            IssuerDid = _selectedCredential.IssuerDid,
            IssuerName = _selectedCredential.IssuerDid.Length > 20
                ? _selectedCredential.IssuerDid[..10] + "..." + _selectedCredential.IssuerDid[^10..]
                : _selectedCredential.IssuerDid,
            IssuedAt = DateTimeOffset.UtcNow,
            ExpiresAt = _selectedCredential.ExpiresAt,
            DisclosableClaims = _selectedCredential.AvailableClaims,
        };
    }

    /// <summary>
    /// Called by DisclosurePicker when the holder confirms presentation.
    /// Receives the list of claim names the holder chose to disclose.
    /// </summary>
    private async Task HandlePresent(List<string> disclosedClaims)
    {
        _submitting = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await CredentialApi.SubmitPresentationAsync(
            Request.RequestId,
            _selectedCredentialId,
            disclosedClaims,
            "placeholder-vp-token");

        _submitting = false;

        if (result.Success)
        {
            await OnSubmitted.InvokeAsync(result);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Failed to submit presentation.";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Called by DisclosurePicker when the holder denies the presentation request.
    /// </summary>
    private async Task HandleDeny()
    {
        _submitting = true;
        StateHasChanged();

        var denied = await CredentialApi.DenyPresentationAsync(Request.RequestId);

        _submitting = false;

        if (denied)
        {
            await OnDenied.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(false));
        }
        else
        {
            _errorMessage = "Failed to deny request.";
            StateHasChanged();
        }
    }

    private string FormatTimeRemaining()
    {
        var remaining = Request.TimeRemaining;
        if (remaining.TotalHours >= 1) return $"{(int)remaining.TotalHours}h {remaining.Minutes}m";
        if (remaining.TotalMinutes >= 1) return $"{(int)remaining.TotalMinutes}m";
        return "less than a minute";
    }
}
