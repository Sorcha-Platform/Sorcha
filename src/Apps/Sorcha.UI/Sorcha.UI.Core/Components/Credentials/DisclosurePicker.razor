@using MudBlazor
@using Sorcha.UI.Core.Models.Credentials

<div style="max-width: 540px; margin: 0 auto;">

    @* ── Header: verifier identity ─────────────────────────────────────────── *@
    <MudPaper Elevation="1" Class="pa-4 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">🔍</MudText>
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@VerifierIdentity</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@BlueprintContext</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    @* ── Matched credential compact card ──────────────────────────────────── *@
    @if (MatchedCredential is not null)
    {
        <MudPaper Elevation="1" Class="pa-3 mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@MatchedCredential.Type</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @MatchedCredential.IssuerName · @MatchedCredential.IssuedAt.ToString("MMM d, yyyy")
                        </MudText>
                    </MudStack>
                </MudStack>
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                    Matched
                </MudChip>
            </MudStack>
        </MudPaper>
    }

    @* ── Claims disclosure section ─────────────────────────────────────────── *@
    <MudPaper Elevation="1" Class="mb-3" Style="overflow: hidden;">

        @* Required claims *@
        @{
            var requiredClaims = Claims?.Where(c => c.Category == DisclosureCategory.Required).ToList() ?? [];
        }
        @if (requiredClaims.Count > 0)
        {
            <div style="background: #f5f5f5; padding: 6px 16px;">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-size: 0.65rem; letter-spacing: 0.08em;">
                    Required by verifier
                </MudText>
            </div>
            @foreach (var claim in requiredClaims)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-4 py-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="Color.Primary" Size="Size.Small" />
                    <MudStack Spacing="0" Style="flex: 1;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@claim.ClaimName</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@claim.ClaimValue</MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Required</MudChip>
                </MudStack>
                <MudDivider />
            }
        }

        @* Optional claims *@
        @{
            var optionalClaims = Claims?.Where(c => c.Category == DisclosureCategory.Optional).ToList() ?? [];
        }
        @if (optionalClaims.Count > 0)
        {
            <div style="background: #f5f5f5; padding: 6px 16px;">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-size: 0.65rem; letter-spacing: 0.08em;">
                    Optional — you choose
                </MudText>
            </div>
            @foreach (var claim in optionalClaims)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-4 py-1">
                    <MudSwitch @bind-Value="claim.IsSharing"
                               Color="Color.Primary"
                               Size="Size.Small" />
                    <MudStack Spacing="0" Style="flex: 1;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@claim.ClaimName</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@claim.ClaimValue</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="@(claim.IsSharing ? Color.Success : Color.Default)">
                        @(claim.IsSharing ? "Sharing" : "Withheld")
                    </MudText>
                </MudStack>
                <MudDivider />
            }
        }

        @* Not-requested claims *@
        @{
            var notRequestedClaims = Claims?.Where(c => c.Category == DisclosureCategory.NotRequested).ToList() ?? [];
        }
        @if (notRequestedClaims.Count > 0)
        {
            <div style="background: #f5f5f5; padding: 6px 16px;">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="font-size: 0.65rem; letter-spacing: 0.08em;">
                    Not requested
                </MudText>
            </div>
            @foreach (var claim in notRequestedClaims)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-4 py-2" Style="opacity: 0.4;">
                    <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" />
                    <MudStack Spacing="0" Style="flex: 1;">
                        <MudText Typo="Typo.caption">@claim.ClaimName</MudText>
                        <MudText Typo="Typo.body2">@claim.ClaimValue</MudText>
                    </MudStack>
                </MudStack>
                <MudDivider />
            }
        }

    </MudPaper>

    @* ── Usage warning ─────────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(UsageWarning))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            ⚠️ @UsageWarning
        </MudAlert>
    }

    @* ── Action bar ────────────────────────────────────────────────────────── *@
    <MudPaper Elevation="0" Class="pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @SharingSummary
            </MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Disabled="@IsLoading"
                           OnClick="@HandleDeny">
                    Deny
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsLoading"
                           OnClick="@HandlePresent">
                    Present Credential
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

</div>

@code {
    /// <summary>Identity of the verifier requesting the presentation.</summary>
    [Parameter]
    public string VerifierIdentity { get; set; } = string.Empty;

    /// <summary>Blueprint context label (e.g. workflow name / action name).</summary>
    [Parameter]
    public string BlueprintContext { get; set; } = string.Empty;

    /// <summary>The credential matched against the verifier's request.</summary>
    [Parameter]
    public CredentialCardViewModel? MatchedCredential { get; set; }

    /// <summary>Full list of claims on the matched credential, categorised for disclosure.</summary>
    [Parameter]
    public List<DisclosureClaimViewModel> Claims { get; set; } = [];

    /// <summary>Optional usage or privacy warning to display to the holder.</summary>
    [Parameter]
    public string? UsageWarning { get; set; }

    /// <summary>
    /// Raised when the holder confirms presentation.
    /// Receives the list of claim names that will be disclosed.
    /// </summary>
    [Parameter]
    public EventCallback<List<string>> OnPresent { get; set; }

    /// <summary>Raised when the holder denies the presentation request.</summary>
    [Parameter]
    public EventCallback OnDeny { get; set; }

    /// <summary>When true, both action buttons are disabled.</summary>
    [Parameter]
    public bool IsLoading { get; set; }

    private string SharingSummary => DisclosureClaimViewModel.GetSharingSummary(Claims);

    private async Task HandlePresent()
    {
        var disclosed = DisclosureClaimViewModel.GetDisclosedClaimNames(Claims);
        await OnPresent.InvokeAsync(disclosed);
    }

    private async Task HandleDeny()
    {
        await OnDeny.InvokeAsync();
    }
}
