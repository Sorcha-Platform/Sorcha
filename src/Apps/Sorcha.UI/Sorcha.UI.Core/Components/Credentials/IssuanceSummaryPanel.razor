@using MudBlazor
@using Sorcha.UI.Core.Models.Credentials

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
            <MudText Typo="Typo.h6">Credential Issued</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudSimpleTable Dense="true" Hover="true" Bordered="false">
            <tbody>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Credential Type</MudText></td>
                    <td><MudText Typo="Typo.body2">@Summary.CredentialType</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Issued To</MudText></td>
                    <td>
                        <MudText Typo="Typo.body2">@Summary.IssuedToName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TruncateDid(Summary.IssuedToDid)</MudText>
                    </td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Signed By</MudText></td>
                    <td><MudText Typo="Typo.body2">@Summary.SignedByOrg</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Processed By</MudText></td>
                    <td><MudText Typo="Typo.body2">@Summary.ProcessedByName, @Summary.ProcessedByRole</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Claims Included</MudText></td>
                    <td><MudText Typo="Typo.body2">@Summary.TotalClaims total, @Summary.DisclosableClaims disclosable</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Usage Policy</MudText></td>
                    <td><MudText Typo="Typo.body2">@Summary.UsagePolicy</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Expires</MudText></td>
                    <td><MudText Typo="Typo.body2">@(Summary.ExpiresAt?.ToString("d MMM yyyy") ?? "No expiry")</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Blueprint</MudText></td>
                    <td><MudText Typo="Typo.body2">@Summary.BlueprintName</MudText></td>
                </tr>
                <tr>
                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">Action</MudText></td>
                    <td><MudText Typo="Typo.body2">@Summary.ActionName</MudText></td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => MudDialog.Close())">
            Done
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public IssuanceSummaryViewModel Summary { get; set; } = new();

    private static string TruncateDid(string did)
    {
        if (string.IsNullOrEmpty(did) || did.Length <= 20)
            return did;

        return $"{did[..10]}...{did[^10..]}";
    }
}
