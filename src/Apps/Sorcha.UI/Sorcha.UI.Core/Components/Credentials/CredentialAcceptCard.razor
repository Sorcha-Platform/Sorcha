@using MudBlazor
@using Sorcha.UI.Core.Models.Credentials

<MudCard Elevation="2" Style="border-left: 4px solid var(--mud-palette-warning); border-radius: 8px;">
    @if (IsLoading)
    {
        <MudProgressLinear Color="Color.Warning" Indeterminate="true" />
    }
    <MudCardContent>
        @* Header row: icon + type + issuer + Pending Review chip *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6" Style="line-height: 1">@GetTypeEmoji()</MudText>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600">@Credential.Type</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.7">@Credential.IssuerOrgName</MudText>
                </MudStack>
            </MudStack>
            <MudChip T="string" Color="Color.Warning" Size="MudBlazor.Size.Small" Variant="Variant.Filled">
                Pending Review
            </MudChip>
        </MudStack>

        @* Subtitle: from / via *@
        <MudText Typo="Typo.caption" Class="mb-3" Style="opacity: 0.7">
            From @Credential.IssuerOrgName
            @if (!string.IsNullOrEmpty(Credential.OriginatingBlueprintName))
            {
                <span> · via @Credential.OriginatingBlueprintName</span>
            }
        </MudText>

        @* Claims grid section *@
        @if (Credential.HighlightClaims.Count > 0)
        {
            <div style="background: var(--mud-palette-background-grey); border-radius: 6px; padding: 12px;" class="mb-3">
                <MudText Typo="Typo.overline" Style="font-size: 10px; letter-spacing: 0.08em; opacity: 0.6; display: block;" Class="mb-2">
                    Claims included
                </MudText>
                <MudGrid Spacing="1">
                    @foreach (var claim in Credential.HighlightClaims)
                    {
                        <MudItem xs="6">
                            <MudStack Spacing="0">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    @if (Credential.DisclosableClaims.Contains(claim.Key))
                                    {
                                        <span aria-label="You control disclosure" title="You control disclosure" style="font-size: var(--mud-typography-caption-size)">🔓</span>
                                    }
                                    else
                                    {
                                        <span aria-label="Always disclosed" title="Always disclosed" style="font-size: var(--mud-typography-caption-size)">🔒</span>
                                    }
                                    <MudText Typo="Typo.caption" Style="opacity: 0.7; font-weight: 500">@claim.Key</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Style="font-weight: 600; word-break: break-word;">@claim.Value</MudText>
                            </MudStack>
                        </MudItem>
                    }
                </MudGrid>
                <MudDivider Class="mt-2 mb-1" />
                <MudText Typo="Typo.caption" Style="opacity: 0.6; font-size: 10px;">
                    🔒 Always disclosed · 🔓 You control disclosure when presenting
                </MudText>
            </div>
        }

        @* Metadata row *@
        <MudText Typo="Typo.caption" Style="opacity: 0.6; font-size: 11px;">
            Issued: @Credential.IssuedAt.ToString("MMM d, yyyy")
            @if (Credential.ExpiresAt.HasValue)
            {
                <span> · Expires: @Credential.ExpiresAt.Value.ToString("MMM d, yyyy")</span>
            }
            <span> · Usage: @Credential.UsagePolicy</span>
            <span> · SD-JWT</span>
            <span> · @Credential.HighlightClaims.Count claim@(Credential.HighlightClaims.Count == 1 ? "" : "s")</span>
            @if (Credential.DisclosableClaims.Count > 0)
            {
                <span> · @Credential.DisclosableClaims.Count disclosable</span>
            }
        </MudText>
    </MudCardContent>

    @* Action buttons *@
    <MudCardActions>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Size="MudBlazor.Size.Small"
                   Disabled="IsLoading"
                   OnClick="@(() => OnDecline.InvokeAsync())">
            Decline
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="MudBlazor.Size.Small"
                   Disabled="IsLoading"
                   Class="ml-2"
                   OnClick="@(() => OnAccept.InvokeAsync())">
            Accept Credential
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public CredentialCardViewModel Credential { get; set; } = default!;

    [Parameter]
    public EventCallback OnAccept { get; set; }

    [Parameter]
    public EventCallback OnDecline { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    private string GetTypeEmoji() => Credential.DisplayConfig.Icon switch
    {
        "Shield" => "🛡️",
        "Badge" => "🏅",
        "School" => "🎓",
        "WorkspacePremium" => "⭐",
        _ => "🏛️"
    };
}
