@using MudBlazor
@using Sorcha.Blueprint.Models
@using Sorcha.Blueprint.Schemas.Client
@using Sorcha.UI.Core.Services
@using Sorcha.UI.Core.Services.Feedback
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using BlueprintAction = Sorcha.Blueprint.Models.Action

@inject IJSRuntime JS

<MudStack Spacing="3">
    <!-- Export/Import Toolbar -->
    <div class="d-flex gap-2 justify-end">
        <MudButton StartIcon="@Icons.Material.Filled.FileDownload"
                   Color="Color.Secondary"
                   Size="MudBlazor.Size.Small"
                   Variant="Variant.Outlined"
                   OnClick="ExportStrings"
                   Disabled="@(Blueprint is null)">
            Export Strings
        </MudButton>
        <MudFileUpload T="IBrowserFile" Accept=".json" FilesChanged="ImportStrings" Class="d-inline-flex">
            <ActivatorContent>
                <MudButton StartIcon="@Icons.Material.Filled.FileUpload"
                           Color="Color.Secondary"
                           Size="MudBlazor.Size.Small"
                           Variant="Variant.Outlined">
                    Import Translations
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>
    </div>

    <!-- Stale Instruction Warnings -->
    @if (_staleInstructions.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            <MudText Typo="Typo.body2">Stale instructions detected (@_staleInstructions.Count):</MudText>
            @foreach (var key in _staleInstructions)
            {
                <MudText Typo="Typo.caption">@key</MudText>
            }
        </MudAlert>
    }

    <!-- Blueprint Overview Instructions -->
    <MudText Typo="Typo.subtitle2">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="mr-1" />
        Blueprint Overview
    </MudText>
    <MudTextField @bind-Value="_overview"
                  Label="Overview (Markdown)"
                  Variant="Variant.Outlined"
                  Lines="5"
                  Margin="Margin.Dense"
                  HelperText="Markdown overview of the workflow purpose and usage"
                  Immediate="true"
                  TextChanged="OnOverviewChanged" />

    <MudDivider Class="my-2" />

    <!-- Per-Action Instructions -->
    <MudText Typo="Typo.subtitle2">
        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Class="mr-1" />
        Action Instructions
    </MudText>

    @if (Blueprint?.Actions != null)
    {
        @foreach (var action in Blueprint.Actions)
        {
            var actionId = action.Id;
            var currentText = GetActionInstruction(actionId);
            var schemaDescription = GetSchemaFallback(action);

            <MudPaper Class="pa-3 mb-2" Outlined="true">
                <MudText Typo="Typo.body2" Style="font-weight: 500;" Class="mb-2">
                    Action @actionId: @action.Title
                </MudText>
                <MudTextField Value="@currentText"
                              ValueChanged="@((string v) => SetActionInstruction(actionId, v))"
                              Label="Instructions (Markdown)"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Margin="Margin.Dense"
                              Immediate="true" />
                @if (schemaDescription is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.Schema" Size="Size.Small" />
                        Schema fallback: @schemaDescription
                    </MudText>
                }
            </MudPaper>
        }
    }

    <MudDivider Class="my-2" />

    <!-- Per-Participant Instructions -->
    <MudText Typo="Typo.subtitle2">
        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />
        Participant Instructions
    </MudText>

    @if (Blueprint?.Participants != null)
    {
        @foreach (var participant in Blueprint.Participants)
        {
            var name = participant.Name;
            var currentText = GetParticipantInstruction(name);

            <MudPaper Class="pa-3 mb-2" Outlined="true">
                <MudText Typo="Typo.body2" Style="font-weight: 500;" Class="mb-2">
                    @name
                </MudText>
                <MudTextField Value="@currentText"
                              ValueChanged="@((string v) => SetParticipantInstruction(name, v))"
                              Label="Role guidance (Markdown)"
                              Variant="Variant.Outlined"
                              Lines="2"
                              Margin="Margin.Dense"
                              Immediate="true" />
            </MudPaper>
        }
    }
</MudStack>

@code {
    [Parameter]
    public Blueprint? Blueprint { get; set; }

    [Parameter]
    public EventCallback<Blueprint> OnInstructionsChanged { get; set; }

    [Inject]
    private IInlineFeedback Feedback { get; set; } = null!;

    private string _overview = string.Empty;
    private List<string> _staleInstructions = [];
    private readonly InstructionExportService _exportService = new();

    protected override void OnParametersSet()
    {
        _overview = Blueprint?.Instructions?.Overview ?? string.Empty;
        DetectStaleInstructions();
    }

    private async Task ExportStrings()
    {
        if (Blueprint is null) return;

        var json = _exportService.Export(Blueprint);
        var fileName = $"instructions-{Blueprint.Id}.json";

        // Register download helper once, then call with data as arguments (no eval injection)
        await JS.InvokeVoidAsync("eval",
            "window.sorcha = window.sorcha || {}; " +
            "window.sorcha.downloadFile = window.sorcha.downloadFile || function(fileName, mimeType, content) { " +
            "var blob = new Blob([content], { type: mimeType }); " +
            "var url = URL.createObjectURL(blob); " +
            "var a = document.createElement('a'); " +
            "a.href = url; a.download = fileName; " +
            "document.body.appendChild(a); a.click(); " +
            "document.body.removeChild(a); URL.revokeObjectURL(url); };");

        await JS.InvokeVoidAsync("sorcha.downloadFile", fileName, "application/json", json);

        Feedback.ShowSuccess("Instruction strings exported");
    }

    private async Task ImportStrings(IBrowserFile? file)
    {
        if (file is null || Blueprint is null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1_048_576);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            _exportService.Import(Blueprint, json);
            _overview = Blueprint.Instructions?.Overview ?? string.Empty;
            await OnInstructionsChanged.InvokeAsync(Blueprint);
            DetectStaleInstructions();
            StateHasChanged();
            Feedback.ShowSuccess("Translations imported successfully");
        }
        catch (Exception ex)
        {
            Feedback.ShowError($"Import failed: {ex.Message}", autoDismissMs: 0);
        }
    }

    private void DetectStaleInstructions()
    {
        _staleInstructions = [];
        if (Blueprint?.Instructions is null) return;

        var actionIds = Blueprint.Actions?.Select(a => a.Id).ToHashSet() ?? [];
        var participantNames = Blueprint.Participants?.Select(p => p.Name).ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];

        // Check action instructions reference valid action IDs
        if (Blueprint.Instructions.ActionInstructions is not null)
        {
            foreach (var key in Blueprint.Instructions.ActionInstructions.Keys)
            {
                if (!actionIds.Contains(key))
                    _staleInstructions.Add($"Action instruction for removed action ID {key}");
            }
        }

        // Check participant instructions reference valid participants
        if (Blueprint.Instructions.ParticipantInstructions is not null)
        {
            foreach (var key in Blueprint.Instructions.ParticipantInstructions.Keys)
            {
                if (!participantNames.Contains(key))
                    _staleInstructions.Add($"Participant instruction for '{key}' (not in participants)");
            }
        }
    }

    private void EnsureInstructions()
    {
        if (Blueprint is null) return;
        Blueprint.Instructions ??= new BlueprintInstructions();
    }

    private async Task OnOverviewChanged(string value)
    {
        EnsureInstructions();
        Blueprint!.Instructions!.Overview = string.IsNullOrWhiteSpace(value) ? null : value;
        await OnInstructionsChanged.InvokeAsync(Blueprint);
    }

    private string GetActionInstruction(int actionId)
    {
        return Blueprint?.Instructions?.ActionInstructions?.GetValueOrDefault(actionId) ?? string.Empty;
    }

    private async Task SetActionInstruction(int actionId, string value)
    {
        EnsureInstructions();
        Blueprint!.Instructions!.ActionInstructions ??= new Dictionary<int, string>();

        if (string.IsNullOrWhiteSpace(value))
            Blueprint.Instructions.ActionInstructions.Remove(actionId);
        else
            Blueprint.Instructions.ActionInstructions[actionId] = value;

        await OnInstructionsChanged.InvokeAsync(Blueprint);
    }

    private string GetParticipantInstruction(string name)
    {
        return Blueprint?.Instructions?.ParticipantInstructions?.GetValueOrDefault(name) ?? string.Empty;
    }

    private async Task SetParticipantInstruction(string name, string value)
    {
        EnsureInstructions();
        Blueprint!.Instructions!.ParticipantInstructions ??= new Dictionary<string, string>();

        if (string.IsNullOrWhiteSpace(value))
            Blueprint.Instructions.ParticipantInstructions.Remove(name);
        else
            Blueprint.Instructions.ParticipantInstructions[name] = value;

        await OnInstructionsChanged.InvokeAsync(Blueprint);
    }

    private string? GetSchemaFallback(BlueprintAction action)
    {
        // Check first control's scope against data schemas for fallback description
        if (action.Form?.Elements is { Count: > 0 } elements && action.DataSchemas is not null)
        {
            var firstControl = elements.FirstOrDefault(e => !string.IsNullOrEmpty(e.Scope));
            if (firstControl is not null)
            {
                return SchemaDescriptionExtractor.GetDescription(firstControl.Scope, action.DataSchemas);
            }
        }
        return null;
    }
}
