{
  "Jwt": {
    "_comment": "Spec 136: Issuer + Audiences are derived from JwtSettings:InstallationName at startup (SorchaIssuer/SorchaAudiences) — do not hardcode them here. Set JwtSettings:InstallationName to match the platform.",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateIssuerSigningKey": true,
    "ValidateLifetime": true,
    "ClockSkewMinutes": 5,
    "SkipValidation": true
  },
  "ServiceClients": {
    "BlueprintService": {
      "Address": "http://localhost:5000"
    },
    "RegisterService": {
      "Address": "http://localhost:5290"
    },
    "WalletService": {
      "Address": "http://localhost:5001"
    },
    "TenantService": {
      "Address": "http://localhost:5110"
    },
    "ValidatorService": {
      "Address": "http://localhost:5004"
    },
    "PeerService": {
      "Address": "http://localhost:5002",
      "UseGrpc": true
    },
    "ApiGateway": {
      "Address": "http://localhost:80"
    }
  },
  "RateLimiting": {
    "McpPerUserRequestsPerMinute": 100,
    "McpPerTenantRequestsPerMinute": 1000,
    "McpAdminToolsRequestsPerMinute": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Sorcha.McpServer": "Information"
    }
  }
}
