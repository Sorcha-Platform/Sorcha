@page "/"
@using Sorcha.Mdoc.Proximity
@using Sorcha.Proximity
@implements IAsyncDisposable
@inject IReaderService Reader
@inject IJSRuntime JS

<PageTitle>Sorcha Reader</PageTitle>

@if (_phase == Phase.Checking)
{
    <p class="reader__status" aria-live="polite">Checking this device…</p>
}
else if (_phase == Phase.Unsupported)
{
    <h1>Can't read here</h1>
    <p class="reader__status">@UnsupportedMessage()</p>
}
else if (_phase == Phase.Ask)
{
    <h1>What do you need to know?</h1>
    <p class="reader__status">
        Ask for the least you need. They'll see exactly what you asked for before they decide.
    </p>

    <ul class="reader__questions">
        @foreach (var question in ReaderQuestion.All)
        {
            <li>
                <button class="reader__question" @onclick="() => Choose(question)">
                    <span class="reader__question-label">@question.Label</span>
                    <span class="reader__question-detail">@question.Detail</span>
                    @if (question.Elements.Any(e => e.IntentToRetain))
                    {
                        @* Shown to the VERIFIER too, not only the citizen. Keeping a copy is a decision, and
                           a verifier should have to notice they are making it. *@
                        <span class="reader__question-retain">You'll keep a record</span>
                    }
                </button>
            </li>
        }
    </ul>
}
else if (_phase == Phase.Scanning)
{
    <h1>Scan their code</h1>
    <p class="reader__status">@_question!.Label</p>

    <video id="reader-scan" playsinline muted autoplay class="reader__viewfinder"></video>

    @if (_scanError is not null)
    {
        <p class="reader__error" role="alert">@_scanError</p>
    }

    <button class="reader__secondary" @onclick="BackToAsk">Cancel</button>
}
else if (_phase == Phase.Reading)
{
    <h1>Reading…</h1>
    <p class="reader__status" aria-live="polite">Hold the devices close together.</p>
}
else if (_phase == Phase.Verdict && _verdict is not null)
{
    <div class="reader__verdict @(_verdict.Accepted ? "reader__verdict--pass" : "reader__verdict--fail")">
        <h1>@(_verdict.Accepted ? "Verified" : "Not verified")</h1>
    </div>

    @if (_verdict.Accepted)
    {
        <ul class="reader__claims">
            @foreach (var claim in _verdict.DisclosedClaims)
            {
                <li class="reader__claim">
                    <span class="reader__claim-name">@Humanise(claim.Key)</span>
                    <span class="reader__claim-value">@Render(claim.Value)</span>
                </li>
            }
        </ul>
    }
    else
    {
        <ul class="reader__errors">
            @foreach (var error in _verdict.Errors)
            {
                <li>@error</li>
            }
        </ul>
    }

    <h2 class="reader__trail-heading">How this was checked</h2>
    <ul class="reader__trail">
        @foreach (var layer in Layers())
        {
            <li class="reader__layer reader__layer--@layer.Status.ToLowerInvariant()">
                <span class="reader__layer-name">@layer.Name</span>
                <span class="reader__layer-status">@layer.Status</span>
            </li>
        }
    </ul>

    @* The honesty rule of the whole app. An offline reader CANNOT check the register, and reporting that as
       a pass would tell an operator their check succeeded when part of it never ran. "Not checked" is a
       third answer, distinct from pass and from fail, and it never vetoes an otherwise-good verdict. *@
    <p class="reader__offline-note">
        This check ran with no internet. The ledger anchor could not be confirmed — that is
        <strong>not checked</strong>, not a failure.
    </p>

    <button class="reader__primary" @onclick="BackToAsk">Read another</button>
}

@code {
    private enum Phase { Checking, Unsupported, Ask, Scanning, Reading, Verdict }

    private Phase _phase = Phase.Checking;
    private ProximityCapability _capability;
    private ReaderQuestion? _question;
    private ProximityVerdict? _verdict;
    private string? _scanError;

    private sealed record Layer(string Name, string Status);

    protected override async Task OnInitializedAsync()
    {
        _capability = await Reader.ProbeAsync();
        _phase = _capability.Supported ? Phase.Ask : Phase.Unsupported;
    }

    private async Task Choose(ReaderQuestion question)
    {
        _question = question;
        _scanError = null;
        _phase = Phase.Scanning;
        StateHasChanged();

        try
        {
            var payload = await JS.InvokeAsync<string>("SorchaQrScanner.start", "reader-scan");
            await ReadAsync(payload);
        }
        catch (Exception ex)
        {
            _scanError = ex.Message;
            StateHasChanged();
        }
    }

    private async Task ReadAsync(string payload)
    {
        _phase = Phase.Reading;
        StateHasChanged();

        try
        {
            _verdict = await Reader.ReadAsync(payload, _question!);
        }
        catch (Exception ex)
        {
            // A failed read is a verdict too — and it is emphatically NOT a pass.
            _verdict = new ProximityVerdict(
                Accepted: false,
                DocType: string.Empty,
                DisclosedClaims: new Dictionary<string, object>(),
                IssuerSignatureValid: false,
                DigestsValid: false,
                DeviceBindingValid: false,
                ValidityOk: false,
                Errors: [ex.Message]);
        }

        _phase = Phase.Verdict;
        StateHasChanged();
    }

    private async Task BackToAsk()
    {
        await StopScannerAsync();
        await Reader.DisposeAsync();

        _verdict = null;
        _question = null;
        _phase = Phase.Ask;
    }

    /// <summary>
    /// The four checks, and — crucially — an honest third status for the one that could not run offline.
    /// </summary>
    private IReadOnlyList<Layer> Layers()
    {
        var v = _verdict!;

        return
        [
            new Layer("They hold the credential", Verdict(v.DeviceBindingValid)),
            new Layer("The issuer signed it", Verdict(v.IssuerSignatureValid)),
            new Layer("Nothing has been altered", Verdict(v.DigestsValid)),
            new Layer("It is in date", Verdict(v.ValidityOk)),

            // Never rendered as a pass. Offline, this check did not run — and saying otherwise would be a
            // lie the operator would act on.
            new Layer("Anchored on the ledger", "Not checked"),
        ];
    }

    private static string Verdict(bool passed) => passed ? "Pass" : "Fail";

    private async Task StopScannerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("SorchaQrScanner.stop");
        }
        catch
        {
            // The scanner may never have started. Tearing down must never itself fail.
        }
    }

    private string UnsupportedMessage() => _capability.Reason switch
    {
        ProximityUnsupportedReason.BluetoothOff => "Turn Bluetooth on, then try again.",
        ProximityUnsupportedReason.PermissionNotYetRequested =>
            "The reader needs permission to use Bluetooth. Try again and allow it when asked.",
        ProximityUnsupportedReason.PermissionDenied =>
            "Bluetooth permission was refused. You can turn it back on in settings.",
        ProximityUnsupportedReason.NoBluetoothHardware => "This device has no Bluetooth.",
        ProximityUnsupportedReason.NoPlugin => "The reader needs the Sorcha Reader app — a browser tab can't use Bluetooth.",
        _ => "Reading isn't available on this device."
    };

    private static string Humanise(string element) => element switch
    {
        "family_name" => "Last name",
        "given_name" => "First name",
        "birth_date" => "Date of birth",
        "age_over_18" => "Over 18",
        "age_over_21" => "Over 21",
        "portrait" => "Photo",
        "document_number" => "Document number",
        "expiry_date" => "Expires",
        "issuing_authority" => "Issued by",
        _ => element.Replace('_', ' ')
    };

    private static string Render(object? value) => value switch
    {
        bool b => b ? "Yes" : "No",
        null => "—",
        byte[] bytes => $"({bytes.Length} bytes)",
        _ => value.ToString() ?? "—"
    };

    public async ValueTask DisposeAsync()
    {
        await StopScannerAsync();
        await Reader.DisposeAsync();
    }
}
