@*
    SPDX-License-Identifier: MIT
    Copyright (c) 2026 Sorcha Contributors

    Citizen wallet present page (Feature 114, T096-T100, T057). Three intake
    layouts selected by IDeviceProfileProbe on load (Feature 159):
      - CameraFirst   : handheld + usable camera — QR viewfinder auto-starts.
      - PasteWithScan : desktop + usable camera — paste is default, scan on demand.
      - PasteOnly     : no usable camera — paste field only, no scan control.
    All three layouts converge at _deepLink → ParseAsync(). Camera is always
    stopped on scan, paste-switch, cancel, navigation, or failure (FR-008).
*@
@page "/present"
@layout MainLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Buffers.Text
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using Microsoft.JSInterop
@using Sorcha.ServiceClients.CitizenWallet
@using Sorcha.UI.Core.Services.HolderKeys
@using Sorcha.Wallet.Pwa.Components
@using Sorcha.Wallet.Pwa.Models.Device
@using Sorcha.Wallet.Pwa.Services
@using Sorcha.Wallet.Pwa.Services.Device
@using Sorcha.Wallet.Pwa.Services.Presentation
@using Sorcha.Verifier.Engine.Dcql
@inject IPresentationEngine Engine
@inject ICredentialCache Credentials
@inject IDeviceKeyService DeviceKey
@inject IStatusListService StatusList
@inject ICitizenWalletClient WalletClient
@inject IHolderKeyClient HolderKeys
@inject HttpClient Http
@inject IJSRuntime JS
@inject IPresentationLog PresentationLog
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject IDeviceProfileProbe DeviceProbe

<PageTitle>Present a credential</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-3">Present a credential</MudText>

    @if (_phase == Phase.AwaitingDeepLink)
    {
        @* Feature 185 — in-person sharing.
           Capability-GATED, not merely linked: this build also runs in a plain browser (capacitor.config
           points the native shell at the hosted PWA), where there is no BLE at all. Offering an affordance
           that cannot work would be worse than not offering it (FR-020). *@
        @if (_proximitySupported)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-3" data-testid="present-proximity-card">
                <MudText Typo="Typo.subtitle2">Someone in front of you?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Share a credential directly with their device. Works with no signal.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Contactless"
                           data-testid="present-proximity-button"
                           OnClick="@(() => Nav.NavigateTo("present/proximity"))">
                    Share in person
                </MudButton>

            </MudPaper>
        }

        <MudPaper Elevation="1" Class="pa-4">
            @if (_intakeMode == IntakeMode.CameraFirst && !_showPaste)
            {
                @* US1: CameraFirst — viewfinder auto-starts, paste-instead escape *@
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Point your camera at the verifier's QR code.
                </MudText>
                <video id="@VideoElementId" playsinline muted autoplay data-testid="present-viewfinder"
                       style="width:100%; max-width:360px; aspect-ratio:1/1; object-fit:cover; border-radius:8px; background:#000;"></video>
                @if (!string.IsNullOrEmpty(_intakeMessage))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" data-testid="present-intake-message">
                        @_intakeMessage
                    </MudAlert>
                    @if (!_scanning)
                    {
                        <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary"
                                   data-testid="present-scan-again"
                                   OnClick="RescanAsync">
                            Scan again
                        </MudButton>
                    }
                }
                <MudButton Class="mt-3" Variant="Variant.Outlined"
                           data-testid="present-paste-instead"
                           OnClick="SwitchToPasteAsync">
                    Paste a link instead
                </MudButton>
            }
            else if (_intakeMode == IntakeMode.PasteWithScan && !_showPaste)
            {
                @* PasteWithScan with viewfinder active (user tapped "Scan with camera") *@
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Point your camera at the verifier's QR code.
                </MudText>
                <video id="@VideoElementId" playsinline muted autoplay data-testid="present-viewfinder"
                       style="width:100%; max-width:360px; aspect-ratio:1/1; object-fit:cover; border-radius:8px; background:#000;"></video>
                <MudButton Class="mt-3" Variant="Variant.Outlined"
                           OnClick="CancelScanAsync">
                    Cancel
                </MudButton>
                @if (!string.IsNullOrEmpty(_intakeMessage))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" data-testid="present-intake-message">
                        @_intakeMessage
                    </MudAlert>
                }
            }
            else
            {
                @* Paste field — shown for PasteWithScan (default), PasteOnly, or after fallback *@
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    @if (_intakeMode == IntakeMode.PasteWithScan)
                    {
                        <text>Paste the <code>openid4vp://</code> link, or scan a QR code with the camera.</text>
                    }
                    else
                    {
                        <text>Paste the <code>openid4vp://</code> link from the verifier.</text>
                    }
                </MudText>

                @* US2 only: offer "Scan with camera" *@
                @if (_intakeMode == IntakeMode.PasteWithScan)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.QrCodeScanner"
                               Variant="Variant.Filled" Color="Color.Primary"
                               Class="mb-3"
                               data-testid="present-scan-with-camera"
                               OnClick="StartDesktopScanAsync">
                        Scan with camera
                    </MudButton>
                }

                <MudTextField @bind-Value="_deepLink"
                              Label="Paste verifier deep link"
                              Lines="3" Variant="Variant.Outlined"
                              data-testid="present-paste-field" />
                <MudButton Class="mt-3" Variant="Variant.Outlined"
                           Disabled="@string.IsNullOrWhiteSpace(_deepLink)"
                           data-testid="present-continue"
                           OnClick="ParseAsync">
                    Continue
                </MudButton>

                @if (!string.IsNullOrEmpty(_intakeMessage))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" data-testid="present-intake-message">
                        @_intakeMessage
                    </MudAlert>
                }
            }
        </MudPaper>
    }
    else if (_phase == Phase.NoMatch)
    {
        <NoMatchingCredentialDialog RequiredVct="@_request?.RequiredVct"
                                    OnCancel="Reset" />
    }
    else if (_phase == Phase.BindFirst)
    {
        @* #1195 Phase 2 (Task 7) — the selection layer answered BindDeviceFirst: the citizen's
           assured-identity root can satisfy this request, but only a device-bound copy can be
           presented on this surface, and THIS device holds none. An explicit routing outcome —
           never a doomed present (device-signing the root fails verification with no local error). *@
        <MudAlert Severity="Severity.Info" Class="mb-3" data-testid="present-bind-first">
            This request needs a credential bound to this device, and this device isn't bound yet.
            Bind it first, then present again.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   data-testid="present-bind-cta"
                   OnClick="GoToBindSurface">
            Bind this device
        </MudButton>
        <MudButton Class="ml-2" Variant="Variant.Outlined" OnClick="Reset">Cancel</MudButton>
    }
    else if (_phase == Phase.Consent && _selected is not null && _request is not null)
    {
        <ConsentSheet Selected="_selected"
                      Request="_request"
                      OptionalToggles="_optionalToggles"
                      Busy="_busy"
                      OnConfirm="ConfirmAsync"
                      OnCancel="Reset" />
    }
    else if (_phase == Phase.PickAlternative && _currentAlternative is not null && _result is not null)
    {
        @* US2 — the citizen picks which alternative to provide (Passport OR Driving Licence). *@
        <CredentialPickerDialog SetChoice="_currentAlternative"
                                PerQuery="_result.PerQuery"
                                OnOptionChosen="OnAlternativeChosen"
                                OnCancel="Reset" />
    }
    else if (_phase == Phase.PickQueryCredential && _currentPickMatches is not null)
    {
        @* US2 — the active query matched several credentials; the citizen picks one. *@
        <CredentialPickerDialog Matches="_currentPickMatches"
                                OnChosen="OnQueryCredentialChosen"
                                OnCancel="Reset" />
    }
    else if (_phase == Phase.MultiConsent && _consentResult is not null && _request is not null)
    {
        <ConsentSheet Request="_request"
                      Result="_consentResult"
                      Selections="_selections"
                      QueryOptionalToggles="_queryOptionalToggles"
                      Busy="_busy"
                      OnConfirm="ConfirmMultiAsync"
                      OnCancel="Reset" />
    }
    else if (_phase == Phase.Done)
    {
        <MudAlert Severity="@(_responseStatus == "ok" ? Severity.Success : Severity.Error)" Class="mb-3">
            @_responseMessage
        </MudAlert>
        <MudButton Variant="Variant.Outlined" OnClick="Reset">Done</MudButton>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" data-testid="present-error">@_error</MudAlert>
    }
</MudContainer>

@code {
    private const string VideoElementId = "sorcha-qr-scan-video";

    private enum Phase { AwaitingDeepLink, NoMatch, BindFirst, Consent, PickAlternative, PickQueryCredential, MultiConsent, Done }

    // Feature 185. False until proven otherwise — an affordance the device cannot honour must not appear.
    private bool _proximitySupported;

    private Phase _phase = Phase.AwaitingDeepLink;
    private string _deepLink = string.Empty;
    private string? _error;
    private bool _busy;
    private ParsedPresentationRequest? _request;
    private CredentialMatch? _selected;
    // #1195 Phase 2 (Task 7) — HOW the selected credential's KB-JWT is signed. Returned by the
    // selection layer together with the credential; this page must never re-derive it.
    private PresentationSigningMode _signingMode = PresentationSigningMode.Device;
    private CredentialMatch? _bindRoot;
    private Dictionary<string, bool> _optionalToggles = new();
    private string _responseStatus = string.Empty;
    private string _responseMessage = string.Empty;

    // Feature 181 US2 — multi-credential orchestration state (active only when the request
    // carries more than one credential query or a multi-option credential_set).
    private IReadOnlyList<CachedCredential> _cachedCreds = [];
    private DcqlMatchResult? _result;
    private DcqlMatchResult? _consentResult;
    private readonly Dictionary<string, CredentialMatch> _selections = new(StringComparer.Ordinal);
    private Dictionary<string, Dictionary<string, bool>> _queryOptionalToggles = new();
    private readonly List<string> _activeQueryIds = new();
    private readonly Dictionary<int, IReadOnlyList<string>> _chosenOptionBySetIndex = new();
    private DcqlSetChoice? _currentAlternative;
    private int _currentAlternativeSetIndex = -1;
    private IReadOnlyList<CredentialMatch>? _currentPickMatches;
    private string? _currentPickQueryId;

    // Feature 159 — intake layout state.
    private IntakeMode _intakeMode = IntakeMode.PasteOnly;
    private bool _showPaste = true;
    private bool _cameraRefusedThisSession;
    private bool _userChosePaste;   // set when user explicitly taps "Paste instead"
    private string? _intakeMessage;

    // Auto-start guard: fires once per load on CameraFirst.
    private bool _autoStartFired;

    // Set to true when StartScanAsync calls ParseAsync so the catch can distinguish
    // a bad-QR-code result from a paste-field parse failure.
    private bool _deepLinkFromScan;

    // Legacy field — kept for DisposeAsync (camera cleanup).
    private bool _scanning;
    private string? _scanError;

    protected override async Task OnInitializedAsync()
    {
        // Feature 185: ask the device what it can do BEFORE offering in-person sharing.
        //
        // Resolved through IServiceProvider rather than @inject, deliberately. The online presentation path
        // must not acquire a hard dependency on a BLE transport it never uses — a host (or a test) that has
        // no proximity registration should still render this page perfectly. Graceful-skip, the same pattern
        // F183 used for IClaimSourceSeeder.
        try
        {
            var transport = Services.GetService(typeof(Sorcha.Proximity.IProximityTransport))
                as Sorcha.Proximity.IProximityTransport;

            _proximitySupported = transport is not null && (await transport.ProbeAsync()).Supported;
        }
        catch
        {
            // An unsupported device is a normal answer, not an error. Never let it break the online path.
            _proximitySupported = false;
        }

        try
        {
            var profile = await DeviceProbe.GetProfileAsync();
            _intakeMode = profile.Mode;
            // PasteWithScan and PasteOnly start with paste shown; CameraFirst starts without.
            _showPaste = _intakeMode != IntakeMode.CameraFirst;
        }
        catch
        {
            // Probe failure → paste-safe fallback (contracts/device-profile.md).
            _intakeMode = IntakeMode.PasteOnly;
            _showPaste = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // US1: auto-start (or re-start after Reset) for CameraFirst when the scanner is not already running.
        // _autoStartFired is cleared by Reset() so re-entry after "Done" fires the camera again.
        if (!_autoStartFired && _intakeMode == IntakeMode.CameraFirst && !_cameraRefusedThisSession && !_showPaste)
        {
            _autoStartFired = true;
            await StartScanAsync();
        }
    }

    private async Task ParseAsync()
    {
        _error = null;
        _intakeMessage = null;
        var fromScan = _deepLinkFromScan;
        _deepLinkFromScan = false;
        try
        {
            // Feature 181 — the deep link carries a request_uri; the engine fetches the
            // request object (anonymous GET) and parses its dcql_query.
            _request = await Engine.ParseAsync(
                _deepLink.Trim(),
                async (url, ct) =>
                {
                    var resp = await Http.GetAsync(url, ct);
                    resp.EnsureSuccessStatusCode();
                    return await resp.Content.ReadAsStringAsync(ct);
                });
            _cachedCreds = await Credentials.ListAsync();

            // Feature 181 US2 — multi-credential requests (>1 credential query, or a credential_set
            // offering alternatives) take the per-query orchestration path; the proven single-ask
            // flow is preserved verbatim for the common single-credential request.
            if (IsMultiCredential(_request))
            {
                BeginMultiFlow();
                return;
            }

            // #1195 Phase 2 (Task 7) — the selection layer picks WHICH credential + signing path
            // this surface uses. This page is the web/remote surface: the holder-cnf root presents
            // SERVER-CUSTODY (the wallet service signs the KB-JWT); a device-cnf copy device-signs.
            var deviceThumbprint = await TryGetDeviceThumbprintAsync();
            var holderThumbprint = await TryGetHolderThumbprintAsync();
            var selection = Engine.Select(
                _request, _cachedCreds, deviceThumbprint, holderThumbprint, PresentationSurface.Remote);
            switch (selection.Outcome)
            {
                case PresentationSelectionOutcome.Selected:
                    _selected = selection.Match;
                    _signingMode = selection.SigningMode;
                    EnterConsent();
                    break;
                case PresentationSelectionOutcome.BindDeviceFirst:
                    _bindRoot = selection.RootToBind;
                    _phase = Phase.BindFirst;
                    break;
                case PresentationSelectionOutcome.HolderKeyUnavailable:
                    // Fail-closed, named — never a guessed present that cannot verify.
                    _error = "Your wallet's holder key couldn't be reached, so the right credential " +
                             "for this request can't be determined. Check your connection and try again.";
                    break;
                default:
                    _phase = Phase.NoMatch;
                    break;
            }
        }
        catch (Exception ex)
        {
            // FR-009: bad QR from any scan path — show friendly message so holder can retry or paste.
            if (fromScan)
            {
                _intakeMessage = "Couldn't read that QR code as a verifier request. Try again or paste the link instead.";
                _showPaste = _intakeMode != IntakeMode.CameraFirst;  // CameraFirst stays in viewfinder; PasteWithScan returns to paste
            }
            else
            {
                _error = ex.Message;
            }
        }
    }

    private void EnterConsent()
    {
        _optionalToggles = (_selected?.AvailableOptional ?? Array.Empty<string>())
            .ToDictionary(n => n, _ => false);
        _phase = Phase.Consent;
    }

    private async Task ConfirmAsync()
    {
        if (_selected is null || _request is null) return;
        _busy = true;
        _error = null;
        try
        {
            var approved = _selected.SatisfiedRequired
                .Concat(_optionalToggles.Where(kv => kv.Value).Select(kv => kv.Key))
                .ToList();

            // #1195 Phase 2 (Task 7) — the signer follows the selection's signing mode. The
            // holder-cnf root signs SERVER-CUSTODY (Task 6a endpoint; the holder private key
            // never reaches this device); a device-cnf copy / legacy credential device-signs.
            JsonElement signerJwk;
            Func<byte[], CancellationToken, Task<byte[]>> signer;
            if (_signingMode == PresentationSigningMode.ServerCustody)
            {
                var holderKeys = await HolderKeys.GetHolderKeysAsync();
                if (holderKeys is null)
                {
                    _error = "Your wallet's holder key couldn't be reached, so this presentation " +
                             "can't be signed. Check your connection and try again.";
                    return;
                }
                signerJwk = holderKeys.HolderJwk;
                signer = SignWithHolderKeyAsync;
            }
            else
            {
                signerJwk = await DeviceKey.GetPublicJwkAsync();
                signer = DeviceKey.SignAsync;
            }

            var vp = await Engine.BuildVpTokenAsync(
                _selected, approved, _request, signerJwk, signer);

            // Standard OpenID4VP 1.0 direct_post (§8.2): vp_token is ALWAYS the object-keyed
            // envelope, even for the single-ask flow — a bare compact string is the retired
            // dialect and HAIP rejects it. Wrap via DcqlVpToken so the wire shape is byte-identical
            // to the multi-credential envelope path.
            var queryId = _request.Query.Credentials[0].Id;
            var vpTokenEnvelope = new DcqlVpToken
            {
                Presentations = new Dictionary<string, IReadOnlyList<string>> { [queryId] = [vp] },
            }.ToJson();

            var form = new FormUrlEncodedContent(new Dictionary<string, string>
            {
                ["vp_token"] = vpTokenEnvelope,
                ["state"] = _request.State,
            });
            var resp = await Http.PostAsync(_request.ResponseUri, form);
            if (resp.IsSuccessStatusCode)
            {
                _responseStatus = "ok";
                _responseMessage = "Verifier accepted the presentation.";
            }
            else
            {
                _responseStatus = "fail";
                _responseMessage = $"Verifier returned {(int)resp.StatusCode} {resp.StatusCode}.";
            }

            await TryLogPresentationAsync(approved, resp.IsSuccessStatusCode);

            _phase = Phase.Done;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task TryLogPresentationAsync(IReadOnlyList<string> disclosedClaims, bool accepted)
    {
        if (_selected is null || _request is null) return;
        try
        {
            var entry = new PresentationLogEntry(
                Id: Guid.NewGuid(),
                PresentedAt: DateTimeOffset.UtcNow,
                CredentialType: _selected.Credential.Vct,
                CredentialLabel: _selected.Credential.DisplayLabel,
                VerifierLabel: string.IsNullOrWhiteSpace(_request.Purpose)
                    ? _request.ClientId
                    : _request.Purpose!,
                DisclosedClaims: disclosedClaims,
                Outcome: accepted ? PresentationLogOutcome.Sent : PresentationLogOutcome.Rejected,
                CredentialId: _selected.Credential.Id);
            await PresentationLog.AppendAsync(entry);
        }
        catch
        {
            // Activity log is a convenience surface; never let it break the flow.
        }
    }

    // ─────────────────── #1195 Phase 2 (Task 7) — selection inputs + server-custody leg ───────────────────

    /// <summary>This device's key thumbprint, or null when no usable device key exists (non-PWA host).</summary>
    private async Task<string?> TryGetDeviceThumbprintAsync()
    {
        try { return await DeviceKey.GetThumbprintAsync(); }
        catch { return null; }   // a host without a device key is a normal answer, not an error
    }

    /// <summary>
    /// The citizen's holder-key thumbprint (RFC 7638, from the wallet service's holder JWK), or null
    /// when unreachable — in which case the selection layer fails CLOSED rather than guessing.
    /// </summary>
    private async Task<string?> TryGetHolderThumbprintAsync()
    {
        try
        {
            var holderKeys = await HolderKeys.GetHolderKeysAsync();
            return holderKeys is null
                ? null
                : PresentationEngine.ComputeJwkThumbprint(holderKeys.HolderJwk);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>
    /// Server-custody signer for a holder-cnf root: round-trips the KB-JWT signing input through
    /// <c>POST /api/v1/wallet/presentations/sign-kb</c> (Task 6a). The holder private key never
    /// reaches this device.
    /// </summary>
    private async Task<byte[]> SignWithHolderKeyAsync(byte[] signingInput, CancellationToken ct)
    {
        var response = await WalletClient.SignKbJwtAsync(
            new Sorcha.CitizenWallet.Abstractions.Models.KbJwtSignRequest
            {
                SigningInput = Encoding.ASCII.GetString(signingInput),
            }, ct);
        return Base64Url.DecodeFromChars(response.Signature);
    }

    /// <summary>Route the BindDeviceFirst outcome to the root's credential card (the Task 6 bind surface).</summary>
    private void GoToBindSurface()
        => Nav.NavigateTo(_bindRoot is not null ? $"credentials/{_bindRoot.Credential.Id}" : "cards");

    // ─────────────────── Feature 181 US2 — multi-credential orchestration ───────────────────

    /// <summary>A request needs the per-query flow when it carries more than one credential query
    /// or a credential_set that offers alternatives (more than one option).</summary>
    private static bool IsMultiCredential(ParsedPresentationRequest request)
        => request.Query.Credentials.Count > 1
           || (request.Query.CredentialSets?.Any(s => s.Options.Count > 1) ?? false);

    private void BeginMultiFlow()
    {
        _result = Engine.MatchQuery(_request!, _cachedCreds);
        ContinueMultiFlow();
    }

    /// <summary>
    /// Drive the per-query flow to the next decision: resolve any alternative choice, then any
    /// multi-candidate query, then land on the consent surface. Re-entrant after each pick.
    /// </summary>
    private void ContinueMultiFlow()
    {
        // 1. A required set with more than one satisfiable option needs an explicit citizen pick
        //    (no auto-pick — FR edge case).
        for (var i = 0; i < _result!.SetChoices.Count; i++)
        {
            var set = _result.SetChoices[i];
            if (set.Required && set.SatisfiableOptions.Count > 1 && !_chosenOptionBySetIndex.ContainsKey(i))
            {
                _currentAlternative = set;
                _currentAlternativeSetIndex = i;
                _phase = Phase.PickAlternative;
                return;
            }
        }

        // 2. Which queries are we presenting?
        ComputeActiveQueryIds();

        // 3. Auto-pick single-candidate active queries; a multi-candidate one needs a pick.
        foreach (var id in _activeQueryIds)
        {
            if (_selections.ContainsKey(id)) continue;
            var qm = _result.PerQuery.First(q => q.QueryId == id);
            if (qm.Candidates.Count == 1)
            {
                _selections[id] = qm.Candidates[0];
            }
            else if (qm.Candidates.Count > 1)
            {
                _currentPickQueryId = id;
                _currentPickMatches = qm.Candidates;
                _phase = Phase.PickQueryCredential;
                return;
            }
        }

        // 4. Consent.
        BuildConsentView();
        _phase = Phase.MultiConsent;
    }

    /// <summary>Resolve which query ids the wallet will present: the chosen alternative options plus
    /// every AND-required query (no sets ⇒ all; with sets ⇒ singleton/auto sets + unreferenced asks).</summary>
    private void ComputeActiveQueryIds()
    {
        _activeQueryIds.Clear();
        var active = new List<string>();

        if (_result!.SetChoices.Count == 0)
        {
            active.AddRange(_result.PerQuery.Select(q => q.QueryId));
        }
        else
        {
            var referenced = new HashSet<string>(
                _result.SetChoices.SelectMany(s => s.Options.SelectMany(o => o)), StringComparer.Ordinal);
            // Queries not referenced by any set are AND-required.
            active.AddRange(_result.PerQuery.Select(q => q.QueryId).Where(id => !referenced.Contains(id)));

            for (var i = 0; i < _result.SetChoices.Count; i++)
            {
                var set = _result.SetChoices[i];
                if (!set.Required) continue;
                if (_chosenOptionBySetIndex.TryGetValue(i, out var chosen)) active.AddRange(chosen);
                else if (set.SatisfiableOptions.Count == 1) active.AddRange(set.SatisfiableOptions[0]);
                // 0 satisfiable options ⇒ unsatisfiable; flagged in consent, nothing to add.
            }
        }

        foreach (var id in active)
        {
            if (!_activeQueryIds.Contains(id)) _activeQueryIds.Add(id);
        }
    }

    /// <summary>Build the filtered consent view (active + unsatisfiable-required sections) and seed
    /// per-query optional toggles for the selected credentials.</summary>
    private void BuildConsentView()
    {
        var showIds = new HashSet<string>(_activeQueryIds, StringComparer.Ordinal);
        foreach (var id in _result!.UnsatisfiedRequiredQueryIds) showIds.Add(id);

        _consentResult = _result with
        {
            PerQuery = _result.PerQuery.Where(q => showIds.Contains(q.QueryId)).ToList()
        };

        _queryOptionalToggles = new();
        foreach (var id in _activeQueryIds)
        {
            if (_selections.TryGetValue(id, out var sel))
            {
                _queryOptionalToggles[id] = sel.AvailableOptional.ToDictionary(n => n, _ => false);
            }
        }
    }

    private void OnAlternativeChosen(IReadOnlyList<string> option)
    {
        if (_currentAlternativeSetIndex >= 0) _chosenOptionBySetIndex[_currentAlternativeSetIndex] = option;
        _currentAlternative = null;
        _currentAlternativeSetIndex = -1;
        ContinueMultiFlow();
    }

    private void OnQueryCredentialChosen(CredentialMatch? match)
    {
        if (match is null || _currentPickQueryId is null) return;
        _selections[_currentPickQueryId] = match;
        _currentPickQueryId = null;
        _currentPickMatches = null;
        ContinueMultiFlow();
    }

    private async Task ConfirmMultiAsync()
    {
        if (_request is null || _result is null) return;
        _busy = true;
        _error = null;
        try
        {
            var consented = new List<ConsentedQuery>();
            foreach (var id in _activeQueryIds)
            {
                if (!_selections.TryGetValue(id, out var sel)) continue;
                var qm = _result.PerQuery.First(q => q.QueryId == id);
                var optional = _queryOptionalToggles.TryGetValue(id, out var toggles)
                    ? toggles.Where(kv => kv.Value).Select(kv => kv.Key)
                    : Enumerable.Empty<string>();
                var approved = sel.SatisfiedRequired.Concat(optional).ToList();
                consented.Add(new ConsentedQuery(id, sel, qm.RequiredClaims, approved));
            }

            if (consented.Count == 0)
            {
                _error = "No credentials selected to present.";
                return;
            }

            var deviceJwk = await DeviceKey.GetPublicJwkAsync();
            // One SD-JWT presentation per consented query, assembled into the object-keyed
            // OpenID4VP 1.0 vp_token envelope.
            var vpTokenEnvelope = await Engine.BuildVpTokenEnvelopeAsync(
                consented, _request, deviceJwk, DeviceKey.SignAsync);

            var form = new FormUrlEncodedContent(new Dictionary<string, string>
            {
                ["vp_token"] = vpTokenEnvelope,
                ["state"] = _request.State,
            });
            var resp = await Http.PostAsync(_request.ResponseUri, form);
            if (resp.IsSuccessStatusCode)
            {
                _responseStatus = "ok";
                _responseMessage = "Verifier accepted the presentation.";
            }
            else
            {
                _responseStatus = "fail";
                _responseMessage = $"Verifier returned {(int)resp.StatusCode} {resp.StatusCode}.";
            }

            await TryLogMultiPresentationAsync(consented, resp.IsSuccessStatusCode);
            _phase = Phase.Done;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task TryLogMultiPresentationAsync(IReadOnlyList<ConsentedQuery> consented, bool accepted)
    {
        if (_request is null) return;
        foreach (var c in consented)
        {
            try
            {
                var entry = new PresentationLogEntry(
                    Id: Guid.NewGuid(),
                    PresentedAt: DateTimeOffset.UtcNow,
                    CredentialType: c.Match.Credential.Vct,
                    CredentialLabel: c.Match.Credential.DisplayLabel,
                    VerifierLabel: string.IsNullOrWhiteSpace(_request.Purpose)
                        ? _request.ClientId
                        : _request.Purpose!,
                    DisclosedClaims: c.ApprovedClaims,
                    Outcome: accepted ? PresentationLogOutcome.Sent : PresentationLogOutcome.Rejected,
                    CredentialId: c.Match.Credential.Id);
                await PresentationLog.AppendAsync(entry);
            }
            catch
            {
                // Activity log is a convenience surface; never let it break the flow.
            }
        }
    }

    private void Reset()
    {
        _phase = Phase.AwaitingDeepLink;
        _deepLink = string.Empty;
        _request = null;
        _selected = null;
        _signingMode = PresentationSigningMode.Device;
        _bindRoot = null;
        _optionalToggles = new();
        _cachedCreds = [];
        _result = null;
        _consentResult = null;
        _selections.Clear();
        _queryOptionalToggles = new();
        _activeQueryIds.Clear();
        _chosenOptionBySetIndex.Clear();
        _currentAlternative = null;
        _currentAlternativeSetIndex = -1;
        _currentPickMatches = null;
        _currentPickQueryId = null;
        _error = null;
        _responseMessage = string.Empty;
        _responseStatus = string.Empty;
        _scanError = null;
        _intakeMessage = null;
        _deepLinkFromScan = false;
        _userChosePaste = false;
        // Restore intake display state from mode (keep _cameraRefusedThisSession across Reset).
        _showPaste = _intakeMode != IntakeMode.CameraFirst || _cameraRefusedThisSession;
        // Allow auto-start to fire again on next render (unless camera was denied this session).
        _autoStartFired = false;
    }

    // ------- QR scanner (shared by CameraFirst auto-start and PasteWithScan on-demand) ----

    /// <summary>Auto-start the camera (CameraFirst, first render).</summary>
    private async Task StartScanAsync()
    {
        _intakeMessage = null;
        _scanError = null;
        _error = null;

        bool supported;
        try
        {
            supported = await JS.InvokeAsync<bool>("SorchaQrScanner.isSupported");
        }
        catch
        {
            supported = false;
        }

        if (!supported)
        {
            _intakeMessage = "This browser doesn't expose a camera API. Paste the link instead.";
            _cameraRefusedThisSession = true;
            _showPaste = true;
            StateHasChanged();
            return;
        }

        _scanning = true;
        StateHasChanged();
        // One render so the <video> element exists before attaching the scanner.
        await Task.Yield();

        try
        {
            var detected = await JS.InvokeAsync<string>("SorchaQrScanner.start", VideoElementId);
            // The user may have navigated away during the scan await; DisposeAsync stopped the
            // scanner and set _disposed. Skip all UI continuation to avoid ObjectDisposedException.
            if (_disposed) return;
            _scanning = false;

            // If user already switched to paste while the scanner was running, respect their choice.
            if (_userChosePaste)
            {
                StateHasChanged();
                return;
            }

            _showPaste = true;  // viewfinder done — restore paste-reachable state

            if (string.IsNullOrWhiteSpace(detected))
            {
                _intakeMessage = "Couldn't read that QR code. Try again or paste the link.";
                _showPaste = _intakeMode != IntakeMode.CameraFirst;
                StateHasChanged();
                return;
            }

            _deepLink = detected;
            _deepLinkFromScan = true;
            StateHasChanged();
            await ParseAsync();
        }
        catch (JSException jsex) when (jsex.Message.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
        {
            if (_disposed) return;
            _scanning = false;
            _showPaste = true;
            StateHasChanged();
        }
        catch (JSException jsex)
        {
            if (_disposed) return;
            _scanning = false;
            _cameraRefusedThisSession = true;
            _showPaste = true;
            _intakeMessage = jsex.Message.Contains("NotAllowedError", StringComparison.OrdinalIgnoreCase)
                ? "Camera permission was denied. You can paste the link instead."
                : jsex.Message.Contains("NotFoundError", StringComparison.OrdinalIgnoreCase)
                    ? "No camera was found on this device. Paste the link instead."
                    : "Couldn't start the scanner. Paste the link instead.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _scanning = false;
            _cameraRefusedThisSession = true;
            _showPaste = true;
            _intakeMessage = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>US2: on-demand scan activated by "Scan with camera" button on desktop.</summary>
    private async Task StartDesktopScanAsync()
    {
        // Show the viewfinder by clearing _showPaste.
        _showPaste = false;
        _intakeMessage = null;
        StateHasChanged();

        // Yield to render the <video> element before attaching.
        await Task.Yield();

        await StartScanAsync();

        // After StartScanAsync completes (success or failure), restore paste view — unless the
        // component was disposed during the scan (user navigated away).
        if (_disposed) return;
        _showPaste = true;
        StateHasChanged();
    }

    /// <summary>US1: explicit "Paste a link instead" tap from CameraFirst layout.</summary>
    private async Task SwitchToPasteAsync()
    {
        // Guard so StartScanAsync (if still in its Task.Yield() continuation) doesn't
        // override the user's explicit paste choice when it finishes the scan call.
        _userChosePaste = true;
        await CancelScanAsync();
        _showPaste = true;
        StateHasChanged();
    }

    /// <summary>US1: retry scanning after a bad-QR result while still in the CameraFirst viewfinder.</summary>
    private async Task RescanAsync()
    {
        _intakeMessage = null;
        await StartScanAsync();
    }

    private async Task CancelScanAsync()
    {
        try { await JS.InvokeVoidAsync("SorchaQrScanner.stop"); } catch { /* idempotent */ }
        _scanning = false;
    }

    /// <summary>
    /// Set once the component is disposed (e.g. the user navigated away mid-scan) so that any
    /// in-flight scan continuation skips its StateHasChanged()/UI updates — guards against the
    /// ObjectDisposedException race (round-4 review finding).
    /// </summary>
    private bool _disposed;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // FR-008: camera MUST be released on navigation.
        if (_scanning)
        {
            try { await JS.InvokeVoidAsync("SorchaQrScanner.stop"); } catch { /* ignore */ }
        }
    }
}
