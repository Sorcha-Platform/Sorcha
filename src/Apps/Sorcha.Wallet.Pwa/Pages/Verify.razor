@*
    SPDX-License-Identifier: MIT
    Copyright (c) 2026 Sorcha Contributors

    Doorstep verification page (Feature 164, B3 US2). Hosts the shared verify control
    (QuestionSelectionPanel → VerificationSessionQr → completion) wired to the live HAIP
    transport via IVerificationTransport and EphemeralVerifierIdentityAdapter.
    After the holder scans and submits, the vpToken is persisted to the per-device
    verification history store for audit.
*@
@page "/verify"
@layout MainLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using Sorcha.UI.Core.Components.Verify
@using Sorcha.UI.Components.User.Models.Verification
@using Sorcha.Verifier.Engine.Models
@using Sorcha.Wallet.Pwa.Services
@using Sorcha.Wallet.Pwa.Services.Context
@implements IDisposable
@inject IVerificationHistoryStore History
@inject IUserContext UserContext
@inject ILogger<Verify> Logger
@inject IServiceProvider Sp
@inject NavigationManager Nav

<PageTitle>Verify a credential · Sorcha Wallet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    @if (_selectedQuestion is null)
    {
        <QuestionSelectionPanel OnQuestionSelected="@SelectQuestionAsync" />

        @* Feature 185: the same check, with no signal.
           This page verifies ONLINE over HAIP. When the two people are standing in front of each other and
           there is no connectivity — a roadside, a doorstep, a basement — the exchange can happen directly
           over Bluetooth instead. Capability-gated: hidden entirely where the device cannot do it, because a
           dead button at a doorstep is worse than no button. *@
        @if (_proximitySupported)
        {
            <MudPaper Elevation="0" Class="pa-4 mt-4" Outlined="true" data-testid="verify-proximity-card">
                <MudText Typo="Typo.subtitle2">No signal?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Check their credential directly, device to device. Nothing goes over the internet.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Contactless"
                           data-testid="verify-proximity-button"
                           OnClick="@(() => Nav.NavigateTo("verify/proximity"))">
                    Check in person
                </MudButton>
            </MudPaper>
        }
    }
    else if (!_complete)
    {
        <VerificationSessionQr Question="@_selectedQuestion"
                               CancellationToken="@_pageCts.Token"
                               OnOutcome="@HandleOutcomeAsync"
                               OnCompleted="@HandleCompletedAsync" />
    }
    else
    {
        @if (_verdict is not null)
        {
            <VerdictTrailPanel Verdict="_verdict" OnVerifyAnother="@Reset" />
        }
        else
        {
            <MudPaper Elevation="2" Class="pa-6 text-center">
                <MudText Typo="Typo.h6" Class="mb-2">Verification received</MudText>
                <MudButton Variant="Variant.Outlined" OnClick="@Reset">Verify another</MudButton>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    // Feature 185. False until proven otherwise — an affordance the device cannot honour must not appear.
    private bool _proximitySupported;

    private VerificationPreset? _selectedQuestion;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => await ProbeProximityAsync();
    private bool _complete;
    private VerdictViewModel? _verdict;
    private VerificationOutcome? _lastOutcome;
    private CancellationTokenSource _pageCts = new();

    private Task SelectQuestionAsync(VerificationPreset question)
    {
        _selectedQuestion = question;
        return Task.CompletedTask;
    }

    private Task HandleOutcomeAsync(VerificationOutcome? outcome)
    {
        _lastOutcome = outcome;
        if (outcome is not null && _selectedQuestion is not null)
            _verdict = VerdictViewModel.From(_selectedQuestion, outcome);
        return Task.CompletedTask;
    }

    private async Task HandleCompletedAsync(string vpToken)
    {
        _complete = true;

        if (string.IsNullOrEmpty(vpToken) || _selectedQuestion is null) return;

        try
        {
            var historyOutcome = _lastOutcome is null
                ? Services.VerifyOutcome.Fail
                : !_lastOutcome.Accepted
                    ? Services.VerifyOutcome.Fail
                    : _lastOutcome.IssuerSignature == IssuerSignatureStatus.Verified
                        ? Services.VerifyOutcome.Pass
                        : Services.VerifyOutcome.Warn;

            var holderName = _lastOutcome is not null
                && _lastOutcome.DisclosedClaims.TryGetValue("fullName", out var fn) ? fn?.ToString() ?? "" : "";

            var record = new VerificationRecord(
                Id: Guid.NewGuid(),
                VerifiedAt: DateTimeOffset.UtcNow,
                ContextOrgId: UserContext.ActiveContextOrgId,
                HolderDisplayName: holderName,
                IssuerOrgName: "",
                CredentialType: _selectedQuestion.RequiredVct,
                Outcome: historyOutcome,
                TrustPanelJson: "");

            try
            {
                await History.AddAsync(record);
                Logger.LogInformation(
                    "Verification recorded: {Outcome} · {Vct}",
                    record.Outcome, record.CredentialType);
            }
            catch (Exception ex)
            {
                // Persist failures are not fatal — the QR session already succeeded.
                Logger.LogWarning(ex, "Failed to persist verification history record {Id}.", record.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to handle completed verification for credential type {Vct}.", _selectedQuestion?.RequiredVct);
        }
    }

    private void Reset()
    {
        _selectedQuestion = null;
        _complete = false;
        _verdict = null;
        _lastOutcome = null;
    }

    public void Dispose() => _pageCts.Dispose();

    /// <summary>Ask the device whether it can do an in-person check, BEFORE offering one.</summary>
    /// <remarks>
    /// Resolved through IServiceProvider rather than @inject: the ONLINE verification path must not acquire a
    /// hard dependency on a BLE transport it never uses, and a host with no proximity registration should
    /// still render this page perfectly.
    /// </remarks>
    private async Task ProbeProximityAsync()
    {
        try
        {
            var transport = Sp.GetService(typeof(Sorcha.Proximity.IProximityTransport))
                as Sorcha.Proximity.IProximityTransport;

            _proximitySupported = transport is not null && (await transport.ProbeAsync()).Supported;
        }
        catch
        {
            // An unsupported device is a normal answer, not an error. Never let it break the online path.
            _proximitySupported = false;
        }
    }
}
