{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Verifier": {
    "ClockSkewSeconds": 60,
    "KbJwtMaxLifetimeSeconds": 120,
    "HaipBaseUrl": "http://haip-service:8080"
  },
  "ServiceAuth": {
    "ClientId": "service-verifier",
    "ClientSecret": "verifier-service-secret"
  }
}
