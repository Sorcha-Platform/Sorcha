    SPDX-License-Identifier: MIT
    Copyright (c) 2026 Sorcha Contributors

    Desk verifier home page (Feature 164, B3 US3). Hosts the shared verify control
    (QuestionSelectionPanel → VerificationSessionQr → completion) wired to the live HAIP
    transport via IVerificationTransport and StableOrgVerifierIdentityProvider.
    The legacy bespoke presentation builder / session store composition is retired in US4.
*@
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Sorcha.UI.Core.Components.Verify
@using Sorcha.UI.Components.User.Models.Verification

<PageTitle>Sorcha Verifier</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-1">Sorcha Verifier</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        Ask a question, show the QR. The citizen approves in their wallet, and the verified
        result — with its full validation trail — appears here.
    </MudText>

    @if (_selectedQuestion is null)
    {
        <QuestionSelectionPanel OnQuestionSelected="@SelectQuestionAsync" />
    }
    else if (!_complete)
    {
        <VerificationSessionQr Question="@_selectedQuestion"
                               CancellationToken="@_pageCts.Token"
                               OnCompleted="@HandleCompletedAsync" />
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-6 text-center">
            <MudIcon Icon="Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-3" />
            <MudText Typo="Typo.h5" Class="mb-2">Verification Complete</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                The credential was presented and verified successfully.
            </MudText>
            <MudButton Variant="Variant.Outlined" OnClick="@Reset">Verify another</MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
    private VerificationPreset? _selectedQuestion;
    private bool _complete;
    private CancellationTokenSource _pageCts = new();

    private Task SelectQuestionAsync(VerificationPreset question)
    {
        _selectedQuestion = question;
        return Task.CompletedTask;
    }

    private Task HandleCompletedAsync(string vpToken)
    {
        _complete = true;
        return Task.CompletedTask;
    }

    private void Reset()
    {
        _selectedQuestion = null;
        _complete = false;
    }

    public void Dispose() => _pageCts.Dispose();
}
