    SPDX-License-Identifier: MIT
    Copyright (c) 2026 Sorcha Contributors

    Desk verifier home page (Feature 164, B3 US3). Hosts the shared verify control
    (QuestionSelectionPanel → VerificationSessionQr → completion) wired to the live HAIP
    transport via IVerificationTransport and StableOrgVerifierIdentityProvider.
    The legacy bespoke presentation builder / session store composition is retired in US4.
*@
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Sorcha.UI.Core.Components.Verify
@using Sorcha.UI.Components.User.Models.Verification
@using Sorcha.Verifier.Engine.Models

<PageTitle>Sorcha Verifier</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 verify-shell">
    <MudText Typo="Typo.body2" Class="mb-6 verify-intro">
        Ask a question, show the QR. The citizen approves in their wallet, and the verified
        result — with its full validation trail — appears here.
    </MudText>

    @if (_selectedQuestion is null)
    {
        <QuestionSelectionPanel OnQuestionSelected="@SelectQuestionAsync" />
    }
    else if (!_complete)
    {
        <div class="verify-pending">
            <div class="verify-pending-title">@_selectedQuestion.Label</div>
            @if (!string.IsNullOrWhiteSpace(_selectedQuestion.Purpose))
            {
                <div class="verify-pending-purpose">@_selectedQuestion.Purpose</div>
            }
            <VerificationSessionQr Question="@_selectedQuestion"
                                   CancellationToken="@_pageCts.Token"
                                   OnOutcome="@HandleOutcomeAsync"
                                   OnCompleted="@HandleCompletedAsync" />
            <div class="verify-waiting" data-testid="verify-waiting">
                <span class="verify-waiting-pulse"></span>
                Waiting for the citizen's wallet…
            </div>
        </div>
    }
    else
    {
        @if (_verdict is not null)
        {
            <VerdictTrailPanel Verdict="_verdict" OnVerifyAnother="@Reset" />
        }
        else
        {
            <MudPaper Elevation="2" Class="pa-6 text-center">
                <MudText Typo="Typo.h6" Class="mb-2">Verification received</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    The presentation was received but no verdict was available.
                </MudText>
                <MudButton Variant="Variant.Outlined" OnClick="@Reset">Verify another</MudButton>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private VerificationPreset? _selectedQuestion;
    private bool _complete;
    private VerdictViewModel? _verdict;
    private CancellationTokenSource _pageCts = new();

    private Task SelectQuestionAsync(VerificationPreset question)
    {
        _selectedQuestion = question;
        return Task.CompletedTask;
    }

    private Task HandleOutcomeAsync(VerificationOutcome? outcome)
    {
        if (outcome is not null && _selectedQuestion is not null)
            _verdict = VerdictViewModel.From(_selectedQuestion, outcome);
        return Task.CompletedTask;
    }

    private Task HandleCompletedAsync(string vpToken)
    {
        _complete = true;
        return Task.CompletedTask;
    }

    private void Reset()
    {
        _selectedQuestion = null;
        _complete = false;
        _verdict = null;
    }

    public void Dispose() => _pageCts.Dispose();
}
