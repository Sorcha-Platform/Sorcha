{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AIProvider": {
    "Provider": "Anthropic",
    "ApiKey": "",
    "Model": "claude-sonnet-4-5-20250929",
    "MaxTokens": 4096
  },

  // Feature 093 US2: credentialStatus embedding in signed SD-JWT VC payloads.
  // When true (default), the ActionExecutionService pre-allocates a status list index
  // before calling the Wallet Service issue endpoint, and the Wallet Service embeds a
  // W3C BitstringStatusListEntry credentialStatus claim in the signed credential payload.
  // Set to false only in pure-internal dev environments where the StatusListManager is
  // not wired up — credentials will be issued without the embedded claim, and verifiers
  // will fall back to the server-side CredentialEntity row per spec 093 FR-010.
  "CredentialStatus": {
    "EnableEmbedding": true
  }
}
