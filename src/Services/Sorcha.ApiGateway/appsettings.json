{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "McpManifest": {
    "Name": "sorcha-mcp",
    "Description": "MCP server for Sorcha — programmable proof infrastructure for multi-party workflows. Tools drive verified credential issuance, blueprint design, and participant actions; every action signed, every state transition ledger-recorded, every disclosure cryptographically bounded.",
    "AuthIssuer": "",
    "AuthAudience": "",
    "_AuthComment": "AuthIssuer/AuthAudience empty => derived per-installation from JwtSettings:InstallationName (F136 SorchaIssuer/SorchaAudiences). Set a value here only to override.",
    "AuthAcquisitionUrl": "https://github.com/Sorcha-Platform/Sorcha/blob/master/scripts/get-jwt-token.sh",
    "StdioCommand": "dotnet",
    "StdioArgs": [ "run", "--project", "src/Apps/Sorcha.McpServer" ],
    "HttpSseUrl": "",
    "AdminCategoryDescription": "Platform-administration tools — health checks, log queries, tenant and user management, validator status. Use this slice when an agent has admin scope.",
    "DesignerCategoryDescription": "Blueprint authoring tools — create, validate, simulate, diff, export blueprints. Use this slice for workflow authoring agents.",
    "ParticipantCategoryDescription": "Participant workflow tools — submit actions, query the inbox, sign transactions, query the register. Use this slice for end-user-facing agents.",
    "CitizenCategoryDescription": "Citizen self-service tools — a consumer-tier (citizen) caller manages only their own Sorcha presence: list credentials, manage enrolled devices, read/update their persona, view pending applications and presentation history, and list invitations. Every tool is scoped to the caller; cross-citizen access is impossible.",
    "DocumentationUrl": "https://github.com/Sorcha-Platform/Sorcha/blob/master/docs/mcp-server.md",
    "_ToolsComment": "MUST match the [McpServerTool(Name=...)] set in the Sorcha.McpServer assembly EXACTLY. Spec 139 US5 (T041): ManifestIntegrityTests in Sorcha.McpServer.Tests reflects that set and fails build-and-test on any drift here OR in server.json. sorcha_wallet_sign is intentionally absent (T029 — de-registered, returns in a security-reviewed wave).",
    "Tools": [
      { "Name": "sorcha_audit_query", "Category": "admin", "Description": "Query the audit log." },
      { "Name": "sorcha_health_check", "Category": "admin", "Description": "Aggregated platform health." },
      { "Name": "sorcha_log_query", "Category": "admin", "Description": "Query service logs." },
      { "Name": "sorcha_metrics", "Category": "admin", "Description": "Platform metrics snapshot." },
      { "Name": "sorcha_peer_status", "Category": "admin", "Description": "P2P peer status." },
      { "Name": "sorcha_register_stats", "Category": "admin", "Description": "Register-level statistics." },
      { "Name": "sorcha_tenant_create", "Category": "admin", "Description": "Create a tenant." },
      { "Name": "sorcha_tenant_list", "Category": "admin", "Description": "List tenants." },
      { "Name": "sorcha_tenant_update", "Category": "admin", "Description": "Update a tenant." },
      { "Name": "sorcha_token_revoke", "Category": "admin", "Description": "Revoke a JWT." },
      { "Name": "sorcha_user_list", "Category": "admin", "Description": "List users." },
      { "Name": "sorcha_user_manage", "Category": "admin", "Description": "Modify user roles or status." },
      { "Name": "sorcha_validator_status", "Category": "admin", "Description": "Validator-roster status." },
      { "Name": "sorcha_register_subscribe", "Category": "admin", "Description": "Subscribe this node to a register for peer replication." },
      { "Name": "sorcha_register_unsubscribe", "Category": "admin", "Description": "Unsubscribe this node from a register, stopping replication." },
      { "Name": "sorcha_register_sync_state", "Category": "admin", "Description": "Get a register's replication sync state and derivation evidence." },
      { "Name": "sorcha_register_relationship", "Category": "admin", "Description": "Get this node's derived role set for a register." },
      { "Name": "sorcha_transaction_status", "Category": "admin", "Description": "Get a transaction's lifecycle status (active/revoked/superseded)." },
      { "Name": "sorcha_transaction_inclusion_proof", "Category": "admin", "Description": "Get a Merkle inclusion proof for a sealed transaction." },
      { "Name": "sorcha_transaction_verification_bundle", "Category": "admin", "Description": "Export a portable offline verification bundle for a transaction." },
      { "Name": "sorcha_transaction_revoke", "Category": "admin", "Description": "Submit a transaction revocation with a reason." },
      { "Name": "sorcha_credential_offer", "Category": "admin", "Description": "Create an OID4VCI credential offer for a HAIP wallet, or poll an offer's status." },
      { "Name": "sorcha_presentation_request", "Category": "admin", "Description": "Create an OID4VP presentation request for a HAIP wallet." },
      { "Name": "sorcha_presentation_status", "Category": "admin", "Description": "Poll a presentation attempt's lifecycle state to its terminal outcome." },
      { "Name": "sorcha_credential_revoke", "Category": "admin", "Description": "Permanently revoke an issued credential." },
      { "Name": "sorcha_credential_suspend", "Category": "admin", "Description": "Temporarily suspend an Active credential (reversible)." },
      { "Name": "sorcha_credential_reinstate", "Category": "admin", "Description": "Reinstate a Suspended credential to Active." },
      { "Name": "sorcha_credential_refresh", "Category": "admin", "Description": "Reissue an Expired credential with a fresh expiry." },
      { "Name": "sorcha_org_status", "Category": "admin", "Description": "Suspend or reactivate an organisation." },
      { "Name": "sorcha_org_wallet_status", "Category": "admin", "Description": "Report which organisations have not yet created their signing wallet." },
      { "Name": "sorcha_platform_settings", "Category": "admin", "Description": "Read platform settings or toggle the public organisation." },
      { "Name": "sorcha_org_user_audit", "Category": "admin", "Description": "Read-only paginated user list for an organisation." },
      { "Name": "sorcha_validator_control", "Category": "admin", "Description": "Start, stop or restart a register's validator." },
      { "Name": "sorcha_user_provision", "Category": "admin", "Description": "Provision a platform user into an organisation." },
      { "Name": "sorcha_user_password_reset", "Category": "admin", "Description": "Reset a platform user's password." },
      { "Name": "sorcha_blueprint_create", "Category": "designer", "Description": "Create a blueprint." },
      { "Name": "sorcha_blueprint_export", "Category": "designer", "Description": "Export a blueprint." },
      { "Name": "sorcha_blueprint_get", "Category": "designer", "Description": "Get a blueprint by id." },
      { "Name": "sorcha_blueprint_list", "Category": "designer", "Description": "List blueprints." },
      { "Name": "sorcha_blueprint_simulate", "Category": "designer", "Description": "Simulate blueprint execution." },
      { "Name": "sorcha_blueprint_update", "Category": "designer", "Description": "Update a blueprint." },
      { "Name": "sorcha_blueprint_validate", "Category": "designer", "Description": "Validate a blueprint." },
      { "Name": "sorcha_disclosure_analysis", "Category": "designer", "Description": "Analyse selective disclosure rules." },
      { "Name": "sorcha_jsonlogic_test", "Category": "designer", "Description": "Test a JsonLogic expression." },
      { "Name": "sorcha_schema_generate", "Category": "designer", "Description": "Generate a JSON schema." },
      { "Name": "sorcha_schema_validate", "Category": "designer", "Description": "Validate a payload against a schema." },
      { "Name": "sorcha_workflow_instances", "Category": "designer", "Description": "List workflow instances of a blueprint." },
      { "Name": "sorcha_action_details", "Category": "participant", "Description": "Read details for one action." },
      { "Name": "sorcha_action_submit", "Category": "participant", "Description": "Submit a signed action to the register." },
      { "Name": "sorcha_action_validate", "Category": "participant", "Description": "Validate an action shape locally." },
      { "Name": "sorcha_disclosed_data", "Category": "participant", "Description": "Read disclosed payloads." },
      { "Name": "sorcha_inbox_list", "Category": "participant", "Description": "List actions awaiting this participant." },
      { "Name": "sorcha_register_query", "Category": "participant", "Description": "Query register transactions." },
      { "Name": "sorcha_transaction_history", "Category": "participant", "Description": "Read transaction history for a wallet." },
      { "Name": "sorcha_wallet_info", "Category": "participant", "Description": "Read wallet metadata." },
      { "Name": "sorcha_workflow_status", "Category": "participant", "Description": "Read the status of a workflow instance." },
      { "Name": "sorcha_my_credentials", "Category": "citizen", "Description": "List the calling citizen's own credentials." },
      { "Name": "sorcha_my_devices", "Category": "citizen", "Description": "List the calling citizen's own enrolled wallet devices." },
      { "Name": "sorcha_my_device_rename", "Category": "citizen", "Description": "Rename one of the calling citizen's own enrolled devices." },
      { "Name": "sorcha_my_device_revoke", "Category": "citizen", "Description": "Revoke one of the calling citizen's own enrolled devices." },
      { "Name": "sorcha_my_persona", "Category": "citizen", "Description": "Read or replace the calling citizen's own persona." },
      { "Name": "sorcha_pending_applications", "Category": "citizen", "Description": "Read the calling citizen's pending-application notice." },
      { "Name": "sorcha_my_presentations", "Category": "citizen", "Description": "List the calling citizen's own presentation history." },
      { "Name": "sorcha_my_invitations", "Category": "citizen", "Description": "List the calling citizen's register invitations." }
    ]
  },
  "Discoverability": {
    "McpServerUrl": "/.well-known/mcp.json",
    "Standards": [
      "BIP32",
      "BIP39",
      "BIP44",
      "ML-DSA (NIST FIPS 204)",
      "ML-KEM (NIST FIPS 203)",
      "OpenID4VCI",
      "OpenID4VP",
      "HAIP 1.0",
      "W3C Verifiable Credentials Data Model 2.0",
      "IETF Token Status List 2024 (RFC 9972)",
      "DID 1.0",
      "OAuth 2.0"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AlertThresholds": {
    "ValidatorFailedWarning": 10,
    "ValidatorFailedCritical": 50,
    "ValidatorSuccessRateWarning": 95,
    "ValidatorSuccessRateCritical": 80,
    "ConsensusFailuresWarning": 5,
    "ConsensusFailuresCritical": 20,
    "DocketsAbandonedWarning": 3,
    "DocketsAbandonedCritical": 10,
    "ValidatorExceptionsWarning": 5,
    "ValidatorExceptionsCritical": 25,
    "PeerHealthPercentageWarning": 70,
    "PeerHealthPercentageCritical": 40,
    "PeerAverageLatencyWarning": 500,
    "PeerAverageLatencyCritical": 2000
  },
  "OpenApi": {
    "ExposeScalar": true
  },
  "Dashboard": {
    "AspireDashboardUrl": "http://localhost:15888",
    "ShowAspireLink": true
  },
  "Services": {
    "Blueprint": {
      "Url": "http://blueprint-service:8080"
    },
    "Wallet": {
      "Url": "http://wallet-service:8080"
    },
    "Register": {
      "Url": "http://register-service:8080"
    },
    "Tenant": {
      "Url": "http://tenant-service:8080"
    },
    "Peer": {
      "Url": "http://peer-service:8080"
    },
    "Validator": {
      "Url": "http://validator-service:8080"
    }
  },
  "ReverseProxy": {
    "Routes": {

      "ui-root": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-login": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/login" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-auth-api": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/ui-auth/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-pages": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/app/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-admin": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/admin/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-design": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/design/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-blazor": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/_blazor/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-framework": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/_framework/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-content": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/_content/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-app-framework": {
        "ClusterId": "admin-cluster",
        "Order": 1,
        "Match": { "Path": "/app/_framework/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/app" }, { "X-Forwarded": "Set" } ]
      },
      "ui-app-content": {
        "ClusterId": "admin-cluster",
        "Order": 1,
        "Match": { "Path": "/app/_content/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/app" }, { "X-Forwarded": "Set" } ]
      },
      "ui-static": {
        "ClusterId": "admin-cluster",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}",
          "Headers": [ { "Name": "Accept", "Values": [ "text/css", "text/javascript", "application/javascript", "image/png", "image/svg+xml", "application/json", "application/manifest+json" ], "Mode": "HeaderPrefix" } ]
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-assets-css": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/css/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-assets-js": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/js/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-assets-lib": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/lib/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "ui-root-files": {
        "ClusterId": "admin-cluster",
        "Order": 99,
        "Match": {
          "Path": "/{filename}",
          "QueryParameters": []
        },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },

      "health-blueprint":  { "ClusterId": "blueprint-cluster",  "Match": { "Path": "/blueprint/health" },  "Transforms": [ { "PathPattern": "/health" } ] },
      "health-register":   { "ClusterId": "register-cluster",   "Match": { "Path": "/register/health" },   "Transforms": [ { "PathPattern": "/health" } ] },
      "health-register-sync": { "ClusterId": "register-cluster", "Match": { "Path": "/health/sync" } },
      "health-wallet":     { "ClusterId": "wallet-cluster",     "Match": { "Path": "/wallet/health" },     "Transforms": [ { "PathPattern": "/health" } ] },
      "health-tenant":     { "ClusterId": "tenant-cluster",     "Match": { "Path": "/tenant/health" },     "Transforms": [ { "PathPattern": "/health" } ] },
      "health-validator":  { "ClusterId": "validator-cluster",  "Match": { "Path": "/validator/health" },  "Transforms": [ { "PathPattern": "/health" } ] },
      "health-peer":       { "ClusterId": "peer-cluster",       "Match": { "Path": "/peer/health" },       "Transforms": [ { "PathPattern": "/health" } ] },

      "legacy-blueprint": {
        "ClusterId": "blueprint-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": { "Path": "/api/blueprint/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "legacy-blueprint-status": {
        "ClusterId": "blueprint-cluster",
        "Match": { "Path": "/api/blueprint/status" },
        "Transforms": [ { "PathPattern": "/api/health" } ]
      },
      "legacy-peer": {
        "ClusterId": "peer-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": { "Path": "/api/peer/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "legacy-peer-status": {
        "ClusterId": "peer-cluster",
        "Match": { "Path": "/api/peer/status" },
        "Transforms": [ { "PathPattern": "/api/health" } ]
      },
      "legacy-wallet": {
        "ClusterId": "wallet-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": { "Path": "/api/wallet/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/{**catch-all}" } ]
      },
      "legacy-wallet-status": {
        "ClusterId": "wallet-cluster",
        "Match": { "Path": "/api/wallet/status" },
        "Transforms": [ { "PathPattern": "/health" } ]
      },
      "legacy-register": {
        "ClusterId": "register-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": { "Path": "/api/register/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "legacy-register-status": {
        "ClusterId": "register-cluster",
        "Match": { "Path": "/api/register/status" },
        "Transforms": [ { "PathPattern": "/api/health" } ]
      },
      "trust-api":     { "ClusterId": "tenant-cluster", "Match": { "Path": "/api/v1/trust/{**catch-all}" }, "Transforms": [ { "X-Forwarded": "Set" } ] },

      "provenance-api": {
        "ClusterId": "register-cluster",
        "Match": { "Path": "/api/provenance/{**catch-all}" },
        "Metadata": {
          "_comment": "Feature 188 — provenance spine + per-docket trail, owned by register-service. A new /api/ path prefix needs its own route: without one it falls through to the ui-static /{**catch-all} and the whole surface is silently unreachable, which is exactly how F111's presentation endpoints were lost (#1309). Deliberately NO AuthorizationPolicy — the endpoints compose RequireAdministrator with RequirePlatformAudience themselves (pattern #13), and an edge policy would duplicate or contradict that. Diagnosis: GET /api/provenance/registers/<id> must return register-service JSON; a bodiless 404 means the gateway is not routing it. NOTE: notes live in Metadata, NOT as a sibling key under Routes — YARP treats every key under Routes as a route, and a comment key there crashes the gateway at startup with 'requires Hosts or Path specified'."
        }
      },

      "legacy-tenant": {
        "ClusterId": "tenant-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": { "Path": "/api/tenant/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "legacy-tenant-health": {
        "ClusterId": "tenant-cluster",
        "Match": { "Path": "/api/tenant/health" },
        "Transforms": [ { "PathPattern": "/health" } ]
      },
      "legacy-validator": {
        "ClusterId": "validator-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": { "Path": "/api/validator/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/{**catch-all}" } ]
      },
      "legacy-validator-health": {
        "ClusterId": "validator-cluster",
        "Match": { "Path": "/api/validator/health" },
        "Transforms": [ { "PathPattern": "/health" } ]
      },
      "legacy-validator-status": {
        "ClusterId": "validator-cluster",
        "Match": { "Path": "/api/validator/status" },
        "Transforms": [ { "PathPattern": "/health" } ]
      },
      "legacy-registers-health": {
        "ClusterId": "register-cluster",
        "Match": { "Path": "/api/registers/health" },
        "Transforms": [ { "PathPattern": "/health" } ]
      },
      "legacy-tenant-status": {
        "ClusterId": "tenant-cluster",
        "Match": { "Path": "/api/tenant/status" },
        "Transforms": [ { "PathPattern": "/health" } ]
      },

      "tenant-bootstrap":      { "ClusterId": "tenant-cluster", "Match": { "Path": "/api/tenants/bootstrap" } },
      "tenant-org-did-document": { "ClusterId": "tenant-cluster", "Match": { "Path": "/orgs/{orgId}/did.json" } },
      "service-auth":           { "ClusterId": "tenant-cluster", "Match": { "Path": "/api/service-auth/{**catch-all}" } },
      "auth-api": {
        "ClusterId": "tenant-cluster",
        "RateLimiterPolicy": "authentication",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "auth-static": {
        "ClusterId": "tenant-cluster",
        "Order": 4,
        "Match": { "Path": "/auth-static/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/auth-static" } ]
      },
      "auth-pages": {
        "ClusterId": "tenant-cluster",
        "RateLimiterPolicy": "authentication",
        "Order": 5,
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "tenant-passkey":         { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/passkey/{**catch-all}" } },
      "me-inbox":               { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/me/inbox/{**catch-all}" } },
      "me-inbox-list":          { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/me/inbox", "Methods": [ "GET" ] } },
      "register-subscriptions-list":   { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-subscriptions", "Methods": [ "GET" ] } },
      "register-subscriptions-get":    { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-subscriptions/{registerId}", "Methods": [ "GET" ] } },
      "register-subscriptions-create": { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-subscriptions", "Methods": [ "POST" ] } },
      "register-subscriptions-delete": { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-subscriptions/{registerId}", "Methods": [ "DELETE" ] } },
      "me-subscribed-registers":       { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/me/subscribed-registers", "Methods": [ "GET" ] } },
      "register-invitations-create":  { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-invitations", "Methods": [ "POST" ] } },
      "register-invitations-accept":  { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-invitations/accept", "Methods": [ "POST" ] } },
      "register-invitations-list":    { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-invitations", "Methods": [ "GET" ] } },
      "register-invitations-revoke":  { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": 1, "Match": { "Path": "/api/organizations/{orgId}/register-invitations/{invitationId}", "Methods": [ "DELETE" ] } },

      "tenant-organizations":   { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/organizations/{**catch-all}" } },
      "tenant-participants":    { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/participants/{**catch-all}" } },
      "tenant-service-principals": { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/service-principals/{**catch-all}" } },
      "me-applications-list":   { "ClusterId": "blueprint-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": -1, "Match": { "Path": "/api/me/applications", "Methods": [ "GET" ] } },
      "me-applications":        { "ClusterId": "blueprint-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Order": -1, "Match": { "Path": "/api/me/applications/{**catch-all}" } },
      "tenant-me":              { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/me/{**catch-all}" } },
      "tenant-me-v1":           { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/v1/me/{**catch-all}" } },
      "tenant-address-lookup":  { "ClusterId": "tenant-cluster", "AuthorizationPolicy": "RequireAuthenticated", "Match": { "Path": "/api/address-lookup/{**catch-all}" } },
