{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "TenantDatabase": "Host=localhost;Port=5432;Database=sorcha_tenant;Username=sorcha_user;Password=placeholder;Include Error Detail=true"
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "SorchaTenant:"
  },

  "Tenant": {
    "AddressLookup": {
      "OsPlaces": {
        "ApiKey": "",
        "BaseUrl": "https://api.os.uk/search/places/v1/"
      }
    }
  },

  "JwtSettings": {
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeMinutes": 1440,
    "SigningKeySource": "UserSecrets",
    "SigningKeyUserSecretName": "JwtSettings:SigningKey"
  },

  "Fido2": {
    "ServerDomain": "localhost",
    "ServerName": "Sorcha Tenant Service",
    "Origins": [
      "https://localhost:7080",
      "http://localhost"
    ],
    "TimestampDriftTolerance": 300000,
    "MDSAccessKey": null,
    "MDSCacheDirPath": null
  },

  "AzureKeyVault": {
    "Enabled": false,
    "VaultUri": "https://your-keyvault.vault.azure.net/",
    "TenantId": "placeholder",
    "ClientId": "placeholder",
    "UseDefaultCredential": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "OpenTelemetry": {
    "ServiceName": "Sorcha.Tenant.Service",
    "ServiceVersion": "1.0.0",
    "ZipkinEndpoint": "http://localhost:9411/api/v2/spans"
  },

  "SocialProviders": [],

  "RateLimiting": {
    "TotpPermitLimit": 5,
    "PlatformAuthPermitLimit": 50
  },

  "Trust": {
    "BaseUrl": "https://sorcha.example/api/v1/trust",
    "DefaultCaAlgorithm": "ES256",
    "DefaultCaValidityYears": 10,
    "DefaultOrgCertValidityYears": 2,
    "CrlRefreshHours": 24
  }
}
