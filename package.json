{
  "name": "sorcha",
  "version": "1.0.0",
  "description": "A modern .NET 10 blueprint execution engine and designer for data flow orchestration.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "docs:prebuild": "node scripts/copy-service-readmes.js",
