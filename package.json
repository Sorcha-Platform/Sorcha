  },
  "homepage": "https://github.com/sorcha-platform/sorcha#readme",
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.15.0",
    "@types/node": "^25.2.0",
    "mermaid": "^11.13.0",
    "swagger-cli": "^4.0.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
