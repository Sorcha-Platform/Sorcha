{
  "identifier": "professional-license",
  "title": "Professional License",
  "description": "Professional license or registration with issuing authority, validity period, and license number",
  "version": "1.0.0",
  "category": "credentials",
  "tags": ["license", "professional", "registration", "credential", "authority"],
  "keywords": ["license", "professional", "registration", "authority", "valid from", "valid to"],
  "schema": {
    "type": "object",
    "properties": {
      "licenseType": {
        "type": "string",
        "title": "License Type",
        "description": "Type of professional license (e.g., medical, legal, engineering)",
        "minLength": 1,
        "maxLength": 100
      },
      "licenseNumber": {
        "type": "string",
        "title": "License Number",
        "description": "Unique license or registration number",
        "minLength": 1,
        "maxLength": 50
      },
      "issuingAuthority": {
        "type": "string",
        "title": "Issuing Authority",
        "description": "Body that issued the license",
        "minLength": 1,
        "maxLength": 200
      },
      "validFrom": {
        "type": "string",
        "title": "Valid From",
        "description": "Date the license becomes valid",
        "format": "date"
      },
      "validTo": {
        "type": "string",
        "title": "Valid To",
        "description": "Date the license expires",
        "format": "date"
      }
    },
    "required": ["licenseType", "licenseNumber", "issuingAuthority", "validFrom", "validTo"]
  },
  "formLayout": {
    "type": "VerticalLayout",
    "elements": [
      { "type": "TextLine", "scope": "licenseType", "title": "License Type" },
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "TextLine", "scope": "licenseNumber", "title": "License Number" },
          { "type": "TextLine", "scope": "issuingAuthority", "title": "Issuing Authority" }
        ]
      },
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "TextLine", "scope": "validFrom", "title": "Valid From" },
          { "type": "TextLine", "scope": "validTo", "title": "Valid To" }
        ]
      }
    ]
  },
  "disclosure": {
    "sensitive": [],
    "recommendation": "Professional license details are typically verifiable through public registers. Share with participants requiring proof of professional standing."
  }
}
