{
  "identifier": "training-certificate",
  "title": "Training Certificate",
  "description": "Training or course completion certificate with grade and issuing institution details",
  "version": "1.0.0",
  "category": "credentials",
  "tags": ["training", "certificate", "education", "credential", "course"],
  "keywords": ["training", "certificate", "course", "grade", "institution", "completion"],
  "schema": {
    "type": "object",
    "properties": {
      "courseName": {
        "type": "string",
        "title": "Course Name",
        "description": "Name of the training course or programme",
        "minLength": 1,
        "maxLength": 200
      },
      "completionDate": {
        "type": "string",
        "title": "Completion Date",
        "description": "Date the course was completed",
        "format": "date"
      },
      "grade": {
        "type": "string",
        "title": "Grade",
        "description": "Grade or result achieved",
        "maxLength": 50
      },
      "institution": {
        "type": "string",
        "title": "Institution",
        "description": "Name of the training provider or institution",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": ["courseName", "completionDate", "institution"]
  },
  "formLayout": {
    "type": "VerticalLayout",
    "elements": [
      { "type": "TextLine", "scope": "courseName", "title": "Course Name" },
      { "type": "TextLine", "scope": "institution", "title": "Institution" },
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "TextLine", "scope": "completionDate", "title": "Completion Date" },
          { "type": "TextLine", "scope": "grade", "title": "Grade" }
        ]
      }
    ]
  },
  "disclosure": {
    "sensitive": [],
    "recommendation": "Training certificates are generally non-sensitive and can be shared with all workflow participants requiring proof of competency."
  }
}
