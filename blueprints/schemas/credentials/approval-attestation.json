{
  "identifier": "approval-attestation",
  "title": "Approval Attestation",
  "description": "Formal attestation of approval recording the type, approver, date, and any conditions applied",
  "version": "1.0.0",
  "category": "credentials",
  "tags": ["approval", "attestation", "credential", "authorisation", "governance"],
  "keywords": ["approval", "attestation", "approved by", "date", "conditions", "authorisation"],
  "schema": {
    "type": "object",
    "properties": {
      "approvalType": {
        "type": "string",
        "title": "Approval Type",
        "description": "Type of approval being attested",
        "minLength": 1,
        "maxLength": 100
      },
      "approvedBy": {
        "type": "string",
        "title": "Approved By",
        "description": "Name or identifier of the approver",
        "minLength": 1,
        "maxLength": 100
      },
      "approvalDate": {
        "type": "string",
        "title": "Approval Date",
        "description": "Date the approval was granted",
        "format": "date"
      },
      "conditions": {
        "type": "string",
        "title": "Conditions",
        "description": "Any conditions attached to the approval",
        "maxLength": 1000
      }
    },
    "required": ["approvalType", "approvedBy", "approvalDate"]
  },
  "formLayout": {
    "type": "VerticalLayout",
    "elements": [
      { "type": "TextLine", "scope": "approvalType", "title": "Approval Type" },
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "TextLine", "scope": "approvedBy", "title": "Approved By" },
          { "type": "TextLine", "scope": "approvalDate", "title": "Approval Date" }
        ]
      },
      { "type": "TextArea", "scope": "conditions", "title": "Conditions" }
    ]
  },
  "disclosure": {
    "sensitive": [],
    "recommendation": "Approval attestations are typically shared with all workflow participants as proof of authorisation. Conditions may be restricted to the approver and applicant."
  }
}
