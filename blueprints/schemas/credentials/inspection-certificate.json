{
  "identifier": "inspection-certificate",
  "title": "Inspection Certificate",
  "description": "Formal inspection certificate recording type, result, inspector, and validity period",
  "version": "1.0.0",
  "category": "credentials",
  "tags": ["inspection", "certificate", "quality", "compliance", "credential"],
  "keywords": ["inspection", "certificate", "result", "inspector", "valid until", "quality"],
  "schema": {
    "type": "object",
    "properties": {
      "inspectionType": {
        "type": "string",
        "title": "Inspection Type",
        "description": "Type of inspection performed",
        "minLength": 1,
        "maxLength": 100
      },
      "result": {
        "type": "string",
        "title": "Result",
        "description": "Inspection outcome",
        "enum": ["pass", "fail", "conditional"]
      },
      "inspector": {
        "type": "string",
        "title": "Inspector",
        "description": "Name or identifier of the inspector",
        "minLength": 1,
        "maxLength": 100
      },
      "validUntil": {
        "type": "string",
        "title": "Valid Until",
        "description": "Date the inspection certificate expires",
        "format": "date"
      }
    },
    "required": ["inspectionType", "result", "inspector"]
  },
  "formLayout": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "TextLine", "scope": "inspectionType", "title": "Inspection Type" },
          { "type": "Dropdown", "scope": "result", "title": "Result" }
        ]
      },
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "TextLine", "scope": "inspector", "title": "Inspector" },
          { "type": "TextLine", "scope": "validUntil", "title": "Valid Until" }
        ]
      }
    ]
  },
  "disclosure": {
    "sensitive": [],
    "recommendation": "Inspection certificates are typically shared with all parties requiring proof of compliance. Conditional results may include commercially sensitive details to restrict."
  }
}
