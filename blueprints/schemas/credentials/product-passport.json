{
  "identifier": "product-passport",
  "title": "Product Passport",
  "description": "Digital product passport compliant with EU ESPR requirements, capturing material composition, sustainability metrics, and manufacturer details",
  "version": "1.0.0",
  "category": "credentials",
  "tags": ["product-passport", "espr", "sustainability", "circular-economy", "credential", "eu"],
  "keywords": ["product passport", "gtin", "material", "carbon footprint", "repairability", "recycled", "manufacturer"],
  "schema": {
    "type": "object",
    "properties": {
      "productIdentifier": {
        "type": "string",
        "title": "Product Identifier",
        "description": "Unique product identifier",
        "minLength": 1,
        "maxLength": 100
      },
      "gtin": {
        "type": "string",
        "title": "GTIN",
        "description": "Global Trade Item Number (13 or 14 digits)",
        "pattern": "^[0-9]{13,14}$"
      },
      "materialComposition": {
        "type": "string",
        "title": "Material Composition",
        "description": "Description of materials used in the product",
        "minLength": 1,
        "maxLength": 1000
      },
      "carbonFootprint": {
        "type": "number",
        "title": "Carbon Footprint",
        "description": "Carbon footprint in kg CO2 equivalent",
        "minimum": 0
      },
      "repairabilityScore": {
        "type": "number",
        "title": "Repairability Score",
        "description": "Repairability score (0 = not repairable, 10 = fully repairable)",
        "minimum": 0,
        "maximum": 10
      },
      "recycledContentPercentage": {
        "type": "number",
        "title": "Recycled Content (%)",
        "description": "Percentage of recycled content in the product",
        "minimum": 0,
        "maximum": 100
      },
      "hazardousSubstances": {
        "type": "string",
        "title": "Hazardous Substances",
        "description": "Declaration of hazardous substances (SVHC/REACH)",
        "maxLength": 1000
      },
      "countryOfManufacture": {
        "type": "string",
        "title": "Country of Manufacture",
        "description": "Country where the product was manufactured",
        "minLength": 1,
        "maxLength": 100
      },
      "manufacturerIdentifier": {
        "type": "string",
        "title": "Manufacturer Identifier",
        "description": "Unique identifier for the manufacturer",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "required": ["productIdentifier", "gtin", "materialComposition", "countryOfManufacture", "manufacturerIdentifier"]
  },
  "formLayout": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "TextLine", "scope": "productIdentifier", "title": "Product Identifier" },
          { "type": "TextLine", "scope": "gtin", "title": "GTIN" }
        ]
      },
      { "type": "TextArea", "scope": "materialComposition", "title": "Material Composition" },
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "Number", "scope": "carbonFootprint", "title": "Carbon Footprint (kg CO2e)" },
          { "type": "Number", "scope": "repairabilityScore", "title": "Repairability Score" }
        ]
      },
      {
        "type": "HorizontalLayout",
        "elements": [
          { "type": "Number", "scope": "recycledContentPercentage", "title": "Recycled Content (%)" },
          { "type": "TextLine", "scope": "countryOfManufacture", "title": "Country of Manufacture" }
        ]
      },
      { "type": "TextArea", "scope": "hazardousSubstances", "title": "Hazardous Substances" },
      { "type": "TextLine", "scope": "manufacturerIdentifier", "title": "Manufacturer Identifier" }
    ]
  },
  "disclosure": {
    "sensitive": [],
    "recommendation": "All product passport fields are publicly readable per EU ESPR regulation. This data is designed for transparency and should be disclosed to all participants, consumers, and regulatory bodies."
  }
}
