{
  "id": "register-governance-v1",
  "title": "Register Governance",
  "description": "Manages admin roster changes for a register via multi-sig quorum workflow",
  "version": 1,
  "category": "governance",
  "tags": [
    "governance",
    "admin",
    "quorum",
    "multi-sig"
  ],
  "author": "Sorcha Team",
  "published": true,
  "template": {
    "@context": "https://sorcha.dev/blueprints/v1",
    "id": "register-governance-v1",
    "title": "Register Governance",
    "description": "Manages admin roster changes for a register via multi-sig quorum workflow",
    "version": 1,
    "participants": [
      {
        "id": "proposer",
        "name": "Proposer",
        "organisation": "Register Admin"
      },
      {
        "id": "voter",
        "name": "Voter",
        "organisation": "Register Admin"
      },
      {
        "id": "target",
        "name": "Target",
        "organisation": "New/Departing Admin"
      }
    ],
    "actions": [
      {
        "id": 0,
        "title": "Assert Ownership",
        "sender": "proposer",
        "isStartingAction": true,
        "routes": [
          {
            "id": "genesis-to-propose",
            "nextActionIds": [
              1
            ],
            "isDefault": true
          }
        ]
      },
      {
        "id": 1,
        "title": "Propose Change",
        "sender": "proposer",
        "routes": [
          {
            "id": "transfer-skip-quorum",
            "nextActionIds": [
              3
            ],
            "condition": {
              "==": [
                {
                  "var": "operationType"
                },
                "Transfer"
              ]
            }
          },
          {
            "id": "owner-override",
            "nextActionIds": [
              3
            ],
            "condition": {
              "and": [
                {
                  "==": [
                    {
                      "var": "ownerOverride"
                    },
                    true
                  ]
                },
                {
                  "==": [
                    {
                      "var": "requiresAcceptance"
                    },
                    true
                  ]
                }
              ]
            }
          },
          {
            "id": "owner-override-no-acceptance",
            "nextActionIds": [
              4
            ],
            "condition": {
              "and": [
                {
                  "==": [
                    {
                      "var": "ownerOverride"
                    },
                    true
                  ]
                },
                {
                  "==": [
                    {
                      "var": "requiresAcceptance"
                    },
                    false
                  ]
                }
              ]
            }
          },
          {
            "id": "to-quorum",
            "nextActionIds": [
              2
            ],
            "isDefault": true
          }
        ],
        "dataSchemas": [
          {
            "type": "object",
            "title": "Governance proposal",
            "description": "The sealed ControlTransactionPayload of a Propose Change action. The envelope is the contract: the operation travels nested under `operation`, not flattened to the top level.",
            "required": [
              "version",
              "roster",
              "operation",
              "enactsProposalId"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "title": "Payload schema version"
              },
              "roster": {
                "type": [
                  "object",
                  "null"
                ],
                "title": "Roster snapshot",
                "description": "Always null on a proposal. A proposal enacts nothing, and writing a roster here would move LastControlTxId so the proposal invalidated itself the instant it sealed (FR-011b). Left unconstrained: the roster contract is declared by RegisterControlRecord, and restating it here would give it a second home to drift from."
              },
              "operation": {
                "type": "object",
                "title": "Governance operation",
                "description": "The change being proposed. Bound in full by every approval signature.",
                "required": [
                  "operationType",
                  "proposerDid",
                  "proposedAt",
                  "rosterSnapshotId",
                  "quorumFormulaAtRaise"
                ],
                "properties": {
                  "operationType": {
                    "type": "string",
                    "enum": [
                      "Add",
                      "Remove",
                      "Transfer",
                      "AddValidator",
                      "RemoveValidator",
                      "RotateValidatorKey",
                      "RevokeIssuanceKey",
                      "RotateIssuanceKey",
                      "CryptoPolicyUpdate"
                    ],
                    "title": "Operation",
                    "x-enumNames": [
                      "Add participant",
                      "Remove participant",
                      "Transfer ownership",
                      "Add validator",
                      "Remove validator",
                      "Rotate validator key",
                      "Revoke issuance key",
                      "Rotate issuance key",
                      "Change encryption policy"
                    ]
                  },
                  "proposerDid": {
                    "type": "string",
                    "title": "Proposed by"
                  },
                  "targetDid": {
                    "type": "string",
                    "title": "Subject of the change"
                  },
                  "targetRole": {
                    "type": "string",
                    "enum": [
                      "Owner",
                      "Admin",
                      "Auditor",
                      "Designer"
                    ],
                    "title": "Role"
                  },
                  "proposedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Proposal expires"
                  },
                  "justification": {
                    "type": "string",
                    "title": "Why",
                    "maxLength": 2000
                  },
                  "validatorEntry": {
                    "type": "object",
                    "title": "Validator being added or rotated",
                    "description": "Bound by the approval digest — approving 'add a validator' must not authorise adding an arbitrary one."
                  },
                  "rosterSnapshotId": {
                    "type": "string",
                    "title": "Roster at time of raise"
                  },
                  "quorumFormulaAtRaise": {
                    "type": "string",
                    "enum": [
                      "StrictMajority",
                      "Supermajority",
                      "Unanimous"
                    ],
                    "title": "Approval rule in force"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "Pending",
                      "Approved",
                      "Rejected",
                      "Expired",
                      "Recorded"
                    ],
                    "title": "Proposal status",
                    "description": "Advisory. The authoritative status is derived from sealed content by GovernanceProposalStatus.Derive, never read from here."
                  },
                  "approvalSignatures": {
                    "type": "array",
                    "title": "Inline approvals",
                    "description": "Owner-override propose-and-enact carries its approvals inline. Empty on a consortium proposal, whose approvals arrive as separate Collect Quorum actions.",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              },
              "enactsProposalId": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "Enacts proposal",
                "description": "Always null on a proposal, and present as an explicit null rather than omitted — it is the discriminator that separates a proposal from the enactment that settles it, so it must travel on both."
              }
            }
          }
        ]
      },
      {
        "id": 2,
        "title": "Collect Quorum",
        "sender": "voter",
        "routes": [
          {
            "id": "quorum-met",
            "nextActionIds": [
              3
            ],
            "condition": {
              "and": [
                {
                  "==": [
                    {
                      "var": "quorumMet"
                    },
                    true
                  ]
                },
                {
                  "==": [
                    {
                      "var": "requiresAcceptance"
                    },
                    true
                  ]
                }
              ]
            }
          },
          {
            "id": "quorum-met-no-acceptance",
            "nextActionIds": [
              4
            ],
            "condition": {
              "and": [
                {
                  "==": [
                    {
                      "var": "quorumMet"
                    },
                    true
                  ]
                },
                {
                  "==": [
                    {
                      "var": "requiresAcceptance"
                    },
                    false
                  ]
                }
              ]
            }
          },
          {
            "id": "quorum-blocked",
            "nextActionIds": [
              1
            ],
            "condition": {
              "==": [
                {
                  "var": "quorumBlocked"
                },
                true
              ]
            }
          },
          {
            "id": "collect-more",
            "nextActionIds": [
              2
            ],
            "isDefault": true
          }
        ],
        "dataSchemas": [
          {
            "type": "object",
            "title": "Governance approval",
            "description": "The payload of an approval submitted as this action. Kept in lockstep with GovernanceApprovalActionPayload by GovernanceApprovalPayloadContractTests — a field on one side and not the other fails the build.",
            "required": [
              "type",
              "proposalId",
              "approverDid",
              "isApproval",
              "signature",
              "publicKey",
              "authMethod",
              "statementVersion",
              "authorisation"
            ],
            "properties": {
              "type": {
                "type": "string",
                "const": "governance-approval",
                "title": "Payload discriminator",
                "description": "Inside the signed payload rather than transaction metadata, which is outside the signature, the payload hash and the merkle leaf."
              },
              "proposalId": {
                "type": "string",
                "title": "Proposal being voted on",
                "description": "The proposal is a ledger transaction, so this is its transaction id."
              },
              "approverDid": {
                "type": "string",
                "title": "Approving organisation"
              },
              "isApproval": {
                "type": "boolean",
                "title": "Approve or reject",
                "description": "Bound by the digest, so a rejection cannot be counted as an approval by flipping it."
              },
              "signature": {
                "type": "string",
                "title": "Organisation signature (slot 100)"
              },
              "publicKey": {
                "type": "string",
                "title": "Organisation public key"
              },
              "authMethod": {
                "type": "string",
                "enum": [
                  "unknown",
                  "software",
                  "hardware-backed",
                  "service"
                ],
                "title": "How the key was held",
                "description": "Recorded so a register may require a minimum standard for a given operation (R-016). 'unknown' is the weakest and is what an unstated method records as — a schema that could not express it would make a legitimate payload invalid."
              },
              "statementVersion": {
                "type": "string",
                "title": "Statement the signature commits to",
                "description": "Carried so a reader rebuilds the right statement rather than inferring it. v1 signatures must not verify under v2 (R-011)."
              },
              "comment": {
                "type": "string",
                "maxLength": 2000
              },
              "authorisation": {
                "type": "object",
                "title": "Who stands behind this approval",
                "description": "Required on EVERY approval (FR-029). An autonomous approver is delegated, not unaccountable.",
                "required": [
                  "kind",
                  "individualDid",
                  "signature",
                  "publicKey",
                  "authMethod",
                  "algorithm"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "direct",
                      "delegated"
                    ]
                  },
                  "individualDid": {
                    "type": "string",
                    "title": "The person accountable"
                  },
                  "signature": {
                    "type": "string"
                  },
                  "publicKey": {
                    "type": "string",
                    "description": "Direct: the individual's own key. Delegated: the machine's key, tied to the grant by approverPublicKey."
                  },
                  "authMethod": {
                    "type": "string",
                    "enum": [
                      "unknown",
                      "software",
                      "hardware-backed",
                      "service"
                    ]
                  },
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "ED25519",
                      "NISTP256",
                      "RSA4096",
                      "ML_DSA_65",
                      "SLH_DSA_128s"
                    ],
                    "title": "Algorithm of publicKey",
                    "description": "Carried because, unlike an organisation, an individual has no roster entry recording it."
                  },
                  "delegationAlgorithm": {
                    "type": "string",
                    "enum": [
                      "ED25519",
                      "NISTP256",
                      "RSA4096",
                      "ML_DSA_65",
                      "SLH_DSA_128s"
                    ],
                    "title": "Algorithm of delegationPublicKey"
                  },
                  "delegationSignature": {
                    "type": "string",
                    "title": "The grantor's signature over the delegation statement",
                    "description": "Present only for a delegated authorisation. This, not the machine's signature, is what binds a named individual to the grant."
                  },
                  "delegationPublicKey": {
                    "type": "string",
                    "title": "Key that produced delegationSignature",
                    "description": "Must derive to the wallet address inside the grant's individualDid, or the accountability record is self-declared."
                  },
                  "delegation": {
                    "type": "object",
                    "title": "How a machine came to be empowered",
                    "description": "Signed by the empowering individual's own key — never server-asserted, because the server mints tokens (FR-033).",
                    "required": [
                      "delegationId",
                      "organisationDid",
                      "individualDid",
                      "approverPublicKey",
                      "scope",
                      "expiresAt",
                      "grantedAt"
                    ],
                    "properties": {
                      "delegationId": {
                        "type": "string"
                      },
                      "organisationDid": {
                        "type": "string",
                        "title": "Organisation whose authority is exercised"
                      },
                      "individualDid": {
                        "type": "string",
                        "title": "The individual who empowered the approver"
                      },
                      "approverPublicKey": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "Add",
                            "Remove",
                            "Transfer",
                            "AddValidator",
                            "RemoveValidator",
                            "RotateValidatorKey",
                            "RevokeIssuanceKey",
                            "RotateIssuanceKey",
                            "CryptoPolicyUpdate"
                          ]
                        },
                        "title": "Operations this delegation permits",
                        "description": "A bot may be empowered for routine changes while Transfer still requires a human."
                      },
                      "expiresAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "grantedAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      {
        "id": 3,
        "title": "Accept Role",
        "sender": "target",
        "routes": [
          {
            "id": "accepted",
            "nextActionIds": [
              4
            ],
            "condition": {
              "==": [
                {
                  "var": "accepted"
                },
                true
              ]
            }
          },
          {
            "id": "declined",
            "nextActionIds": [
              1
            ],
            "isDefault": true
          }
        ]
      },
      {
        "id": 4,
        "title": "Record Control Transaction",
        "sender": "proposer",
        "routes": [
          {
            "id": "loop-back",
            "nextActionIds": [
              1
            ],
            "isDefault": true
          }
        ]
      }
    ],
    "metadata": {
      "category": "governance",
      "type": "register-governance",
      "isSystem": "true",
      "hasCycles": "true"
    }
  },
  "parameterSchema": null,
  "defaultParameters": null,
  "examples": []
}
