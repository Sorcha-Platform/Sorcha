# =============================================================================
# Sorcha Platform — Environment Configuration
# =============================================================================
#
# Copy this file to .env and edit the values for your environment.
# Run ./scripts/sorcha-setup.sh for interactive setup that generates this file.
#
# NEVER commit .env to source control — it contains secrets.
# The .env file is already in .gitignore.
#
# Variables marked [REQUIRED] must be set. Others have sensible defaults.
# Variables marked [SECRET] should use strong random values in production.
#

# =============================================================================
# Installation Identity
# =============================================================================

# Display name for this Sorcha node. Used in JWT issuer URLs and peer identity.
# For local development, "localhost" is fine. In production, use your domain.
# ALWAYS SET THIS EXPLICITLY (same reasoning as JWT_SIGNING_KEY below): it drives
# the token issuer (urn:sorcha:{name}) and tier audiences, and base-compose-only
# services such as mcp-server-http read it from this .env. A mismatch here means
# tokens self-reject on issuer/audience instead of signature.
INSTALLATION_NAME=localhost

# =============================================================================
# JWT Authentication                                                  [SECRET]
# =============================================================================

# 256-bit base64-encoded key used to sign all JWT tokens.
# CRITICAL: Generate a unique key for every deployment.
# Generate with: openssl rand -base64 32
# Default below is for development only — CHANGE IN PRODUCTION.
#
# ALWAYS SET THIS EXPLICITLY — do not rely on per-service defaults.
# Some services are defined ONLY in the base docker-compose.yml (e.g.
# mcp-server-http, the Streamable HTTP MCP transport) and therefore do NOT
# receive the jwt-env override that environment overlays like
# docker-compose.n1.yml apply to the core services. Those base-only services
# read JWT_SIGNING_KEY from THIS .env via the base anchor's `${JWT_SIGNING_KEY:-…}`
# fallback. If JWT_SIGNING_KEY is unset, they fall back to the generic dev key
# above while the rest of the stack uses the overlay's key — the mismatch makes
# them reject every real token with `IDX10517: Signature validation failed`.
# Pinning it here keeps the base anchor and every overlay anchor on ONE key.
JWT_SIGNING_KEY=c29yY2hhLWRvY2tlci1kZXYta2V5LTIwMjUtbWluLTI1Ni1iaXRzLXNlY3VyZQ==

# =============================================================================
# PostgreSQL Database                                                 [SECRET]
# =============================================================================

# Credentials for PostgreSQL (used by Tenant Service and Wallet Service).
# The docker-compose stack creates the database with these credentials.
POSTGRES_USER=sorcha
POSTGRES_PASSWORD=sorcha_dev_password

# Override the default PostgreSQL port if 5432 is already in use.
# POSTGRES_PORT=5432

# =============================================================================
# MongoDB Database                                                    [SECRET]
# =============================================================================

# Credentials for MongoDB (used by Register Service for ledger storage).
# The docker-compose stack creates the database with these credentials.
MONGO_USERNAME=sorcha
MONGO_PASSWORD=sorcha_dev_password

# Override the default MongoDB port if 27017 is already in use.
# MONGODB_PORT=27017

# =============================================================================
# Redis
# =============================================================================

# Redis password. Leave empty for no authentication (development only).
# In production, set a strong password.
REDIS_PASSWORD=

# Override the default Redis port if 6379 is already in use.
# REDIS_PORT=16379

# =============================================================================
# Runtime Environment
# =============================================================================

# ASP.NET Core environment: Development, Staging, or Production.
# Development enables detailed errors, Scalar API docs, and seed data.
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# Social login OAuth credentials                                      [SECRET]
# =============================================================================
# Used only on environments configured for public social signup (e.g. n1).
# Leave blank for local dev — the corresponding "Continue with..." buttons
# will be hidden when credentials are absent.
#
# To register the OAuth applications and obtain these values, see:
#   docs/guides/SOCIAL-LOGIN-SETUP.md

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# =============================================================================
# AI Integration (Optional)
# =============================================================================

# Anthropic API key for AI-assisted blueprint design chat.
# Leave empty to disable AI features. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# =============================================================================
# Peer Network (Optional)
# =============================================================================

# Unique node ID for this Sorcha instance in the peer network.
# Format: <name>.sorcha.dev (or your domain)
PEER_NODE_ID=local-peer.sorcha.dev

# Public address for incoming peer connections (empty = not publicly reachable).
# PEER_PUBLIC_ADDRESS=

# Seed peer to connect to on startup (for joining an existing network).
# Leave empty for standalone operation. To run this node as a SyncOnly replica
# of an existing network (e.g. n1.sorcha.dev), point these at the seed node.
# SEED_PEER_NODE_ID=n1.sorcha.dev
# SEED_PEER_HOST=n1.sorcha.dev
# SEED_PEER_PORT=50051
#
# Whether the seed's gRPC port is TLS-terminated. Set to "true" when the seed is
# reached over the internet via HTTPS (e.g. a public node behind Caddy, which
# terminates TLS on its gRPC port); "false" for a plaintext docker-network seed.
# CRITICAL for cross-node sync: a wrong value makes the peer channel dial the
# wrong scheme, so replication/fan-out to the owner silently fails.
# SEED_PEER_ENABLE_TLS=false

# =============================================================================
# Transactional Email (Optional)
# =============================================================================
# Used by the Tenant Service for verification / invite / welcome emails.
# Leave ACS_EMAIL_CONNECTION_STRING empty to use the SMTP path (or no-op in dev).

# Base URL used to build links (verify-email, accept-invite) in email bodies.
EMAIL_BASE_URL=http://localhost
# From-address and display name on outbound transactional email.
EMAIL_FROM_ADDRESS=noreply@sorcha.dev
EMAIL_FROM_NAME=Sorcha Platform
# Azure Communication Services connection string. When set, ACS is used instead
# of SMTP. Leave empty for SMTP / development.                         [SECRET]
ACS_EMAIL_CONNECTION_STRING=

# =============================================================================
# OpenTelemetry (Optional)
# =============================================================================
# OTLP exporter endpoints (the Aspire dashboard / collector listens on these).
OTEL_SERVICE_NAME=sorcha-service
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# =============================================================================
# API Documentation
# =============================================================================
# Require auth on the Scalar / OpenAPI surfaces. Defaults to true; set false to
# expose API docs without a token (development convenience only).
# OPENAPI_REQUIRE_AUTH=true

# =============================================================================
# Deployment (n1 / remote nodes)
# =============================================================================
# Public IP / hostname of the n1 node, used by the n1 docker-compose override
# and the ports override to advertise the node's reachable address.
# N1_PUBLIC_IP=n1.sorcha.dev

# =============================================================================
# Port Overrides (Optional)
# =============================================================================
# Override default ports if they conflict with other services on your machine.
# Defaults are shown in comments. Uncomment and change as needed.
#
# GATEWAY_HTTP_PORT=80         # API Gateway HTTP
# GATEWAY_HTTPS_PORT=443       # API Gateway HTTPS
# BLUEPRINT_PORT=5000          # Blueprint Service
# REGISTER_PORT=5380           # Register Service
# TENANT_PORT=5450             # Tenant Service
# VALIDATOR_HTTP_PORT=5800     # Validator Service HTTP
# VALIDATOR_GRPC_PORT=5801     # Validator Service gRPC
# UI_HTTP_PORT=5400            # Sorcha UI HTTP
# UI_HTTPS_PORT=5401           # Sorcha UI HTTPS
# WALLET_PWA_PORT=7400         # Citizen Wallet PWA
# VERIFIER_PORT=7401           # Reference Verifier
# PEER_GRPC_PORT=50051         # Peer Service gRPC
# MONGODB_PORT=27017           # MongoDB (also documented above)
# ASPIRE_UI_PORT=18888         # Aspire Dashboard

# =============================================================================
# RATE LIMITS (#1437 / #1533)
# =============================================================================
# The API Gateway's limits are set in docker-compose.yml and are DELIBERATELY tight
# because the gateway is the public edge. Override them per deploy here — do not
# loosen docker-compose.n1.yml, and never add a second `environment:` key to a
# service block (a duplicate mapping key makes compose refuse the whole file).
#
# The one that bites: `authentication` is a SLIDING 1-minute window PARTITIONED PER
# IP. At the default of 60 it is saturated by any bulk provisioning from a single
# address — running the walkthrough suite 429s part-way through every setup, which
# reads exactly like a platform failure rather than a limiter.
#
# Raise these on a dev/demo node that provisions in bulk (n1 uses 1200/6000/600/100).
# Leave them at the defaults on anything internet-facing you care about.
RATELIMIT_AUTH_PERMIT=60
RATELIMIT_AUTH_QUEUE=0
RATELIMIT_API_PERMIT=600
RATELIMIT_API_QUEUE=0
RATELIMIT_STRICT_TOKENS=60
RATELIMIT_STRICT_PER_PERIOD=10
RATELIMIT_STRICT_PERIOD_SECS=1
RATELIMIT_STRICT_QUEUE=0
