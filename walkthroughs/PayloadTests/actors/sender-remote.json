{
  "actor": {
    "name": "sender",
    "description": "Generates test file, uploads chunks, executes Send File action (remote)"
  },
  "connection": {
    "gatewayUrl": "https://n1.sorcha.dev",
    "registerId": "{{registerId}}",
    "credentials": {
      "email": "{{sender.email}}",
      "password": "$env:SENDER_PASSWORD",
      "organizationId": "{{sender.organizationId}}"
    },
    "walletAddress": "{{sender.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 30 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Send File",
      "decision": "approve",
      "preActions": [
        {
          "type": "file-upload",
          "config": {
            "fieldName": "attachment",
            "sizeBytes": 1024,
            "seed": 85,
            "fileName": "test-file.bin",
            "contentType": "application/octet-stream"
          }
        }
      ],
      "payload": {
        "message": "Agent cross-node file transfer (1KB)"
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/sender-actions.jsonl"
  }
}
