{
  "actor": {
    "name": "building-control",
    "description": "Technical inspection, compliance check, and fee calculation (remote machine)"
  },
  "connection": {
    "gatewayUrl": "https://n1.sorcha.dev",
    "registerId": "{{registerId}}",
    "credentials": {
      "email": "{{roles.building-control.email}}",
      "password": "$env:INSPECTOR_PASSWORD",
      "organizationId": "{{roles.building-control.organizationId}}"
    },
    "walletAddress": "{{roles.building-control.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 30 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Building Control Inspection",
      "decision": "approve",
      "payload": {
        "structuralApproved": true,
        "fireCompliant": true,
        "accessCompliant": true,
        "inspectionNotes": "All structural, fire safety, and accessibility requirements met."
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/building-control-actions.jsonl"
  }
}
