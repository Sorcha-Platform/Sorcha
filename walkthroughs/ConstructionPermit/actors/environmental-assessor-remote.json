{
  "actor": {
    "name": "environmental-assessor",
    "description": "Environmental impact assessment (remote machine)"
  },
  "connection": {
    "gatewayUrl": "https://n1.sorcha.dev",
    "registerId": "{{registerId}}",
    "credentials": {
      "email": "{{roles.environmental-assessor.email}}",
      "password": "$env:ENVIRONMENTAL_PASSWORD",
      "organizationId": "{{roles.environmental-assessor.organizationId}}"
    },
    "walletAddress": "{{roles.environmental-assessor.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 30 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Environmental Impact Assessment",
      "decision": "approve",
      "payload": {
        "environmentalImpact": "low",
        "mitigationRequired": false,
        "environmentalConditions": "No significant environmental impact identified."
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/environmental-assessor-actions.jsonl"
  }
}
