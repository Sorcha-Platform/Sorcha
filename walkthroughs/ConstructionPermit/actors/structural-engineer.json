{
  "actor": {
    "name": "structural-engineer",
    "description": "Independent structural review with risk score calculation"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{registerId}}",
    "credentials": {
      "email": "{{roles.structural-engineer.email}}",
      "password": "$env:ENGINEER_PASSWORD",
      "organizationId": "{{roles.structural-engineer.organizationId}}"
    },
    "walletAddress": "{{roles.structural-engineer.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 30 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Structural Assessment",
      "decision": "approve",
      "payload": {
        "loadRating": 4.5,
        "foundationType": "strip",
        "structuralGrade": "B",
        "structuralNotes": "Standard residential structure. Strip foundations adequate for soil conditions. No concerns with load-bearing capacity."
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/structural-engineer-actions.jsonl"
  }
}
