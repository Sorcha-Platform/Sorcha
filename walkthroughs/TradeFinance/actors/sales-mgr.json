{
  "actor": {
    "name": "sales-mgr",
    "description": "Acknowledges POs, confirms delivery, raises invoices (Highland Timber)"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{registers.sme-trade-register.id}}",
    "credentials": {
      "email": "{{roles.sales-mgr.email}}",
      "password": "$env:SALES_MGR_PASSWORD",
      "organizationId": "{{roles.sales-mgr.organizationId}}"
    },
    "walletAddress": "{{roles.sales-mgr.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 20 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Acknowledge PO",
      "decision": "approve",
      "payload": {
        "accepted": true,
        "estimatedDeliveryDate": "2026-04-14",
        "orderConfirmationRef": "HTS-ACK-2026-0892",
        "notes": "Order confirmed. Stock available from Inverness depot. Delivery scheduled for 14 April."
      }
    },
    {
      "actionName": "Confirm Delivery",
      "decision": "approve",
      "payload": {
        "deliveryNoteRef": "HTS-DN-2026-1204",
        "actualDeliveryDate": "2026-04-14",
        "deliveredItems": [
          { "description": "Structural Timber C24 (47x200mm)", "quantityDelivered": 500 },
          { "description": "OSB/3 Structural Board (18mm)", "quantityDelivered": 120 },
          { "description": "Joist Hangers & Connectors (mixed)", "quantityDelivered": 10 }
        ],
        "deliveryCondition": "Good — all items delivered intact, no damage noted. Timber moisture content within spec."
      }
    },
    {
      "actionName": "Raise Invoice",
      "decision": "approve",
      "payload": {
        "invoiceNumber": "HTS-INV-2026-03847",
        "invoiceDate": "2026-04-17",
        "lineItems": [
          { "description": "Structural Timber C24 (47x200mm)", "quantity": 500, "unitPrice": 8.50, "lineTotal": 4250 },
          { "description": "OSB/3 Structural Board (18mm)", "quantity": 120, "unitPrice": 32.00, "lineTotal": 3840 },
          { "description": "Joist Hangers & Connectors (mixed)", "quantity": 10, "unitPrice": 45.00, "lineTotal": 450 }
        ],
        "subtotal": 8540,
        "vatRate": 0.20,
        "vatAmount": 1708,
        "invoiceTotal": 10248,
        "paymentTerms": "Net 30",
        "paymentDueDate": "2026-05-17",
        "supplierCostBreakdown": {
          "materialCost": 6200,
          "logistics": 480,
          "margin": 1860,
          "marginPercentage": 21.8
        }
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/sales-mgr-actions.jsonl"
  }
}
