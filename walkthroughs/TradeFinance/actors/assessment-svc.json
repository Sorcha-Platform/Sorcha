{
  "actor": {
    "name": "assessment-svc",
    "description": "Automated buyer credit assessment (UK Trade Credit Bureau)"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{registers.trade-finance-register.id}}",
    "credentials": {
      "email": "{{roles.assessment-svc.email}}",
      "password": "$env:ASSESSMENT_SVC_PASSWORD",
      "organizationId": "{{roles.assessment-svc.organizationId}}"
    },
    "walletAddress": "{{roles.assessment-svc.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 20 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Buyer Credit Assessment",
      "decision": "approve",
      "payload": {
        "buyerCreditScore": 85,
        "creditLimit": 250000,
        "riskRating": "low",
        "assessmentDate": "2026-04-17",
        "paymentHistoryScore": 92,
        "yearsTrading": 14,
        "assessmentNotes": "Strong payment history. No defaults recorded. Established Highland contractor with 14 years trading. Credit limit comfortably covers requested financing."
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/assessment-svc-actions.jsonl"
  }
}
