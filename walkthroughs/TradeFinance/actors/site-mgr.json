{
  "actor": {
    "name": "site-mgr",
    "description": "Confirms goods received on site (Cairngorm Construction)"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{registers.sme-trade-register.id}}",
    "credentials": {
      "email": "{{roles.site-mgr.email}}",
      "password": "$env:SITE_MGR_PASSWORD",
      "organizationId": "{{roles.site-mgr.organizationId}}"
    },
    "walletAddress": "{{roles.site-mgr.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 20 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Confirm Goods Received",
      "decision": "approve",
      "payload": {
        "grnReference": "CAIRN-GRN-2026-00418",
        "receivedDate": "2026-04-14",
        "conditionNotes": "All items received in good condition. Quantities match delivery note HTS-DN-2026-1204. Timber stored under cover on site.",
        "discrepancyFlag": false
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/site-mgr-actions.jsonl"
  }
}
