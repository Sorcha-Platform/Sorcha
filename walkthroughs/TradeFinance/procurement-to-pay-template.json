{
  "id": "trade-finance-procurement-to-pay-v1",
  "title": "SME Procurement-to-Pay",
  "description": "Multi-organisation procurement-to-pay workflow for SME trade finance. A buyer (Cairngorm Construction) raises a purchase order to a supplier (Highland Timber Supplies), who acknowledges, delivers, and invoices. The buyer confirms goods received and approves or disputes the invoice. A funder (ScotTrade Finance) observes with limited disclosure. Features field-level encryption, selective disclosure, verifiable credential issuance on approval, and a dispute loop.",
  "version": 1,
  "category": "trade-finance",
  "tags": ["procurement", "trade-finance", "sme", "multi-org", "verifiable-credential", "field-level-encryption", "selective-disclosure"],
  "author": "Sorcha Team",
  "published": true,
  "template": {
    "id": "trade-finance-procurement-to-pay-generated",
    "title": "SME Procurement-to-Pay",
    "description": "A realistic procurement-to-pay process between a construction buyer and timber supplier, with a trade finance funder observing under selective disclosure. Six actions cover the full cycle from purchase order through delivery, goods receipt, invoicing, and approval with dispute routing. Demonstrates field-level encryption, selective disclosure to a funder, and VerifiedInvoiceCredential issuance.",
    "version": 1,
    "metadata": {
      "category": "Trade Finance",
      "complexity": "Medium",
      "actions": "6",
      "features": "Multi-Org, Field-Level Encryption, Selective Disclosure, Verifiable Credential, Dispute Routing, Calculations",
      "sector": "Construction & Supply Chain"
    },
    "instanceReference": {
      "prefix": "PO",
      "components": [
        { "field": "/projectName", "transform": "FirstWord", "chars": 3 },
        { "field": "/poReference", "transform": "Truncate", "chars": 4 }
      ]
    },
    "participants": [
      {
        "id": "procurement-mgr",
        "name": "Procurement Manager",
        "organisation": "Cairngorm Construction Ltd",
        "description": "Raises purchase orders, confirms goods received notices, and approves or disputes invoices."
      },
      {
        "id": "site-mgr",
        "name": "Site Manager",
        "organisation": "Cairngorm Construction Ltd",
        "description": "Confirms goods received on site against delivery notes and flags any discrepancies."
      },
      {
        "id": "sales-mgr",
        "name": "Sales Manager",
        "organisation": "Highland Timber Supplies",
        "description": "Acknowledges purchase orders, confirms delivery, and raises invoices for completed orders."
      },
      {
        "id": "finance-director",
        "name": "Finance Director",
        "organisation": "Highland Timber Supplies",
        "description": "Observes procurement workflow for internal finance oversight and trade financing purposes."
      },
      {
        "id": "credit-analyst",
        "name": "Credit Analyst",
        "organisation": "ScotTrade Finance",
        "description": "Funder observer with limited disclosure — sees only payment terms and invoice totals for credit assessment."
      }
    ],
    "actions": [
