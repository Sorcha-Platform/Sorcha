      {
        "id": 5,
        "title": "Raise Invoice",
        "description": "Sales manager raises an invoice for the delivered goods, including line item totals, VAT, and payment terms. The supplier cost breakdown is private to the supplier and finance director only.",
        "sender": "sales-mgr",
        "requiredPriorActions": [4],
        "rejectionConfig": { "isTerminal": true },
        "dataSchemas": [
          {
            "type": "object",
            "properties": {
              "invoiceNumber": {
                "type": "string",
                "title": "Invoice Number",
                "maxLength": 30
              },
              "invoiceDate": {
                "type": "string",
                "title": "Invoice Date",
                "format": "date"
              },
              "lineItems": {
                "type": "array",
                "title": "Invoice Line Items",
                "items": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "title": "Description"
                    },
                    "quantity": {
                      "type": "number",
                      "title": "Quantity"
                    },
                    "unitPrice": {
                      "type": "number",
                      "title": "Unit Price (GBP)"
                    },
                    "lineTotal": {
                      "type": "number",
