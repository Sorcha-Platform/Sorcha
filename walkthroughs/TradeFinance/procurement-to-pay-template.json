      {
        "id": 6,
        "title": "Approve/Dispute Invoice",
        "description": "Procurement manager reviews the invoice and either approves (issuing a VerifiedInvoiceCredential to the supplier) or disputes and returns to the supplier for resubmission.",
        "sender": "procurement-mgr",
        "requiredPriorActions": [5],
        "dataSchemas": [
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "title": "Decision",
                "enum": ["approve", "dispute"]
              },
              "approvalNotes": {
                "type": "string",
                "title": "Approval Notes",
                "maxLength": 1000
              },
              "approvedAmount": {
                "type": "number",
                "title": "Approved Amount (GBP)",
                "minimum": 0
              },
              "disputeReason": {
                "type": "string",
                "title": "Dispute Reason",
                "maxLength": 1000
              },
              "poReference": {
