            "type": "object",
            "properties": {
              "poReference": {
                "type": "string",
                "title": "PO Reference",
                "maxLength": 30
              },
              "projectName": {
                "type": "string",
                "title": "Project Name",
                "minLength": 3,
                "maxLength": 200
              },
              "siteAddress": {
                "type": "string",
                "title": "Site Address",
                "maxLength": 500
              },
              "lineItems": {
