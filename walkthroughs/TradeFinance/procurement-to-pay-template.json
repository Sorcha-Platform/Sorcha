                }
              },
              "subtotal": {
                "type": "number",
                "title": "Subtotal (GBP)",
                "minimum": 0
              },
              "vatRate": {
                "type": "number",
                "title": "VAT Rate",
                "minimum": 0,
                "maximum": 1
              },
              "vatAmount": {
                "type": "number",
                "title": "VAT Amount (GBP)",
                "minimum": 0
              },
              "invoiceTotal": {
                "type": "number",
                "title": "Invoice Total (GBP)",
                "minimum": 0
              },
              "paymentTerms": {
                "type": "string",
                "title": "Payment Terms",
                "enum": ["Net 15", "Net 30", "Net 45", "Net 60"]
              },
              "paymentDueDate": {
                "type": "string",
                "title": "Payment Due Date",
                "format": "date"
              },
              "supplierCostBreakdown": {
                "type": "object",
                "title": "Supplier Cost Breakdown (Confidential)",
                "properties": {
                  "materialCost": {
                    "type": "number",
                    "title": "Material Cost (GBP)"
                  },
                  "logistics": {
                    "type": "number",
                    "title": "Logistics Cost (GBP)"
                  },
                  "margin": {
                    "type": "number",
                    "title": "Margin (GBP)"
                  },
                  "marginPercentage": {
                    "type": "number",
                    "title": "Margin Percentage"
                  }
                }
              }
            },
            "required": [
              "invoiceNumber",
              "invoiceDate",
              "lineItems",
              "subtotal",
              "vatRate",
              "vatAmount",
              "invoiceTotal",
              "paymentTerms",
              "paymentDueDate"
            ]
          }
        ],
        "calculations": {
          "invoiceTotal": {
            "reduce": [
              { "var": "lineItems" },
              { "+": [{ "var": "accumulator" }, { "var": "current.lineTotal" }] },
              0
            ]
          }
        },
        "disclosures": [
          {
            "participantAddress": "procurement-mgr",
            "dataPointers": ["/invoiceNumber", "/invoiceDate", "/lineItems", "/subtotal", "/vatRate", "/vatAmount", "/invoiceTotal", "/paymentTerms", "/paymentDueDate"]
