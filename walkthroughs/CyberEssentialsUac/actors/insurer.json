{
  "actor": {
    "name": "insurer",
    "description": "Cyber insurer — issues a premium quote after posture credential is verified"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{registerId}}",
    "credentials": {
      "email": "{{roles.insurer.email}}",
      "password": "$env:INSURER_PASSWORD",
      "organizationId": "{{roles.insurer.organizationId}}"
    },
    "walletAddress": "{{roles.insurer.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 30 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Issue Quote",
      "decision": "approve",
      "payload": {
        "premiumGbp": 4200.00,
        "quoteRef": "CE-Q-0001",
        "validUntil": "2027-06-02"
      }
    }
  ],
  "resilience": {
    "retryCount": 3,
    "retryDelaySeconds": 2,
    "circuitBreakerThreshold": 5,
    "circuitBreakerDurationSeconds": 30
  },
  "logging": {
    "level": "Information",
    "actionLog": "./logs/insurer-actions.jsonl"
  }
}
