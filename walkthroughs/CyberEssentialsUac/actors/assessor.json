{
  "actor": {
    "name": "assessor",
    "description": "Submits UAC assessments, issues posture credentials, or records non-compliance"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{registerId}}",
    "credentials": {
      "email": "{{roles.assessor.email}}",
      "password": "$env:ASSESSOR_PASSWORD",
      "organizationId": "{{roles.assessor.organizationId}}"
    },
    "walletAddress": "{{roles.assessor.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 30 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Submit UAC Assessment",
      "decision": "approve",
      "payload": {}
    },
    {
      "actionName": "Issue Posture Credential",
      "decision": "approve",
      "payload": {
        "issuanceNote": "Issued on UAC assessment pass"
      }
    },
    {
      "actionName": "Record Non-Compliance",
      "decision": "approve",
      "payload": {
        "remediationNotes": "Admin MFA not enforced — UAC requirement C failed"
      }
    }
  ],
  "resilience": {
    "retryCount": 3,
    "retryDelaySeconds": 2,
    "circuitBreakerThreshold": 5,
    "circuitBreakerDurationSeconds": 30
  },
  "logging": {
    "level": "Information",
    "actionLog": "./logs/assessor-actions.jsonl"
  }
}
