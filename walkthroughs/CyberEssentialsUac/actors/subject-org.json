{
  "actor": {
    "name": "subject-org",
    "description": "Assessed organisation — present for sorcha-agent validate and non-gated flows; credential-gated Request Cover is script-injected (see README)"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{registerId}}",
    "credentials": {
      "email": "{{roles.subject-org.email}}",
      "password": "$env:SUBJECT_ORG_PASSWORD",
      "organizationId": "{{roles.subject-org.organizationId}}"
    },
    "walletAddress": "{{roles.subject-org.walletAddress}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 30 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Request Cover",
      "decision": "approve",
      "payload": {
        "coverAmountGbp": 1000000,
        "sector": "Software",
        "employeeCount": 58
      }
    }
  ],
  "resilience": {
    "retryCount": 3,
    "retryDelaySeconds": 2,
    "circuitBreakerThreshold": 5,
    "circuitBreakerDurationSeconds": 30
  },
  "logging": {
    "level": "Information",
    "actionLog": "./logs/subject-org-actions.jsonl"
  }
}
