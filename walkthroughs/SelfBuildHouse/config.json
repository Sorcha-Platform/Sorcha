{
  "name": "SelfBuildHouse",
  "description": "Scottish self-build house — planning permission and building warrant across 2 registers, 6 organisations, 7 participants, with verifiable credentials, document uploads, and staged inspections.",
  "category": "multi-org",
  "organizations": [
    { "name": "Self-Builder (Member of Public)", "subdomain": "self-builder", "role": "applicant" },
    { "name": "Strathcarron Council — Planning", "subdomain": "strathcarron-planning", "role": "planning authority" },
    { "name": "Strathcarron Council — Building Standards", "subdomain": "strathcarron-building-standards", "role": "building warrant + inspections" },
    { "name": "Caledonian Water", "subdomain": "caledonian-water", "role": "utilities consultation" },
    { "name": "Murchison Engineering", "subdomain": "murchison-structural", "role": "site investigation + structural calcs" },
    { "name": "Heatherbank Environmental", "subdomain": "heatherbank", "role": "habitat survey + environmental assessment" }
  ],
  "secretsKey": "self-build-house",
  "requiresRegister": true,
  "requiresParticipants": true,
  "registers": [
    { "name": "Strathcarron Planning Register", "purpose": "Planning applications and decisions" },
    { "name": "Strathcarron Building Standards Register", "purpose": "Building warrants and completion certificates" }
  ],
  "templates": [
    "planning-permission-template.json",
    "building-warrant-template.json"
  ],
  "scenarios": [
    "data/scenario-a-happy-path.json",
    "data/scenario-b-protected-species.json",
    "data/scenario-c-refused.json"
  ]
}
