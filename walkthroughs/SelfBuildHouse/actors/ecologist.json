{
  "actor": {
    "name": "ecologist",
    "description": "Ecological survey and species mitigation (if triggered)"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{planningRegisterId}}",
    "credentials": {
      "email": "$env:ADMIN_EMAIL",
      "password": "$env:ADMIN_PASSWORD",
      "organizationId": "{{organizationId}}"
    },
    "walletAddress": "{{wallets.ecologist}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 20 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Ecological Survey",
      "decision": "approve",
      "payload": {
        "habitatClassification": "garden-ground",
        "protectedSpeciesPresent": false,
        "speciesFound": [],
        "ecologicalImpactRating": "negligible",
        "seasonalConstraints": "None identified. Site is maintained garden ground with no significant ecological features.",
        "surveyNotes": "Phase 1 habitat survey conducted. Site comprises maintained garden ground with ornamental planting. No trees with bat roost potential. No badger setts within 30m. No evidence of red squirrel activity. Ecological impact negligible."
      }
    },
    {
      "actionName": "Species Mitigation Plan",
      "decision": "approve",
      "payload": {
        "mitigationType": "habitat-enhancement",
        "licensingRequired": false,
        "constructionTimingRestrictions": "None required",
        "mitigationMeasures": "Standard biodiversity enhancement measures only",
        "estimatedMitigationCost": 0
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/ecologist-actions.jsonl"
  }
}
