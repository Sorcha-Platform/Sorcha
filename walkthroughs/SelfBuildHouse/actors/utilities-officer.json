{
  "actor": {
    "name": "utilities-officer",
    "description": "Utilities consultation for water and drainage feasibility"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{planningRegisterId}}",
    "credentials": {
      "email": "$env:ADMIN_EMAIL",
      "password": "$env:ADMIN_PASSWORD",
      "organizationId": "{{organizationId}}"
    },
    "walletAddress": "{{wallets.utilities-officer}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 20 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Utilities Consultation",
      "decision": "approve",
      "payload": {
        "waterSupplyFeasible": true,
        "nearestMainDistance": 25,
        "drainageSolution": "septic-tank",
        "surfaceWaterPlan": "soakaway",
        "capacityConfirmed": true,
        "connectionCostEstimate": 3500,
        "consultationOutcome": "feasible",
        "consultationNotes": "Water main available on Lochside Road, 25m from plot boundary. Connection feasible with standard works. Private septic tank with soakaway discharge acceptable given gravel subsoil."
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/utilities-officer-actions.jsonl"
  }
}
