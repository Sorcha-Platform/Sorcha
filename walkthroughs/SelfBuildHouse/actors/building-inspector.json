{
  "actor": {
    "name": "building-inspector",
    "description": "Foundation, structure, and final inspections with completion certificate"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{buildingRegisterId}}",
    "credentials": {
      "email": "$env:ADMIN_EMAIL",
      "password": "$env:ADMIN_PASSWORD",
      "organizationId": "{{organizationId}}"
    },
    "walletAddress": "{{wallets.building-inspector}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 20 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Foundation Inspection",
      "decision": "approve",
      "payload": {
        "inspectionDate": "2026-08-12",
        "foundationDepthMeasured": 620,
        "concreteSpecVerified": true,
        "reinforcementAsDrawing": true,
        "dampProofMembraneInstalled": true,
        "drainageRunsVerified": true,
        "outcome": "pass",
        "defectsNoted": "No defects. Foundations excavated to gravel formation at 620mm depth. C30 concrete as specified."
      }
    },
    {
      "actionName": "Structure & Weathertight Inspection",
      "decision": "approve",
      "payload": {
        "inspectionDate": "2026-11-18",
        "structuralFrameComplete": true,
        "roofComplete": true,
        "windowsDoorsInstalled": true,
        "insulationAsSpec": true,
        "airTightnessResult": 2.8,
        "outcome": "pass",
        "inspectorNotes": "Timber frame erected correctly. Natural slate installed. Air tightness 2.8 m³/h/m² — excellent. MVHR ducting correctly routed."
      }
    },
    {
      "actionName": "Final Inspection & Completion Certificate",
      "decision": "approve",
      "payload": {
        "inspectionDate": "2027-02-10",
        "allServicesConnected": true,
        "fireSafetyVerified": true,
        "electricalCertificateRef": "NICEIC-2027-HLD-004521",
        "plumbingSignOff": true,
        "epcRating": "A",
        "finalSapScore": 89,
        "habitable": true,
        "completionRef": "CC-26/00142/BW"
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/building-inspector-actions.jsonl"
  }
}
