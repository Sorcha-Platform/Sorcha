{
  "actor": {
    "name": "self-builder",
    "description": "Submits planning application and building warrant application"
  },
  "connection": {
    "gatewayUrl": "http://localhost",
    "registerId": "{{planningRegisterId}}",
    "credentials": {
      "email": "$env:ADMIN_EMAIL",
      "password": "$env:ADMIN_PASSWORD",
      "organizationId": "{{organizationId}}"
    },
    "walletAddress": "{{wallets.self-builder}}"
  },
  "inbox": {
    "signalR": { "enabled": true },
    "polling": { "enabled": true, "intervalSeconds": 20 }
  },
  "mode": "rules",
  "rules": [
    {
      "actionName": "Submit Planning Application",
      "decision": "approve",
      "payload": {
        "projectName": "Birchwood Cottage",
        "siteAddress": "Plot 3, Lochside Road, Drumnadrochit, Inverness-shire, IV63 6TU",
        "gridReference": "NH5130",
        "plotSizeHectares": 0.25,
        "dwellingType": "detached",
        "storeys": 1,
        "grossFloorArea": 120,
        "bedrooms": 3,
        "constructionMethod": "timber-frame",
        "estimatedBuildCost": 220000,
        "existingLandUse": "garden-ground",
        "accessArrangement": "existing-access",
        "withinConservationArea": false,
        "designStatement": "A single-storey timber-frame dwelling designed to sit sympathetically within the existing landscape of Lochside Road. Natural larch cladding, natural slate roof, and generous glazing oriented south toward Loch Ness."
      }
    },
    {
      "actionName": "Submit Building Warrant Application",
      "decision": "approve",
      "payload": {
        "planningPermitReference": "26/00142/FUL",
        "siteAddress": "Plot 3, Lochside Road, Drumnadrochit, Inverness-shire, IV63 6TU",
        "constructionMethod": "timber-frame",
        "wallInsulationType": "mineral-wool",
        "heatingSystem": "air-source-heat-pump",
        "renewableEnergy": "solar-PV",
        "estimatedBuildCost": 220000,
        "proposedStartDate": "2026-06-01",
        "sapRating": 86
      }
    }
  ],
  "logging": {
    "level": "Information",
    "actionLog": "./logs/self-builder-actions.jsonl"
  }
}
